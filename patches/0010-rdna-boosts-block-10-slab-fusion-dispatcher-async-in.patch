+        node->src[1]->ne[0] >= 2 && node->src[1]->ne[0] <= 15 &&
+        q_norm->type == GGML_TYPE_F32 && k_norm->type == GGML_TYPE_F32 &&
+        silu->type == GGML_TYPE_F32 &&
