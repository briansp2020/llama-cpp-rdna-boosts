+// avoiding the [n_embd, n_used] intermediate and its separate reduction launch.  Single-token only
+// (n_tokens == 1, gate in ggml_cuda_mul_mat_id_weighted_rdna3_5_ok).  GGML_CUDA_DISABLE_WEIGHTED_DOWN=1
