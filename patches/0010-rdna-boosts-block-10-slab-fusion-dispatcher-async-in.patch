+    const bool target_qwen36 = node->ne[0] == 512 && next->ne[0] == 2048 &&
+        (!has_ids || (gate->ne[1] == 8 && weights->ne[2] == 256));
+    const bool target_qwen4exp = node->ne[0] == 640 && next->ne[0] == 2560 &&
+        (!has_ids || (gate->ne[1] == 10 && weights->ne[2] == 512));
