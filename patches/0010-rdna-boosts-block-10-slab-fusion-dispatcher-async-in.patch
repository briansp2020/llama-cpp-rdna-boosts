+            ggml_can_fuse_subgraph(cgraph, i, { GGML_OP_GLU, GGML_OP_MUL_MAT }, { i + 1 })) {
+        ggml_cuda_mul_mat_q_swiglu_dense(ctx, next->src[0], next, node);
+        return 1;
+    }
+    return 0;
+}
