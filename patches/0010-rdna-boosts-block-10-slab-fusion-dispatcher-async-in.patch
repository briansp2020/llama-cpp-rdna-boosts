+    if (use_mmq && ggml_can_fuse_subgraph(cgraph, i, { GGML_OP_GLU, next->op }, { i + 1 })) {
+        ggml_cuda_mul_mat_q_swiglu(ctx, weights, ids, next, node);
+        return 1;
+    }
+    return 0;
