+    ggml_cuda_mm_fusion_args_device gb{};
+    gb.gb_x2    = wb->data;
+    gb.gb_dst2  = (float *) beta_w->data;
+    gb.gb_dt    = (const float *) dt->data;
+    gb.gb_a     = (const float *) ssm_a->data;
