From b1693a9fb49cf01b6b5ec7115449abf4a8a33111 Mon Sep 17 00:00:00 2001
From: "Brian S. Park" <brianspark@hotmail.com>
Date: Tue, 20 Oct 2026 17:23:47 -0700
Subject: [PATCH] cuda: gfx1100 head-512 WMMA FA rows, and head 512 on WMMA
 prefill again on RDNA3_0

The RDNA head-512 rows of ggml_cuda_fattn_mma_get_config_rdna were tuned
on gfx1201 and keep Q in registers.  On gfx1100 every head-512 kernel
then sits at 256 VGPRs and spills 1.2-1.8k registers per lane (2.2-3.4 KB
scratch), which is why WMMA lost to the tile kernel there and RDNA3_0 was
capped at head 256 (issue #30, r5).

Give RDNA3_0 its own head-512 rows: Q in shared memory, one 128-thread
block per SIMD, 64-wide K / V / combine batches (spills 46-149), and let
DKQ == DV == 512 take WMMA prefill on RDNA3_0 again on top of the 256
cap.  Other heads above 256 keep the tile kernel; RDNA4 and RDNA3_5 are
unchanged.  The decode / verify band (n_q <= 8) stays on the tile kernel.
GGML_CUDA_FA_RDNA3_WMMA_512=0 turns it off (GGML_CUDA_FA_WMMA_256=0 and
GGML_CUDA_FA_WMMA_MAX_HEAD also take it out, as before).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/fattn-mma-f16.cuh | 10 ++++++++++
 ggml/src/ggml-cuda/fattn.cu          | 12 +++++++++++-
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/fattn-mma-f16.cuh b/ggml/src/ggml-cuda/fattn-mma-f16.cuh
index 2c656aaa5..8b1d56275 100644
--- a/ggml/src/ggml-cuda/fattn-mma-f16.cuh
+++ b/ggml/src/ggml-cuda/fattn-mma-f16.cuh
@@ -193,6 +193,16 @@ static constexpr __host__ __device__ fattn_mma_config ggml_cuda_fattn_mma_get_co
     GGML_CUDA_FATTN_MMA_CONFIG_CASE(320, 256, 32, 256, 2,  64,  96,  16,  16, 1, true);
     GGML_CUDA_FATTN_MMA_CONFIG_CASE(320, 256, 64, 256, 2,  64,  96,  16,  16, 1, true);
 
+    // RDNA3_0 (gfx1100) head 512: the RDNA4 rows below keep Q in registers and spill 1.2-1.8k VGPRs per lane on
+    // gfx1100 (2.2-3.4 KB scratch), which made WMMA ~30 % slower than the tile kernel there.  Q in shared memory,
+    // one 128-thread block per SIMD and 64-wide K/V/combine batches spill 46-331 instead; gemma-4-26B-A4B
+    // pp2048 @ d32768: q8_0 2793 vs tile 1891, f16 2841 vs 2000.  (AMD prefill takes <= 32 columns for heads
+    // > 256, see ggml_cuda_flash_attn_ext_mma_f16_switch_ncols1; the 64-column row is kept consistent.)
+    if (!is_rdna3_5 && !is_rdna4 && DKQ == 512 && DV == 512) {
+        if (ncols == 16) { return fattn_mma_config(128, 1, 64, 64, 64, 64, 1, false); }
+        if (ncols == 32) { return fattn_mma_config(128, 1, 32, 64, 64, 64, 1, false); }
+        if (ncols == 64) { return fattn_mma_config(128, 1, 32, 64, 64, 64, 1, false); }
+    }
     GGML_CUDA_FATTN_MMA_CONFIG_CASE(512, 512,  8, 128, 3,  64,  96,  64, 128, 1, true);
     GGML_CUDA_FATTN_MMA_CONFIG_CASE(512, 512, 16, 128, 2,  64,  96,  16,  16, 1, true);
     GGML_CUDA_FATTN_MMA_CONFIG_CASE(512, 512, 32, 128, 2,  32, 128, 128,  64, 1, true);
diff --git a/ggml/src/ggml-cuda/fattn.cu b/ggml/src/ggml-cuda/fattn.cu
index cb49fbae2..46398eba1 100644
--- a/ggml/src/ggml-cuda/fattn.cu
+++ b/ggml/src/ggml-cuda/fattn.cu
@@ -795,6 +795,16 @@ static best_fattn_kernel ggml_cuda_get_best_fattn_kernel(const int device, const
         return e != nullptr ? std::atoi(e) : -1;
     }();
     const int wmma_max_head = wmma_max_env >= 0 ? wmma_max_env : (wmma_256 && GGML_CUDA_CC_IS_RDNA4(cc) ? 576 : wmma_256 && GGML_CUDA_CC_IS_RDNA3_0(cc) ? 256 : wmma_256 && GGML_CUDA_CC_IS_RDNA3_5(cc) ? 320 : 128);
+    // RDNA3_0 head 512 (DKQ == DV == 512, e.g. Gemma 4's global layers) has its own gfx1100 rows in
+    // ggml_cuda_fattn_mma_get_config_rdna and takes WMMA prefill on top of the 256 cap: gemma-4-26B-A4B pp2048 @ d32768
+    // q8_0 2793 vs 1891 (tile), f16 2841 vs 2000.  Other heads above 256 keep the tile kernel there.
+    // GGML_CUDA_FA_WMMA_256=0 / GGML_CUDA_FA_WMMA_MAX_HEAD keep their meaning (this does not apply when either is set).
+    static const bool rdna3_512_off = [] {
+        const char * e = getenv("GGML_CUDA_FA_RDNA3_WMMA_512");
+        return e != nullptr && std::atoi(e) == 0;
+    }();
+    const bool rdna3_512 = wmma_256 && wmma_max_env < 0 && !rdna3_512_off && GGML_CUDA_CC_IS_RDNA3_0(cc) &&
+        Q->ne[0] == 512 && V->ne[0] == 512;
     // Whole decode/verify band (n_q = 1 included) on WMMA with the folded GQA group, default on.
     // GGML_CUDA_FA_WMMA_256=0 / GGML_CUDA_FA_WMMA_MAX_HEAD stay the escape hatches, so they must
     // disable this exactly like the generic head>128 WMMA band below.
@@ -806,7 +816,7 @@ static best_fattn_kernel ggml_cuda_get_best_fattn_kernel(const int device, const
     // kernel: decode (n_q = 1) never uses WMMA, so a WMMA verify batch would
     // produce different logits than decode (GREEDY-PURITY band invariant).
     // Upstream's head>128 gqa-eff threshold (16) is kept on top.
-    if ((amd_wmma_available(cc) && gqa_opt_applies && Q->ne[0] <= wmma_max_head) && Q->ne[0] != 40 && Q->ne[0] != 72 &&
+    if ((amd_wmma_available(cc) && gqa_opt_applies && (Q->ne[0] <= wmma_max_head || rdna3_512)) && Q->ne[0] != 40 && Q->ne[0] != 72 &&
             Q->ne[1] * gqa_ratio_eff > (Q->ne[0] <= 128 ? 8 : 16) && Q->ne[1] > 8) {
         // The kernel instantiates logit_softcap only for heads 128/256/512.
         if (logit_softcap == 0.0f || Q->ne[0] == 128 || Q->ne[0] == 256 || Q->ne[0] == 512) {
-- 
2.43.0

