+        ggml_cuda_topk_moe_match m;
+        if (const int n_topk = ggml_cuda_topk_moe_match_at(cgraph, i + 1, m)) {
+            if (ggml_cuda_router_topk_moe_ok(*cuda_ctx, node, m.logits, m.bias, m.args) && ggml_nrows(m.logits) == 1) {
