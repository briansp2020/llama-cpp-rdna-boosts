+// gfx1100 (RDNA3_0) dense Q4_K mmvq VDR (vec_dot_q4_K_q8_1_vdr4_dense); see get_vdr_mmvq_dense() in mmvq.cu
+#define VDR_Q4_K_Q8_1_MMVQ_RDNA3_0 4
+
+#if defined(RDNA3_0)
+// gfx1100 (RDNA3_0) dense Q4_K mmvq, 32 elements per call (VDR 4).  The two 16-element chunks of a call belong to
+// the same two sub-blocks, so each sub-block's 16 products are summed in one integer dot-product chain before its
+// single scale/convert/fma (|dot1| <= 16*15*127, times the 6-bit scale < 2^21, exact); the mins term uses the same
+// exact-product form as vec_dot_q4_K_q8_1.  Half the per-(row, column) float work and per-row unpacking of the
+// 16-element form per weight, which is what bounds the multi-row verify kernel on gfx1100.
+static __device__ __forceinline__ float vec_dot_q4_K_q8_1_vdr4_dense(
+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+
+    const block_q4_K * bq4_K = (const block_q4_K *) vbq + kbx;
+
+    // iqs is in 0,4..28: chunks iqs and iqs+2 share bq8_offset and the scale pair (see vec_dot_q4_K_q8_1_vdr4)
+    const int bq8_offset = QR4_K * ((iqs/2) / (QI8_1/2));
+    const int i8 = (iqs/2) % 4;
+
+    const int * q4 = (const int *)(bq4_K->qs + 16 * bq8_offset + 4 * i8);
+    const int v0 = q4[0];
+    const int v1 = q4[4];
+    const int v2 = q4[1];
+    const int v3 = q4[5];
+
+    // scales/mins of sub-block pair j packed as in vec_dot_q4_K_q8_1
+    const uint16_t * scales = (const uint16_t *)bq4_K->scales;
+    const int j  = bq8_offset/2;
+    const int jm = j & 1;
+
+    const uint32_t s02 = scales[jm + 0] | ((uint32_t) scales[jm + 2] << 16);
+    const uint32_t s4  = scales[jm + 4];
+
+    const uint32_t scm_lo = s02 & 0x3f3f3f3f;
+    const uint32_t scm_hi = ((s4 | (s4 << 12)) & 0x0f0f0f0f) | ((s02 & 0xc0c0c0c0) >> 2);
+    const uint32_t scm    = j >= 2 ? scm_hi : scm_lo;
+
+    float sumf_d = 0.0f;
+    float sumf_m = 0.0f;
+
+#pragma unroll
+    for (int i = 0; i < QR4_K; ++i) {
+        const block_q8_1 * bq8i = bq8_1 + bq8_offset + i;
+        const int * q8 = (const int *)bq8i->qs + i8;
+        const float d8 = __low2float(bq8i->ds);
+
+        int dot1 = ggml_cuda_dp4a((v0 >> (4*i)) & 0x0F0F0F0F, q8[0], 0);
+        dot1     = ggml_cuda_dp4a((v1 >> (4*i)) & 0x0F0F0F0F, q8[4], dot1);
+        dot1     = ggml_cuda_dp4a((v2 >> (4*i)) & 0x0F0F0F0F, q8[1], dot1);
+        dot1     = ggml_cuda_dp4a((v3 >> (4*i)) & 0x0F0F0F0F, q8[5], dot1);
+
+        int dot2 = ggml_cuda_dp4a(0x01010101, q8[0], 0);
+        dot2     = ggml_cuda_dp4a(0x01010101, q8[4], dot2);
+        dot2     = ggml_cuda_dp4a(0x01010101, q8[1], dot2);
+        dot2     = ggml_cuda_dp4a(0x01010101, q8[5], dot2);
+
+        sumf_d += d8 * ggml_cuda_mul_small(dot1, (scm >> (8*i)) & 0xFF);
+        sumf_m += (d8 * (float) dot2) * (float) ((scm >> (8*i + 16)) & 0xFF);
+    }
+
+    const float2 dm4f = __half22float2(bq4_K->dm);
+
+    return dm4f.x*sumf_d - dm4f.y*sumf_m;
+}
+#endif // defined(RDNA3_0)
