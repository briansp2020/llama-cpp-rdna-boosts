From 66e88732b696657800d00daa493c4012d8c39de2 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Fri, 30 Oct 2026 12:34:22 +0000
Subject: [PATCH 3/4] GDN direct conv for 1-token decode on RDNA4 / RDNA3_0,
 only where it also takes the q / k l2 norm pair (gdn_conv_norm_match() > 0)
 and the decode-only ssm_prescan fusion would not take the conv; the
 ssm_conv_in epilogue steps aside for exactly those concats (and goes on
 scanning the window). The data-dependent gate lives in the compute-time
 matchers; graph_optimize uses the structural match
 (ggml_cuda_gdn_conv_pattern_at_concat), whose alloc deps are a superset.
 Bit-identical. GGML_CUDA_FUSE_GDN_CONV_DECODE=0 off (the 1-token path alone;
 GGML_CUDA_FUSE_GDN_CONV_VERIFY=0 still turns off the whole band)

---
 ggml/src/ggml-cuda/gdn-conv.cu  | 36 ++++++++++++++++++++++++++++-----
 ggml/src/ggml-cuda/gdn-conv.cuh |  1 +
 ggml/src/ggml-cuda/ggml-cuda.cu |  2 +-
 ggml/src/ggml-cuda/mmvq.cu      | 24 +++++++++++++++++++++-
 ggml/src/ggml-cuda/mmvq.cuh     |  1 +
 5 files changed, 57 insertions(+), 7 deletions(-)

diff --git a/ggml/src/ggml-cuda/gdn-conv.cu b/ggml/src/ggml-cuda/gdn-conv.cu
index f1aa17db3..97b6ce57f 100644
--- a/ggml/src/ggml-cuda/gdn-conv.cu
+++ b/ggml/src/ggml-cuda/gdn-conv.cu
@@ -1,5 +1,6 @@
 #include "gdn-conv.cuh"
 #include "unary.cuh"
+#include "mmvq.cuh"
 #include <cstdlib>
 #include <algorithm>
 
@@ -187,11 +188,12 @@ static bool gdn_conv_check(const ggml_cgraph * cgraph, int i, ggml_cuda_gdn_conv
     if (tr->ne[0] != T || tr->ne[1] != C || tr->view_offs != 0) return false;
     if (cc->ne[0] != T + 3 || cc->ne[1] != C || cc->ne[2] != 1 || cc->ne[3] != 1 || !ggml_is_contiguous(cc)) return false;
     int n_snap = 0; bool snap_ok = true;
-    // On RDNA4 and RDNA3_0 the 2..255-token batches (the speculative verify step) take the fused path too; otherwise their CONCAT is a
-    // generic non-contiguous copy per layer.  Same kernels, bit-identical.  GGML_CUDA_FUSE_GDN_CONV_VERIFY=0 turns it off.
+    // On RDNA4 and RDNA3_0 the 1..255-token batches (decode and the speculative verify step) take the fused path too; otherwise
+    // their CONCAT is a generic non-contiguous copy per layer (decode: the ssm_conv_in epilogue, which steps aside for this path).
+    // Same kernels, bit-identical.  GGML_CUDA_FUSE_GDN_CONV_VERIFY=0 turns it off.
     static const bool conv_verify = getenv("GGML_CUDA_FUSE_GDN_CONV_VERIFY") == nullptr || atoi(getenv("GGML_CUDA_FUSE_GDN_CONV_VERIFY")) != 0;
     const int  cc_verify = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
-    const bool verify_ok = conv_verify && T >= 2 && (GGML_CUDA_CC_IS_RDNA4(cc_verify) || GGML_CUDA_CC_IS_RDNA3_0(cc_verify));
+    const bool verify_ok = conv_verify && T >= 1 && (GGML_CUDA_CC_IS_RDNA4(cc_verify) || GGML_CUDA_CC_IS_RDNA3_0(cc_verify));
     if ((T < 256 && !verify_ok) || C % 256 != 0) return false;
     if (i + 1 >= cgraph->n_nodes || cgraph->nodes[i + 1]->op != GGML_OP_VIEW || cgraph->nodes[i + 1]->view_src != cc) return false;
     int64_t tail_from = T + 3; int conv = -1;
@@ -243,12 +245,20 @@ static bool gdn_conv_check(const ggml_cgraph * cgraph, int i, ggml_cuda_gdn_conv
     return true;
 }
 
-bool ggml_cuda_gdn_conv_match_at_concat(const ggml_cgraph * cgraph, int i, ggml_cuda_gdn_conv_match & m) { return gdn_conv_check(cgraph, i, m); }
+static bool gdn_conv_decode_ok(const ggml_cgraph * cgraph, const ggml_cuda_gdn_conv_match & m);
+
+bool ggml_cuda_gdn_conv_match_at_concat(const ggml_cgraph * cgraph, int i, ggml_cuda_gdn_conv_match & m) {
+    return gdn_conv_check(cgraph, i, m) && gdn_conv_decode_ok(cgraph, m);
+}
+
+// The structural match alone (graph_optimize, before allocation: no data pointers yet).  A superset of match_at_concat, so
+// its alloc deps cover every case the compute-time matchers take.
+bool ggml_cuda_gdn_conv_pattern_at_concat(const ggml_cgraph * cgraph, int i, ggml_cuda_gdn_conv_match & m) { return gdn_conv_check(cgraph, i, m); }
 
 bool ggml_cuda_gdn_conv_match_at_conv(const ggml_cgraph * cgraph, int j, ggml_cuda_gdn_conv_match & m) {
     if (!gdn_conv_enabled() || j < 1 || cgraph->nodes[j]->op != GGML_OP_SSM_CONV) return false;
     const ggml_tensor * cc = cgraph->nodes[j]->src[0];
-    for (int i = j - 1; i >= 0 && i >= j - 64; --i) if (cgraph->nodes[i] == cc) return gdn_conv_check(cgraph, i, m) && m.conv_idx == j;
+    for (int i = j - 1; i >= 0 && i >= j - 64; --i) if (cgraph->nodes[i] == cc) return gdn_conv_check(cgraph, i, m) && m.conv_idx == j && gdn_conv_decode_ok(cgraph, m);
     return false;
 }
 
@@ -373,6 +383,22 @@ static int gdn_conv_norm_match(const ggml_cgraph * cgraph, const ggml_cuda_gdn_c
     return j2 + 1;
 }
 
+// One token (decode; GGML_CUDA_FUSE_GDN_CONV_DECODE=0: off): the direct conv only where it also takes the q / k l2 norm pair (otherwise the ssm_conv_in epilogue,
+// which writes the CONCAT inside the in-proj GEMV, is cheaper) and only where the decode-only ssm_prescan fusion would not
+// take the conv.  Uses data pointers: compute time only.  Every compute-time caller (CONCAT, SSM_CONV, the ssm_conv_in
+// stand-down, the snapshot and gather folds) goes through the two matchers above, so they all decide the same way.
+static bool gdn_conv_decode_ok(const ggml_cgraph * cgraph, const ggml_cuda_gdn_conv_match & m) {
+    if (m.T > 1) {
+        return true;
+    }
+    static const bool decode = getenv("GGML_CUDA_FUSE_GDN_CONV_DECODE") == nullptr || atoi(getenv("GGML_CUDA_FUSE_GDN_CONV_DECODE")) != 0;
+    if (!decode) {
+        return false;
+    }
+    gdn_conv_norm_args na;
+    return gdn_conv_norm_match(cgraph, m, na) > 0 && !ggml_cuda_ssm_prescan_match_at(cgraph, m.conv_idx);
+}
+
 // Depthwise causal conv1d fusion entry point (GDN).  Returns the number of graph nodes to skip
 // when fused, 0 otherwise.  A/B / bisect kill switch: GGML_CUDA_DISABLE_CONV_FUSION=1.
 int ggml_cuda_gdn_conv_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
diff --git a/ggml/src/ggml-cuda/gdn-conv.cuh b/ggml/src/ggml-cuda/gdn-conv.cuh
index 1a7148d21..dcfad68c6 100644
--- a/ggml/src/ggml-cuda/gdn-conv.cuh
+++ b/ggml/src/ggml-cuda/gdn-conv.cuh
@@ -18,6 +18,7 @@ struct ggml_cuda_gdn_conv_match {
     ggml_tensor * snap_dst[SNAP_MAX] = {};
 };
 bool ggml_cuda_gdn_conv_match_at_concat(const ggml_cgraph * cgraph, int i, ggml_cuda_gdn_conv_match & m);
+bool ggml_cuda_gdn_conv_pattern_at_concat(const ggml_cgraph * cgraph, int i, ggml_cuda_gdn_conv_match & m);
 bool ggml_cuda_gdn_conv_match_at_conv(const ggml_cgraph * cgraph, int j, ggml_cuda_gdn_conv_match & m);
 void ggml_cuda_gdn_conv_write_tail(ggml_backend_cuda_context & ctx, const ggml_cuda_gdn_conv_match & m);
 struct gdn_conv_norm_args;
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 5f9cb4b14..2583f9508 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -6727,7 +6727,7 @@ static void ggml_backend_cuda_graph_optimize(ggml_backend_t backend, ggml_cgraph
                     continue;
                 }
                 ggml_cuda_gdn_conv_match gm;
-                if (ggml_cuda_gdn_conv_match_at_concat(cgraph, i, gm)) {
+                if (ggml_cuda_gdn_conv_pattern_at_concat(cgraph, i, gm)) {
                     params->add_alloc_dep(params->user_data, const_cast<ggml_tensor *>(gm.x), cgraph->nodes[gm.conv_idx]);
                     params->add_alloc_dep(params->user_data, const_cast<ggml_tensor *>(gm.state), cgraph->nodes[gm.conv_idx]);
                 }
diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 194ab5598..65cc68129 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -1,4 +1,5 @@
 #include "mmvq.cuh"
+#include "gdn-conv.cuh"
 #include "moe-expert-cache.h"   // Phase 1b: moe_cache_enabled/moe_cache_get_cold (the UVA cold seam)
 #include "quantize.cuh"
 #include "unary.cuh"
@@ -3118,6 +3119,12 @@ int ggml_cuda_ssm_conv_in_try_fuse(ggml_backend_cuda_context & ctx, const ggml_c
         if (s0 == nullptr || s0->op != GGML_OP_GET_ROWS || s0->type != GGML_TYPE_F32) {
             continue;
         }
+        // the GDN direct conv takes this concat (decode included on RDNA4 / RDNA3_0): it reads the plain matmul output
+        // and the conv state itself, so this epilogue must not consume the concat (it would skip the plain store)
+        ggml_cuda_gdn_conv_match gdn_m;
+        if (ggml_cuda_gdn_conv_match_at_concat(cgraph, j, gdn_m)) {
+            continue;
+        }
         // conv_input [cs, C] = states [(cs-1)*C] + qkv [C], dim 0
         const int64_t C = n->ne[1] * n->ne[2] * n->ne[3];
         const int64_t cs = n->ne[0];
@@ -3158,7 +3165,19 @@ int ggml_cuda_ssm_conv_in_try_fuse(ggml_backend_cuda_context & ctx, const ggml_c
 // Fuse the SSM pre-scan chain: conv+silu, l2_norm(q,k) and the gate/beta projections (decode only).
 // One kernel instead of ssm_conv, l2_norm_pair and ssm_gate_beta.  Returns 15 when fused.
 // GGML_CUDA_DISABLE_SSM_PRESCAN=1 turns it off.
+// The decode-only conv + l2 norm + gate / beta prescan fusion at SSM_CONV node i: whether it would take the node
+// (ggml_cuda_ssm_prescan_try_fuse with launch = false).  Also consulted by the GDN direct conv, which steps aside for it.
+static int ggml_cuda_ssm_prescan_impl(ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph, int i);
+
+bool ggml_cuda_ssm_prescan_match_at(const ggml_cgraph * cgraph, int i) {
+    return ggml_cuda_ssm_prescan_impl(nullptr, cgraph, i) != 0;
+}
+
 int ggml_cuda_ssm_prescan_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    return ggml_cuda_ssm_prescan_impl(&ctx, cgraph, i);
+}
+
+static int ggml_cuda_ssm_prescan_impl(ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph, int i) {
     static const bool disable_ssm_prescan = getenv("GGML_CUDA_DISABLE_SSM_PRESCAN") != nullptr && std::atoi(getenv("GGML_CUDA_DISABLE_SSM_PRESCAN"));
     ggml_tensor * node = cgraph->nodes[i];
     if (disable_ssm_prescan || node->op != GGML_OP_SSM_CONV || node->type != GGML_TYPE_F32 || node->ne[1] != 1 ||
@@ -3237,9 +3256,12 @@ int ggml_cuda_ssm_prescan_try_fuse(ggml_backend_cuda_context & ctx, const ggml_c
     if (wiring_ok && type_ok) {
         const int out_nodes[] = { i + 1, i + 3, i + 5, i + 11, i + 15 };
         if (ggml_cuda_check_fusion_memory_ranges(cgraph, i, 16, out_nodes, 5)) {
+            if (ctx == nullptr) {
+                return 15;
+            }
             float eps;
             memcpy(&eps, q_norm->op_params, sizeof(float));
-            ggml_cuda_op_ssm_conv_l2_gatebeta(ctx,
+            ggml_cuda_op_ssm_conv_l2_gatebeta(*ctx,
                 node->src[0], node->src[1],
                 alpha_w->src[0], beta_w->src[0], alpha_w->src[1], dt, ssm_a,
                 (ggml_tensor *) q_norm, (ggml_tensor *) k_norm, (ggml_tensor *) silu,
diff --git a/ggml/src/ggml-cuda/mmvq.cuh b/ggml/src/ggml-cuda/mmvq.cuh
index 84dd93992..ea7ce5ad9 100644
--- a/ggml/src/ggml-cuda/mmvq.cuh
+++ b/ggml/src/ggml-cuda/mmvq.cuh
@@ -58,6 +58,7 @@ bool ggml_cuda_should_fuse_mul_mat_vec_q(const ggml_tensor * tensor, const bool
 int ggml_cuda_mul_mat_id_weighted_down_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i);
 
 int ggml_cuda_ssm_conv_in_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i);
+bool ggml_cuda_ssm_prescan_match_at(const struct ggml_cgraph * cgraph, int i);
 int ggml_cuda_ssm_prescan_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i);
 
 int ggml_cuda_mul_mat_dual_output_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i);
