+// WIP-ONLY (2026-10-12, TODO #52 bisect): hash a node's output columns immediately after its
+// launch.  Requires graph capture OFF.  NOT FOR DELIVERY.
+static void ggml_cuda_dump_node_hash(ggml_backend_cuda_context * cuda_ctx, ggml_tensor * t, int idx) {
+    static const char * filt = getenv("LLAMA_DUMP_CUDA");
+    if (filt == nullptr || filt[0] == '\0' || t == nullptr || t->buffer == nullptr || t->data == nullptr) {
+        return;
+    }
+    const bool all = (filt[0] == '*' && filt[1] == '\0');
+    if (!all) {
+        if (t->name == nullptr) {
+            return;
+        }
+        if (filt[0] == '=') {
+            if (strcmp(t->name, filt + 1) != 0) {
+                return;
+            }
+        } else if (strstr(t->name, filt) == nullptr) {
+            return;
+        }
+    }
+    // the buffer readback copies on cudaStreamPerThread; order it against the compute stream
+    CUDA_CHECK(cudaStreamSynchronize(cuda_ctx->stream()));
+    const char * nm = (t->name != nullptr && t->name[0] != '\0') ? t->name : "(unnamed)";
+    const size_t col = std::min<size_t>(ggml_row_size(t->type, t->ne[0]), (size_t) (1u << 20));
+    const int64_t n_tok = std::min<int64_t>(t->ne[1], 32);
+    const int64_t n_seq = std::min<int64_t>(t->ne[2], 2);
+    for (int64_t seq = 0; seq < n_seq; ++seq) {
+        for (int64_t tok = 0; tok < n_tok; ++tok) {
+            std::vector<uint8_t> buf(col);
+            ggml_backend_tensor_get(t, buf.data(), (size_t) tok * t->nb[1] + (size_t) seq * t->nb[2], col);
+            uint64_t h = 1469598103934665603ull;
+            for (size_t j = 0; j < col; ++j) {
+                h = (h ^ buf[j]) * 1099511628211ull;
+            }
+            GGML_LOG_WARN("CUDADUMP id=%d %-44s op=%-20s ne=[%lld,%lld,%lld,%lld] tok=%lld seq=%lld hash=%016llx\n",
+                    idx, nm, ggml_op_name(t->op),
+                    (long long) t->ne[0], (long long) t->ne[1], (long long) t->ne[2], (long long) t->ne[3],
+                    (long long) tok, (long long) seq, (unsigned long long) h);
+        }
+    }
+}
