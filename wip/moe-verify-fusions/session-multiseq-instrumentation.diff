+// WIP-ONLY diagnostic (2026-10-12, TODO #52 multi-sequence determinism bisect).  NOT FOR DELIVERY.
+// LLAMA_DUMP_GRAPH="substr1,substr2" (or "*") hashes the named compute-graph tensors right after
+// the graph runs, so two arms can be diffed tensor-by-tensor.
+static void llama_dump_graph_hashes(ggml_cgraph * gf, uint32_t ub_n_tokens, uint32_t ub_n_seqs, uint32_t ub_n_seq_tokens) {
+    static const char * spec = getenv("LLAMA_DUMP_GRAPH");
+    if (spec == nullptr || spec[0] == '\0' || gf == nullptr) {
+        return;
+    }
+    std::vector<std::string> filters;
+    {
+        std::string s(spec);
+        size_t p = 0;
+        while (p <= s.size()) {
+            size_t q = s.find(',', p);
+            if (q == std::string::npos) { q = s.size(); }
+            if (q > p) { filters.push_back(s.substr(p, q - p)); }
+            p = q + 1;
+        }
+    }
+    LLAMA_LOG_WARN("LLAMADUMP-BATCH n_tokens=%u n_seqs=%u n_seq_tokens=%u\n", ub_n_tokens, ub_n_seqs, ub_n_seq_tokens);
+    const int n_nodes = ggml_graph_n_nodes(gf);
+    for (int i = 0; i < n_nodes; ++i) {
+        ggml_tensor * t = ggml_graph_node(gf, i);
+        if (t == nullptr || t->name == nullptr || t->buffer == nullptr || t->data == nullptr) {
+            continue;
+        }
+        bool match = false;
+        for (const auto & f : filters) {
+            if (f == "*" || strstr(t->name, f.c_str()) != nullptr) { match = true; break; }
+        }
+        if (!match) {
+            continue;
+        }
+        // per-(token,seq) hash of the column over ne[0] (embd); ne[1] = tokens, ne[2] = seqs
+        const size_t col = std::min<size_t>(ggml_row_size(t->type, t->ne[0]), (size_t) (1u << 20));
+        const int64_t n_tok = std::min<int64_t>(t->ne[1], 32);
+        const int64_t n_seq = std::min<int64_t>(t->ne[2], 2);
+        for (int64_t tok = 0; tok < n_tok; ++tok) {
+            for (int64_t seq = 0; seq < n_seq; ++seq) {
+                std::vector<uint8_t> buf(col);
+                ggml_backend_tensor_get(t, buf.data(), (size_t) tok * t->nb[1] + (size_t) seq * t->nb[2], col);
+                uint64_t h = 1469598103934665603ull;
+                for (size_t j = 0; j < col; ++j) {
+                    h = (h ^ buf[j]) * 1099511628211ull;
+                }
+                LLAMA_LOG_WARN("LLAMADUMP %-44s op=%-20s ne=[%lld,%lld,%lld,%lld] tok=%lld seq=%lld hash=%016llx\n",
+                        t->name, ggml_op_name(t->op),
+                        (long long) t->ne[0], (long long) t->ne[1], (long long) t->ne[2], (long long) t->ne[3],
+                        (long long) tok, (long long) seq, (unsigned long long) h);
+            }
+        }
+    }
+}
