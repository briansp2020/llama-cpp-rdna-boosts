From c59a184ab25427cc30b5e64304dff60dfbb9fcd9 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Sat, 17 Oct 2026 23:08:24 +0000
Subject: [PATCH 2/2] cuda: keep BF16 caches off the RMS_NORM + MUL + ROPE +
 SET_ROWS fusion

ggml_cuda_should_fuse_rope_set_rows admits a BF16 SET_ROWS (rope's own set_rows path writes BF16), but the 5-op
RMS_NORM, MUL, ROPE, VIEW, SET_ROWS fusion runs ggml_cuda_op_rms_norm_mul_rope_fused, which writes F32 / F16 rows only
and aborts otherwise.  A qk-norm model whose K cache write follows the K rope reached it with -ctk bf16 (plain r80:
NEOX models such as Qwen3-30B-A3B; with the M-RoPE fusion also the Qwen3.x IMROPE models).  Decline the 5-op match
for BF16; the RMS_NORM + MUL + ROPE fusion and the plain SET_ROWS take it instead.  test-backend-ops gains the BF16
set_rows cases of RMS_NORM_MUL_ROPE.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu | 2 ++
 tests/test-backend-ops.cpp               | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
index 5474d6254..5acffdc44 100644
--- a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
@@ -1036,7 +1036,9 @@ static bool ggml_cuda_can_fuse(const struct ggml_cgraph *                cgraph,
         const ggml_tensor * view     = cgraph->nodes[node_idx + 3];
         const ggml_tensor * set_rows = cgraph->nodes[node_idx + 4];
 
+        // ggml_cuda_op_rms_norm_mul_rope_fused writes F32 / F16 rows only; a BF16 cache keeps rope's own set_rows path
         if (ggml_check_edges(cgraph, node_idx, {{1, 0, 0}, {2, 0, 1}, {3, 0, 2}, {4, 0, 3}}) &&
+            set_rows->type != GGML_TYPE_BF16 &&
             ggml_cuda_should_fuse_rms_norm_mul_rope(rms_norm, mul, rope) &&
             ggml_cuda_should_fuse_rope_set_rows(rope, view, set_rows)) {
             int out_nodes[] = { node_idx + 4 };
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index d2bc89109..0f00ff8e1 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -10893,7 +10893,7 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     test_cases.emplace_back(new test_l2_norm     (GGML_TYPE_F32, {4, 1, 65536, 1}, 1e-12f, false, false));
     test_cases.emplace_back(new test_rms_norm_mul_add(GGML_TYPE_F32, {4, 1, 65536, 1}, 1e-6f, false, false));
 
-    for (ggml_type set_rows_type : { GGML_TYPE_F32, GGML_TYPE_F16 }) {
+    for (ggml_type set_rows_type : { GGML_TYPE_F32, GGML_TYPE_F16, GGML_TYPE_BF16 }) {
         test_cases.emplace_back(new test_rms_norm_mul_rope({ 256, 1, 1, 1 }, 1e-6f, false, true, false, GGML_ROPE_TYPE_NORMAL, false, false, set_rows_type));
         test_cases.emplace_back(new test_rms_norm_mul_rope({ 128, 4, 3, 1 }, 1e-6f, false, true, false, GGML_ROPE_TYPE_NORMAL, false, false, set_rows_type));
     }
