From 586c123b4fc5d39aca0871198abdd5e2e409bd07 Mon Sep 17 00:00:00 2001
From: briansp2020 <bsp2020@gmail.com>
Date: Wed, 7 Oct 2026 00:02:24 +0000
Subject: [PATCH] cuda: reuse the BF16 copy of a shared F32 src1 across cuBLAS
 BF16 GEMMs (prefill hc mixers)

The BF16 hyper-connection weights of Flash-Next GSQ-RCO take the cuBLAS/hipBLASLt BF16 path at prefill
(MMB does not take BF16 weights on RDNA4), which converted the whole F32 activation for every GEMM.  The
hc mixer feeds one normalized [hc_dim, T] tensor to two of them (hc_down and the 4-wide hc_inject), so
each 2048-token ubatch spent ~43 ms per GPU converting 84 MB tensors, twice per mixer.

- bf16_src1_cache: per-graph single-entry cache of the BF16 copy, keyed by view root, data, stream and
  size like the Q8_1 input cache, cleared at graph start; multi-token (>= 64) graphs only, so decode and
  verify are untouched.  GGML_CUDA_BF16_SRC1_CACHE=0 disables it.
- qwen4exp: emit the inject product right after the down product, so the two run back to back.
- hc_combine_norm writes the BF16 copy of xn in the same pass (its existing out_xn_bf16 output, RNE
  like the conversion it replaces) as the cached entry; the F32 xn is still stored for dsv4_hc_pre.

On r33 (2 x R9700, all experts in VRAM): llama-bench pp2048 -sm tensor 2495 -> 3173 t/s, -sm layer 2412 -> 2519;
server prefill 9.4k / 32.6k tokens 2297 / 2391 -> 2383 / 2473 t/s.  Greedy output identical to r33 (decode, 2.9k,
9.4k and 32.6k prompts, tensor and layer split); perplexity KLD vs r33 at the run-to-run floor; 259.6k VRAM peak
unchanged.  The r19 trace: conversions 56.6 -> 13.1 ms per pp2048 ubatch per GPU.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/common.cuh   | 32 +++++++++++++++++++++
 ggml/src/ggml-cuda/ggml-cuda.cu | 50 ++++++++++++++++++++++++++++++++-
 src/models/qwen4exp.cpp         | 14 +++++----
 3 files changed, 90 insertions(+), 6 deletions(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 21beb7511..1fa5e3321 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -2056,6 +2056,38 @@ struct ggml_backend_cuda_context {
     // pool
     std::unique_ptr<ggml_cuda_pool> pools[GGML_CUDA_MAX_DEVICES][GGML_CUDA_MAX_STREAMS];
 
+    // Per-graph cache of the BF16 copy that the cuBLAS BF16 matmul makes of an F32 src1 (multi-token graphs).
+    // The hc mixer feeds one normalized [hc_dim, T] tensor to two BF16 GEMMs (hc_down and the 4-wide hc_inject),
+    // which converted all of it twice; the second GEMM now reuses the first copy.  Keyed like the Q8_1 cache
+    // (tensor, data, stream, size), only the most recent conversion is kept, and it is dropped at graph start.
+    // Declared after `pools` so that its pool buffer is released before the pools are destroyed.
+    struct bf16_src1_cache_entry {
+        const ggml_tensor * src1 = nullptr;
+        const void * data = nullptr;
+        int stream_no = 0;
+        int64_t n = 0;
+        std::unique_ptr<ggml_cuda_pool_alloc<nv_bfloat16>> buf;
+    } bf16_src1_cache;
+
+    void bf16_src1_cache_clear() {
+        bf16_src1_cache.buf.reset();
+        bf16_src1_cache.src1 = nullptr;
+        bf16_src1_cache.data = nullptr;
+    }
+
+    // Make `root` (a view root, contiguous, n elements) the cached entry and return its BF16 buffer for the
+    // caller to fill: the cuBLAS BF16 path converts into it, a fused producer (hc_combine_norm) writes it.
+    nv_bfloat16 * bf16_src1_cache_put(const ggml_tensor * root, int64_t n) {
+        auto & c = bf16_src1_cache;
+        c.buf.reset();
+        c.buf       = std::make_unique<ggml_cuda_pool_alloc<nv_bfloat16>>(pool(), n);
+        c.src1      = root;
+        c.data      = root->data;
+        c.stream_no = curr_stream_no;
+        c.n         = n;
+        return c.buf->get();
+    }
+
     static std::unique_ptr<ggml_cuda_pool> new_pool_for_device(int device, int stream_no);
 
     ggml_cuda_pool & pool(int device) {
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 67debf913..537d7b8a2 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2794,6 +2794,12 @@ struct cuda_gc_timer {
     ~cuda_gc_timer() { if (t0) { g_cgc_us += ggml_time_us() - t0; g_cgc_nodes += cg->n_nodes; g_cgc_calls += 1; } }
 };
 
+// GGML_CUDA_BF16_SRC1_CACHE=0 disables the per-graph BF16 src1 reuse (bf16_src1_cache in common.cuh).
+static bool ggml_cuda_bf16_src1_cache_on() {
+    static const bool on = getenv("GGML_CUDA_BF16_SRC1_CACHE") == nullptr || atoi(getenv("GGML_CUDA_BF16_SRC1_CACHE")) != 0;
+    return on;
+}
+
 template<ggml_type compute_type>
 
 static void ggml_cuda_mul_mat_cublas_impl(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
@@ -2863,7 +2869,34 @@ static void ggml_cuda_mul_mat_cublas_impl(ggml_backend_cuda_context & ctx, const
                  if (d > g_cb_worst_us) { g_cb_worst_us = d; snprintf(g_cb_worst, sizeof(g_cb_worst), "src0=%s n=%lld type=%s", src0->name, (long long) ggml_nelements(src0), ggml_type_name(src0->type)); } }
 
     const int64_t t_cb1 = g_cgc_on ? ggml_time_us() : 0;
-    if (src1->type == compute_type) {
+    // BF16 GEMMs of a multi-token graph that share an F32 src1 convert it once, and a fused producer may have
+    // written the BF16 copy already (see bf16_src1_cache).  Keyed by the view root, so a reshape of a cached
+    // tensor (hc_norm is a reshape of the combine+norm output) finds it.
+    bool src1_bf16_cached = false;
+    if constexpr (compute_type == GGML_TYPE_BF16) {
+        const ggml_tensor * root = src1;
+        while (root->view_src) {
+            root = root->view_src;
+        }
+        const int64_t n = ggml_nelements(src1);
+        if (ggml_cuda_bf16_src1_cache_on() && src1->type == GGML_TYPE_F32 && ggml_is_contiguously_allocated(src1) &&
+                ne11*ne12*ne13 >= 64 && src1->data == root->data && ggml_nelements(root) == n) {
+            const auto & c = ctx.bf16_src1_cache;
+            if (c.buf && c.src1 == root && c.data == root->data && c.stream_no == ctx.curr_stream_no && c.n == n) {
+                src1_ptr = (const cuda_t *) c.buf->get();
+            } else {
+                nv_bfloat16 * buf = ctx.bf16_src1_cache_put(root, n);
+                const auto convert_func = traits::convert(src1->type);
+                GGML_ASSERT(convert_func != nullptr);
+                convert_func(src1->data, buf, n, main_stream);
+                src1_ptr = (const cuda_t *) buf;
+            }
+            src1_bf16_cached = true;
+        }
+    }
+    if (src1_bf16_cached) {
+        // F32 -> BF16 keeps the element strides (block size 1)
+    } else if (src1->type == compute_type) {
         src1_ptr = (const cuda_t *) src1->data;
     } else {
         src1_alloc.alloc(ggml_nelements(src1));
@@ -5378,6 +5411,18 @@ static void ggml_cuda_hc_combine_norm_set_bf16(ggml_backend_cuda_context & ctx,
     }
 }
 
+// Multi-token combine+norm whose xn feeds the cuBLAS BF16 hc GEMMs (MMB does not take BF16 weights on every arch):
+// write the BF16 copy of xn in the same pass, as the cached BF16 src1 of the GEMMs that follow (bf16_src1_cache).
+// hc_f2bf32 rounds to nearest even like the conversion it replaces, and the F32 xn is still stored for dsv4_hc_pre.
+static void ggml_cuda_hc_combine_norm_set_bf16_src1(ggml_backend_cuda_context & ctx, ggml_cuda_hc_combine_norm_args & args) {
+    const ggml_tensor * xn = args.out_xn;
+    if (args.out_xn_bf16 != nullptr || !args.store_xn_f32 || !ggml_cuda_bf16_src1_cache_on() ||
+            xn->view_src != nullptr || !ggml_is_contiguous(xn) || xn->ne[2]*xn->ne[3] < 64) {
+        return;
+    }
+    args.out_xn_bf16 = (uint16_t *) ctx.bf16_src1_cache_put(xn, ggml_nelements(xn));
+}
+
 // Prefill indexer head reduction: relu + head-sum.  Anchored at the RELU.  Our qwen4exp graph (the
 // L2a memory win) puts the relu BEFORE the 4-D reshape, so an optional RESHAPE between the relu and
 // the head views is accepted; the reference's relu-on-4-D form matches with no reshape.  The fused
@@ -7497,6 +7542,7 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
                                     }
                                     if (alias_ok && supp && canf) {
                                         ggml_cuda_hc_combine_norm_set_bf16(*cuda_ctx, args);
+                                        ggml_cuda_hc_combine_norm_set_bf16_src1(*cuda_ctx, args);
                                         ggml_cuda_op_hc_combine_norm(*cuda_ctx, args);
                                         return g - i;
                                     }
@@ -7680,6 +7726,7 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
                             const bool canf = ggml_can_fuse_subgraph_ext(cgraph, idxs, count, ops, out_nodes, 2);
                             if (alias_ok && supp && canf) {
                                 ggml_cuda_hc_combine_norm_set_bf16(*cuda_ctx, args);
+                                ggml_cuda_hc_combine_norm_set_bf16_src1(*cuda_ctx, args);
                                 ggml_cuda_op_hc_combine_norm(*cuda_ctx, args);
                                 return g - i;
                             }
@@ -8124,6 +8171,7 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
 
     // The Q8_1 input cache is only valid within one graph execution.
     cuda_ctx->q8_1_cache_clear();
+    cuda_ctx->bf16_src1_cache_clear();
     ggml_cuda_mmb_set_active_ctx(cuda_ctx);
     ggml_cuda_mmb_begin_graph();
 
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 661aa43f7..0d227456a 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -739,6 +739,15 @@ ggml_tensor * llama_model_qwen4exp::graph::build_hc_mix(
     cb(xn, "hc_norm", il);
 
     ggml_tensor * lo = build_lora_mm(w_down, xn);
+    if (inject) {
+        // emit the inject product right after the down product: both are BF16 GEMMs over the same xn, and the
+        // CUDA backend converts a shared F32 src1 to BF16 once when the two run back to back (bf16_src1_cache);
+        // emitted at the combine, the block's own BF16 GEMMs in between made it convert the whole xn twice
+        ggml_build_forward_expand(gf, lo);
+        *inject = build_lora_mm(w_inject, xn);
+        cb(*inject, "hc_inject", il);
+        ggml_build_forward_expand(gf, *inject);
+    }
     lo = ggml_silu(ctx0, ggml_scale(ctx0, lo, 1.0f / (float) hc));
     ggml_tensor * gate = build_lora_mm(w_up, lo);
     cb(gate, "hc_gate", il);
@@ -768,11 +777,6 @@ ggml_tensor * llama_model_qwen4exp::graph::build_hc_mix(
     }
     cb(mixed, "hc_mixed", il);
 
-    if (inject) {
-        *inject = build_lora_mm(w_inject, xn);
-        cb(*inject, "hc_inject", il);
-    }
-
     return mixed;
 }
 
