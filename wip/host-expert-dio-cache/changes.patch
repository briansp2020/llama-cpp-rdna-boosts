+// (a per-slot event; waits only for that copy, not the whole stream).  Caller holds `g_mutex`.
+static char * pool_slot_locked(host_pool_t & p, int expert, int * out_slot, bool sync_on_evict) {
+    if (expert < 0 || expert >= p.n_experts) {
