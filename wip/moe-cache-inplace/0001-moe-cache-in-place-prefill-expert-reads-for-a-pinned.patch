diff --git a/ggml/src/ggml-backend-impl.h b/ggml/src/ggml-backend-impl.h
index 52b8f37f6..48ec479a5 100644
--- a/ggml/src/ggml-backend-impl.h
+++ b/ggml/src/ggml-backend-impl.h
@@ -278,6 +278,10 @@ extern "C" {
         // (its decode/verify band).  The scheduler keys its band decisions (the take-over before the ids
         // readback, the per-layer split grouping and rebalance) off it.  NULL = the historical 8.
         int64_t (*moe_cache_band)(ggml_backend_t backend);
+        // MoE expert cache: true when a whole-table staging of this host weight would be served in place (the
+        // consumer reads the cache's arena / pinned host alias and nothing is copied), so the scheduler can
+        // stage it below the width gate.  NULL = never.
+        bool (*moe_cache_inplace)(ggml_backend_t backend, const struct ggml_tensor * weight);
         bool (*moe_cache_gather)(ggml_backend_t backend, const struct ggml_tensor * weight, const struct ggml_tensor * weight_cpy, const struct ggml_tensor * ids, size_t slice_off, int split_axis);
     };
 
diff --git a/ggml/src/ggml-backend-meta.cpp b/ggml/src/ggml-backend-meta.cpp
index ec06b0196..2d1f10a12 100644
--- a/ggml/src/ggml-backend-meta.cpp
+++ b/ggml/src/ggml-backend-meta.cpp
@@ -3303,6 +3303,18 @@ static int64_t ggml_backend_meta_moe_cache_band(ggml_backend_t backend) {
     return n_backends > 0 ? band : 8;
 }
 
+// A host weight is served in place only if every device holding a slice serves it in place.
+static bool ggml_backend_meta_moe_cache_inplace(ggml_backend_t backend, const struct ggml_tensor * weight) {
+    const size_t n_backends = ggml_backend_meta_n_backends(backend);
+    for (size_t j = 0; j < n_backends; j++) {
+        ggml_backend_t simple_backend = ggml_backend_meta_simple_backend(backend, j);
+        if (simple_backend->iface.moe_cache_inplace == nullptr || !simple_backend->iface.moe_cache_inplace(simple_backend, weight)) {
+            return false;
+        }
+    }
+    return n_backends > 0;
+}
+
 static bool ggml_backend_meta_moe_cache_gather(ggml_backend_t backend, const struct ggml_tensor * weight,
         const struct ggml_tensor * weight_cpy, const struct ggml_tensor * ids,
         size_t slice_off, int split_axis) {
@@ -3374,6 +3386,7 @@ static const ggml_backend_i ggml_backend_meta_i = {
     /* .moe_cache_take_over     = */ ggml_backend_meta_moe_cache_take_over,
     /* .moe_cache_promote       = */ ggml_backend_meta_moe_cache_promote,
     /* .moe_cache_band          = */ ggml_backend_meta_moe_cache_band,
+    /* .moe_cache_inplace       = */ ggml_backend_meta_moe_cache_inplace,
     /* .moe_cache_gather        = */ ggml_backend_meta_moe_cache_gather,
 };
 
diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index fc6ce6901..0543a3676 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -2354,6 +2354,31 @@ static bool sched_input_gatherable(ggml_backend_sched_t sched, struct ggml_backe
 // whole-tensor staging moves the device's entire shard every ubatch.  The ring path already prefers the
 // gather for a routed expert table (`sched_input_gatherable` in `sched_stage_issue`); the meta
 // backend's `stage_input` path defers routed expert tables to the gather there too.
+// wip/moe-expert-cache: below the staging width gate a split still stages when every host weight in it is a
+// routed table its backend serves in place (staging then copies nothing, so the gate's whole-table cost does not
+// apply), its batch is above the cache band (the band is the cache's take-over), and its staging is deferred to the
+// consumer (the meta backend's, or the scheduler's ring in stage-then-D2D mode).
+static bool sched_stage_inplace_ok(ggml_backend_sched_t sched, const struct ggml_backend_sched_split * split) {
+    ggml_backend_t backend = sched->backends[split->backend_id];
+    // a backend-owned staging (meta) or the scheduler's ring in stage-then-D2D mode (the redirect mode never D2Ds)
+    const bool defers = backend->iface.stage_input != NULL || (backend->iface.stage_buffer != NULL && sched->stage_mode == 0);
+    if (!defers || backend->iface.moe_cache_inplace == NULL ||
+        sched_stage_batch_tokens(split) <= sched_moe_cache_band(backend)) {
+        return false;
+    }
+    int n = 0;
+    for (int i = 0; i < split->n_inputs; i++) {
+        if (!sched_stage_is_host_weight(split->inputs[i])) {
+            continue;
+        }
+        if (!backend->iface.moe_cache_inplace(backend, split->inputs[i])) {
+            return false;
+        }
+        n++;
+    }
+    return n > 0;
+}
+
 static void sched_stage_issue(ggml_backend_sched_t sched, struct ggml_backend_sched_split * split) {
     sched_stage_restore(sched);
     sched->stage_consumed_n = 0;
@@ -2362,7 +2387,8 @@ static void sched_stage_issue(ggml_backend_sched_t sched, struct ggml_backend_sc
         return;
     }
     if (sched_stage_min_tokens_for(sched, split) > 0 &&
-        sched_stage_batch_tokens(split) < sched_stage_min_tokens_for(sched, split)) {
+        sched_stage_batch_tokens(split) < sched_stage_min_tokens_for(sched, split) &&
+        !sched_stage_inplace_ok(sched, split)) {
         return;
     }
     // A large expert table is always gathered (see `sched_input_gatherable`), so it must not be
