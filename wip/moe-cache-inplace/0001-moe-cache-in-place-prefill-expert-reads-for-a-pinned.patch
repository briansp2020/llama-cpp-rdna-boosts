diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 67debf913..365821192 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3458,6 +3458,15 @@ static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor *
     // same compute stream and the first decode flush reads it after the inter-token synchronize.
     if (moe_cache_enabled() && ids->ne[1] > MOE_EXPERT_CACHE_MAX_TOK) {
         moe_cache_tally_prefill(dst, src0, ids, ctx.device, ctx.stream());
+        // in-place prefill reads: only the MMQ kernel reads a deferred table in place (mirrors the dispatch below)
+        const int cc_ip = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+        const bool to_mmq = ggml_is_quantized(src0->type) && dst->ne[2] > get_mmvq_mmid_max_batch(src0->type, cc_ip) &&
+            !ggml_cuda_mmb_supported_mmid(src0, src1, ids, dst) &&
+            ggml_cuda_should_use_mmq(src0->type, cc_ip, src1->ne[2], src0->ne[2]);
+        moe_cache_inplace_src ip;
+        if (!to_mmq && moe_cache_inplace_take(ctx.device, src0->data, &ip)) {
+            moe_cache_inplace_fill(ctx.device, ip, src0->data, ctx.stream());
+        }
     }
 
     // wip/moe-expert-cache slot-remap consumer: if the scheduler handed this expert table to the
@@ -8925,9 +8934,38 @@ static void * ggml_backend_cuda_stage_buffer(ggml_backend_t backend, int slot, s
     return cuda_ctx->h2d_stage_buffer(slot, size);
 }
 
+// MoE expert cache: a routed expert table's staging copy takes its arena-resident experts from the arena
+// (moe_cache_stage_table) instead of re-uploading the whole table from the host.
+static bool ggml_backend_cuda_stage_from_cache(ggml_backend_cuda_context * cuda_ctx, const void * src, size_t offset,
+        size_t width, size_t stride_src, size_t n_copies, void * dst, ggml_backend_event_t ev, bool defer) {
+    if (!moe_cache_enabled()) {
+        return false;
+    }
+    static cudaEvent_t order_ev[GGML_CUDA_MAX_DEVICES] = {};
+    const int dev = cuda_ctx->device;
+    if (order_ev[dev] == nullptr && cudaEventCreateWithFlags(&order_ev[dev], cudaEventDisableTiming) != cudaSuccess) {
+        (void) cudaGetLastError();
+        order_ev[dev] = nullptr;
+        return false;
+    }
+    cudaStream_t s = cuda_ctx->copy_stream();
+    if (!moe_cache_stage_table(dev, src, offset, width, stride_src, n_copies, dst, cuda_ctx->stream(), s, order_ev[dev], defer)) {
+        return false;
+    }
+    CUDA_CHECK(cudaEventRecord((cudaEvent_t) ev->context, s));
+    return true;
+}
+
 static void ggml_backend_cuda_stage_upload(ggml_backend_t backend, void * dst, const void * data, size_t size, ggml_backend_event_t ev) {
     ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
     ggml_cuda_set_device(cuda_ctx->device);
+    // Deferred unless the scheduler's redirect mode (GGML_SCHED_STAGE_MODE=1) points the input at the slot: every
+    // other caller (the scheduler's ring in its default mode, the meta backend's mirrored upload) copies the slot
+    // into the input with stage_d2d, where the deferral is resolved.
+    static const bool redirect = getenv("GGML_SCHED_STAGE_MODE") != nullptr && atoi(getenv("GGML_SCHED_STAGE_MODE")) != 0;
+    if (ggml_backend_cuda_stage_from_cache(cuda_ctx, data, 0, size, size, 1, dst, ev, /*defer =*/ !redirect)) {
+        return;
+    }
     cudaStream_t s = cuda_ctx->copy_stream();
     CUDA_CHECK(cudaMemcpyAsync(dst, data, size, cudaMemcpyHostToDevice, s));
     CUDA_CHECK(cudaEventRecord((cudaEvent_t) ev->context, s));
@@ -8950,6 +8988,9 @@ static bool ggml_backend_cuda_stage_gather(ggml_backend_t backend, int slot, con
     if (dst == nullptr) {
         return false;
     }
+    if (ggml_backend_cuda_stage_from_cache(cuda_ctx, src, offset, width, stride_src, n_copies, dst, ev, /*defer =*/ true)) {
+        return true;
+    }
     cudaStream_t s = cuda_ctx->copy_stream();
     // WIP r42 (stage-1 item 2): a pinned source lets the compacted slice be copied straight with one
     // 2-D H2D, moving only `total` bytes instead of the whole contiguous range.  The pageable 2-D H2D
@@ -9001,6 +9042,10 @@ static void ggml_backend_cuda_stage_wait(ggml_backend_t backend, ggml_backend_ev
 static void ggml_backend_cuda_stage_d2d(ggml_backend_t backend, void * dst, const void * src, size_t size) {
     ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
     ggml_cuda_set_device(cuda_ctx->device);
+    // a deferred cache staging: the slot was never filled, the tensor's consumer reads the table in place
+    if (moe_cache_enabled() && moe_cache_stage_d2d_take(cuda_ctx->device, dst, src)) {
+        return;
+    }
     CUDA_CHECK(cudaMemcpyAsync(dst, src, size, cudaMemcpyDeviceToDevice, cuda_ctx->stream()));
 }
 
@@ -9073,6 +9118,12 @@ static bool ggml_backend_cuda_moe_cache_promote(ggml_backend_t backend, const gg
     return moe_cache_promote_host(weight, weight_cpy, ids, n_used, n_tok, ids_nb0, ids_nb1, ctx->stream(), ctx->device);
 }
 
+// MoE expert cache: true when a whole-table staging of `weight` would be served in place (see the iface comment).
+static bool ggml_backend_cuda_moe_cache_inplace(ggml_backend_t backend, const ggml_tensor * weight) {
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    return weight != nullptr && moe_cache_enabled() && moe_cache_inplace_ready(cuda_ctx->device, weight->data);
+}
+
 // B2: device-side host-weight expert gather for an offloaded `MUL_MAT_ID` prefill (see the iface comment).
 static int64_t ggml_backend_cuda_moe_cache_band(ggml_backend_t backend) {
     const ggml_backend_cuda_context * cuda_ctx = (const ggml_backend_cuda_context *) backend->context;
@@ -9112,6 +9163,7 @@ static const ggml_backend_i ggml_backend_cuda_interface = {
     /* .moe_cache_take_over     = */ ggml_backend_cuda_moe_cache_take_over,
     /* .moe_cache_promote       = */ ggml_backend_cuda_moe_cache_promote,
     /* .moe_cache_band          = */ ggml_backend_cuda_moe_cache_band,
+    /* .moe_cache_inplace       = */ ggml_backend_cuda_moe_cache_inplace,
     /* .moe_cache_gather        = */ ggml_backend_cuda_moe_cache_gather,
 };
 
@@ -9938,6 +9990,12 @@ static bool ggml_backend_cuda_device_offload_op(ggml_backend_dev_t dev, const gg
         op->ne[2] <= MOE_EXPERT_CACHE_MAX_TOK) {
         return true;
     }
+    // Above the band, a table the cache reads in place (nothing is copied) is cheaper on the device at any width:
+    // without this, 17..31-token routed batches (3 MTP streams at n-max 7, short prompts) run on the CPU.
+    if (moe_cache_enabled() && op->op == GGML_OP_MUL_MAT_ID && op->src[0] != nullptr &&
+        moe_cache_inplace_ready(dev_ctx->device, op->src[0]->data)) {
+        return true;
+    }
 
     return get_op_batch_size(op) >= dev_ctx->op_offload_min_batch_size;
 }
diff --git a/ggml/src/ggml-cuda/mmq.cuh b/ggml/src/ggml-cuda/mmq.cuh
index 89b35cff0..ed20df29a 100644
--- a/ggml/src/ggml-cuda/mmq.cuh
+++ b/ggml/src/ggml-cuda/mmq.cuh
@@ -1,6 +1,7 @@
 #pragma once
 
 #include "common.cuh"
+#include "moe-expert-cache.h"
 #include "unary.cuh"
 
 #include <climits>
@@ -1620,6 +1621,23 @@ static __global__ void build_mmq_routed_descriptors(
     }
 }
 
+// In-place expert source for the routed-compact kernel (MoE expert cache, prefill): `on` reads expert `e` from its
+// arena slot when resident and from the pinned host alias otherwise, instead of from the staged table `x`.  Byte
+// offsets are 64-bit; row strides are in type blocks (0 = the staged table's own).
+struct mmq_routed_src {
+    const char *    arena;
+    const int32_t * slot_dev;
+    const char *    cold;
+    int64_t         arena_bytes;
+    int64_t         cold_bytes;
+    int             cold_row_stride;
+    int             slots;
+    int             identity;
+    int             on;
+    const char *    tail;        // the last expert's zero-padded copy, read when it is cold (nullptr: none needed)
+    int             last;        // n_experts - 1
+};
+
 template <ggml_type type, int J, bool fallback>
 __launch_bounds__(ggml_cuda_mmq_get_nthreads(type, J, fallback), ggml_cuda_mmq_get_occupancy(type, J, fallback))
 static __global__ void mul_mat_q_routed_compact(
@@ -1628,7 +1646,7 @@ static __global__ void mul_mat_q_routed_compact(
         const int max_descriptors, float * __restrict__ dst, const float * __restrict__ y_scale,
         const uint3 blocks_per_ne00, const int nrows_x, const int stride_row_x, const int ncols_y, const int stride_col_dst,
         const uint3 channel_ratio, const int stride_channel_x,
-        const uint3 sample_ratio, const int stride_sample_x) {
+        const uint3 sample_ratio, const int stride_sample_x, const mmq_routed_src src) {
     // Skip unused template specializations for faster compilation:
     if (ggml_cuda_mmq_get_config(type, J, fallback).type == GGML_TYPE_COUNT) {
         NO_DEVICE_CODE;
@@ -1668,8 +1686,24 @@ static __global__ void mul_mat_q_routed_compact(
         }
         __syncthreads();
 
-        const int offset_x = fastdiv(wt, sample_ratio) * stride_sample_x +
+        const char * x_use = x;
+        int stride_row_use = stride_row_x;
+        int offset_x = fastdiv(wt, sample_ratio) * stride_sample_x +
             fastdiv(zt, channel_ratio) * stride_channel_x + it * I * stride_row_x;
+        if (src.on) {
+            const int slot = src.identity ? zt : (src.slot_dev != nullptr ? src.slot_dev[zt] : -1);
+            if (slot >= 0 && slot < src.slots) {
+                x_use = src.arena + (int64_t) slot * src.arena_bytes;
+            } else if (zt == src.last && src.tail != nullptr) {
+                x_use = src.tail;   // arena layout, so the staged row stride
+            } else {
+                x_use = src.cold + (int64_t) zt * src.cold_bytes;
+                if (src.cold_row_stride != 0) {
+                    stride_row_use = src.cold_row_stride;
+                }
+            }
+            offset_x = it * I * stride_row_use;
+        }
         const int offset_y = (col_low + jt * J) * (sizeof(block_q8_1_mmq) / sizeof(int));
         const int tile_x_max_i = nrows_x - it * I - 1;
         const int tile_y_max_j = col_diff - jt * J - 1;
@@ -1677,8 +1711,8 @@ static __global__ void mul_mat_q_routed_compact(
 
         constexpr bool fixup = false;
         mul_mat_q_process_tile<type, J, fallback, fixup>
-            (x, offset_x, y + offset_y, ids_dst_shared, dst + it * I, nullptr, y_scale_tile,
-             stride_row_x, ncols_y, stride_col_dst,
+            (x_use, offset_x, y + offset_y, ids_dst_shared, dst + it * I, nullptr, y_scale_tile,
+             stride_row_use, ncols_y, stride_col_dst,
              tile_x_max_i, tile_y_max_j, 0, blocks_per_ne00.z);
     }
 }
@@ -1727,6 +1761,25 @@ static void launch_mul_mat_q(ggml_backend_cuda_context & ctx, const mmq_args & a
     const bool use_compact_routed = args.ids_dst != nullptr && mmq_rdna3_5_id_n_experts_ok(args.nchannels_y) && mmq_routed_compact_arch_ok(cc) &&
         !has_gate && !ggml_cuda_mmq_get_stream_k(type, J, fallback, cc) && mmq_rdna3_5_id_use_compact(type, J, GGML_CUDA_CC_IS_RDNA4(cc)) &&
         !routed_disabled;
+    // MoE expert cache, in-place prefill reads: a deferred table is read in place by the compact kernel; any other
+    // path (and the fused gate stream) gets the staged bytes written first.
+    mmq_routed_src routed_src = {};
+    if (moe_cache_enabled() && args.ids_dst != nullptr) {
+        moe_cache_inplace_src ip;
+        if (moe_cache_inplace_take(id, args.x, &ip)) {
+            const size_t ts = ggml_type_size(type);
+            if (use_compact_routed && ip.arena_bytes % ts == 0 && ip.cold_bytes % ts == 0 && ip.cold_row_bytes % ts == 0 &&
+                moe_cache_inplace_tail(id, ip, args.expert_bounds, stream)) {
+                routed_src = {ip.arena, ip.slot_dev, ip.cold, ip.arena_bytes, ip.cold_bytes,
+                              (int) (ip.cold_row_bytes / ts), ip.slots, ip.identity, 1, ip.tail, ip.n_experts - 1};
+            } else {
+                moe_cache_inplace_fill(id, ip, (void *) args.x, stream);
+            }
+        }
+        if (args.x_gate != nullptr && moe_cache_inplace_take(id, args.x_gate, &ip)) {
+            moe_cache_inplace_fill(id, ip, (void *) args.x_gate, stream);
+        }
+    }
     if (use_compact_routed) {
         const int max_descriptors = (args.ncols_dst + J - 1) / J + args.nchannels_y;
         ggml_cuda_pool_alloc<uint32_t> descriptors(ctx.pool(id), max_descriptors);
@@ -1738,7 +1791,7 @@ static void launch_mul_mat_q(ggml_backend_cuda_context & ctx, const mmq_args & a
         mul_mat_q_routed_compact<type, J, fallback><<<block_nums_compact, block_dims, nbytes_shared, stream>>>
             (args.x, args.y, args.ids_dst, args.expert_bounds, descriptors.get(), max_descriptors, args.dst, args.y_scale,
              blocks_per_ne00_fd, args.nrows_x, args.stride_row_x, args.ncols_y, args.nrows_dst,
-             channel_ratio_fd, args.stride_channel_x, sample_ratio_fd, args.stride_sample_x);
+             channel_ratio_fd, args.stride_channel_x, sample_ratio_fd, args.stride_sample_x, routed_src);
         return;
     }
 
diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index cfc40e596..217c5421f 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -7,6 +7,7 @@
 #include "mmvq.cuh"
 
 #include <algorithm>
