From a208afa083a88114a52e74387be53678efcfe20a Mon Sep 17 00:00:00 2001
From: "Brian S. Park" <brianspark@hotmail.com>
Date: Sat, 17 Oct 2026 15:26:36 -0700
Subject: [PATCH 2/2] cuda: the fused rms_norm_mul_rope kernel handles MROPE
 and IMROPE

The RMS_NORM + MUL + ROPE fusion (and with it the rope + KV-rotation FWHT
fusion) only accepted the norm and neox rope modes, so it never fired on
models that run rope_multi, such as the Qwen3.5 / 3.6 / 3.8 family
(IMROPE).  Teach the fused kernel rope_multi's position lookup: each
rotated pair picks its position row (t/h/w/e) from the mrope sections
exactly as rope_multi does, and the pairs are neox-style as in
rope_multi.  Vision rope and n_offs != 0 stay unfused.  Same arithmetic
as the unfused rms_norm, mul and rope_multi; bit-identical output.
GGML_CUDA_DISABLE_RMS_NORM_MUL_MROPE turns the new modes off.

test-backend-ops: RMS_NORM_MUL_ROPE also covers GGML_ROPE_TYPE_MROPE.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu |  6 ++-
 ggml/src/ggml-cuda/rope.cu               | 51 +++++++++++++++++++-----
 tests/test-backend-ops.cpp               |  2 +-
 3 files changed, 45 insertions(+), 14 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
index 9611f2fe8..8209a36b6 100644
--- a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
@@ -308,9 +308,11 @@ static bool ggml_cuda_should_fuse_rms_norm_mul_rope(const ggml_tensor * rms_norm
         return false;
     }
 
-    // the fused kernel handles the norm/neox rope modes only
+    // the fused kernel handles the norm/neox/mrope/imrope modes (not vision)
+    static const bool no_mrope = getenv("GGML_CUDA_DISABLE_RMS_NORM_MUL_MROPE") != nullptr;
     const int mode = ((const int32_t *) rope->op_params)[2];
-    if (mode != GGML_ROPE_TYPE_NORMAL && mode != GGML_ROPE_TYPE_NEOX) {
+    if (mode != GGML_ROPE_TYPE_NORMAL && mode != GGML_ROPE_TYPE_NEOX &&
+        (no_mrope || (mode != GGML_ROPE_TYPE_MROPE && mode != GGML_ROPE_TYPE_IMROPE))) {
         return false;
     }
 
diff --git a/ggml/src/ggml-cuda/rope.cu b/ggml/src/ggml-cuda/rope.cu
index e4b1b2acf..9171da5de 100644
--- a/ggml/src/ggml-cuda/rope.cu
+++ b/ggml/src/ggml-cuda/rope.cu
@@ -764,7 +764,8 @@ static __global__ void rms_norm_mul_rope_f32(
         const rope_corr_dims corr_dims, const float theta_scale,
         const float * freq_factors,
         const int64_t * row_indices, const int set_rows_stride,
-        const bool is_neox, const float fwht_scale) {
+        const bool is_neox, const float fwht_scale,
+        const int mrope_mode, const mrope_sections sections) {
     ggml_cuda_pdl_lc();
     const int row = blockIdx.x;
     const int tid = threadIdx.x;
@@ -829,7 +830,29 @@ static __global__ void rms_norm_mul_rope_f32(
                     continue;
                 }
 
-                const float theta_base  = pos[channel]*powf(theta_scale, i0/2.0f);
+                // mrope_mode 1: MROPE, 2: IMROPE; the position row of each sector is picked as in rope_multi
+                int p = channel;
+                if (mrope_mode != 0) {
+                    const int sect_dims = sections.v[0] + sections.v[1] + sections.v[2] + sections.v[3];
+                    const int sec_w     = sections.v[1] + sections.v[0];
+                    const int sector    = (i0 / 2) % sect_dims;
+                    if (mrope_mode == 2) {
+                        if (sector % 3 == 1 && sector < 3 * sections.v[1]) {
+                            p += nchannels * 1;
+                        } else if (sector % 3 == 2 && sector < 3 * sections.v[2]) {
+                            p += nchannels * 2;
+                        } else if (!(sector % 3 == 0 && sector < 3 * sections.v[0])) {
+                            p += nchannels * 3;
+                        }
+                    } else if (sector >= sec_w + sections.v[2]) {
+                        p += nchannels * 3;
+                    } else if (sector >= sec_w) {
+                        p += nchannels * 2;
+                    } else if (sector >= sections.v[0]) {
+                        p += nchannels * 1;
+                    }
+                }
+                const float theta_base  = pos[p]*powf(theta_scale, i0/2.0f);
                 const float freq_factor = has_ff ? freq_factors[i0/2] : 1.0f;
 
                 float cos_theta;
@@ -877,7 +900,8 @@ static void rms_norm_mul_rope_cuda(
         const rope_corr_dims corr_dims,
         const float * freq_factors,
         const int64_t * row_indices, const int set_rows_stride,
-        const bool is_neox, const int fwht_n, const float fwht_scale, cudaStream_t stream) {
+        const bool is_neox, const int fwht_n, const float fwht_scale,
+        const int mrope_mode, const mrope_sections sections, cudaStream_t stream) {
     GGML_ASSERT(ncols % 2 == 0);
 
     const dim3 blocks_num(nrows, MIN(nchannels, UINT16_MAX), MIN(nsamples, UINT16_MAX));
@@ -900,7 +924,7 @@ static void rms_norm_mul_rope_cuda(
                     x, dst, ncols, nchannels, nsamples, s01, s02, s03, s1, s2, s3, eps, mul, mul_s01, mul_s02, mul_s03,
                     mul_ncols_packed, mul_nrows_packed, mul_nchannels_packed, mul_nsamples_packed,
                     n_dims, pos, freq_scale, ext_factor, attn_factor, corr_dims, theta_scale,
-                    freq_factors, row_indices, set_rows_stride, is_neox, fwht_scale);
+                    freq_factors, row_indices, set_rows_stride, is_neox, fwht_scale, mrope_mode, sections);
             };
             const bool has_ff = freq_factors != nullptr;
             switch (fwht_n) {
@@ -923,13 +947,13 @@ static void rms_norm_mul_rope_cuda(
                 x, dst, ncols, nchannels, nsamples, s01, s02, s03, s1, s2, s3, eps, mul, mul_s01, mul_s02, mul_s03,
                 mul_ncols_packed, mul_nrows_packed, mul_nchannels_packed, mul_nsamples_packed,
                 n_dims, pos, freq_scale, ext_factor, attn_factor, corr_dims, theta_scale,
-                freq_factors, row_indices, set_rows_stride, is_neox, fwht_scale);
+                freq_factors, row_indices, set_rows_stride, is_neox, fwht_scale, mrope_mode, sections);
         } else {
             ggml_cuda_kernel_launch(rms_norm_mul_rope_f32<256, true, D>, launch_params,
                 x, dst, ncols, nchannels, nsamples, s01, s02, s03, s1, s2, s3, eps, mul, mul_s01, mul_s02, mul_s03,
                 mul_ncols_packed, mul_nrows_packed, mul_nchannels_packed, mul_nsamples_packed,
                 n_dims, pos, freq_scale, ext_factor, attn_factor, corr_dims, theta_scale,
-                freq_factors, row_indices, set_rows_stride, is_neox, fwht_scale);
+                freq_factors, row_indices, set_rows_stride, is_neox, fwht_scale, mrope_mode, sections);
         }
     } else {
         const dim3 block_dims(1024, 1, 1);
@@ -939,13 +963,13 @@ static void rms_norm_mul_rope_cuda(
                 x, dst, ncols, nchannels, nsamples, s01, s02, s03, s1, s2, s3, eps, mul, mul_s01, mul_s02, mul_s03,
                 mul_ncols_packed, mul_nrows_packed, mul_nchannels_packed, mul_nsamples_packed,
                 n_dims, pos, freq_scale, ext_factor, attn_factor, corr_dims, theta_scale,
-                freq_factors, row_indices, set_rows_stride, is_neox, fwht_scale);
+                freq_factors, row_indices, set_rows_stride, is_neox, fwht_scale, mrope_mode, sections);
         } else {
             ggml_cuda_kernel_launch(rms_norm_mul_rope_f32<1024, true, D>, launch_params,
                 x, dst, ncols, nchannels, nsamples, s01, s02, s03, s1, s2, s3, eps, mul, mul_s01, mul_s02, mul_s03,
                 mul_ncols_packed, mul_nrows_packed, mul_nchannels_packed, mul_nsamples_packed,
                 n_dims, pos, freq_scale, ext_factor, attn_factor, corr_dims, theta_scale,
-                freq_factors, row_indices, set_rows_stride, is_neox, fwht_scale);
+                freq_factors, row_indices, set_rows_stride, is_neox, fwht_scale, mrope_mode, sections);
         }
     }
 }
@@ -1004,7 +1028,12 @@ void ggml_cuda_op_rms_norm_mul_rope_fused(ggml_backend_cuda_context & ctx,
     memcpy(&beta_fast,   (const int32_t *) rope->op_params +  9, sizeof(float));
     memcpy(&beta_slow,   (const int32_t *) rope->op_params + 10, sizeof(float));
 
-    const bool is_neox = mode & GGML_ROPE_TYPE_NEOX;
+    // rope_multi rotates neox-style pairs; it is selected by the MROPE bit (IMROPE includes it)
+    const int  mrope_mode = mode == GGML_ROPE_TYPE_IMROPE ? 2 : mode == GGML_ROPE_TYPE_MROPE ? 1 : 0;
+    const bool is_neox    = (mode & GGML_ROPE_TYPE_NEOX) || mrope_mode != 0;
+
+    mrope_sections sections;
+    memcpy(&sections.v, (const int32_t *) rope->op_params + 11, sizeof(int)*4);
 
     const int32_t * pos = (const int32_t *) rope->src[1]->data;
 
@@ -1038,14 +1067,14 @@ void ggml_cuda_op_rms_norm_mul_rope_fused(ggml_backend_cuda_context & ctx,
             (const float *) mul_src->data, mul_s01, mul_s02, mul_s03,
             mul_src->ne[0], mul_src->ne[1], mul_src->ne[2], mul_src->ne[3],
             n_dims, pos, freq_scale, freq_base, ext_factor, attn_factor, corr_dims,
-            freq_factors, row_indices, set_rows_stride, is_neox, fwht_n, fwht_scale, stream);
+            freq_factors, row_indices, set_rows_stride, is_neox, fwht_n, fwht_scale, mrope_mode, sections, stream);
     } else if (dst_type == GGML_TYPE_F16) {
         rms_norm_mul_rope_cuda((const float *) x->data, (half *) dst_d,
             x->ne[0], x->ne[1], x->ne[2], x->ne[3], s01, s02, s03, s1, s2, s3, eps,
             (const float *) mul_src->data, mul_s01, mul_s02, mul_s03,
             mul_src->ne[0], mul_src->ne[1], mul_src->ne[2], mul_src->ne[3],
             n_dims, pos, freq_scale, freq_base, ext_factor, attn_factor, corr_dims,
-            freq_factors, row_indices, set_rows_stride, is_neox, fwht_n, fwht_scale, stream);
+            freq_factors, row_indices, set_rows_stride, is_neox, fwht_n, fwht_scale, mrope_mode, sections, stream);
     } else {
         GGML_ABORT("fatal error");
     }
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index c7b463841..b83c9a714 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -10936,7 +10936,7 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     for (auto multi_add : {false, true}) {
         for (auto set_rows : {false, true}) {
             for (auto broadcast : {false, true}) {
-                for (auto rope : {GGML_ROPE_TYPE_NORMAL, GGML_ROPE_TYPE_NEOX, GGML_ROPE_TYPE_IMROPE}) {
+                for (auto rope : {GGML_ROPE_TYPE_NORMAL, GGML_ROPE_TYPE_NEOX, GGML_ROPE_TYPE_MROPE, GGML_ROPE_TYPE_IMROPE}) {
                     test_cases.emplace_back(new test_rms_norm_mul_rope({768, 1, 1, 1}, 1e-6f, multi_add, set_rows, broadcast, rope));
                     test_cases.emplace_back(new test_rms_norm_mul_rope({768, 3, 1, 1}, 1e-6f, multi_add, set_rows, broadcast, rope));
                     test_cases.emplace_back(new test_rms_norm_mul_rope({768, 3, 5, 1}, 1e-6f, multi_add, set_rows, broadcast, rope));
