From 892bd89b69f02a85bec5bc114daae7acde5c20cb Mon Sep 17 00:00:00 2001
From: "Brian S. Park" <brianspark@hotmail.com>
Date: Sat, 17 Oct 2026 15:42:13 -0700
Subject: [PATCH 1/2] cuda: keep a BF16 cache row out of the fused
 rms_norm_mul_rope + set_rows

ggml_cuda_should_fuse_rope_set_rows admits a BF16 SET_ROWS destination
(rope's own set_rows fusion writes BF16), but the RMS_NORM + MUL + ROPE +
VIEW + SET_ROWS fusion shares that check and its host op only writes
F32/F16, so it aborts in ggml_cuda_op_rms_norm_mul_rope_fused.  It is
reached by a model with q/k norm whose K cache write directly follows
the K rope, e.g. Qwen3 with -ctk bf16.  Leave BF16 to the existing
rope + set_rows path there.

test-backend-ops: RMS_NORM_MUL_ROPE gains BF16 set_rows cases.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu | 2 ++
 tests/test-backend-ops.cpp               | 4 ++++
 2 files changed, 6 insertions(+)

diff --git a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
index 463232ef9..9611f2fe8 100644
--- a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
@@ -1033,7 +1033,9 @@ static bool ggml_cuda_can_fuse(const struct ggml_cgraph *                cgraph,
         const ggml_tensor * view     = cgraph->nodes[node_idx + 3];
         const ggml_tensor * set_rows = cgraph->nodes[node_idx + 4];
 
+        // the fused rms_norm_mul_rope kernel writes F32/F16 only; a BF16 row goes through rope's own set_rows fusion
         if (ggml_check_edges(cgraph, node_idx, {{1, 0, 0}, {2, 0, 1}, {3, 0, 2}, {4, 0, 3}}) &&
+            set_rows->type != GGML_TYPE_BF16 &&
             ggml_cuda_should_fuse_rms_norm_mul_rope(rms_norm, mul, rope) &&
             ggml_cuda_should_fuse_rope_set_rows(rope, view, set_rows)) {
             int out_nodes[] = { node_idx + 4 };
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 771e0139c..c7b463841 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -10950,6 +10950,10 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
             }
         }
     }
+    // a BF16 cache row behind the fused rope (the rope_set_rows fusion admits BF16)
+    for (auto rope : {GGML_ROPE_TYPE_NEOX, GGML_ROPE_TYPE_IMROPE}) {
+        test_cases.emplace_back(new test_rms_norm_mul_rope({128, 4, 3, 1}, 1e-6f, false, true, true, rope, true, true, GGML_TYPE_BF16));
+    }
     // ne[2] > 65535 exceeds the CUDA gridDim.y limit (#27901)
     test_cases.emplace_back(new test_rms_norm_mul_rope({4, 1, 65536, 1}, 1e-6f, false, false, false, GGML_ROPE_TYPE_NORMAL));
     test_cases.emplace_back(new test_rms_norm_mul_rope({4, 1, 65536, 1}, 1e-6f, false, true,  false, GGML_ROPE_TYPE_NEOX));
-- 
