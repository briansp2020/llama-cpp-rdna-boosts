+// wip/fa-stage-chunking: merge one KV chunk's unnormalized partial into the running accumulator.
+// One block per output row, one thread per DV element.  `acc`/`acc_meta` stay unnormalized until
+// `final`, so the next chunk can merge into them; only the final call divides by the rowsum.
+// `part == nullptr` (final only) just normalizes.  Same arithmetic as flash_attn_combine_results.
+static __global__ void flash_attn_chunk_merge(
+        float  * __restrict__ acc,             // [nrows][D], unnormalized, in/out
+        float2 * __restrict__ acc_meta,        // [nrows]   (max, rowsum), in/out
+        const float  * __restrict__ part,      // [nrows][D] or nullptr
+        const float2 * __restrict__ part_meta, // [nrows]    or nullptr
+        const int D) {
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+
+    __shared__ float2 s_meta;
+    if (tid == 0) {
+        s_meta = acc_meta[row];
+    }
+    __syncthreads();
+
+    float2 m = s_meta;
+    float * a = acc + (int64_t) row*D;
+    if (part != nullptr) {
+        const float2 pm = part_meta[row];
+        const float kqmax  = fmaxf(m.x, pm.x);
+        const float s_acc  = expf(m.x  - kqmax);
+        const float s_part = expf(pm.x - kqmax);
+        m.x = kqmax;
+        m.y = s_acc*m.y + s_part*pm.y;
+
+        const float * b = part + (int64_t) row*D;
+        a[tid] = s_acc*a[tid] + s_part*b[tid];
+    }
+    __syncthreads();
+    if (tid == 0) {
+        acc_meta[row] = m;
+    }
