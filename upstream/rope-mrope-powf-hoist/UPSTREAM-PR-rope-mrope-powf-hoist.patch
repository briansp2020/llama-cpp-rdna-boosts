From 7acb5add94ff641de334b6eafb6c78bab5baa4f7 Mon Sep 17 00:00:00 2001
From: Stew Forster <ci@rdna-boosts.invalid>
Date: Thu, 29 Oct 2026 13:08:38 -0500
Subject: [PATCH] CUDA: rope: compute the M-RoPE section power once, not once
 per section arm

rope_multi computed powf(theta_scale, iw/2) inside every section arm, although
only the position index differs between them. Adjacent lanes take different arms
(sector % 3), so the divergent arms were serialized within a wave and powf ran
once per arm taken. Hoist it before the branch: same input, same value, so the
result is bit-identical (the 'no arm matched, theta_base stays 0' case is
unchanged too).

Measured on gfx1201: the rms_norm_mul_rope_f32 kernel that shares this math goes
3.20 -> 2.85 us (__half dst) / 3.06 -> 2.70 us (f32 dst) per launch; on a 7900
XTX (gfx1100) Qwen3.6-35B-A3B Q4_K_M decode is 137.6 -> 138.6 t/s (+0.65 %),
27B Q4_K_M and 9B Q8_0 +0.25 %. Greedy text byte-identical and prefill logits
KLD 0.000000.
---
 ggml/src/ggml-cuda/rope.cu | 19 +++++++++++--------
 1 file changed, 11 insertions(+), 8 deletions(-)

diff --git a/ggml/src/ggml-cuda/rope.cu b/ggml/src/ggml-cuda/rope.cu
index 45e813406..cbc795fe8 100644
--- a/ggml/src/ggml-cuda/rope.cu
+++ b/ggml/src/ggml-cuda/rope.cu
@@ -262,26 +262,29 @@ static __global__ void rope_multi(const T *            x,
     const int sec_w = sections.v[1] + sections.v[0];
     const int sector = (iw / 2) % sect_dims;
 
+    // the same power in every section arm: computed once so a divergent wave does not run powf per arm
+    const float theta_pow = powf(theta_scale, iw / 2.0f);
+
     float theta_base = 0.0;
     if (is_imrope) {
         if (sector % 3 == 1 && sector < 3 * sections.v[1]) {         // h
-            theta_base = pos[i2 + ne02 * 1] * powf(theta_scale, iw / 2.0f);
+            theta_base = pos[i2 + ne02 * 1] * theta_pow;
         } else if (sector % 3 == 2 && sector < 3 * sections.v[2]) {  // w
-            theta_base = pos[i2 + ne02 * 2] * powf(theta_scale, iw / 2.0f);
+            theta_base = pos[i2 + ne02 * 2] * theta_pow;
         } else if (sector % 3 == 0 && sector < 3 * sections.v[0]) {  // t
-            theta_base = pos[i2] * powf(theta_scale, iw / 2.0f);
+            theta_base = pos[i2] * theta_pow;
         } else {
-            theta_base = pos[i2 + ne02 * 3] * powf(theta_scale, iw / 2.0f);
+            theta_base = pos[i2 + ne02 * 3] * theta_pow;
         }
     } else {
         if (sector < sections.v[0]) {
-            theta_base = pos[i2] * powf(theta_scale, iw / 2.0f);
+            theta_base = pos[i2] * theta_pow;
         } else if (sector >= sections.v[0] && sector < sec_w) {
-            theta_base = pos[i2 + ne02 * 1] * powf(theta_scale, iw / 2.0f);
+            theta_base = pos[i2 + ne02 * 1] * theta_pow;
         } else if (sector >= sec_w && sector < sec_w + sections.v[2]) {
-            theta_base = pos[i2 + ne02 * 2] * powf(theta_scale, iw / 2.0f);
+            theta_base = pos[i2 + ne02 * 2] * theta_pow;
         } else if (sector >= sec_w + sections.v[2]) {
-            theta_base = pos[i2 + ne02 * 3] * powf(theta_scale, iw / 2.0f);
+            theta_base = pos[i2 + ne02 * 3] * theta_pow;
         }
     }
 
