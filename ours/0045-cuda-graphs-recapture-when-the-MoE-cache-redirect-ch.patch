From 6c15c9ce37af707ed0f94bd6395e1caf7a5d9f69 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Wed, 4 Nov 2026 07:01:02 +0000
Subject: [PATCH 45/50] cuda graphs: recapture when the MoE cache redirect
 choice of a node changed (FINDINGS 716)

The per-op MoE consumer decides at dispatch whether a MUL_MAT_ID reads the expert-cache arena through
the slot remap or the scheduler copy (input_cpy), and a captured graph keeps that choice.  A table
that declined after its capture (remap_n_used = 0, remap not rewritten) was replayed through the
previous token's remap: wrong experts.  moe_cache_redirect_sig hashes the consumer's test per node;
a graph recaptures when it differs from the one stored at capture (GGML_CUDA_GRAPH_MOE_SIG=0 off).
---
 ggml/src/ggml-cuda/common.cuh          |  2 +
 ggml/src/ggml-cuda/ggml-cuda.cu        |  7 +++-
 ggml/src/ggml-cuda/moe-expert-cache.cu | 53 +++++++++++++++++++++-----
 ggml/src/ggml-cuda/moe-expert-cache.h  |  4 ++
 4 files changed, 55 insertions(+), 11 deletions(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index e8ec35d62..a9306a581 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1486,6 +1486,8 @@ struct ggml_cuda_graph {
     // the addresses of pool temporaries and per-context scratch buffers, so it is recaptured once any
     // of that memory has been freed (see ggml_cuda_graph_mem_freed)
     uint64_t mem_gen = 0;
+    // moe_cache_redirect_sig() when it was captured: which MoE ops the capture redirected onto an expert-cache arena
+    uint64_t moe_sig = 0;
     // What a replay bakes in, per node, packed to the sources the node actually has.  The compare that
     // guards a replay is O(nodes) and runs on EVERY graph_compute (the scheduler mints a fresh
     // `cgraph->uid` per split, so the `uid` early-out in ggml_cuda_graph_update_required cannot fire),
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index b9c2d01a2..023a73ce0 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -7738,8 +7738,12 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
                     // recapture a graph whose pool temporaries or scratch buffers were freed since its capture
                     // (GGML_CUDA_GRAPH_MEM_GEN=0 disables the check, A/B only)
                     static const bool mem_gen_check = [] { const char * e = getenv("GGML_CUDA_GRAPH_MEM_GEN"); return !e || atoi(e) != 0; }();
+                    // and one whose MoE redirect choice changed (a table declined or took over since its capture;
+                    // GGML_CUDA_GRAPH_MOE_SIG=0 disables the check, A/B only)
+                    static const bool moe_sig_check = [] { const char * e = getenv("GGML_CUDA_GRAPH_MOE_SIG"); return !e || atoi(e) != 0; }();
                     cuda_graph_update_required = graph->instances.empty() ||
-                        (mem_gen_check && graph->mem_gen != ggml_cuda_graph_mem_gen(cuda_ctx->device));
+                        (mem_gen_check && graph->mem_gen != ggml_cuda_graph_mem_gen(cuda_ctx->device)) ||
+                        (moe_sig_check && graph->moe_sig != moe_cache_redirect_sig(cgraph, cuda_ctx->device));
                 }
             }
 
@@ -7789,6 +7793,7 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
         }
 
         graph->mem_gen = ggml_cuda_graph_mem_gen(cuda_ctx->device);
+        graph->moe_sig = moe_cache_redirect_sig(cgraph, cuda_ctx->device);
         CUDA_CHECK(cudaStreamBeginCapture(cuda_ctx->stream(), cudaStreamCaptureModeRelaxed));
     }
 
diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index 30fa3d29d..ef1188927 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -404,6 +404,7 @@ int64_t g_pool_total_bytes = 0;   // PROCESS-WIDE total budget (split over all r
 // or written from the wrong GPU - a page fault or garbage, with -sm layer on 2 GPUs).
 // Only trust an alias whose table is on the calling device and, when the op is known, belongs to the op's layer.
 static int64_t g_alias_stale = 0;
+static bool    g_sig_probe   = false;   // moe_cache_redirect_sig's lookups: not counted in the stats
 static int alias_find_checked(const void * key, int device, int layer) {
     const auto it = g_alias_to_id.find(key);
     if (it == g_alias_to_id.end()) {
@@ -413,7 +414,7 @@ static int alias_find_checked(const void * key, int device, int layer) {
     if (id < 0 || id >= (int) g_tables.size() ||
         (device >= 0 && g_tables[id].device != device) ||
         (layer >= 0 && g_tables[id].layer >= 0 && g_tables[id].layer != layer)) {
-        if (g_alias_stale++ == 0 || (g_alias_stale % 10000) == 0) {
+        if (!g_sig_probe && (g_alias_stale++ == 0 || (g_alias_stale % 10000) == 0)) {
             // Warn on the first, then every 10000th: the guard is doing its job either way, but the
             // magnitude is what tells a one-off (a scheduler address reused across graphs, which is
             // routine) from a runaway (the graphs being re-planned constantly).
@@ -9815,13 +9816,9 @@ const uintptr_t * moe_cache_get_cold_ptrs(const void * arena) {
     return nullptr;
 }
 
-bool moe_cache_get_table(const ggml_tensor * op, const ggml_tensor * weight_cpy, int device,
-                         void ** arena, int64_t * n_slots,
-                         size_t * expert_bytes, void ** remap_dev, int64_t * n_used, int64_t * n_tok) {
-    if (!g_enabled || weight_cpy == nullptr) {
-        return false;
-    }
-    std::lock_guard<std::mutex> lock(g_mutex);
+static bool get_table_locked(const ggml_tensor * op, const ggml_tensor * weight_cpy, int device,
+                             void ** arena, int64_t * n_slots,
+                             size_t * expert_bytes, void ** remap_dev, int64_t * n_used, int64_t * n_tok) {
     int id = alias_find_checked(weight_cpy, device, op != nullptr ? name_layer(op) : -1);
     // Fallback for `-sm tensor`: a meta graph rebuild can hand the op a different simple-tensor pointer
     // than the one the hook saw, so resolve by the semantic (layer, role, device) key.  The buffer
@@ -9847,7 +9844,7 @@ bool moe_cache_get_table(const ggml_tensor * op, const ggml_tensor * weight_cpy,
     // the real copied buffer, and the shallow arena copy carries a null `buffer`).
     if (t.identity && t.arena != nullptr && t.slots >= t.n_experts &&
         op != nullptr && op->ne[2] <= MOE_EXPERT_CACHE_MAX_TOK) {
-        g_get_ok++;
+        g_get_ok += g_sig_probe ? 0 : 1;
         if (arena)        *arena        = t.arena;
         if (n_slots)      *n_slots      = t.slots;
         if (expert_bytes) *expert_bytes = t.expert_bytes;
@@ -9862,7 +9859,7 @@ bool moe_cache_get_table(const ggml_tensor * op, const ggml_tensor * weight_cpy,
     if (t.remap_round != remap_round_locked(device)) {
         return false;   // published for an earlier split (see remap_round_locked): the op reads the scheduler's copy
     }
-    g_get_ok++;
+    g_get_ok += g_sig_probe ? 0 : 1;
     if (arena)        *arena        = t.arena;
     if (n_slots)      *n_slots      = t.slots;
     if (expert_bytes) *expert_bytes = t.expert_bytes;
@@ -9872,6 +9869,42 @@ bool moe_cache_get_table(const ggml_tensor * op, const ggml_tensor * weight_cpy,
     return true;
 }
 
+bool moe_cache_get_table(const ggml_tensor * op, const ggml_tensor * weight_cpy, int device,
+                         void ** arena, int64_t * n_slots,
+                         size_t * expert_bytes, void ** remap_dev, int64_t * n_used, int64_t * n_tok) {
+    if (!g_enabled || weight_cpy == nullptr) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return get_table_locked(op, weight_cpy, device, arena, n_slots, expert_bytes, remap_dev, n_used, n_tok);
+}
+
+// Which MUL_MAT_ID nodes of `cgraph` the per-op consumer redirects onto an arena right now (the consumer's own test:
+// `moe_cache_get_table` plus the remap shape).  A captured CUDA graph bakes that choice in (the arena base and the
+// remap buffer, or the scheduler's `input_cpy`), so a replay is only valid while the signature is unchanged: a table
+// that declines after its capture would otherwise be read through a remap this call never wrote (FINDINGS 716).
+uint64_t moe_cache_redirect_sig(const ggml_cgraph * cgraph, int device) {
+    if (!g_enabled || cgraph == nullptr) {
+        return 0;
+    }
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_sig_probe = true;
+    uint64_t h = 1469598103934665603ull;
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        if (node->op != GGML_OP_MUL_MAT_ID || node->src[0] == nullptr || node->src[2] == nullptr) {
+            continue;
+        }
+        void *  remap = nullptr;
+        int64_t nu = 0, nt = 0;
+        const bool on = get_table_locked(node, node->src[0], device, nullptr, nullptr, nullptr, &remap, &nu, &nt) &&
+                        (remap == nullptr || (nu == node->src[2]->ne[0] && nt == node->src[2]->ne[1]));
+        h = (h ^ (uint64_t) (2 * i + (on ? 1 : 0))) * 1099511628211ull;
+    }
+    g_sig_probe = false;
+    return h;
+}
+
 // After a failed `moe_cache_redirect_fused`: true when the cache took over either lane anyway (one lane declined, or a
 // remap shape the fused kernel cannot take).  The scheduler skipped the copy of every taken-over input, so the original
 // tensors are stale for that lane: the caller must not fuse, and each op reads its own table through the per-op
diff --git a/ggml/src/ggml-cuda/moe-expert-cache.h b/ggml/src/ggml-cuda/moe-expert-cache.h
index d7f252fde..08db04627 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.h
+++ b/ggml/src/ggml-cuda/moe-expert-cache.h
@@ -357,6 +357,10 @@ bool moe_cache_get_table(const struct ggml_tensor * op, const struct ggml_tensor
                          void ** arena, int64_t * n_slots,
                          size_t * expert_bytes, void ** remap_dev, int64_t * n_used, int64_t * n_tok);
 
+// A hash of which MUL_MAT_ID nodes of `cgraph` the consumer redirects onto an arena now (0: cache off); a captured
+// CUDA graph is replayed only while it is unchanged.
+uint64_t moe_cache_redirect_sig(const struct ggml_cgraph * cgraph, int device);
+
 // Structural takeover for the decode/verify band: true when the table is cache-managed and the consumer
 // can read the arena without the host routing (an identity table, served with the raw ids).  Every other
 // table takes the eager host-routing path (`moe_cache_update_host`), which materializes the remap on the
