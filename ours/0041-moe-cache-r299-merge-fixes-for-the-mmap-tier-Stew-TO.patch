From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Tue, 17 Nov 2026 02:28:28 +0000
Subject: [PATCH 41/44] moe cache: r299 merge fixes for the mmap tier (Stew
 TODO #327 / #335 / #336)

fusion_serve passes our gate routing copy and stands the fused prefill down (MIXED) when the gate and up
lanes route differently (tier tables place them independently; the fused kernels read one ids copy).
get_table_locked honours (clears) the take-over promise on both serve paths (not in the signature probe),
and our tier prefill take-overs (routed / in-place prepare, prefetch) clear any older promise, so the
release repair never re-fills a sparse table copy from the mmap master.
---
 ggml/src/ggml-cuda/moe-expert-cache.cu | 15 +++++++++++++--
 ggml/src/ggml-cuda/moe-expert-tier.inc |  7 +++++++
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index 68b40d4bdd..06f09d4c6a 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -11943,7 +11943,11 @@ bool moe_cache_update_host(const ggml_tensor * weight, const ggml_tensor * weigh
         // prefill-in-place arena (TODO #317 P1) below serves the other tables.
         if (t.host_sparse) {
             t.remap_prefill = false;
-            return tier_prefill_routed_locked(t, weight_cpy, ids, n_used, n_tok, ids_nb0, ids_nb1, stream);
+            const bool taken = tier_prefill_routed_locked(t, weight_cpy, ids, n_used, n_tok, ids_nb0, ids_nb1, stream);
+            if (taken) {
+                t.taken_cpy = nullptr;   // ours: our resolve fills this copy; no older promise may stand for it
+            }
+            return taken;
         }
         // TODO #317 (wip/prefill-in-place-arena P1): serve this table's USED set in place out of the arena --
         // admit what is missing, publish the slot-remapped routing, and let `MUL_MAT_ID` read the arena.  A
@@ -12903,7 +12907,14 @@ moe_cache_serve_status moe_cache_fusion_serve(const ggml_tensor * op, const ggml
     }
     // Both lanes are served: build the shallow arena/remap copies.  The redirect re-resolves under the
     // lock, so a table that flips unserveable in between lands as MIXED (the caller stands down).
-    if (!moe_cache_redirect_fused(op, src0, gate, ids, device, stream, src0_cpy, ids_cpy, gate_cpy)) {
+    // ours: our redirect also returns the gate lane's own routing copy (tier tables place gate and up
+    // independently).  The fused kernels read both lanes through the ONE ids copy, so lanes whose routings
+    // differ stand the fusion down (identity lanes both keep the raw ids and still pass).
+    ggml_tensor gate_ids_tmp;
+    if (!moe_cache_redirect_fused(op, src0, gate, ids, device, stream, src0_cpy, ids_cpy, gate_cpy, &gate_ids_tmp)) {
+        return MOE_CACHE_SERVE_MIXED;
+    }
+    if (gate != nullptr && gate_ids_tmp.data != ids_cpy->data) {
         return MOE_CACHE_SERVE_MIXED;
     }
     return MOE_CACHE_SERVE_IN_PLACE;
diff --git a/ggml/src/ggml-cuda/moe-expert-tier.inc b/ggml/src/ggml-cuda/moe-expert-tier.inc
index 3bb0ccdee8..0add00a4e7 100644
--- a/ggml/src/ggml-cuda/moe-expert-tier.inc
+++ b/ggml/src/ggml-cuda/moe-expert-tier.inc
@@ -3314,6 +3314,7 @@ static bool moe_cache_pf_take(const ggml_tensor * weight, const ggml_tensor * we
     }
     t.pf_stage   = P.buf[P.cur_buf] + t.pf_off;
     t.pf_dst     = weight_cpy->data;
+    t.taken_cpy  = nullptr;   // our prefetch fills this copy; no older take-over promise may stand for it
     g_alias_to_id[weight_cpy] = id;
     return true;
 }
@@ -3442,6 +3443,9 @@ static bool get_table_locked(const ggml_tensor * op, const ggml_tensor * weight_
     if (t.identity && t.arena != nullptr && t.slots >= t.n_experts &&
         op != nullptr && moe_cache_width_serves_in_place(op->ne[2])) {
         g_get_ok += g_sig_probe ? 0 : 1;
+        if (!g_sig_probe) {
+            t.taken_cpy = nullptr;   // served: the promise it was made with is honoured (TODO #335/#336)
+        }
         if (arena)        *arena        = t.arena;
         if (n_slots)      *n_slots      = t.slots;
         if (expert_bytes) *expert_bytes = t.expert_bytes;
@@ -3457,6 +3461,9 @@ static bool get_table_locked(const ggml_tensor * op, const ggml_tensor * weight_
         return false;   // published for an earlier split (see remap_round_locked): the op reads the scheduler's copy
     }
     g_get_ok += g_sig_probe ? 0 : 1;
+    if (!g_sig_probe) {
+        t.taken_cpy = nullptr;   // served: the promise it was made with is honoured (TODO #335/#336)
+    }
     if (arena)        *arena        = t.arena;
     if (n_slots)      *n_slots      = t.slots;
     if (expert_bytes) *expert_bytes = t.expert_bytes;
