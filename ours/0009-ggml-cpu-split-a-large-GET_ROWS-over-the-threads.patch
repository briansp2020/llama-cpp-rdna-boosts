From 7712c88739f2de27ec793d2b7ff16803bbc29009 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Sun, 25 Oct 2026 16:42:58 +0000
Subject: [PATCH 09/22] ggml-cpu: split a large GET_ROWS over the threads

GET_ROWS always ran as one task (FIXME: thread launch cost with GPU
offload).  For a prompt ubatch the CPU token-embedding lookup is
thousands of dequantized rows on the critical path ahead of the GPU
splits: 2048 IQ3_S rows of 2560 took ~35-60 ms of one core per ubatch
with both GPUs idle (-sm tensor, 2 x R9700).  Use n_threads once the
output reaches GGML_CPU_GET_ROWS_MT_MIN elements (default 262144, so
decode and short turns stay single-task; 0 = never).  The row loop
already partitions by ith/nth, so the values are unchanged.

(cherry picked from commit 2ed1dc49650a3e9caa59c7214e3c3fc9b395a78a)
---
 ggml/src/ggml-cpu/ggml-cpu.c | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 158571f6c..416b5aa3b 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -2284,6 +2284,19 @@ static void set_numa_thread_affinity(int thread_n) { UNUSED(thread_n);  }
 static void clear_numa_thread_affinity(void) {}
 #endif
 
+// GGML_CPU_GET_ROWS_MT_MIN: output elements from which GET_ROWS splits its rows over the threads (see ggml_get_n_tasks)
+static int64_t ggml_cpu_get_rows_mt_min(void) {
+    static int64_t v = -1;
+    if (v < 0) {
+        const char * e = getenv("GGML_CPU_GET_ROWS_MT_MIN");
+        v = e != NULL ? (int64_t) atoll(e) : (int64_t) 262144;
+        if (v < 0) {
+            v = 0;
+        }
+    }
+    return v;
+}
+
 static int ggml_get_n_tasks(struct ggml_tensor * node, int n_threads) {
     int n_tasks = 0;
 
@@ -2412,7 +2425,12 @@ static int ggml_get_n_tasks(struct ggml_tensor * node, int n_threads) {
                 // FIXME: get_rows can use additional threads, but the cost of launching additional threads
                 // decreases performance with GPU offloading
                 //n_tasks = n_threads;
-                n_tasks = 1;
+                // ...for a small gather (decode, short turns).  A prompt ubatch's token-embedding lookup is
+                // thousands of dequantized rows on the critical path ahead of the GPU splits (~35-60 ms of one
+                // core for 2048 IQ3_S rows of 2560), so split the rows (each thread writes its own rows, same
+                // values) once the output reaches GGML_CPU_GET_ROWS_MT_MIN elements (default 262144; 0 = never).
+                const int64_t mt_min = ggml_cpu_get_rows_mt_min();
+                n_tasks = (mt_min > 0 && ggml_nelements(node) >= mt_min) ? n_threads : 1;
             } break;
         case GGML_OP_SCALE:
         case GGML_OP_SET:
-- 
