From c118a90f30389dedc79ba0a202e924bedbcedd23 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Mon, 2 Nov 2026 16:17:35 +0000
Subject: [PATCH 34/43] moe cache RAM tier: inclusive tier (GGML_MOE_TIER_INCL,
 default off) -- every expert keeps its RAM copy, so an eviction only flips
 the remap and an admission is one H2D copy; only from the pin budget the
 plain tiers leave over (GGML_MOE_TIER_INCL_MARGIN_MIB)

---
 ggml/src/ggml-cuda/moe-expert-cache.cu | 82 +++++++++++++++++++++++---
 1 file changed, 75 insertions(+), 7 deletions(-)

diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index 174c8ce7e..2158c0bb8 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -127,7 +127,9 @@ struct table_t {
     // compact layout.  An admission swaps arena <-> RAM, so nothing is read from the file after sizing.
     char *      ram_base    = nullptr;
     size_t      ram_bytes   = 0;
-    std::vector<int32_t> ram_slot;      // expert -> RAM slot, -1 while resident
+    std::vector<int32_t> ram_slot;      // expert -> RAM slot, -1 while resident (inclusive tier: every expert, always)
+    bool        ram_incl    = false;    // inclusive tier (GGML_MOE_TIER_INCL): every expert keeps its RAM copy, so an
+                                        // eviction only flips the remap (no copy-back) and an admission is one H2D copy
     bool        ram_partial = false;    // the tier holds only this layer's share (the hottest cold experts); an
                                         // expert outside it is read and filled through the registered file alias
     std::vector<int32_t> ram_free;      // free RAM slots (the spares: where an evicted expert lands)
@@ -919,9 +921,20 @@ static int64_t g_tier_partial = 0;   // tables left without a tier by the pin bu
 static int64_t g_tier_share_tables = 0;   // tables given a partial tier (an equal per-layer share of the budget)
 static int64_t g_tier_file_fills   = 0;   // admissions of an expert outside a partial tier (filled from the alias)
 static int64_t g_tier_file_victims = 0;   // victims of a partial tier with no RAM slot (back to the file alias)
-static int64_t g_tier_thru = 0;           // fill-through: routed experts outside a partial tier copied into it
+static int64_t g_tier_thru = 0;
+static int64_t g_tier_incl_tables = 0;     // tables with an inclusive tier (GGML_MOE_TIER_INCL)           // fill-through: routed experts outside a partial tier copied into it
 // GGML_MOE_TIER_FILL (default on): a partial tier fills its routed non-members through (tier_fill_through_locked) and
 // never reads the file alias; =0 reads them through the registered alias (declines when it cannot register).
+// GGML_MOE_TIER_INCL=1 (default off): a full tier also keeps a copy of the experts resident in VRAM, when the pin budget
+// fits it.  Admission = one RAM -> VRAM copy; eviction = the remap only (the victim's cold pointer is its permanent copy).
+static bool tier_incl_on() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_MOE_TIER_INCL");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    return on;
+}
+
 static bool tier_fill_on() {
     static const bool v = [] {
         const char * e = getenv("GGML_MOE_TIER_FILL");
@@ -1035,6 +1048,7 @@ static void tier_drop_all_locked(const char * why) {
         t.ram_bytes = 0;
         t.ram_slot.clear();
         t.ram_partial = false;
+        t.ram_incl    = false;
         t.ram_free.clear();
         t.ram_pending.clear();
         for (const table_t::precopy_t & c : t.precopy) {
@@ -1216,7 +1230,34 @@ static bool tier_build_locked(table_t & t) {
     const int n_tier = partial ? n_share : n_cold;
     size_t bytes   = (size_t) (n_tier + n_spare) * t.expert_bytes + SREG_PAD;
     const int64_t kept_reg = tier_kept_reg_bytes_locked(t);
-    if (!partial && n_spare > 1 && g_tier_bytes + kept_reg + (int64_t) bytes > budget) {
+    const size_t  incl_bytes = (size_t) t.n_experts * t.expert_bytes + SREG_PAD;
+    // Inclusive only from the budget the plain tiers of every table leave over (GGML_MOE_TIER_INCL_MARGIN_MIB kept
+    // back, default 1024), so it never pushes a later table into a partial tier.  A table not allocated yet counts as
+    // wholly cold (conservative).  The tables built first (the sizing order) take it while the surplus lasts.
+    static int64_t incl_left = INT64_MIN;
+    if (incl_left == INT64_MIN && tier_incl_on()) {
+        const char * mg = getenv("GGML_MOE_TIER_INCL_MARGIN_MIB");
+        int64_t need = (mg != nullptr ? atoll(mg) : 1024) * 1048576;
+        for (const table_t & o : g_tables) {
+            if (!o.host_sparse || o.sparse_off || o.host_dev == nullptr || o.n_experts <= 0) {
+                continue;
+            }
+            const int cold = o.n_experts - std::max(0, (int) o.expert_slot.size());
+            need += (int64_t) (cold + g_tier_spares) * (int64_t) o.expert_bytes + (int64_t) SREG_PAD;
+        }
+        incl_left = budget - need;
+        GGML_LOG_WARN("moe_cache RAM tier: inclusive surplus %.0f MiB (pin budget %.0f MiB, plain tiers %.0f MiB)\n",
+                      incl_left / 1048576.0, budget / 1048576.0, need / 1048576.0);
+    }
+    const int64_t incl_extra = (int64_t) incl_bytes - (int64_t) ((size_t) (n_cold + n_spare) * t.expert_bytes + SREG_PAD);
+    const bool    incl = !partial && tier_incl_on() && incl_extra <= incl_left &&
+                         g_tier_bytes + kept_reg + (int64_t) incl_bytes <= budget;
+    if (incl) {
+        incl_left -= incl_extra;
+        n_spare = 0;
+        bytes   = incl_bytes;
+    }
+    if (!incl && !partial && n_spare > 1 && g_tier_bytes + kept_reg + (int64_t) bytes > budget) {
         n_spare = 1;   // the extra spares do not fit: the single-spare layout
         bytes   = (size_t) (n_cold + 1) * t.expert_bytes + SREG_PAD;
     }
@@ -1283,7 +1324,7 @@ static bool tier_build_locked(table_t & t) {
     }
     int32_t j = 0;
     for (int32_t e = 0; e < t.n_experts; e++) {
-        if (t.expert_slot.find(e) != t.expert_slot.end() || !member[(size_t) e]) {
+        if (!incl && (t.expert_slot.find(e) != t.expert_slot.end() || !member[(size_t) e])) {
             ptrs[(size_t) e] = tier_file_ptr(t, e);
             continue;
         }
@@ -1301,6 +1342,8 @@ static bool tier_build_locked(table_t & t) {
     t.ram_base    = base;
     t.ram_bytes   = bytes;
     t.ram_partial = partial;
+    t.ram_incl    = incl;
+    g_tier_incl_tables += incl ? 1 : 0;
     g_tier_share_tables += partial ? 1 : 0;
     t.ram_free.clear();
     for (int k = 0; k < n_spare; k++) {
@@ -1364,6 +1407,9 @@ static cudaStream_t precopy_stream(int device) {
 }
 
 static void precopy_plan_locked(table_t & t, void * stream, const int32_t * protect, int n_protect) {
+    if (t.ram_incl) {
+        return;   // every victim already has its RAM copy
+    }
     const int want = g_tier_spares - 1;
     if (!g_precopy || want <= 0 || g_tier_off || t.ram_base == nullptr || stream == nullptr || t.arena == nullptr ||
         t.slots <= 0 || t.device < 0) {
@@ -1507,6 +1553,24 @@ static bool tier_fill_through_locked(table_t & t, const std::vector<int32_t> & u
 
 static cudaError_t tier_swap_locked(table_t & t, void * dst, int32_t e, int32_t victim, void * stream) {
     const int32_t p  = e >= 0 && e < (int32_t) t.ram_slot.size() ? t.ram_slot[(size_t) e] : -1;
+    if (t.ram_incl) {
+        // The victim's cold pointer already names its permanent RAM copy; the remap upload after this call stops the
+        // GPU reading its arena slot, and the copy below is ordered after every earlier reader on the compute stream.
+        if (p < 0 || stream == nullptr) {
+            return cudaErrorInvalidValue;
+        }
+        GGML_UNUSED(victim);
+        device_guard dg(t.device);
+        moe_cache_copy_kernel<<<128, 256, 0, (cudaStream_t) stream>>>((char *) dst, t.ram_base + (size_t) p * t.expert_bytes,
+                                                                      t.expert_bytes);
+        const cudaError_t err = cudaGetLastError();
+        if (err != cudaSuccess) {
+            return err;
+        }
+        (void) cudaEventRecord(t.swap_ev, (cudaStream_t) stream);
+        g_tier_swaps++;
+        return cudaGetLastError();
+    }
     const auto    pc = victim >= 0 ? precopy_find(t, victim) : t.precopy.end();
     // A partial tier: an incoming non-member (p < 0) fills from the registered alias, and a victim with no RAM slot
     // goes back to the file (its cold pointer only; the caller checked that it is registered and cached).
@@ -3283,12 +3347,12 @@ moe_cache_alias access_locked(table_t & t, int32_t expert, void * stream,
     }
     // A tier table evicts into a free RAM slot; with none free this call (the spare is still the source of a pending
     // copy), the miss is served cold and the expert can be admitted on a later call.
-    if (slot < 0 && t.ram_base != nullptr && !t.ram_partial && t.ram_free.empty() && t.precopy.empty()) {
+    if (slot < 0 && t.ram_base != nullptr && !t.ram_partial && !t.ram_incl && t.ram_free.empty() && t.precopy.empty()) {
         g_tier_nospare++;
     }
     // With copy-back ahead the victim may also leave through its precopy; the victim choice itself is unchanged.
     // A partial tier's victim may also go back to the file.
-    if (slot < 0 && (t.ram_base == nullptr || t.ram_partial || !t.ram_free.empty() || !t.precopy.empty())) {
+    if (slot < 0 && (t.ram_base == nullptr || t.ram_partial || t.ram_incl || !t.ram_free.empty() || !t.precopy.empty())) {
         // evict the resident with the smallest decaying count; tie -> oldest use.
         for (int s = 0; s < t.slots; s++) {
             const int32_t e = t.slot_expert[s];
@@ -3299,7 +3363,7 @@ moe_cache_alias access_locked(table_t & t, int32_t expert, void * stream,
                 slot   = s;
             }
         }
-        if (t.ram_base != nullptr && !t.ram_partial && victim >= 0 && t.ram_free.empty() &&
+        if (t.ram_base != nullptr && !t.ram_partial && !t.ram_incl && victim >= 0 && t.ram_free.empty() &&
             precopy_find(t, victim) == t.precopy.end()) {
             victim = -1;   // the victim has nowhere to go this call: served cold, as with no spare
             slot   = -1;
@@ -9270,6 +9334,10 @@ void moe_cache_report() {
                       (long long) g_sreg_nolock, (long long) g_stage_tables, (long long) g_sreg_remaps,
                       (long long) g_route_fills);
     }
+    if (g_tier_incl_tables > 0) {
+        GGML_LOG_WARN("%s: RAM tier: %lld tables with an inclusive tier (GGML_MOE_TIER_INCL)\n", __func__,
+                      (long long) g_tier_incl_tables);
+    }
     if (g_tier_swaps > 0 || g_tier_bytes > 0) {
         GGML_LOG_WARN("%s: RAM tier: %lld tables with a partial tier, %lld fills from the file, %lld victims back to the "
                       "file, %lld filled through into the tier, %lld declines\n", __func__, (long long) g_tier_share_tables,
-- 
