             continue;
         }
         // the GDN direct conv takes this concat (decode included on RDNA4 / RDNA3_0): it reads the plain matmul output
-        // and the conv-state row itself, so this epilogue must not consume the concat
+        // and the conv state itself, so this epilogue must not consume the concat (it would skip the plain store)
         ggml_cuda_gdn_conv_match gdn_m;
         if (ggml_cuda_gdn_conv_match_at_concat(cgraph, j, gdn_m)) {
-            return 0;
+            continue;
         }
         // conv_input [cs, C] = states [(cs-1)*C] + qkv [C], dim 0
         const int64_t C = n->ne[1] * n->ne[2] * n->ne[3];
@@ -3172,7 +3172,19 @@ int ggml_cuda_ssm_conv_in_try_fuse(ggml_backend_cuda_context & ctx, const ggml_c
 // Fuse the SSM pre-scan chain: conv+silu, l2_norm(q,k) and the gate/beta projections (decode only).
 // One kernel instead of ssm_conv, l2_norm_pair and ssm_gate_beta.  Returns 15 when fused.
 // GGML_CUDA_DISABLE_SSM_PRESCAN=1 turns it off.
+// The decode-only conv + l2 norm + gate / beta prescan fusion at SSM_CONV node i: whether it would take the node
+// (ggml_cuda_ssm_prescan_try_fuse with launch = false).  Also consulted by the GDN direct conv, which steps aside for it.
+static int ggml_cuda_ssm_prescan_impl(ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph, int i);
+
+bool ggml_cuda_ssm_prescan_match_at(const ggml_cgraph * cgraph, int i) {
+    return ggml_cuda_ssm_prescan_impl(nullptr, cgraph, i) != 0;
+}
+
 int ggml_cuda_ssm_prescan_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    return ggml_cuda_ssm_prescan_impl(&ctx, cgraph, i);
+}
+
+static int ggml_cuda_ssm_prescan_impl(ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph, int i) {
     static const bool disable_ssm_prescan = getenv("GGML_CUDA_DISABLE_SSM_PRESCAN") != nullptr && std::atoi(getenv("GGML_CUDA_DISABLE_SSM_PRESCAN"));
     ggml_tensor * node = cgraph->nodes[i];
     if (disable_ssm_prescan || node->op != GGML_OP_SSM_CONV || node->type != GGML_TYPE_F32 || node->ne[1] != 1 ||
@@ -3251,9 +3263,12 @@ int ggml_cuda_ssm_prescan_try_fuse(ggml_backend_cuda_context & ctx, const ggml_c
     if (wiring_ok && type_ok) {
         const int out_nodes[] = { i + 1, i + 3, i + 5, i + 11, i + 15 };
         if (ggml_cuda_check_fusion_memory_ranges(cgraph, i, 16, out_nodes, 5)) {
+            if (ctx == nullptr) {
+                return 15;
+            }
             float eps;
             memcpy(&eps, q_norm->op_params, sizeof(float));
-            ggml_cuda_op_ssm_conv_l2_gatebeta(ctx,
+            ggml_cuda_op_ssm_conv_l2_gatebeta(*ctx,
                 node->src[0], node->src[1],
                 alpha_w->src[0], beta_w->src[0], alpha_w->src[1], dt, ssm_a,
                 (ggml_tensor *) q_norm, (ggml_tensor *) k_norm, (ggml_tensor *) silu,
