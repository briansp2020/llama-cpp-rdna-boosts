+    // llama_state_seq_get_data_ext(), but the batched path may return as soon as the device-to-host copies are queued:
+    // the bytes reach `dst` at the next llama_state_finish(), at the next batched state save or restore on this
+    // context (the ones that go through its pinned staging buffer), or never if the context is freed first.  `dst` must
+    // stay valid and unread until llama_state_finish() returns; call it before reading or freeing `dst`.  The queued
+    // copies are ordered before later work on the same streams, so a following llama_decode() can overwrite the
+    // state without waiting for them.  Paths that cannot defer copy synchronously, as llama_state_seq_get_data_ext;
+    // on failure (0 returned) nothing is left pending.
+    LLAMA_API size_t llama_state_seq_get_data_deferred(
+            struct llama_context * ctx,
+                         uint8_t * dst,
+                          size_t   size,
+                    llama_seq_id   seq_id,
+           llama_state_seq_flags   flags);
+
+    // completes a copy left pending by llama_state_seq_get_data_deferred() (a no-op when none is pending)
+    LLAMA_API void llama_state_finish(struct llama_context * ctx);
+
     //
     // Decoding
     //
