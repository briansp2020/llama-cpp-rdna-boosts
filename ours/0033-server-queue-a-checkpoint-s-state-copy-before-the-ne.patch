-            llama_state_copy_pieces(pcs, grp[g], grp[g + 1], n_copy_threads);
-        }
-        if (st_timing) {
-            const int64_t t_end = ggml_time_us();
-            LLAMA_LOG_INFO("state get: %zu pieces, %.1f MiB in %zu group(s): enqueue %.2f ms, copy+wait %.2f ms "
-                           "(%.1f GiB/s), total %.2f ms\n", winfos.size(), total / 1048576.0, n_grp,
-                           (t_copy - t_enq) / 1e3, (t_end - t_copy) / 1e3,
-                           total / 1073741824.0 / std::max(1e-6, (t_end - t_copy) / 1e6), (t_end - t_enq) / 1e3);
+            if (st_timing) {
+                const int64_t t_end = ggml_time_us();
+                LLAMA_LOG_INFO("state get%s: %zu pieces, %.1f MiB in %zu group(s): enqueue %.2f ms, copy+wait %.2f ms "
+                               "(%.1f GiB/s), total %.2f ms\n", deferred ? " (deferred)" : "", n_pcs, total / 1048576.0, n_grp,
+                               deferred ? 0.0 : (t_copy - t_enq) / 1e3, (t_end - t_copy) / 1e3,
+                               total / 1073741824.0 / std::max(1e-6, (t_end - t_copy) / 1e6), (t_end - t_enq) / 1e3);
+            }
+        };
+        // llama_state_seq_get_data_deferred: only the piped path defers (its events fence each group); the queued
+        // device copies are ordered before any later work on these streams, so the next graph may overwrite the state
+        if (lctx->state_defer_next && piped) {
+            if (st_timing) {
