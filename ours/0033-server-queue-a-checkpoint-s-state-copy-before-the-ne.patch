@@ -6081,7 +6098,17 @@ private:
     llama_context * lctx = nullptr;
 };
 
+void llama_context::state_finish(bool copy) {
+    if (state_pending) {
+        auto f = std::move(state_pending);
+        state_pending = nullptr;
+        f(copy);
+    }
+}
+
 uint8_t * llama_context::state_stage(size_t size) {
+    // every batched save or restore comes through here: a deferred copy still owns the stage and the pipe events
+    state_finish();
     if (buf_state_stage == nullptr || ggml_backend_buffer_get_size(buf_state_stage.get()) < size) {
         buf_state_stage.reset();
         // the pinned type of the output device (the first simple device of a meta device), as for the outputs
@@ -7533,6 +7560,22 @@ size_t llama_state_seq_set_data_ext(llama_context * ctx, const uint8_t * src, si
     return ctx->state_seq_set_data(seq_id, src, size, flags);
 }
 
+size_t llama_state_seq_get_data_deferred(llama_context * ctx, uint8_t * dst, size_t size, llama_seq_id seq_id, llama_state_seq_flags flags) {
+    ctx->synchronize();
+
+    ctx->state_defer_next = true;
+    const size_t n = ctx->state_seq_get_data(seq_id, dst, size, flags);   // catches internally, 0 on failure
+    ctx->state_defer_next = false;
+    if (n == 0) {
+        ctx->state_finish(/* copy = */ false);   // a failed read leaves nothing that could write into `dst` later
+    }
+    return n;
+}
+
+void llama_state_finish(llama_context * ctx) {
+    ctx->state_finish();
+}
+
 size_t llama_state_seq_save_file(llama_context * ctx, const char * filepath, llama_seq_id seq_id, const llama_token * tokens, size_t n_token_count) {
     ctx->synchronize();
 
