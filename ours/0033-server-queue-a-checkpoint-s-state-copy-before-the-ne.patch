+    // LLAMA_CKPT_ASYNC_VERIFY=1 (a check, off by default): each deferred checkpoint also takes a synchronous copy of the
+    // same state just before it, and the two are compared once the deferred copy has landed (ckpt_async_complete)
+    static bool ckpt_async_verify() {
+        static const bool on = [] { const char * e = getenv("LLAMA_CKPT_ASYNC_VERIFY"); return e != nullptr && atoi(e) != 0; }();
+        return on;
+    }
+    std::vector<std::pair<std::shared_ptr<const common_prompt_checkpoint>, std::vector<uint8_t>>> ckpt_verify;
+    int64_t n_ckpt_verify_ok = 0;
+    int64_t n_ckpt_verify_bad = 0;
+
+    // lands a deferred checkpoint copy (llama_state_finish) and runs the verify comparisons; also at the end of every
+    // update_slots(), so no exit path leaves a copy pending into a buffer that a later pass might free
+    void ckpt_async_complete() {
+        llama_state_finish(ctx_tgt);
+        for (auto & v : ckpt_verify) {
+            const auto & got = v.first->data_tgt;
+            const auto & ref = v.second;
+            size_t off = 0;
+            while (off < ref.size() && off < got.size() && got[off] == ref[off]) {
+                ++off;
+            }
+            if (got.size() == ref.size() && off == ref.size()) {
+                n_ckpt_verify_ok++;
+            } else {
+                n_ckpt_verify_bad++;
+                SRV_WRN("ckpt async verify: MISMATCH at byte %zu of %zu (got %zu bytes)\n", off, ref.size(), got.size());
+            }
+            SRV_WRN("ckpt async verify: %" PRId64 " equal, %" PRId64 " differ\n", n_ckpt_verify_ok, n_ckpt_verify_bad);
+        }
+        ckpt_verify.clear();
+    }
+
+    struct ckpt_async_guard {
+        server_context_impl * self;
+        ~ckpt_async_guard() { self->ckpt_async_complete(); }
+    };
+
