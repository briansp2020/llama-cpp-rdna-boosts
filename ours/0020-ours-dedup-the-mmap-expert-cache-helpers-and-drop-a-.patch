@@ -2034,6 +2034,30 @@ static char * ggml_cuda_pin_chunk(int device, std::unique_lock<std::mutex> & loc
 // Only a pageable host pointer bounces: a pinned one (e.g. a CUDA_Host graph input) already copies at full speed, so
 // the extra memcpy would be pure overhead.  If the chunk cannot be allocated the copy stays direct.
 // GGML_CUDA_BOUNCE_MIN sets the threshold in bytes (default 1 = every size, 0 or an unparsable value = off).
+// Stream `n_copies` rows of `size` bytes (`stride_data` apart in host memory, `stride_tensor` apart on the device)
+// through the reused pinned chunk `chunk` of `cap` bytes, synchronously on `stream`: compact rows are packed back to
+// back; strided rows go as one 2-D copy per chunk that carries the source stride.
+static void ggml_cuda_pin_chunk_upload(char * chunk, size_t cap, char * dst_base, const char * data, size_t size,
+                                       size_t n_copies, size_t stride_tensor, size_t stride_data, cudaStream_t stream) {
+    const bool compact = stride_tensor == size;
+    const size_t rows = compact ? cap / size : 1 + (cap - size) / stride_data;
+    for (size_t e0 = 0; e0 < n_copies; e0 += rows) {
+        const size_t n = std::min(rows, n_copies - e0);
+        char * dst = dst_base + e0 * stride_tensor;
+        const char * src = data + e0 * stride_data;
+        if (compact) {
+            for (size_t e = 0; e < n; ++e) {
+                memcpy(chunk + e * size, src + e * stride_data, size);
+            }
+            CUDA_CHECK(cudaMemcpyAsync(dst, chunk, n * size, cudaMemcpyHostToDevice, stream));
+        } else {
+            memcpy(chunk, src, (n - 1) * stride_data + size);
+            CUDA_CHECK(cudaMemcpy2DAsync(dst, stride_tensor, chunk, stride_data, size, n, cudaMemcpyHostToDevice, stream));
+        }
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+    }
+}
