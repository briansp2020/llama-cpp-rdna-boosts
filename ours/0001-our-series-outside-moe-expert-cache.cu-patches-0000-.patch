diff --git a/ggml/src/ggml-cuda/topk-rows.cu b/ggml/src/ggml-cuda/topk-rows.cu
new file mode 100644
index 000000000..bb35da5f9
--- /dev/null
+++ b/ggml/src/ggml-cuda/topk-rows.cu
@@ -0,0 +1,175 @@
+#include "topk-rows.cuh"
+
+// Candidate selection by a threshold instead of an exact top-K: in each block every thread takes the max of its share,
+// the block sorts the thread maxima and takes the K-th largest as the threshold L, and every element >= L is kept.
+// At least K elements are >= L (K threads hold one), and every element left out is < L, i.e. below at least K kept
+// ones; that is all the sampler needs (llama_get_logits_topk_ith), with no tie handling: equal values are all kept.
+// Applied per 4096-column chunk, then per row over the chunks' candidates (the property composes).  A row whose
+// candidates do not fit (more than cap) or that holds a NaN is flagged, and the caller reads it in full.
+
+static constexpr int TOPK_ROWS_BLOCK = 256;
+static constexpr int TOPK_ROWS_CHUNK = 4096;
+// stage 2 relies on a chunk's cap_c = 4K entries landing on distinct threads (slot i -> thread i % TOPK_ROWS_BLOCK), so
+// a chunk that kept >= K values gives >= K threads a valid maximum (otherwise thr = -inf, overflow, full read)
+static_assert(4*GGML_CUDA_TOPK_ROWS_MAX_K <= TOPK_ROWS_BLOCK, "a chunk's candidates must fit one slot per thread");
+
+// descending bitonic sort of s[0, TOPK_ROWS_BLOCK) in shared memory, one element per thread
+static __device__ void topk_rows_sort_desc(float * s) {
+    const int tid = threadIdx.x;
+    for (int size = 2; size <= TOPK_ROWS_BLOCK; size <<= 1) {
+        for (int stride = size >> 1; stride > 0; stride >>= 1) {
+            const int partner = tid ^ stride;
+            if (partner > tid) {
+                const bool  desc = (tid & size) == 0;
+                const float a    = s[tid];
+                const float b    = s[partner];
+                if (desc ? a < b : a > b) {
+                    s[tid]     = b;
+                    s[partner] = a;
+                }
+            }
+            __syncthreads();
+        }
+    }
+}
+
+// Stage 1: block (chunk, row): the chunk's candidates (count, values, column ids) in the chunk's slot, flags bit 0 =
+// NaN, bit 1 = overflow (more than cap_c candidates).
+static __global__ void __launch_bounds__(TOPK_ROWS_BLOCK, 1) topk_rows_chunk_kernel(
+        const float * __restrict__ src, const int64_t ncols, const int64_t stride, const int k, const int cap_c,
+        float * __restrict__ tv, int32_t * __restrict__ ti, int32_t * __restrict__ tn) {
+    const int     c      = blockIdx.x;
+    const int     row    = blockIdx.y;
+    const int     nchunk = gridDim.x;
+    const int64_t c0     = (int64_t) c*TOPK_ROWS_CHUNK;
+    const int     n      = (int) min((int64_t) TOPK_ROWS_CHUNK, ncols - c0);
+    const float * x      = src + (int64_t) row*stride + c0;
+    const size_t  slot   = (size_t) row*nchunk + c;
+    const int     tid    = threadIdx.x;
+
+    __shared__ float s_max[TOPK_ROWS_BLOCK];
+    __shared__ int   s_n;
+    __shared__ int   s_flags;
+    if (tid == 0) {
+        s_n     = 0;
+        s_flags = 0;
+    }
+    float m   = -INFINITY;
+    bool  nan = false;
+    for (int i = tid; i < n; i += TOPK_ROWS_BLOCK) {
+        const float v = x[i];
+        nan |= v != v;
+        m = v > m ? v : m;
+    }
+    s_max[tid] = m;
+    __syncthreads();
+    if (nan) {
+        atomicOr(&s_flags, 1);
+    }
+    topk_rows_sort_desc(s_max);
+    // fewer than k elements in the chunk: keep them all
+    const float thr = n <= k ? -INFINITY : s_max[k - 1];
+    float   * v  = tv + slot*cap_c;
+    int32_t * id = ti + slot*cap_c;
+    for (int i = tid; i < n; i += TOPK_ROWS_BLOCK) {
+        const float xv = x[i];
+        if (xv >= thr) {
+            const int p = atomicAdd(&s_n, 1);
+            if (p < cap_c) {
+                v[p]  = xv;
+                id[p] = (int32_t) (c0 + i);
+            }
+        }
+    }
+    __syncthreads();
+    if (tid == 0) {
+        tn[2*slot + 0] = min(s_n, cap_c);
+        tn[2*slot + 1] = s_flags | (s_n > cap_c ? 2 : 0);
+    }
+}
+
+// Stage 2: block row: the same selection over the row's chunk candidates, into the output record (ids + id_offset).
+static __global__ void __launch_bounds__(TOPK_ROWS_BLOCK, 1) topk_rows_merge_kernel(
+        const int k, const int cap_c, const int cap, const int nchunk, const int32_t id_offset,
+        const float * __restrict__ tv, const int32_t * __restrict__ ti, const int32_t * __restrict__ tn,
+        char * __restrict__ dst) {
+    const int       row = blockIdx.x;
+    const int       tid = threadIdx.x;
+    const int       n   = nchunk*cap_c;
+    const float   * v   = tv + (size_t) row*n;
+    const int32_t * id  = ti + (size_t) row*n;
+    const int32_t * cn  = tn + (size_t) row*nchunk*2;
+
+    char    * rec  = dst + (size_t) row*ggml_cuda_topk_rows_record_bytes(cap);
+    float   * vals = (float *) rec;
+    int32_t * ids  = (int32_t *) (rec + (size_t) cap*sizeof(float));
+    int32_t * meta = ids + cap;
+
+    __shared__ float s_max[TOPK_ROWS_BLOCK];
+    __shared__ int   s_n;
+    __shared__ int   s_flags;
+    __shared__ int   s_valid;
+    if (tid == 0) {
+        s_n     = 0;
+        s_flags = 0;
+        s_valid = 0;
+    }
+    __syncthreads();
+    int flags = 0;
+    int valid = 0;
+    for (int c = tid; c < nchunk; c += TOPK_ROWS_BLOCK) {
+        flags |= cn[2*c + 1];
+        valid += cn[2*c + 0];
+    }
+    if (flags) {
+        atomicOr(&s_flags, flags);
+    }
+    if (valid) {
+        atomicAdd(&s_valid, valid);
+    }
+    // slot i = (chunk i / cap_c, entry i % cap_c): strided over the threads, so every chunk's entries spread out
+    float m = -INFINITY;
+    for (int i = tid; i < n; i += TOPK_ROWS_BLOCK) {
+        if (i % cap_c < cn[2*(i / cap_c)]) {
+            m = v[i] > m ? v[i] : m;
+        }
+    }
+    s_max[tid] = m;
+    __syncthreads();
+    topk_rows_sort_desc(s_max);
+    const float thr = s_valid <= k ? -INFINITY : s_max[k - 1];
+    for (int i = tid; i < n; i += TOPK_ROWS_BLOCK) {
+        if (i % cap_c < cn[2*(i / cap_c)] && v[i] >= thr) {
+            const int p = atomicAdd(&s_n, 1);
+            if (p < cap) {
+                vals[p] = v[i];
+                ids[p]  = id[i] + id_offset;
+            }
+        }
+    }
+    __syncthreads();
+    if (tid == 0) {
+        meta[0] = min(s_n, cap);
+        meta[1] = (s_flags & 1) | ((s_flags & 2) || s_n > cap ? 2 : 0);
+    }
+}
+
+void ggml_cuda_topk_rows(ggml_cuda_pool & pool, cudaStream_t stream, const float * src, int64_t ncols, int64_t nrows,
+        int64_t stride, int k, int32_t id_offset, char * dst) {
+    GGML_ASSERT(k > 0 && k <= GGML_CUDA_TOPK_ROWS_MAX_K && k <= TOPK_ROWS_BLOCK);
+    if (nrows <= 0) {
+        return;
+    }
+    const int    cap    = ggml_cuda_topk_rows_cap(k);
+    const int    cap_c  = cap;
+    const int    nchunk = (int) ((ncols + TOPK_ROWS_CHUNK - 1)/TOPK_ROWS_CHUNK);
+    const size_t nslot  = (size_t) nrows*nchunk;
+    ggml_cuda_pool_alloc<float>   tv(pool, nslot*cap_c);
+    ggml_cuda_pool_alloc<int32_t> ti(pool, nslot*cap_c);
+    ggml_cuda_pool_alloc<int32_t> tn(pool, nslot*2);
+    topk_rows_chunk_kernel<<<dim3(nchunk, (unsigned) nrows), TOPK_ROWS_BLOCK, 0, stream>>>(
+            src, ncols, stride, k, cap_c, tv.get(), ti.get(), tn.get());
+    topk_rows_merge_kernel<<<(unsigned) nrows, TOPK_ROWS_BLOCK, 0, stream>>>(
+            k, cap_c, cap, nchunk, id_offset, tv.get(), ti.get(), tn.get(), dst);
+    CUDA_CHECK(cudaGetLastError());
+}
diff --git a/ggml/src/ggml-cuda/topk-rows.cuh b/ggml/src/ggml-cuda/topk-rows.cuh
new file mode 100644
index 000000000..eb6e65abb
--- /dev/null
+++ b/ggml/src/ggml-cuda/topk-rows.cuh
@@ -0,0 +1,23 @@
+#pragma once
+
+#include "common.cuh"
+
+// Per-row logits candidates of an F32 matrix (the LM head logits) for the sampler: for each row, a set of at least
+// min(K, ncols) values with their column index + id_offset, unsorted, such that every value left out is below at least
+// K of the kept ones.  One output record per row, cap = ggml_cuda_topk_rows_cap(K) entries:
+//   float vals[cap]; int32_t ids[cap]; int32_t n; int32_t flags;
+// flags bit 0: the row holds a NaN; bit 1: more than cap candidates (the record is incomplete).  Either way the caller
+// must read the row in full.
+static constexpr int GGML_CUDA_TOPK_ROWS_MAX_K = 64;
+
+static __host__ __device__ inline int ggml_cuda_topk_rows_cap(int k) {
+    return 4*k;
+}
+
+static __host__ __device__ inline size_t ggml_cuda_topk_rows_record_bytes(int cap) {
+    return (size_t) cap*(sizeof(float) + sizeof(int32_t)) + 2*sizeof(int32_t);
+}
+
+// Two stages on stream: the candidates of every 4096-column chunk (many blocks per row), then of those per row.
+void ggml_cuda_topk_rows(ggml_cuda_pool & pool, cudaStream_t stream, const float * src, int64_t ncols, int64_t nrows,
+        int64_t stride, int k, int32_t id_offset, char * dst);
