+bool llama_context::logits_topk_issue(ggml_backend_t backend_res, ggml_tensor * t_logits, int64_t row0, int64_t n_rows) {
+    if (ltopk.k <= 0 || n_rows <= 0 || t_logits->type != GGML_TYPE_F32 || t_logits->ne[1] < n_rows ||
+            t_logits->ne[0] != (int64_t) model.vocab.n_tokens()) {
+        return false;
+    }
+    constexpr int max_pieces = 16;
+    ggml_backend_meta_row_piece pieces[max_pieces];
+    int n_pieces = ggml_backend_meta_tensor_row_pieces(backend_res, t_logits, pieces, max_pieces);
+    if (n_pieces == -1) {
+        // a tensor-split tensor in a layout the pieces do not cover: copy it in full (and do not resolve the entry
+        // point from the meta device, which has none)
+        return false;
+    }
+    if (n_pieces < 0) {
+        if (t_logits->buffer == nullptr || ggml_backend_buffer_is_host(t_logits->buffer)) {
+            return false; // a host buffer: the full copy is a plain memcpy anyway
+        }
+        pieces[0] = { backend_res, t_logits, 0, 0, t_logits->ne[0] };
+        n_pieces  = 1;
+    }
+    if (!ltopk.fn_resolved) {
+        ltopk.fn_resolved = true;
+        ggml_backend_dev_t dev = ggml_backend_get_device(pieces[0].backend);
+        ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+        ltopk.fn = reg ? (decltype(ltopk.fn)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_rows_topk_async") : nullptr;
+        if (ltopk.fn == nullptr) {
+            LLAMA_LOG_WARN("%s: LLAMA_LOGITS_TOPK: the logits backend has no top-k entry point; copying full logits\n", __func__);
+        }
+    }
+    if (ltopk.fn == nullptr) {
+        return false;
+    }
+    const size_t rec_bytes = logits_topk_rec_bytes(ltopk.k);
+    const size_t need      = (size_t) n_pieces*n_rows*rec_bytes;
+    if (!ltopk.host || ggml_backend_buffer_get_size(ltopk.host.get()) < need) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(pieces[0].backend);
+        ggml_backend_buffer_type_t buft = dev ? ggml_backend_dev_host_buffer_type(dev) : nullptr;
+        if (buft == nullptr) {
+            ltopk.fn = nullptr;
+            return false;
+        }
+        synchronize(); // a previous decode's record copy may still be in flight into the old buffer
+        ltopk.host.reset(ggml_backend_buft_alloc_buffer(buft, need*2));
+        if (!ltopk.host) {
+            ltopk.fn = nullptr;
+            return false;
+        }
+    }
+    char * host = (char *) ggml_backend_buffer_get_base(ltopk.host.get());
+    for (int p = 0; p < n_pieces; ++p) {
+        const auto & pc = pieces[p];
+        if (pc.simple->ne[1] < n_rows ||
+            !ltopk.fn(pc.backend, pc.simple, pc.col_simple, pc.ncols, n_rows, (int32_t) pc.col_full, ltopk.k,
+                      host + (size_t) p*n_rows*rec_bytes)) {
+            return false; // the full copy follows; a record already queued is simply unused
+        }
+    }
+    ltopk.t_logits = t_logits;
+    ltopk.backend  = backend_res;
+    ltopk.row0     = row0;
+    ltopk.n_rows   = n_rows;
+    ltopk.n_rows_issued = n_rows;
+    ltopk.n_pieces = n_pieces;
+    ltopk.view_slot = sched_alt_in_use ? 1 : 0;
+    for (int64_t r = 0; r < n_rows; ++r) {
+        ltopk.src_row[row0 + r]      = r;
+        ltopk.rec_row[row0 + r]      = r;
+        ltopk.merged_state[row0 + r] = 0;
+    }
+    return true;
+}
