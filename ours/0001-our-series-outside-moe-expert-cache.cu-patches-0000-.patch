+static __device__ __forceinline__ float moe_iq4nl_dot(const moe_iq4nl_raw & r) {
+    int sumi = 0;
+#pragma unroll
+    for (int l = 0; l < VDR_IQ4_NL_Q8_1_MMVQ; ++l) {
+        const int2 v = get_int_from_table_16(r.q4[l], kvalues_iq4nl);
+        sumi = ggml_cuda_dp4a(v.x, r.q8[2*l + 0], sumi);
+        sumi = ggml_cuda_dp4a(v.y, r.q8[2*l + 1], sumi);
+    }
+    const float d = __half2float(r.d) * __low2float(r.ds);
+    return d * sumi;
