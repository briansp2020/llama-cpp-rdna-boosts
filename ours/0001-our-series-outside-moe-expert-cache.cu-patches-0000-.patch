+int32_t llama_context::get_logits_topk_ith(int32_t i, const float ** vals, const llama_token ** ids, int32_t * k_slice) {
+    output_reorder();
+
+    int64_t j = -1;
+    try {
+        j = output_resolve_row(i);
+    } catch (const std::exception &) {
+        return -1;
+    }
+    if (j < 0 || j >= (int64_t) ltopk.rec_row.size() || ltopk.rec_row[j] < 0 || ltopk.merged_state[j] < 0) {
+        return -1;
+    }
+    if (ltopk.merged_state[j] == 0) {
+        const size_t  rec_bytes = logits_topk_rec_bytes(ltopk.k);
+        const int     cap       = logits_topk_cap(ltopk.k);
+        const char  * host      = (const char *) ggml_backend_buffer_get_base(ltopk.host.get());
+        std::vector<std::pair<float, llama_token>> c;
+        bool bad = false;
+        for (int p = 0; p < ltopk.n_pieces && !bad; ++p) {
+            const char    * rec = host + ((size_t) p*ltopk.n_rows_issued + ltopk.rec_row[j])*rec_bytes;
+            const float   * v   = (const float *) rec;
+            const int32_t * id  = (const int32_t *) (rec + (size_t) cap*sizeof(float));
+            const int32_t   n   = id[cap];
+            bad = id[cap + 1] != 0; // a NaN in the row, or more candidates than the record holds
+            for (int32_t q = 0; q < n; ++q) {
+                c.emplace_back(v[q], id[q]);
+            }
+        }
+        if (bad) {
+            ltopk.merged_state[j] = -1;
+            return -1;
+        }
+        std::sort(c.begin(), c.end(), [](const std::pair<float, llama_token> & a, const std::pair<float, llama_token> & b) {
+            return a.first > b.first || (a.first == b.first && a.second < b.second);
+        });
+        auto & mv = ltopk.merged_vals[j];
+        auto & mi = ltopk.merged_ids[j];
+        mv.resize(c.size());
+        mi.resize(c.size());
+        for (size_t q = 0; q < c.size(); ++q) {
+            mv[q] = c[q].first;
+            mi[q] = c[q].second;
+        }
+        ltopk.merged_state[j] = 1;
+    }
+    *vals    = ltopk.merged_vals[j].data();
+    *ids     = ltopk.merged_ids[j].data();
+    *k_slice = ltopk.k;
+    return (int32_t) ltopk.merged_vals[j].size();
+}
