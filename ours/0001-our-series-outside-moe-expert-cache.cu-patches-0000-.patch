 float * llama_context::get_logits() {
     output_reorder();
+    logits_topk_slot_guard slot_guard(ltopk.view_slot);
+
+    // every deferred row in full: one sync, then runs of consecutive source rows in one copy each
+    const int64_t n_rows = (int64_t) ltopk.src_row.size();
+    bool synced = false;
+    for (int64_t j = 0; j < n_rows; ) {
+        if (ltopk.src_row[j] < 0) {
+            ++j;
+            continue;
+        }
+        if (!synced) {
+            synchronize();
+            synced = true;
+        }
+        int64_t run = 1;
+        while (j + run < n_rows && ltopk.src_row[j + run] == ltopk.src_row[j] + run) {
+            ++run;
+        }
+        const size_t row_bytes = (size_t) model.vocab.n_tokens()*sizeof(float);
+        ggml_backend_tensor_get(ltopk.t_logits, logits.data + j*model.vocab.n_tokens(), (size_t) ltopk.src_row[j]*row_bytes,
+                (size_t) run*row_bytes);
+        for (int64_t q = 0; q < run; ++q) {
+            ltopk.src_row[j + q] = -1;
+        }
+        j += run;
+    }
 
     return logits.data;
 }
 
+void llama_context::logits_topk_reset(int64_t n_outputs) {
+    ltopk.t_logits      = nullptr;
+    ltopk.n_rows        = 0;
+    ltopk.n_rows_issued = 0;
+    if (ltopk.k > 0) {
+        ltopk.src_row.assign(n_outputs, -1);
+        ltopk.rec_row.assign(n_outputs, -1);
+        ltopk.merged_state.assign(n_outputs, 0);
+        ltopk.merged_vals.resize(n_outputs);
+        ltopk.merged_ids.resize(n_outputs);
+    }
+}
+
+// the per-row record of ggml_backend_cuda_rows_topk_async: float vals[cap]; int32_t ids[cap]; int32_t n; int32_t flags
+static int    logits_topk_cap(int k)       { return 4*k; }
+static size_t logits_topk_rec_bytes(int k) { return (size_t) logits_topk_cap(k)*(sizeof(float) + sizeof(int32_t)) + 2*sizeof(int32_t); }
+
+void llama_context::logits_topk_fetch(int64_t j) {
+    if (j < 0 || j >= (int64_t) ltopk.src_row.size() || ltopk.src_row[j] < 0) {
+        return;
+    }
+    synchronize();
+    logits_topk_slot_guard slot_guard(ltopk.view_slot);
+    const int64_t n_vocab = model.vocab.n_tokens();
+    ggml_backend_tensor_get(ltopk.t_logits, logits.data + j*n_vocab, (size_t) ltopk.src_row[j]*n_vocab*sizeof(float),
+            (size_t) n_vocab*sizeof(float));
+    ltopk.src_row[j] = -1;
+}
+
+void llama_context::logits_topk_flush_full() {
+    if (ltopk.n_rows == 0) {
+        return;
+    }
+    const int64_t n_vocab = model.vocab.n_tokens();
+    logits_topk_slot_guard slot_guard(ltopk.view_slot);
+    ggml_backend_tensor_get_async(ltopk.backend, ltopk.t_logits, logits.data + ltopk.row0*n_vocab, 0,
+            (size_t) ltopk.n_rows*n_vocab*sizeof(float));
+    // the next ubatch overwrites t_logits and the record block: wait for this copy (and the records) first
+    ggml_backend_synchronize(ltopk.backend);
+    for (int64_t r = 0; r < ltopk.n_rows; ++r) {
+        ltopk.src_row[ltopk.row0 + r] = -1;
+        ltopk.rec_row[ltopk.row0 + r] = -1; // the next ubatch's records reuse the block
+    }
+    ltopk.n_rows = 0;
+}
