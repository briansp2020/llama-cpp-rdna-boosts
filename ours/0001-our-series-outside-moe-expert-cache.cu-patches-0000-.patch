+// The draft context's second scheduler registers its compute tensors (t_logits among them) under meta view slot 1, but a
+// deferred row is read after decode() has switched back to slot 0: read it under the slot it was issued from.
+struct logits_topk_slot_guard {
+    bool restore;
+    int  back;
+    explicit logits_topk_slot_guard(int slot) : restore(slot != ggml_backend_meta_get_view_slot()), back(ggml_backend_meta_get_view_slot()) {
+        if (restore) {
+            ggml_backend_meta_set_view_slot(slot);
+        }
+    }
+    ~logits_topk_slot_guard() {
+        if (restore) {
+            ggml_backend_meta_set_view_slot(back);
+        }
+    }
+};
