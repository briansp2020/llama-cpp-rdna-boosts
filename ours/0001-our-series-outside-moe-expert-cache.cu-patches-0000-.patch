+// IQ4_NL items with their loads issued ahead (GGML_CUDA_MOE_PF4NL=0: the generic loop).  The MoE GEMV waits on vector
+// loads for ~2/3 of its cycles (rocprofv3 ATT on gfx1201) and each item's loads were waited for before the next item issued.
+// Phase 1 loads the raw words of up to MOE_PF_U items, phase 2 computes them in item order with vec_dot_iq4_nl_q8_1's
+// arithmetic, so each row's per-thread accumulation is unchanged (bit-identical).
+#define MOE_PF_U 2
+struct moe_iq4nl_raw {
+    int    q4[VDR_IQ4_NL_Q8_1_MMVQ];
+    int    q8[2*VDR_IQ4_NL_Q8_1_MMVQ];
+    half   d;
+    half2  ds;
+};
+static __device__ __forceinline__ void moe_iq4nl_load(moe_iq4nl_raw & r, const void * vbq, const block_q8_1 * bq8_1,
+        const int kbx, const int iqs) {
+    const block_iq4_nl * bq4 = (const block_iq4_nl *) vbq + kbx;
+    const int * q8 = (const int *) bq8_1->qs + iqs;
+#pragma unroll
+    for (int l = 0; l < VDR_IQ4_NL_Q8_1_MMVQ; ++l) {
+        r.q4[l]       = get_int_b2(bq4->qs, iqs + l);
+        r.q8[2*l + 0] = q8[l + 0];
+        r.q8[2*l + 1] = q8[l + 4];
+    }
+    r.d  = bq4->d;
+    r.ds = bq8_1->ds;
