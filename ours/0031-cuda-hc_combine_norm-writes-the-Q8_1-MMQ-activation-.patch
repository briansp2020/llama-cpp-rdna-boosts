     const char * const q8_arena0 = cuda_ctx->q8_1_arena;
     cuda_ctx->mwr_done_graph = nullptr;
     cuda_ctx->bf16_src1_cache_clear();
+    cuda_ctx->mmq_q8_handoff_clear();
     ggml_cuda_mmb_set_active_ctx(cuda_ctx);
     ggml_cuda_mmb_begin_graph();
 
@@ -9952,6 +9953,7 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
             c->pool_stack_census();
             ggml_cuda_mmb_yield_caches(c);
             c->bf16_src1_cache_clear();
