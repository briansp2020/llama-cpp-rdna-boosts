diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 8050b730fc..ad3359ddf4 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -2873,6 +2873,41 @@ struct ggml_backend_cuda_context {
     static void bf16_src1_buf_del(void * p) {
         delete (ggml_cuda_pool_alloc<nv_bfloat16> *) p;
     }
+    // hc_combine_norm -> dense MMQ Q8_1 handoff (GGML_CUDA_HC_CN_MMQ_Q8): the fused combine+norm writes the one
+    // consuming MUL_MAT's block_q8_1_mmq (D4) activation in the same pass, and that MUL_MAT (keyed by its node,
+    // src1 data and shape) skips quantize_mmq_q8_1.  One block, reused while big enough, dropped at graph start/end
+    // like bf16_src1_cache; the consumer invalidates the key when it takes it.
+    struct mmq_q8_handoff_entry {
+        const ggml_tensor * dst = nullptr;   // the consuming MUL_MAT
+        const void * data = nullptr;         // its src1 data (the norm output)
+        int64_t ne10 = 0, ne11 = 0;
+        int stream_no = 0;
+        size_t cap = 0;
+        std::unique_ptr<ggml_cuda_pool_alloc<char>> buf;
+    } mmq_q8_handoff;
+    static void mmq_q8_handoff_del(void * p) {
+        delete (ggml_cuda_pool_alloc<char> *) p;
+    }
+    void mmq_q8_handoff_clear() {
+        pool_stack_kill(mmq_q8_handoff.buf.release());
+        mmq_q8_handoff.dst  = nullptr;
+        mmq_q8_handoff.data = nullptr;
+        mmq_q8_handoff.cap  = 0;
+    }
+    void * mmq_q8_handoff_put(const ggml_tensor * dst, const void * data, int64_t ne10, int64_t ne11, size_t nbytes) {
+        auto & h = mmq_q8_handoff;
+        if (h.buf == nullptr || h.stream_no != curr_stream_no || h.cap < nbytes) {
+            mmq_q8_handoff_clear();
+            auto * buf = new ggml_cuda_pool_alloc<char>(pool(), nbytes);
+            pool_stack_push(buf, mmq_q8_handoff_del, nbytes, POOL_STACK_BF16);
+            h.buf       = std::unique_ptr<ggml_cuda_pool_alloc<char>>(buf);
+            h.stream_no = curr_stream_no;
+            h.cap       = nbytes;
+        }
+        h.dst = dst; h.data = data; h.ne10 = ne10; h.ne11 = ne11;
+        return h.buf->get();
+    }
+
     void bf16_src1_cache_clear() {
         pool_stack_kill(bf16_src1_cache.buf.release());
         bf16_src1_cache.src1 = nullptr;
@@ -2933,6 +2968,12 @@ int  ggml_cuda_get_physical_device(int device);
 bool ggml_cuda_compute_forward(ggml_backend_cuda_context & ctx, struct ggml_tensor * dst);
 
 
+// hc_combine_norm -> dense MMQ Q8_1 handoff: 1 (default) on, 0 off, 2 on + the consumer also quantizes and compares (debug, slow).
+static inline int ggml_cuda_hc_cn_mmq_q8_mode() {
+    static const int m = [] { const char * e = getenv("GGML_CUDA_HC_CN_MMQ_Q8"); return e == nullptr ? 1 : atoi(e); }();
+    return m;
+}
+
 // BF16 src1 cache (GGML_CUDA_BF16_SRC1_CACHE=0: off), shared by the MMB / HC producers.
 static inline bool ggml_cuda_bf16_src1_cache_on() {
     static const bool on = [] { const char * e = getenv("GGML_CUDA_BF16_SRC1_CACHE"); return e == nullptr || atoi(e) != 0; }();
