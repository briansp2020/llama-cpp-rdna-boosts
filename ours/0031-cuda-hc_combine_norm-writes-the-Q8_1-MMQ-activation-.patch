@@ -301,6 +303,20 @@ static __global__ void __launch_bounds__(HC_CN_BLOCK, 1) hc_combine_norm_f32(
                 const float v = hc_mul_rn(hc_mul_rn(scale, xs[k][0]), g[col]);
