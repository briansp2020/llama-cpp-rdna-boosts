+// Multi-token combine+norm whose xn feeds a dense Q8_0-class (D4) MUL_MAT that takes MMQ: also write that MUL_MAT's
+// block_q8_1_mmq activation (GGML_CUDA_HC_CN_MMQ_Q8).  Scalar RMS mode only (the vec4 mode groups 8 lanes per
+// 32 columns); the consumer re-checks node, data, shape, layout and stream and quantizes itself on any mismatch.
+void ggml_cuda_hc_combine_norm_set_mmq_q8(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i_last,
+                                          ggml_cuda_hc_combine_norm_args & args) {
+    const ggml_tensor * xn = args.out_xn;
+    const int64_t n_embd = args.out_res->ne[0];
+    const int64_t T      = args.out_res->ne[2] * args.out_res->ne[3];
+    if (ggml_cuda_hc_cn_mmq_q8_mode() == 0 || args.single_block || !args.store_xn_f32 || ggml_cuda_rms_norm_vec() ||
+            ggml_cuda_info().devices[ctx.device].warp_size != 32 || n_embd % QK8_1_MMQ != 0 || T < 64 ||
+            xn->view_src != nullptr || !ggml_is_contiguous(xn)) {
+        return;
+    }
+    for (int j = i_last + 1; j < cgraph->n_nodes && j <= i_last + 64; ++j) {
+        const ggml_tensor * mm = cgraph->nodes[j];
+        if (mm->op != GGML_OP_MUL_MAT) {
+            continue;
+        }
+        const ggml_tensor * s1 = mm->src[1];
+        const ggml_tensor * root = s1;
+        while (root->view_src) {
+            root = root->view_src;
+        }
+        if (root != xn) {
+            continue;
+        }
+        const ggml_tensor * s0 = mm->src[0];
+        const int64_t ne10 = s1->ne[0];
+        if (!ggml_is_quantized(s0->type) || mmq_get_q8_1_ds_layout(s0->type) != MMQ_Q8_1_DS_LAYOUT_D4 ||
+                s1->data != xn->data || !ggml_is_contiguous(s1) || ne10 != n_embd * args.out_res->ne[1] ||
+                s1->ne[1] != T || s1->ne[2] != 1 || s1->ne[3] != 1 || ne10 % MATRIX_ROW_PADDING != 0 ||
+                !ggml_cuda_mul_mat_takes_mmq(ctx, s0, s1, mm)) {
+            return;   // the first MUL_MAT reading xn is not a plain D4 MMQ: leave it to quantize
+        }
+        // the activation + a full tile's over-read (J <= 256 columns, rounded to 1 KiB loads)
+        const size_t nbytes = (size_t) T * ne10 / QK8_1_MMQ * sizeof(block_q8_1_mmq) + 256 * sizeof(block_q8_1_mmq) + 1024;
+        args.out_xn_q8 = ctx.mmq_q8_handoff_put(mm, xn->data, ne10, T, nbytes);
+        return;
+    }
+}
