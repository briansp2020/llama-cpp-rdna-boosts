From b7528bc55afe494757fb729a2e84b7a539e70cc3 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Thu, 5 Nov 2026 06:27:59 +0000
Subject: [PATCH 47/54] cuda slab: GGML_CUDA_SLAB_WORK_MIN_MIB sizes the work
 band up front

A compute view wider than the band learned from the reserves (the -ub 4096 prefill view, 2304 MiB vs 1792) moved
the boundary after the arena was filled, evicted arena tables and latched the RAM tier off for the run (decode
83 -> 26 t/s). With the env set the band is at least that big from the slab creation on (init, narrow floor,
set_narrow_floor, shrink floor) and the seed floor is the band itself. Default 0: unchanged. Prod model, 1 R9700,
-ub 4096 with 2304: no eviction, 101k prefill +10.6 %, 259.6k +12.4 %, decode -2..-3 % (FINDINGS 776).
---
 ggml/src/ggml-cuda/ggml-cuda-slab.cu | 26 ++++++++++++++++++++++----
 1 file changed, 22 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda-slab.cu b/ggml/src/ggml-cuda/ggml-cuda-slab.cu
index a7fbd479d..80f46cc4f 100644
--- a/ggml/src/ggml-cuda/ggml-cuda-slab.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda-slab.cu
@@ -286,6 +286,7 @@ static bool ggml_cuda_slab_narrow2_enabled() {
 // host-resident weight table (so the per-slot capacity covers every upload the ring will see).
 static size_t g_slab_ring_region_bytes = 0;
 static size_t ggml_cuda_slab_up(size_t x, size_t a);   // defined below (used by the ring-floor pin)
+static size_t ggml_cuda_slab_work_min_bytes();             // defined below (GGML_CUDA_SLAB_WORK_MIN_MIB)
 void ggml_cuda_slab_set_ring_region(size_t bytes) {
     g_slab_ring_region_bytes = bytes;
 }
@@ -340,6 +341,7 @@ void ggml_cuda_slab_set_narrow_floor(int device, size_t bytes) {
     if (cchunk > 0) {
         nf = ggml_cuda_slab_up(bytes, cchunk) + cchunk;
     }
+    nf = std::max(nf, ggml_cuda_slab_up(ggml_cuda_slab_work_min_bytes(), s.chunk));
     if (nf <= s.narrow_floor) {
         return;   // not a raise: nothing to apply and nothing to report
     }
@@ -387,6 +389,9 @@ size_t ggml_cuda_slab_seed_floor(int device) {
     if (!s.inited || s.narrow_floor == 0) {
         return 0;
     }
+    if (ggml_cuda_slab_work_min_bytes() > 0) {
+        return s.narrow_floor;   // the band is sized up front: no wide view reclaims anything above it
+    }
     const size_t wide_off = ggml_cuda_slab_wide_offset(s);
     return wide_off + (s.wide_reserve_bytes > 0 ? ggml_cuda_slab_up(s.wide_reserve_bytes, s.chunk) : 0);
 }
@@ -400,6 +405,19 @@ static size_t ggml_cuda_slab_chunk_bytes() {
     return chunk_mib * 1024 * 1024;
 }
 
+// GGML_CUDA_SLAB_WORK_MIN_MIB (default 0: off): the always-resident work band is at least this big from the slab's
+// creation on.  The band is otherwise learned from the reserves, and a compute view wider than it (measured: the
+// -ub 4096 prefill view, 2304 MiB, against the 1792 MiB band the reserve measured) moves the boundary later, which
+// evicts arena tables and latches the RAM tier off for the run.  Sized up front, the arena is that much smaller from
+// the start and nothing is evicted.
+static size_t ggml_cuda_slab_work_min_bytes() {
+    static const size_t v = [] {
+        const char * e = getenv("GGML_CUDA_SLAB_WORK_MIN_MIB");
+        return e != nullptr ? (size_t) std::max<long long>(0, atoll(e)) << 20 : (size_t) 0;
+    }();
+    return v;
+}
+
 // fit-slab-accounting revival (G3): the MTP/DFlash draft context's VRAM, passed to the MoE preflight
 // before the slab is armed.  The reserve uses it because the draft is created AFTER the slab.
 static size_t g_slab_aux_reserve_bytes = 0;
@@ -1142,7 +1160,7 @@ static void * ggml_cuda_slab_narrow2_alloc(int device, size_t need) {
             if (s.declined) {
                 return nullptr;
             }
-            if (!ggml_cuda_slab_init_locked(device, s, need)) {
+            if (!ggml_cuda_slab_init_locked(device, s, std::max(need, ggml_cuda_slab_work_min_bytes()))) {
                 return nullptr;
             }
         }
@@ -1284,7 +1302,7 @@ void * ggml_cuda_slab_work_alloc(int device, size_t need) {
             if (s.declined) {
                 return nullptr;   // declined once: do not retry init or repeat the diagnostic
             }
-            if (!ggml_cuda_slab_init_locked(device, s, need)) {
+            if (!ggml_cuda_slab_init_locked(device, s, std::max(need, ggml_cuda_slab_work_min_bytes()))) {
                 return nullptr;
             }
             s.work_needs.insert(ggml_cuda_slab_up(need, s.chunk));
@@ -1297,7 +1315,7 @@ void * ggml_cuda_slab_work_alloc(int device, size_t need) {
         // one) stays at base 0 until the graph allocator re-creates it above the ring on the next wide
         // reserve; `work_needs` still floors the boundary at the wide need meanwhile.
         if (s.narrow_floor == 0 && need < s.boundary) {
-            s.narrow_floor = ggml_cuda_slab_up(need, s.chunk);
+            s.narrow_floor = std::max(ggml_cuda_slab_up(need, s.chunk), ggml_cuda_slab_up(ggml_cuda_slab_work_min_bytes(), s.chunk));
             s.ring_region = ggml_cuda_slab_ring_candidate(s, s.narrow_floor);
             s.ring_slots  = ggml_backend_cuda_context::h2d_stage_slots();
             s.ring_used   = 0;
@@ -1369,7 +1387,7 @@ void * ggml_cuda_slab_work_alloc(int device, size_t need) {
             s.wide_n_inval++;
         }
         const size_t contrib = ret_off + ggml_cuda_slab_up(need, s.chunk);
-        size_t floor = s.narrow_floor;
+        size_t floor = std::max(s.narrow_floor, ggml_cuda_slab_up(ggml_cuda_slab_work_min_bytes(), s.chunk));
         if (s.wide_aux_size > 0) {
             const size_t aux_end = s.wide_aux_off + s.wide_aux_size;
             if (aux_end > floor) {
-- 
