+static void fb_launch_locked(const moe_fill_jobs & jobs, int n, cudaStream_t s) {
+    dim3       grid(128, (unsigned) n);
+    const dim3 block(256);
+    if (ggml_cuda_grid_stall_pad(grid, block)) {
+        grid.x = 129;   // the kernel's stride loop takes any block count; 129 x n blocks stays off the stall for every n
+    }
+    moe_cache_fill_batch_kernel<<<grid, block, 0, s>>>(jobs);
+}
+static bool fb_flush_locked() {
+    if (g_fb.n_save == 0 && g_fb.n_fill == 0) {
+        return true;
+    }
+    // GGML_MOE_FILL_BATCH_FAULT=<n> (debug): the n-th flush fails without launching.
+    static const int64_t fault = [] { const char * e = getenv("GGML_MOE_FILL_BATCH_FAULT"); return e != nullptr ? (int64_t) atoll(e) : (int64_t) 0; }();
+    g_fb_flushes++;
+    g_fb_jobs += g_fb.n_save + g_fb.n_fill;
+    bool ok = !(fault > 0 && g_fb_flushes == fault);
+    if (ok) {
+        device_guard dg(g_fb.device);
+        if (g_fb.n_save > 0) {
+            fb_launch_locked(g_fb.save, g_fb.n_save, g_fb.stream);
+            ok = cudaGetLastError() == cudaSuccess;
+        }
+        if (ok && g_fb.n_fill > 0) {
+            fb_launch_locked(g_fb.fill, g_fb.n_fill, g_fb.stream);
+            ok = cudaGetLastError() == cudaSuccess;
+        }
+    }
+    g_fb.n_save = g_fb.n_fill = g_fb.n_kv = 0;
+    const int n_undo = g_fb.n_undo;
+    g_fb.n_undo = 0;
+    if (ok) {
+        return true;
+    }
+    // Every queued fill's slot still has its old bytes while expert_slot names it: same end state as a failed swap.
+    (void) cudaGetLastError();
+    g_fb_failed++;
+    GGML_LOG_WARN("%s: batched fill launch failed; dropping the RAM tier\n", __func__);
+    for (int k = 0; k < n_undo; k++) {
+        table_t & t = g_tables[(size_t) g_fb.undo[k].table];
+        t.expert_slot.erase(g_fb.undo[k].expert);
+        t.slot_expert[g_fb.undo[k].slot] = -1;
+        t.slot_dirty = true;
+        slot_seq_set_locked(t, g_fb.undo[k].slot, -1);
+    }
+    tier_drop_all_locked("batched fill failed");
+    return false;
+}
