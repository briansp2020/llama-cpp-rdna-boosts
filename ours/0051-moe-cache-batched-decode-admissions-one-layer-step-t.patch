+// Batched decode admissions (GGML_MOE_FILL_BATCH, default on; =0: one launch per copy and pointer, as before).  Inside one
+// moe_cache_remap_dev call the victim saves and the fills of a layer's tables are queued and launched just before the remap:
+// phase 1 = every save (arena -> KV slot / spare RAM slot), phase 2 = every fill and map upload.  A job's copies run
+// concurrently with its phase, so no job may read or write what another job of its phase writes, and phase 1 runs first
+// because it reads the arena slots phase 2 overwrites.  KV slots a queued job touches are off limits to the CLOCK (fb_kv).
+#define MOE_FB_MAX_JOBS 16
+struct moe_fill_job {
+    char *       dst;
+    const char * src;
+    uintptr_t *  ptrs;   // optional: ptrs[e] = v, in the same kernel
+    size_t       n;
+    uintptr_t    v;
+    int32_t      e;
+    int32_t      pad;
+};
+struct moe_fill_jobs {
+    moe_fill_job j[MOE_FB_MAX_JOBS];
+};
+static_assert(sizeof(moe_fill_jobs) <= 1024, "kernel argument");
+static __global__ void moe_cache_fill_batch_kernel(const moe_fill_jobs jobs) {
+    const moe_fill_job & jb = jobs.j[blockIdx.y];
+    if (blockIdx.x == 0 && threadIdx.x == 0 && jb.ptrs != nullptr && jb.e >= 0) {
+        jb.ptrs[jb.e] = jb.v;
+    }
+    char * __restrict__       dst = jb.dst;
+    const char * __restrict__ src = jb.src;
+    const size_t n      = jb.n;
+    const size_t stride = (size_t) gridDim.x * blockDim.x;
+    size_t       i      = (size_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if ((((uintptr_t) dst | (uintptr_t) src | n) & 15) == 0) {
+        uint4 *       d = (uint4 *) dst;
+        const uint4 * q = (const uint4 *) src;
+        for (; i < n / 16; i += stride) {
+            d[i] = q[i];
+        }
+        return;
+    }
+    for (; i < n; i += stride) {
+        dst[i] = src[i];
+    }
+}
+struct fill_batch_t {
+    int           device = -1;
+    cudaStream_t  stream = nullptr;
+    moe_fill_jobs save = {}, fill = {};
+    int           n_save = 0, n_fill = 0;
+    struct undo_t { int table, slot; int32_t expert; } undo[MOE_FB_MAX_JOBS];
+    int           n_undo = 0;
+    int           kv[2 * MOE_FB_MAX_JOBS + 2];   // KV slots a queued job reads or writes
+    int           n_kv = 0;
+};
+static fill_batch_t g_fb;
+static int64_t g_fb_flushes = 0, g_fb_jobs = 0, g_fb_late = 0, g_fb_failed = 0;
+static const bool g_fill_batch = [] { const char * e = getenv("GGML_MOE_FILL_BATCH"); return e == nullptr || atoi(e) != 0; }();
+static bool fb_flush_locked();   // launches what is queued; false: a launch failed, the tier is dropped
+static inline bool fb_on(const table_t & t) {
+    return g_fill_batch && g_defer_tab == &t;
+}
+static inline bool fb_kv_busy(int i) {
+    for (int k = 0; k < g_fb.n_kv; k++) {
+        if (g_fb.kv[k] == i) {
+            return true;
+        }
+    }
+    return false;
+}
+static inline void fb_kv_mark(int i) {
+    if (i >= 0 && !fb_kv_busy(i) && g_fb.n_kv < (int) (sizeof(g_fb.kv) / sizeof(g_fb.kv[0]))) {
+        g_fb.kv[g_fb.n_kv++] = i;
+    }
+}
+// Room for one job on (device, stream), flushing what is queued if not.  False: that flush failed.
+static bool fb_room_locked(int device, cudaStream_t s) {
+    if ((g_fb.n_save + g_fb.n_fill > 0 && (g_fb.device != device || g_fb.stream != s)) ||
+        g_fb.n_save >= MOE_FB_MAX_JOBS || g_fb.n_fill >= MOE_FB_MAX_JOBS || g_fb.n_kv + 2 > (int) (sizeof(g_fb.kv) / sizeof(g_fb.kv[0]))) {
+        if (!fb_flush_locked()) {
+            return false;
+        }
+    }
+    g_fb.device = device;
+    g_fb.stream = s;
+    return true;
+}
+static bool fb_push_save_locked(int device, cudaStream_t s, char * dst, const char * src, size_t n, uintptr_t * ptrs, int32_t e, uintptr_t v) {
+    if (!fb_room_locked(device, s)) {
+        return false;
+    }
+    for (int k = 0; k < g_fb.n_fill; k++) {
+        if (g_fb.fill.j[k].dst == src && !fb_flush_locked()) {   // reads a slot already queued for a fill: keep the order
+            return false;
+        }
+    }
+    g_fb.save.j[g_fb.n_save++] = { dst, src, ptrs, n, v, e, 0 };
+    return true;
+}
+static bool fb_push_fill_locked(int device, cudaStream_t s, char * dst, const char * src, size_t n, uintptr_t * ptrs, int32_t e, uintptr_t v) {
+    if (!fb_room_locked(device, s)) {
+        return false;
+    }
+    for (int k = 0; k < g_fb.n_fill; k++) {
+        if (g_fb.fill.j[k].dst == dst && !fb_flush_locked()) {   // the same slot twice: keep the order
+            return false;
+        }
+    }
+    g_fb.fill.j[g_fb.n_fill++] = { dst, src, ptrs, n, v, e, 0 };
+    return true;
+}
