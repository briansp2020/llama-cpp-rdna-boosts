From 8e8bed324534b9af7d417273ce91f6009bf741cc Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Fri, 23 Oct 2026 17:30:24 +0000
Subject: [PATCH 06/15] server: LLAMA_CKPT_USER_MERGE=K, no checkpoint break at
 a user message followed by <= K prompt tokens (local, default off)

(cherry picked from commit b78b01c965c642090e6d91098cde2dca1639f097)
---
 tools/server/server-context.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 19c39cbd8..2b39ed27b 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -4739,7 +4739,16 @@ private:
                         slot.prompt.tokens.push_back(cur_tok);
 
                         // break at the last user message, or at user messages at least min step past the last checkpoint
-                        if (do_checkpoint && spans.is_user_start(slot.prompt.n_tokens())) {
+                        // LLAMA_CKPT_USER_MERGE=K (local, default 0 = off): no break when at most K prompt tokens follow,
+                        // so a short follow-up is one chunk (plus the end-of-prompt tail below) instead of two.  It drops
+                        // that user-start checkpoint (an edited last message restores from an earlier one) and changes the
+                        // ubatch split, so the outputs change like any ubatch change.
+                        static const int ckpt_user_merge = [] {
+                            const char * e = getenv("LLAMA_CKPT_USER_MERGE");
+                            return e != nullptr ? std::max(0, atoi(e)) : 0;
+                        }();
+                        if (do_checkpoint && spans.is_user_start(slot.prompt.n_tokens()) &&
+                                slot.task->n_tokens() - slot.prompt.n_tokens() > ckpt_user_merge) {
                             const auto pos = slot.prompt.n_tokens();
                             const auto & checkpoints = slot.prompt.checkpoints;
 
