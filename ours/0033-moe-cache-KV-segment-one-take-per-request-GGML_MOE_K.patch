diff --git a/src/llama-ext.h b/src/llama-ext.h
index 7c5753e8b..1ea51fac6 100644
--- a/src/llama-ext.h
+++ b/src/llama-ext.h
@@ -151,6 +151,14 @@ LLAMA_API std::vector<ggml_backend_buffer_t> llama_memory_get_buffers(const llam
 // (the qwen4exp/glm5-next indexer) moves both, or neither.
 LLAMA_API bool llama_memory_seq_park(llama_memory_t mem, llama_seq_id seq_id, bool park);
 
+// KV segment, one take per request (GGML_MOE_KV_SEG_TAKE1, default on with GGML_MOE_KV_LEND=1 and GGML_MOE_KV_SEG=1; 0: a
+// take per step of the growing prompt).  n > 0: the prompts being processed will write about n more cells, so the cache
+// that lends its rows to the MoE expert cache takes the rows up to there back now, in one take, and keeps them until the
+// next hint.  n <= 0: no prompt in progress, the line follows the cells in use again.  Only a hint: every ubatch still
+// reports its own need, so a low one costs later takes and a high one drops expert copies early.  Call it between
+// decodes, from the thread that decodes; a no-op without a lending cache (whichever contexts exist).
+LLAMA_API void llama_kv_lend_hint(int32_t n);
+
 // Whether the attention cache(s) of mem support parking at all (see llama_memory_seq_park): a unified cache whose cells
 // no other cache shares, with V not transposed and no sliding window, plus, for a memory whose second cache mirrors the
 // attention cells, that cache as well.  A memory without an attention cache: true.
diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index 8995d5585..c095eb396 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -400,6 +400,7 @@ typedef void (*llama_kv_lend_unregister_t)();
 static const llama_kv_cache *     g_kv_lend_owner      = nullptr;
 static llama_kv_lend_need_t       g_kv_lend_need       = nullptr;
 static llama_kv_lend_unregister_t g_kv_lend_unregister = nullptr;
+static uint32_t                   g_kv_lend_floor      = 0;   // llama_kv_lend_hint(): rows the prompts in progress will reach
 
 //
 // llama_kv_cache
@@ -1283,13 +1284,33 @@ void llama_kv_cache::lend_need(uint32_t at_least) const {
         return;
     }
     const auto & cells = v_cells[0];
-    uint32_t rows = std::max(at_least, cells.used_max_p1());
+    uint32_t rows = std::max({ at_least, cells.used_max_p1(), g_kv_lend_floor });
     if (!parked.empty()) {
         rows = cells.size();   // parked sequences sit at the top of the cache
     }
     g_kv_lend_need((int64_t) std::min<uint64_t>(cells.size(), GGML_PAD((uint64_t) rows, 8192)));
 }
 
+void llama_kv_cache::lend_hint(int32_t n) const {
+    const auto & cells = v_cells[0];
+    g_kv_lend_floor = n > 0 ? (uint32_t) std::min<uint64_t>(cells.size(), (uint64_t) cells.used_max_p1() + (uint64_t) n) : 0;
+    if (n > 0) {
+        lend_need(0);
+    }
+}
+
+void llama_kv_lend_hint(int32_t n) {
+    static const bool on = [] {
+        const char * l = getenv("GGML_MOE_KV_LEND");
+        const char * s = getenv("GGML_MOE_KV_SEG");
+        const char * e = getenv("GGML_MOE_KV_SEG_TAKE1");
+        return l != nullptr && atoi(l) > 0 && s != nullptr && atoi(s) > 0 && (e == nullptr || atoi(e) != 0);
+    }();
+    if (on && g_kv_lend_owner != nullptr) {   // only the lending cache counts, whichever contexts exist
+        g_kv_lend_owner->lend_hint(n);
+    }
+}
+
 void llama_kv_cache::init_rotation(const char * name_tag) {
     if (!(n_rot_k || n_rot_v) || layers.empty()) {
         return;
@@ -2685,6 +2706,7 @@ llama_kv_cache::~llama_kv_cache() {
         g_kv_lend_owner      = nullptr;
         g_kv_lend_need       = nullptr;
         g_kv_lend_unregister = nullptr;
+        g_kv_lend_floor      = 0;
     }
