From 35245c006be45be07fb938835a0fb67a6bbd6f09 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Thu, 5 Nov 2026 20:54:49 +0000
Subject: [PATCH 50/54] moe cache: a failed host-source fill rolls the
 admission back and stands the table down (GGML_MOE_FILL_ROLLBACK)

The remap is built from expert_slot, so a slot whose bytes never arrived served stale data: wrong output and only a warning.
Same rule as stew r219 (issue #274), on our r206 file: undo the admission, and moe_cache_update_host and get_table_locked
decline that table from then on, so the scheduler serves it from the host master.  The RAM tier and sparse paths already
roll back, and production tables only use those.  GGML_MOE_FILL_FAULT=n forces failures from the n-th fill.

FINDINGS 780.
---
 ggml/src/ggml-cuda/moe-expert-cache.cu | 53 ++++++++++++++++++++++++--
 1 file changed, 50 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index 60cccc72a..6079383e3 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -196,6 +196,7 @@ struct table_t {
     int64_t     fills       = 0;
     int64_t     evictions   = 0;
     bool        alloc_failed= false;
+    bool        fill_failed = false;   // a host-source fill failed: the table declines wholesale from then on
     // Session 7 identity fast path: slots == n_experts, slot == expert, the whole table was copied
     // in at sizing time, and the consumer reads the arena with the raw routing ids (no remap, no
     // per-token host routing readback).
@@ -604,6 +605,7 @@ int64_t                             g_alloc_failed    = 0;
 // host->device traffic; only the fill is managed by the cache.
 int64_t                             g_acc_hits        = 0;
 int64_t                             g_acc_fills       = 0;
+int64_t                             g_fill_fail       = 0;   // fills rolled back (GGML_MOE_FILL_ROLLBACK)
 int64_t                             g_acc_colds       = 0;
 int64_t                             g_fill_bytes      = 0;
 int64_t                             g_cold_bytes      = 0;
@@ -4007,6 +4009,12 @@ moe_cache_alias access_locked(table_t & t, int32_t expert, void * stream,
         } else if (!expert_host_src(t, expert, pool, /*allow_empty_fill*/ true, &hsrc)) {
             err = cudaErrorInvalidDeviceFunction;
         }
+        // GGML_MOE_FILL_FAULT=<n> (debug, default off): every host-source fill from the n-th on fails.
+        static const int64_t fill_fault = [] { const char * e = getenv("GGML_MOE_FILL_FAULT"); return e != nullptr ? (int64_t) atoll(e) : (int64_t) 0; }();
+        static int64_t fill_seen = 0;
+        if (fill_fault > 0 && err == cudaSuccess && !local_src && ++fill_seen >= fill_fault) {
+            err = cudaErrorInvalidValue;
+        }
         if (err == cudaSuccess && !local_src) {
             err = copy_slot_from_src(t, dst, hsrc, (cudaStream_t) stream);
         }
@@ -4016,8 +4024,30 @@ moe_cache_alias access_locked(table_t & t, int32_t expert, void * stream,
             expert_src_done(t, pool, hsrc, stream, /*retire*/ false);
         }
         if (err != cudaSuccess) {
-            GGML_LOG_WARN("%s: async fill failed table layer=%d role=%s expert=%d: %s\n",
-                          __func__, t.layer, t.role.c_str(), expert, cudaGetErrorString(cudaGetLastError()));
+            // The remap is built from expert_slot, so a slot whose bytes never arrived serves stale data: wrong output, no
+            // fault.  Undo the admission and stand the table down; the scheduler serves it from the host master.  Same
+            // rule as stew r219 (issue #274).  GGML_MOE_FILL_ROLLBACK=0: the old warn-only behaviour, A/B only.
+            static const bool rollback = [] { const char * e = getenv("GGML_MOE_FILL_ROLLBACK"); return e == nullptr || atoi(e) != 0; }();
+            (void) cudaGetLastError();   // consume it, or the next launch check aborts on this stale error
+            if (!rollback) {
+                GGML_LOG_WARN("%s: async fill failed table layer=%d role=%s expert=%d: %s\n",
+                              __func__, t.layer, t.role.c_str(), expert, cudaGetErrorString(err));
+            } else {
+                t.expert_slot.erase(expert);
+                t.slot_expert[slot] = -1;
+                t.slot_dirty = true;
+                t.count[expert] = 0;
+                t.fills--;
+                g_acc_fills--;
+                g_fill_bytes -= (int64_t) t.expert_bytes;
+                g_fill_fail++;
+                if (!t.fill_failed) {
+                    GGML_LOG_WARN("%s: fill failed table layer=%d role=%s expert=%d: %s; rolled back, the table declines from now on (%lld failed fills)\n",
+                                  __func__, t.layer, t.role.c_str(), expert, cudaGetErrorString(err), (long long) g_fill_fail);
+                }
+                t.fill_failed = true;
+                return { nullptr, false };
+            }
         }
     }
     return { (char *) t.arena + (size_t) slot * t.expert_bytes, true };
@@ -8424,6 +8454,10 @@ bool moe_cache_update_host(const ggml_tensor * weight, const ggml_tensor * weigh
     }
     std::lock_guard<std::mutex> lock(g_mutex);
     table_t & t = g_tables[table];
+    if (t.fill_failed) {
+        g_decline_all++;   // decline before anything is remapped: the scheduler still fills input_cpy
+        return false;
+    }
     t.dr_lag_n = 0;   // this path runs the policy on the current routing; a pending device-remap lag is stale
     tier_release_pending_locked(t);
     if (t.sparse_off) {
@@ -8727,6 +8761,12 @@ bool moe_cache_update_host(const ggml_tensor * weight, const ggml_tensor * weigh
         bool cold = false;
         (void) access_locked(t, e, stream, used.data(), (int) used.size(), &cold);
     }
+    if (t.fill_failed) {
+        // A fill failed in this call: pass 2 could still resolve the expert (cold read, forced admission) and take the
+        // input over, while the consumer refuses this table and would read an input_cpy nobody filled.
+        g_decline_all++;
+        return false;
+    }
     precopy_plan_locked(t, stream, used.data(), (int) used.size());
 
     // Pass 2: build the remap from the FINAL map.  Nothing evicts between here and the read.
@@ -9950,6 +9990,9 @@ static bool get_table_locked(const ggml_tensor * op, const ggml_tensor * weight_
     // slots, and the caller re-checks the remap shape, so a partially-evicted cache still serves its
     // residents.
     table_t & t = g_tables[id];
+    if (t.fill_failed) {
+        return false;   // never hand out the arena of a table whose fills failed
+    }
     // Identity fast path: slot == expert, the whole table is resident, so the arena is indexed by the
     // raw routing ids and no remap (and no per-token host routing readback) is needed.  Restricted to
     // the decode/verify band: prefill keeps the normal path (its MMQ fusions and the MMQ dispatch read
@@ -10559,7 +10602,11 @@ void moe_cache_report() {
                       (long long) g_prs_rebuilds);
     }
     GGML_LOG_INFO("%s: VRAM budget: requested=%s MiB/device, free-clamped=%lld, arena alloc failures=%lld (fail-soft)\n",
-                  __func__, budget_desc(), (long long) g_alloc_clamped, (long long) g_alloc_failed);    if (g_acc_hits + g_acc_fills + g_acc_colds > 0) {
+                  __func__, budget_desc(), (long long) g_alloc_clamped, (long long) g_alloc_failed);
+    if (g_fill_fail > 0) {
+        GGML_LOG_WARN("%s: FAILED fills: %lld, rolled back; those tables were served from the host master\n", __func__, (long long) g_fill_fail);
+    }
+    if (g_acc_hits + g_acc_fills + g_acc_colds > 0) {
         const int64_t acc   = g_acc_hits + g_acc_fills + g_acc_colds;
         const int64_t bytes = g_fill_bytes + g_cold_bytes;
         // One census op per (layer, role, device) table per token; integer division loses at most
