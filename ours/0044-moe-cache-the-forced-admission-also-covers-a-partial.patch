From 2cc71ab07f9ce347f69cd268134f92d5aeead924 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Tue, 3 Nov 2026 20:03:18 +0000
Subject: [PATCH 44/50] moe cache: the forced admission also covers a
 partial-tier table (it can decline the same way), repoints an evicted
 victim's cold pointer to the file, and leaves the slot's fill state unknown
 (GGML_MOE_FORCE_ADMIT)

---
 ggml/src/ggml-cuda/moe-expert-cache.cu | 34 +++++++++++++++++++++++++-
 1 file changed, 33 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index b755a2d70..30fa3d29d 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -4025,6 +4025,23 @@ static bool g_force_admit = [] {
     return e == nullptr || atoi(e) != 0;
 }();
 
+// A victim of force_admit_locked leaving VRAM on a tier table: with a copy-back ahead the fill waited for, it keeps that
+// exact RAM copy (as tier_swap_locked does); otherwise (a partial tier, no tier_swap) its cold pointer, which may still
+// name the RAM slot it was admitted from, goes back to the file alias.  On the compute stream, before the op.
+static void victim_cold_locked(table_t & t, int32_t victim, std::vector<table_t::precopy_t>::iterator pc, void * stream) {
+    if (pc != t.precopy.end()) {
+        const int32_t q = pc->ram;
+        moe_cache_set_ptr_kernel<<<1, 1, 0, (cudaStream_t) stream>>>(t.cold_ptrs, victim,
+                                                                    (uintptr_t) (t.ram_base + (size_t) q * t.expert_bytes));
+        t.ram_slot[(size_t) victim] = q;
+        t.precopy_idle.push_back(pc->ev);
+        t.precopy.erase(pc);
+        g_pc_used++;
+    } else if (t.ram_base != nullptr && t.cold_ptrs != nullptr) {
+        moe_cache_set_ptr_kernel<<<1, 1, 0, (cudaStream_t) stream>>>(t.cold_ptrs, victim, tier_file_ptr(t, victim));
+    }
+}
+
 static int force_admit_locked(table_t & t, int32_t expert, void * stream, const int32_t * protect, int n_protect) {
     if (t.slots <= 0 || t.arena == nullptr || t.host == nullptr || stream == nullptr || expert < 0 ||
         expert >= t.n_experts) {
@@ -4067,6 +4084,14 @@ static int force_admit_locked(table_t & t, int32_t expert, void * stream, const
     src.kind   = cudaMemcpyHostToDevice;
     src.bounce = idx;
     char * dst = (char *) t.arena + (size_t) slot * t.expert_bytes;
+    // a partial tier: the victim may have a copy-back ahead in flight from this slot (precopy_plan_locked picks by the same
+    // rule): wait for it before the fill overwrites the slot (victim_cold_locked then keeps that RAM copy)
+    const auto pc = victim >= 0 && t.ram_base != nullptr ? precopy_find(t, victim) : t.precopy.end();
+    if (pc != t.precopy.end() && cudaStreamWaitEvent((cudaStream_t) stream, pc->ev, 0) != cudaSuccess) {
+        (void) cudaGetLastError();
+        expert_src_done(t, nullptr, src, stream, /*retire*/ false);
+        return -1;
+    }
     if (copy_slot_from_src(t, dst, src, (cudaStream_t) stream) != cudaSuccess) {
         GGML_LOG_WARN("%s: bounce fill failed table layer=%d role=%s expert=%d: %s\n", __func__, t.layer, t.role.c_str(),
                       expert, cudaGetErrorString(cudaGetLastError()));
@@ -4078,6 +4103,7 @@ static int force_admit_locked(table_t & t, int32_t expert, void * stream, const
             t.slot_expert[slot] = -1;
             t.slot_dirty = true;
             t.evictions++;
+            victim_cold_locked(t, victim, pc, stream);
         }
         return -1;
     }
@@ -4086,7 +4112,9 @@ static int force_admit_locked(table_t & t, int32_t expert, void * stream, const
         t.expert_slot.erase(victim);
         t.slot_expert[slot] = -1;
         t.evictions++;
+        victim_cold_locked(t, victim, pc, stream);
     }
+    slot_seq_set_locked(t, slot, -1);   // filled on the stream outside a fence scope: copy-back ahead waits on pol_ev
     t.slot_expert[slot]   = expert;
     t.expert_slot[expert] = slot;
     t.slot_dirty          = true;
@@ -8663,7 +8691,11 @@ bool moe_cache_update_host(const ggml_tensor * weight, const ggml_tensor * weigh
     // so a small arena is fine and the decline is not needed.
     // A sparse table without a RAM tier is bounded too when the forced admission is on: it needs a slot (or a victim
     // outside this call's experts) for every routed expert it cannot register, and only this bound guarantees one.
-    const bool force = g_force_admit && t.host_sparse && t.ram_base == nullptr;
+    // A partial tier can decline the same way (every member routed, no spare free, the pin budget refusing the
+    // registration), so it is forced too, but only for shapes that fit the bound: a larger shape keeps the cold reads
+    // (a deterministic decline would send a RAM-tier table to the scheduler copy, FINDINGS 716).
+    const bool force = g_force_admit && t.host_sparse &&
+                       (t.ram_base == nullptr || (t.ram_partial && t.slots >= (int) (n_used * n_tok)));
     if ((!table_cold_ok(t) || force) && t.slots < (int) (n_used * n_tok)) {
         g_decline_all++;
         return false;
-- 
