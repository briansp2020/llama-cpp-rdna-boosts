+        return;
+    }
+    if (e < (int32_t) t.ghost.size() && (int64_t) t.ghost[(size_t) e] < kvl_borrow_touch()) {
+        return;
+    }
+    kvl_stream_init_locked(t);
+    if (kvl_stream(t.device) == nullptr || stream != kvl_stream(t.device)) {
+        return;
+    }
+    kvl_build_locked();
+    if (g_kvl_slots.empty() || t.expert_bytes > g_kvl_slot_bytes) {
