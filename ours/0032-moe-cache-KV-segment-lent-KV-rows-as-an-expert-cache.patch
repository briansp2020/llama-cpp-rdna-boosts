+static int64_t g_kvl_borrows = 0;
+static void kvl_borrow_locked(table_t & t, int32_t e, void * stream) {
+    if (kvl_seg_on() || !kvl_borrow_on() || !g_kvl_in_decode || e < 0 || e >= t.n_experts || !kvl_eligible(t)) {
+        return;
