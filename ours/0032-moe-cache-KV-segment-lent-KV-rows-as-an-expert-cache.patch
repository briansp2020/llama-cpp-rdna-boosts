+        if (sl.table < 0 && !kt.pf && kt.device == device && kvl_avail(sl) && (int) i != g_kvl_pin && !fb_kv_busy((int) i)) {
+            cur = (i + 1) % n;
+            return (int) i;
+        }
+    }
+    return -1;
