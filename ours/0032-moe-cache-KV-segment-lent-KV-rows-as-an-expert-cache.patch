+static void kvl_seg_quota_locked() {
+    int n_tab[16] = {}, n_free[16] = {};
+    for (const table_t & o : g_tables) {
+        if (kvl_eligible(o) && o.device >= 0 && o.device < 16 && o.expert_bytes <= g_kvl_slot_bytes &&
+            (int) heat_rank_vec(o).size() == o.n_experts && kvl_stream(o.device) != nullptr && o.dr_last_stream == kvl_stream(o.device)) {
+            n_tab[o.device]++;
+        }
+    }
+    for (const kvl_slot_t & sl : g_kvl_slots) {
+        const kvl_tensor_t & kt = g_kvl_tensors[(size_t) sl.tensor];
+        if (!kt.pf && kt.device >= 0 && kt.device < 16 && kvl_avail(sl)) {
+            n_free[kt.device]++;
+        }
+    }
+    for (int d = 0; d < 16; d++) {
+        g_kvl_quota[d]     = n_tab[d] > 0 ? n_free[d] / n_tab[d] : 0;
+        g_kvl_quota_str[d] = kvl_stream(d) != nullptr;
