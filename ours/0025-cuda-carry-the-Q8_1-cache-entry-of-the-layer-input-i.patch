(cherry picked from commit eae5fc08fefa2033fabbe50a4afdd10ba041e935)
(cherry picked from commit e7926f6f7612f63348bac293e554433f6df7dc65)
(cherry picked from commit bc3c9637edacd7440d84abd647c28db5d63bfb24)
(cherry picked from commit f41b73ffb27d3f9f689df72db4c70605ed319878)
---
 ggml/src/ggml-cuda/common.cuh   |  18 ++++-
 ggml/src/ggml-cuda/ggml-cuda.cu | 126 +++++++++++++++++++++++++++++++-
 ggml/src/ggml-cuda/graph.cuh    |   4 +
 ggml/src/ggml-cuda/hc-mix.cu    |   1 +
 4 files changed, 146 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index b6f926aef2..b3495d99de 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1868,6 +1868,8 @@ struct ggml_backend_cuda_context {
     // tensor is written once and its data is immutable until the next graph.
     // Cleared at graph start; entries are also keyed by the stream they were
     // quantized on, so forked streams never read unsynchronized data.
+    // Exception: the Q8_1 carry (ggml-cuda.cu) re-enters one exact entry of the
+    // previous compute into a routed-MoE split that reads it.
     struct q8_1_cache_entry {
         const ggml_tensor * src1 = nullptr;
         const void * data = nullptr;
@@ -1881,7 +1883,14 @@ struct ggml_backend_cuda_context {
         int64_t s13 = 0;
         size_t offset = 0;
         size_t size   = 0;
+        // Q8_1 carry (ggml_cuda_q8_1_carry_*): `abs` set = an entry carried in from the previous compute (its
+        // absolute address; `offset` unused); `exact` = written byte-identically to quantize_q8_1 by a producer
+        // of this compute, the only entries that may be carried out.
+        const char * abs = nullptr;
+        bool exact = false;
     };
+    // entries the previous graph_compute on this ctx produced and may hand to the next one (see ggml-cuda.cu)
+    std::vector<q8_1_cache_entry> q8_1_carry_out;
     char * q8_1_arena = nullptr;
     size_t q8_1_arena_size = 0;
     std::vector<char *> q8_1_arena_retired;
@@ -2049,7 +2058,7 @@ struct ggml_backend_cuda_context {
             }
             if (same) {
                 found = true;
-                return q8_1_arena + e.offset;
+                return e.abs != nullptr ? (void *) e.abs : (void *) (q8_1_arena + e.offset);
             }
         }
         found = false;
@@ -2082,6 +2091,13 @@ struct ggml_backend_cuda_context {
         return data;
     }
 
+    // the producer of the entry just allocated by q8_1_cache_get (found == false) writes it byte-identically to
+    // quantize_q8_1 (d and d*sum of the integer quants), so a later compute may reuse it (Q8_1 carry)
+    void q8_1_cache_mark_exact() {
+        GGML_ASSERT(!q8_1_cache.empty() && q8_1_cache.back().abs == nullptr);
+        q8_1_cache.back().exact = true;
+    }
+
     // Stale-source-pointer guard for the on-the-fly Q8_1 quantize / fused-write launches: the
     // source read range (the tensor's own ne/nb extent) must lie within the root tensor's
     // buffer allocation.  A compute buffer that is reallocated while a cache entry still
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index ae51538386..1155699d70 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -9141,11 +9141,15 @@ static bool ggml_cuda_graph_is_multi_token(const ggml_cgraph * cgraph) {
 // tokens, i.e. 93 % of calls ran the node loop directly and `GGML_CUDA_DISABLE_GRAPHS=1` measured the
 // same speed.  Counters only; they cost two increments per call.
 static int64_t g_gc_n_direct = 0, g_gc_n_replay = 0, g_gc_n_capture = 0, g_gc_n_propchg = 0;
+// recaptures forced only by the Q8_1 carry signature: carry appeared, disappeared, or moved
+static int64_t g_gc_n_q8_new = 0, g_gc_n_q8_gone = 0, g_gc_n_q8_moved = 0;
 
 static void ggml_cuda_graph_stats_report() {
     fprintf(stderr, "%s: graph_compute calls: direct=%lld replay=%lld capture=%lld properties_changed=%lld\n",
             __func__, (long long) g_gc_n_direct, (long long) g_gc_n_replay, (long long) g_gc_n_capture,
             (long long) g_gc_n_propchg);
+    fprintf(stderr, "%s: q8 carry recaptures: new=%lld gone=%lld moved=%lld\n",
+            __func__, (long long) g_gc_n_q8_new, (long long) g_gc_n_q8_gone, (long long) g_gc_n_q8_moved);
 }
 
 static void ggml_cuda_graph_stats_arm() {
@@ -9803,6 +9807,111 @@ static bool ggml_cuda_graph_set_enabled(ggml_backend_cuda_context * cuda_ctx, gg
 
 
 
+// Q8_1 carry across the routed-MoE split (FINDINGS 1010/1011).  A decode/verify layer runs as three computes
+// per device; the scheduler splits before the layer's first routed MUL_MAT_ID (expert-cache staging, #129), and
+// the Q8_1 cache is cleared per compute, so the routed MoE re-quantized the layer input that the hc mixer had
+// just written to the cache.  The previous compute hands its exact entries (written byte-identically to
+// quantize_q8_1, see q8_1_cache_mark_exact) to the next; a compute whose first node is a routed MUL_MAT_ID
+// takes the one entry for that node's activation, if the previous compute produced it.  Captured graphs bake the
+// carried address in: a replay records the entries its capture produced (ggml_cuda_graph::q8_out), and a graph
+// is recaptured when the carried entry differs from the one it was captured with (q8_carry_sig).
+// GGML_CUDA_Q8_1_CARRY=0: off.  GGML_CUDA_Q8_1_CARRY_LOG=1: report the first carries.
+static bool ggml_cuda_q8_1_carry_enabled() {
+    // the retired-arena keep-alive is what keeps a carried address valid across an arena growth
+    static const bool on = [] {
+        const char * e = getenv("GGML_CUDA_Q8_1_CARRY");
+        return (e == nullptr || atoi(e) != 0) && getenv("GGML_CUDA_Q8_1_ARENA_FREE_OLD") == nullptr;
+    }();
+    return on;
+}
+
+// returns the carried entry's signature (0 = nothing carried)
+static uint64_t ggml_cuda_q8_1_carry_in(ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph) {
+    std::vector<ggml_backend_cuda_context::q8_1_cache_entry> prev;
+    prev.swap(ctx->q8_1_carry_out);   // only ever from the immediately preceding compute on this ctx
+    if (prev.empty() || !ggml_cuda_q8_1_carry_enabled() || cgraph->n_nodes == 0) {
+        return 0;
+    }
+    const ggml_tensor * n0 = cgraph->nodes[0];
+    if (n0->op != GGML_OP_MUL_MAT_ID || n0->src[1] == nullptr || ggml_cuda_graph_is_multi_token(cgraph)) {
+        return 0;
+    }
+    // the cache key the mmvq MUL_MAT_ID launcher uses for src1
+    const ggml_tensor * key = n0->src[1];
+    while (key->view_src != nullptr && n0->src[1]->data == key->data) {
+        key = key->view_src;
+    }
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        if (cgraph->nodes[i] == key) {
+            return 0;   // computed in this compute: not the previous compute's output
+        }
+    }
+    for (const auto & e : prev) {
+        // pointers first: a replay's record holds capture-time tensor pointers, never dereferenced
+        if (e.src1 != key || e.stream_no != 0 || e.data != key->data) {
+            continue;
+        }
+        ggml_backend_cuda_context::q8_1_cache_entry c = e;
+        c.exact = false;   // never carried on again
+        ctx->q8_1_cache.push_back(c);
+        if (c.abs >= ctx->q8_1_arena && c.abs < ctx->q8_1_arena + ctx->q8_1_arena_size) {
+            // this compute's own entries go past it
+            ctx->q8_1_arena_pos = std::max(ctx->q8_1_arena_pos, (size_t) (c.abs - ctx->q8_1_arena) + c.size);
+        }
+        uint64_t h = 1469598103934665603ull;
+        const uint64_t v[] = { (uint64_t) (uintptr_t) c.src1, (uint64_t) (uintptr_t) c.data, (uint64_t) (uintptr_t) c.abs,
+                               (uint64_t) c.size, (uint64_t) c.ne10, (uint64_t) c.ne11, (uint64_t) c.ne12, (uint64_t) c.ne13,
+                               (uint64_t) c.s11, (uint64_t) c.s12, (uint64_t) c.s13 };
+        for (uint64_t x : v) {
+            h = (h ^ x) * 1099511628211ull;
+        }
+        static const bool log = getenv("GGML_CUDA_Q8_1_CARRY_LOG") != nullptr;
+        static std::atomic<int64_t> n_carry {0};
+        const int64_t n = n_carry.fetch_add(1, std::memory_order_relaxed);
+        if (log && (n < 8 || n % 100000 == 0)) {
+            GGML_LOG_WARN("%s: device %d: carry #%lld %s -> %s (%lld x %lld) at %p\n", __func__, ctx->device, (long long) n,
+                          key->name, n0->name, (long long) c.ne10, (long long) (c.ne11*c.ne12*c.ne13), (const void *) c.abs);
+        }
+        return h != 0 ? h : 1;
+    }
+    return 0;
+}
+
+// what this compute hands to the next: the exact entries it produced (a replay: the ones its capture produced)
+static void ggml_cuda_q8_1_carry_out(ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph, const char * arena0,
+                                     bool use_cuda_graph, bool cuda_graph_update_required, ggml_cuda_graph * graph) {
+    ctx->q8_1_carry_out.clear();
+    if (!ggml_cuda_q8_1_carry_enabled()) {
+        return;
+    }
+#ifdef USE_CUDA_GRAPH
+    if (use_cuda_graph && !cuda_graph_update_required) {
+        ctx->q8_1_carry_out = graph->q8_out;
+        return;
+    }
+#else
+    GGML_UNUSED(graph);
+    GGML_UNUSED(cuda_graph_update_required);
+#endif
+    // an arena growth during the compute moved the live entries (copy) - carry nothing from it
+    if (!ggml_cuda_graph_is_multi_token(cgraph) && ctx->q8_1_arena == arena0) {
+        for (const auto & e : ctx->q8_1_cache) {
+            if (e.exact && e.abs == nullptr && e.stream_no == 0) {
+                ggml_backend_cuda_context::q8_1_cache_entry c = e;
+                c.abs = ctx->q8_1_arena + e.offset;
+                ctx->q8_1_carry_out.push_back(c);
+            }
+        }
+    }
+#ifdef USE_CUDA_GRAPH
+    if (use_cuda_graph) {
+        graph->q8_out = ctx->q8_1_carry_out;   // captured: what its replays produce
+    }
+#else
+    GGML_UNUSED(use_cuda_graph);
+#endif
+}
+
 static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend, ggml_cgraph * cgraph) {
     const cuda_gc_timer cuda_gc_timer_inst(cgraph);
     int64_t t_gc = g_cgc_on ? ggml_time_us() : 0;
@@ -9819,9 +9928,12 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
             cuda_ctx->device, (void *) cuda_ctx->stream(), cgraph->n_nodes ? cgraph->nodes[0]->name : "-", cgraph->n_nodes);
     }
 
-    // The Q8_1 input cache is only valid within one graph execution, and so is the shared FA KV-group bitmap.
+    // The Q8_1 input cache is only valid within one graph execution, and so is the shared FA KV-group bitmap...
     cuda_ctx->q8_1_cache_clear();
     ggml_cuda_fattn_new_graph_eval(*cuda_ctx);
+    // ...except the one carried Q8_1 entry (0 = none; a captured graph is recaptured when it changes)
+    const uint64_t q8_carry_sig = ggml_cuda_q8_1_carry_in(cuda_ctx, cgraph);
+    const char * const q8_arena0 = cuda_ctx->q8_1_arena;
     cuda_ctx->mwr_done_graph = nullptr;
     cuda_ctx->bf16_src1_cache_clear();
     ggml_cuda_mmb_set_active_ctx(cuda_ctx);
@@ -9940,9 +10052,16 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
                     // and one whose MoE redirect choice changed (a table declined or took over since its capture;
                     // GGML_CUDA_GRAPH_MOE_SIG=0 disables the check, A/B only)
                     static const bool moe_sig_check = [] { const char * e = getenv("GGML_CUDA_GRAPH_MOE_SIG"); return !e || atoi(e) != 0; }();
-                    cuda_graph_update_required = graph->instances.empty() ||
+                    // and one whose carried Q8_1 entry (address, layout) differs from the one it was captured with:
+                    // its replay reads the carried buffer at the captured address (never disabled: correctness)
+                    const bool other_update = graph->instances.empty() ||
                         (mem_gen_check && graph->mem_gen != ggml_cuda_graph_mem_gen(cuda_ctx->device)) ||
                         (moe_sig_check && graph->moe_sig != moe_cache_redirect_sig(cgraph, cuda_ctx->device));
+                    const bool q8_update = graph->q8_carry_sig != q8_carry_sig;
+                    if (q8_update && !other_update) {
+                        (graph->q8_carry_sig == 0 ? g_gc_n_q8_new : q8_carry_sig == 0 ? g_gc_n_q8_gone : g_gc_n_q8_moved)++;
+                    }
+                    cuda_graph_update_required = other_update || q8_update;
                 }
             }
 
@@ -9994,6 +10113,7 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
         graph->mem_gen = ggml_cuda_graph_mem_gen(cuda_ctx->device);
         cuda_ctx->capturing = true;   // no arena growth / synchronising allocation may happen from here
         graph->moe_sig = moe_cache_redirect_sig(cgraph, cuda_ctx->device);
+        graph->q8_carry_sig = q8_carry_sig;
         CUDA_CHECK(cudaStreamBeginCapture(cuda_ctx->stream(), cudaStreamCaptureModeRelaxed));
     }
 
@@ -10003,6 +10123,8 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
     cuda_ctx->capturing = false;
     if (t_gc) { g_ev_rest_us += ggml_time_us() - g_loop_start; }
 
+    ggml_cuda_q8_1_carry_out(cuda_ctx, cgraph, q8_arena0, use_cuda_graph, cuda_graph_update_required, graph);
+
     ggml_cuda_mmb_compute_done();
     return GGML_STATUS_SUCCESS;
 }
