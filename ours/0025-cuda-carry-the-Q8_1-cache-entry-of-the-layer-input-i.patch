index b63986114b..4d7d0fdbda 100644
--- a/ggml/src/ggml-cuda/hc-mix.cu
+++ b/ggml/src/ggml-cuda/hc-mix.cu
@@ -1925,6 +1925,7 @@ static void ggml_cuda_op_hc_mix_q8(ggml_backend_cuda_context & ctx, ggml_tensor
                                       n_embd, n_tokens, 1, 1, mixed_stride_t, mixed_stride_t*n_tokens, mixed_stride_t*n_tokens, found);
         if (!found) {
             q8 = (block_q8_1 *) p;
+            ctx.q8_1_cache_mark_exact(); // d, d*isum like quantize_q8_1: may be carried into the routed-MoE split
