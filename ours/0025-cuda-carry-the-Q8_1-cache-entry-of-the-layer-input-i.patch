--- a/ggml/src/ggml-cuda/graph.cuh
+++ b/ggml/src/ggml-cuda/graph.cuh
@@ -66,6 +66,10 @@ struct ggml_cuda_graph {
     uint64_t mem_gen = 0;
     // moe_cache_redirect_sig() when it was captured: which MoE ops the capture redirected onto an expert-cache arena
     uint64_t moe_sig = 0;
+    // Q8_1 carry (ggml-cuda.cu): the signature of the entry carried in when this graph was captured (0 = none),
+    // and the exact entries the capture produced, which a replay hands to the next compute
+    uint64_t q8_carry_sig = 0;
+    std::vector<ggml_backend_cuda_context::q8_1_cache_entry> q8_out;
     // What a replay bakes in, per node, packed to the sources the node actually has.  The compare that
     // guards a replay is O(nodes) and runs on EVERY graph_compute (the scheduler mints a fresh
     // `cgraph->uid` per split, so the `uid` early-out in ggml_cuda_graph_update_required cannot fire),
