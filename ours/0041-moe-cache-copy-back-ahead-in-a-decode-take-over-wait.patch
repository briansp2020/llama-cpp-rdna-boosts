     void *      mark_stream    = nullptr;   // the stream the deferred work went to
+    // Per arena slot, when its last fill is known to have landed (copy-back ahead reads the slot on the side stream):
+    // 0 = complete (a synchronous fill), > 0 = once the lag flag reaches that value, -1 = unknown (the side stream
+    // waits on pol_ev, as before), -2 = filled in the open decode take-over (not yet committed).  Missing = -1.
+    std::vector<int32_t> slot_seq;
+    std::vector<int32_t> defer_slots;       // slots at -2: the commit gives them its seq, a flush makes them -1
     // Copy-back ahead (GGML_MOE_TIER_PRECOPY): spare RAM slots that already hold a copy of a resident the policy is likely
     // to evict next (D2H on the device's side stream, done when `ev` fires), so its admission needs no D2H on the compute
     // stream.  The copy stays valid while the expert is resident (weights never change); an entry is consumed by the swap
@@ -965,6 +970,9 @@ static const bool g_fill_fence = [] {
 }();
 static const void * g_defer_tab = nullptr;   // the table whose decode take-over defers its markers (else none)
 static int64_t g_fence_commits = 0, g_fence_flushes = 0;
+static int64_t g_pc_polev = 0;   // precopy plans that still waited on the compute stream (pol_ev)
+static bool    fence_done_locked(const table_t & t, int32_t seq);
+static int32_t slot_seq_get_locked(const table_t & t, int slot);
 static int64_t g_pc_waited = 0;   // admissions whose precopy had not completed yet (the GPU waited for it)
 // GGML_MOE_TIER_PRECOPY=0: no copy-back ahead (each swap copies its victim back on the compute stream, as before).
 static const bool g_precopy = [] {
@@ -1710,8 +1718,10 @@ static void precopy_plan_locked(table_t & t, void * stream, const int32_t * prot
         }
     }
 
-    cudaStream_t ss    = nullptr;
-    int          n_new = 0;
+    cudaStream_t ss     = nullptr;
+    int          n_new  = 0;
+    bool         waited = false;
+    const bool   fenced = g_defer_tab == &t;   // only a decode take-over defers (GGML_MOE_FILL_FENCE)
     for (const int32_t e : cand) {
         if (n_new >= 2) {
             break;   // bounds the hook's host time per call; later calls continue
@@ -1726,17 +1736,30 @@ static void precopy_plan_locked(table_t & t, void * stream, const int32_t * prot
         if (rs == t.expert_slot.end() || rs->second < 0) {
             continue;
         }
+        // GGML_MOE_FILL_FENCE, decode take-over: a slot whose fill the lag flag shows landed needs no wait
+        bool need_wait = true;
+        if (fenced) {
+            const int32_t q = slot_seq_get_locked(t, rs->second);
+            if (q == -2 || (q > 0 && !fence_done_locked(t, q))) {
+                continue;   // filled in this take-over or not landed yet: a later call copies it
+            }
+            need_wait = q == -1;
+        }
         if (ss == nullptr) {
             ss = precopy_stream(t.device);
             if (ss == nullptr) {
                 return;
             }
+        }
+        if (need_wait && !waited) {
             if ((t.pol_ev == nullptr && cudaEventCreateWithFlags(&t.pol_ev, cudaEventDisableTiming) != cudaSuccess) ||
                 cudaEventRecord(t.pol_ev, (cudaStream_t) stream) != cudaSuccess ||
                 cudaStreamWaitEvent(ss, t.pol_ev, 0) != cudaSuccess) {
                 (void) cudaGetLastError();
                 return;
             }
+            waited = true;
+            g_pc_polev++;
         }
         cudaEvent_t ev = nullptr;
         if (!t.precopy_idle.empty()) {
@@ -1950,8 +1973,26 @@ static bool fence_done_locked(const table_t & t, int32_t seq) {
     const uint32_t v = (uint32_t) __atomic_load_n(&t.dr_lag_host[t.dr_cap], __ATOMIC_ACQUIRE);
     return (int32_t) (v - (uint32_t) seq) >= 0;
 }
+static void slot_seq_set_locked(table_t & t, int slot, int32_t v) {
+    if (slot < 0) {
+        return;
+    }
+    if ((size_t) slot >= t.slot_seq.size()) {
+        t.slot_seq.resize((size_t) slot + 1, -1);
+    }
+    t.slot_seq[(size_t) slot] = v;
+}
+static int32_t slot_seq_get_locked(const table_t & t, int slot) {
+    return slot >= 0 && (size_t) slot < t.slot_seq.size() ? t.slot_seq[(size_t) slot] : -1;
+}
 // Deferred swaps / map upload that no launch will cover: record their events now (on the stream they went to).
 static void fence_flush_locked(table_t & t) {
+    for (int32_t sl : t.defer_slots) {
+        if (slot_seq_get_locked(t, sl) == -2) {
+            slot_seq_set_locked(t, sl, -1);   // its fill is covered by swap_ev only: the side stream waits on pol_ev
+        }
+    }
+    t.defer_slots.clear();
     if (!t.swap_defer && !t.map_defer) {
         return;
     }
@@ -1970,6 +2011,12 @@ static void fence_flush_locked(table_t & t) {
 }
 // The remap launch that writes lag flag value `seq` covers the deferred work.
 static void fence_commit_locked(table_t & t, int32_t seq) {
+    for (int32_t sl : t.defer_slots) {
+        if (slot_seq_get_locked(t, sl) == -2) {
+            slot_seq_set_locked(t, sl, seq);
+        }
+    }
+    t.defer_slots.clear();
     g_fence_commits += t.swap_defer || t.map_defer;
     if (t.swap_defer) {
         t.swap_defer = false; t.swap_mark_flag = true; t.swap_mark_seq = seq;
@@ -3854,6 +3901,12 @@ moe_cache_alias access_locked(table_t & t, int32_t expert, void * stream,
     t.slot_expert[slot] = expert;
     t.expert_slot[expert] = slot;
     t.slot_dirty = true;
+    if (g_defer_tab == &t) {
