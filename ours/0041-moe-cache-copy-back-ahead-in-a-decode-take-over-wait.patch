 ggml/src/ggml-cuda/moe-expert-cache.cu | 72 ++++++++++++++++++++++++--
 1 file changed, 68 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index 8b2fc2b09..d3804b5b6 100644
