From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Thu, 19 Nov 2026 08:11:21 +0000
Subject: [PATCH 39/49] cuda/hip: keep prompt GEMMs off hipBLASLt (one result
 per input)

On ROCm, rocBLAS hands GEMMs to hipBLASLt by default, and hipBLASLt returned
one of two different results for bit-identical inputs, the choice made once
per process: the same prompt gave two distinct outputs across server starts
(the MoE router GEMM at 41..266 tokens first, then the next hipBLAS GEMM in
graph order once the router was moved).

- MMB F32 split tile: own token floor (GGML_CUDA_MMB_F32SPLIT_MIN_T, RDNA4
  default MMVF_MAX_BATCH_SIZE_FLAT + 1 = 33, never lower), so the whole
  prompt band of the router runs on our deterministic tile instead of
  hipBLAS; src1 ne[1] <= 32 stays on MMVF. =512 restores the old floor.
- ggml_cuda_init: default ROCBLAS_USE_HIPBLASLT=0 (the Tensile path of
  rocBLAS itself) before the first handle; an explicit ROCBLAS_USE_HIPBLASLT
  wins, GGML_CUDA_HIPBLASLT=1 keeps the rocBLAS default.

10/10 server starts give one output (was 2 outcomes); KLD vs the old path
0.0109 (ub 256) / 0.0100 (ub 4096), rounding level.

(cherry picked from commit ffb81dfb94dcbb109cdd3c8727ace22495d7bd15)
(cherry picked from commit 805e7fb4a8955f912ed0f86f7cb741567f8e9afd)
(cherry picked from commit 75227992feaae5cdec6b62dded4847d51051eb96)
(cherry picked from commit ea4cbbeacf7f10bc4840aa094b36e6bef5f4964b)
(cherry picked from commit 38fc7805486027e6509b940a983326c2e90f1760)
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 26 +++++++++++++++++++++++---
 ggml/src/ggml-cuda/mmb.cu       | 23 +++++++++++++++++++----
 2 files changed, 42 insertions(+), 7 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 286800923d..e10e982f53 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -571,6 +571,26 @@ static int ggml_cuda_parse_id(const char * devName) {
 static ggml_cuda_device_info ggml_cuda_init() {
     ggml_cuda_device_info info = {};
 
+#if defined(GGML_USE_HIP)
+    // FINDINGS 1020: rocBLAS hands GEMMs to hipBLASLt by default, and hipBLASLt returned one of two different
+    // results for bit-identical inputs (the choice made once per process) -- the same prompt gave two distinct
+    // outputs across server starts.  rocBLAS's own Tensile path was single-outcome (FINDINGS 1019, 12 starts).
+    // Default it off before the first rocBLAS handle exists; an explicit ROCBLAS_USE_HIPBLASLT in the
+    // environment still wins, and GGML_CUDA_HIPBLASLT=1 keeps rocBLAS's default (kill switch).
+    {
+        const char * lt = getenv("GGML_CUDA_HIPBLASLT");
+        if (lt == nullptr || atoi(lt) == 0) {
+#if defined(_WIN32)
+            if (getenv("ROCBLAS_USE_HIPBLASLT") == nullptr) {
+                _putenv_s("ROCBLAS_USE_HIPBLASLT", "0");
+            }
+#else
+            setenv("ROCBLAS_USE_HIPBLASLT", "0", /*overwrite =*/ 0);
+#endif
+        }
+    }
+#endif // defined(GGML_USE_HIP)
+
     cudaError_t err = cudaGetDeviceCount(&info.physical_device_count);
     if (err != cudaSuccess) {
         GGML_LOG_ERROR("%s: failed to initialize " GGML_CUDA_NAME ": %s\n", __func__, cudaGetErrorString(err));
@@ -7504,9 +7524,9 @@ static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor
     // MMB: bf16-WMMA dequant weight GEMM (pwilkin strix-halo port). Prefill-only: the predicate
     // requires T >= GGML_CUDA_MMB_MIN_T (default 512), so the whole decode/verify band
     // (n_tokens <= 8) stays on the existing kernels and W = 1..8 is bit-identical either way.
-    // BF16 dense weights on RDNA4 take MMB from 33 tokens (MMVF_MAX_BATCH_SIZE_FLAT + 1) while hipBLASLt is
-    // off (ROCBLAS_USE_HIPBLASLT=0): rocBLAS's own Tensile kernels are much slower on these shapes
-    // (GGML_CUDA_MMB_BF16_DENSE / GGML_CUDA_MMB_BF16_MIN_T).
+    // The F32 split tile has its own floor (GGML_CUDA_MMB_F32SPLIT_MIN_T, RDNA4 default 33 =
+    // MMVF_MAX_BATCH_SIZE_FLAT + 1) -- it replaces hipBLAS(Lt) for the prompt band (FINDINGS 1020); so do
+    // BF16 dense weights on RDNA4 while hipBLASLt is off (GGML_CUDA_MMB_BF16_DENSE / _BF16_MIN_T).
     if (ggml_cuda_mmb_supported_mm(src0, src1, dst)) {
         MMB_T(ggml_cuda_mul_mat_mmb(ctx, src0, src1, dst), 0);
         return;
diff --git a/ggml/src/ggml-cuda/mmb.cu b/ggml/src/ggml-cuda/mmb.cu
index 62f6c3a191..fbc1fc0a45 100644
--- a/ggml/src/ggml-cuda/mmb.cu
+++ b/ggml/src/ggml-cuda/mmb.cu
@@ -1534,6 +1534,7 @@ struct mmb_arch_cfg {
     int  f32split_mode  = 1;     // 0 off, 1 shape-aware, 2 every F32 GEMM through mmb
     int  f32split_min_k = 0;
     int  f32split_min_m = 128;   // the MoE router (M=512) wins on mmb; the M=4 inject pair does not
+    int  f32split_min_t = 512;   // n_tokens >= this may take the F32 split tile (see mmb_f32split_min_t)
     int  cache_max      = 4;     // activation-conversion cache entries
     int  shadow_mode    = 0;     // bf16 weight shadow
     int  shadow_cap_mb  = 6144;
@@ -1579,6 +1580,11 @@ static mmb_arch_cfg mmb_arch_defaults(const int cc) {
         // wip/mmb-general/gfx1201-s13-f32-hc16.md.
         c.f32split_mode = 1;
         c.tiny_m       = 1;
+        // FINDINGS 1020: below min_t the F32 router GEMM (M=512) went to hipBLAS, which on ROCm
+        // hands it to hipBLASLt, and hipBLASLt returned one of two different results for
+        // bit-identical inputs (picked once per process) -- two distinct outputs for the same
+        // prompt.  Keep the whole prompt band on our deterministic split tile instead.
+        c.f32split_min_t = MMVF_MAX_BATCH_SIZE_FLAT + 1;
         // BF16 dense weights (qwen4exp hc mixer, BF16 router, shared-expert gate): with hipBLASLt off
         // (ROCBLAS_USE_HIPBLASLT=0, the determinism control) these GEMMs run on rocBLAS's own Tensile kernels,
         // which cost a GSQ IQ3_S Flash-Next about a third of its prefill.  mmb_dense_flag() stays off on RDNA4
@@ -1906,6 +1912,13 @@ bool mmb_f32split() { return mmb_f32split_mode() != 0; }
 // Defaults: MIN_M = 128 (the router; measured 2.4x better on MMB) and MIN_K = 0 (disabled -- the
 // long-K hc inject pair is *worse* on MMB despite the WMMA path; see the table above).
 int mmb_f32split_min_k() { return mmb_policy<int>([](int d) { const char * e = getenv("GGML_CUDA_MMB_F32SPLIT_MIN_K"); return e ? atoi(e) : mmb_cfg_for_device(d).f32split_min_k; }); }
+// Lowest n_tokens for the F32 split tile.  Never below MMVF_MAX_BATCH_SIZE_FLAT + 1: the decode/verify
+// band (and the flattened QSA indexer band) must stay on MMVF, which ggml_cuda_mul_mat only reaches
+// when MMB declines.  GGML_CUDA_MMB_F32SPLIT_MIN_T=512 restores the old behaviour (kill switch).
+static int mmb_f32split_min_t() {
+    const int v = mmb_policy<int>([](int d) { const char * e = getenv("GGML_CUDA_MMB_F32SPLIT_MIN_T"); return e ? atoi(e) : mmb_cfg_for_device(d).f32split_min_t; });
+    return v > MMVF_MAX_BATCH_SIZE_FLAT ? v : MMVF_MAX_BATCH_SIZE_FLAT + 1;
+}
 int mmb_f32split_min_m() { return mmb_policy<int>([](int d) { const char * e = getenv("GGML_CUDA_MMB_F32SPLIT_MIN_M"); return e ? atoi(e) : mmb_cfg_for_device(d).f32split_min_m; }); }
 // tiny-M F32 (the hc *_inject pair): M=hc=4, K=10240.  Neither tile suits it (see
 // mmb_tiny_m_f32_kernel), so it gets its own warp-per-token kernel.  This has to be part of the
@@ -2293,13 +2306,15 @@ bool ggml_cuda_mmb_supported_mm(const ggml_tensor * src0, const ggml_tensor * sr
     if (f32cand && !f32w) return false;   // this F32 shape is better on rocBLAS -- no fusion stand-down either
     if ((f32cand ? K % 32 : K % 64) != 0 || src1->ne[0] != K || dst->ne[0] != M) return false;
     if ((src0->type == GGML_TYPE_Q4_K || src0->type == GGML_TYPE_Q5_K || src0->type == GGML_TYPE_Q6_K || src0->type == GGML_TYPE_Q3_K || src0->type == GGML_TYPE_IQ4_XS || src0->type == GGML_TYPE_IQ3_S || src0->type == GGML_TYPE_IQ3_XXS || src0->type == GGML_TYPE_IQ2_S || src0->type == GGML_TYPE_IQ2_XS || src0->type == GGML_TYPE_IQ2_XXS) && K % 256 != 0) return false;   // whole 256-value super-blocks
-    // BF16 dense weights where mmb_bf16_dense() routes them have their own floor (mmb_bf16_min_t); every
-    // other MMB GEMM keeps min_t.
+    // the F32 split tile has its own floor (mmb_f32split_min_t), and so do BF16 dense weights where
+    // mmb_bf16_dense() routes them (mmb_bf16_min_t); every other MMB GEMM -- the tiny-M F32 kernel included --
+    // keeps min_t.
+    const bool f32split_path = f32cand && !mmb_tiny_m_f32_ok(K, M);
     const bool bf16_path = src0->type == GGML_TYPE_BF16 && mmb_bf16_dense();
-    const int64_t t_min = bf16_path ? mmb_bf16_min_t() : mmb_min_t();
+    const int64_t t_min = f32split_path ? mmb_f32split_min_t() : bf16_path ? mmb_bf16_min_t() : mmb_min_t();
     if (T < t_min || T > INT32_MAX / 4) return false;
     // ggml_cuda_mul_mat keys its MMVF band on ne11 alone; a 3D/4D src1 must not leave it via T.
-    if (bf16_path && src1->ne[1] <= MMVF_MAX_BATCH_SIZE_FLAT) return false;
+    if ((f32split_path || bf16_path) && src1->ne[1] <= MMVF_MAX_BATCH_SIZE_FLAT) return false;
     return ggml_nrows(dst) == T;
 }
 
