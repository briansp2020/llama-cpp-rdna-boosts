+            const int k = std::min(t.slots, t.n_experts);
+            if (k > 0 && sparse_stage_fill_locked(t, k)) {
+                for (int i = 0; i < k; i++) {
+                    t.slot_expert[i] = i;
+                    t.expert_slot[i] = i;
+                    slot_seq_set_locked(t, i, 0);   // synchronous staged fill
+                    if (i < (int) t.slot_prov.size()) {
