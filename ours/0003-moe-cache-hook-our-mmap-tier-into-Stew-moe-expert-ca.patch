+
+    t.misses++;
+    // Every miss is a touch of an expert we do NOT hold, i.e. demand we are not serving.  The
+    // admission rules below compare this demand against the value a resident has demonstrated
+    // (`count`).  Counting the current touch in BEFORE the decision is what makes the rules
+    // non-degenerate: without it a never-resident expert would always look like zero demand.
+    if (expert >= 0 && expert < (int32_t) t.ghost.size()) {
+        t.ghost[expert]++;
+    }
+
+    if (t.slots <= 0) {
+        if (cold_ok && out_cold != nullptr) {
+            *out_cold = true;
+            g_acc_colds++;
+            g_cold_bytes += (int64_t) t.expert_bytes;
+        }
+        return { nullptr, false };
+    }
+    if (t.ram_base != nullptr && stream == nullptr) {
+        return { nullptr, false };   // a RAM-tier swap must be ordered with the readers (compute stream)
+    }
+    int     slot   = -1;
+    int32_t victim = -1;   // arena resident evicted by this miss (also fetched into the pool: additive)
+    if ((int) t.expert_slot.size() < t.slots) {
+        for (int s = 0; s < t.slots; s++) {
+            if (t.slot_expert[s] < 0) { slot = s; break; }
+        }
+    }
+    // KV lending: with no free slot, an expert whose victim copy cold_ptrs already names is read from VRAM as it is
+    // (no eviction, no fill); the victims' stream only, so its cold pointer is ordered with this call's kernel.
+    if (slot < 0 && cold_ok && out_cold != nullptr && kvl_on() && kvl_stay_on() && g_kvl_in_decode && stream == g_kvl_stream &&
+        expert >= 0 && expert < (int32_t) kvl_kvv(t).size() && kvl_kvv(t)[(size_t) expert] >= 0) {
+        g_kvl_slots[(size_t) kvl_kvv(t)[(size_t) expert]].ref = true;
+        g_kvl_hits++;
+        g_kvl_stays++;
+        *out_cold = true;
+        g_acc_colds++;
+        return { nullptr, false };
+    }
+    // A tier table evicts into a free RAM slot; with none free this call (the spare is still the source of a pending
+    // copy), the miss is served cold and the expert can be admitted on a later call.
+    if (slot < 0 && t.ram_base != nullptr && !t.ram_partial && t.ram_free.empty() && t.precopy.empty()) {
+        g_tier_nospare++;
+    }
+    // With copy-back ahead the victim may also leave through its precopy; the victim choice itself is unchanged.
+    // A partial tier's victim may also go back to the file.
+    if (slot < 0 && (t.ram_base == nullptr || t.ram_partial || !t.ram_free.empty() || !t.precopy.empty())) {
+        // evict the resident with the smallest decaying count; tie -> oldest use.
+        for (int s = 0; s < t.slots; s++) {
+            const int32_t e = t.slot_expert[s];
+            if (e < 0 || is_protected(e)) { continue; }
+            if (victim < 0 || t.count[e] < t.count[victim] ||
+                (t.count[e] == t.count[victim] && t.last[e] < t.last[victim])) {
+                victim = e;
+                slot   = s;
+            }
+        }
+        if (t.ram_base != nullptr && !t.ram_partial && victim >= 0 && t.ram_free.empty() &&
+            precopy_find(t, victim) == t.precopy.end()) {
+            victim = -1;   // the victim has nowhere to go this call: served cold, as with no spare
+            slot   = -1;
+            g_tier_nospare++;
+        }
+        // Phase 1b fill-vs-cold admission.  Only meaningful when a cold read is actually available
+        // (`COLD=uva`); with no cold path a rejected miss could not be served at all, so every mode
+        // fills and the policy is a no-op.  A rejected miss is still a miss and is served from the
+        // pinned host slice, so the resident set converges on the hot experts without slot churn.
+        bool   reject = false;
+        if (slot >= 0 && cold_ok && out_cold != nullptr) {
+            // Provisional pre-fill: a never-hit resident is treated as an empty slot for admission, so
+            // the doorkeeper does not delay the real hot set behind it.
+            const bool prov = g_prov_evict && slot < (int) t.slot_prov.size() && t.slot_prov[slot] != 0;
+            if (!prov) {
+                if (admit == 1) {
+                    // value: hold the resident unless the incoming has demonstrated more demand.
+                    reject = t.ghost[expert] <= t.count[victim];
+                } else if (admit == 2) {
+                    // touch: a first-touch expert is served cold; admit from the Nth touch on.
+                    reject = t.ghost[expert] < (t.ram_base != nullptr && tier_touch() > 0 ? tier_touch() : g_touch);
+                }
+            }
+        }
+        if (reject) {
+            g_cold_admits++;
+            g_acc_colds++;
+            g_cold_bytes += (int64_t) t.expert_bytes;
+            *out_cold = true;
+            kvl_note_cold_locked(t, expert);
+            return { nullptr, false };
+        }
+        if (slot >= 0) {
+            // sparse master: the victim turns cold, so its bytes must still be in RAM (pinned now; a victim whose pages
+            // left the page cache stays resident and the incoming expert is read cold - no disk read per eviction).
+            // The incoming expert is filled from the alias, so it must be registered too.
+            if (t.host_sparse && t.ram_base == nullptr) {
+                const bool victim_prov = slot < (int) t.slot_prov.size() && t.slot_prov[slot] != 0;
+                if (!victim_prov && !sparse_in_ram_locked(t, victim)) {   // a never-hit placeholder is always evictable
+                    g_sreg_stay++;
+                    return { nullptr, false };
+                }
+                if (!sparse_need_locked(t, expert) || !sparse_need_locked(t, victim)) {
+                    g_sreg_keep++;
+                    return { nullptr, false };
+                }
+            } else if (t.ram_partial) {
+                // the incoming expert outside the tier fills from the alias; a victim with no RAM slot is read from the
+                // file again, so it must be cached and registered
+                const bool to_file = t.ram_free.empty() && precopy_find(t, victim) == t.precopy.end();
+                const bool victim_prov = slot < (int) t.slot_prov.size() && t.slot_prov[slot] != 0;
+                if (to_file && !tier_fill_on() && !victim_prov && !sparse_in_ram_locked(t, victim)) {
+                    g_sreg_stay++;
+                    return { nullptr, false };
+                }
+                if (!sparse_need_locked(t, expert) || (to_file && !tier_fill_on() && !sparse_need_locked(t, victim))) {
+                    g_sreg_keep++;
+                    return { nullptr, false };
+                }
+            }
+            t.expert_slot.erase(victim);
+            t.slot_expert[slot] = -1;
+            t.evictions++;
+        }
+    }
+    if (slot >= 0 && victim < 0 && t.host_sparse && !sparse_need_locked(t, expert)) {
+        g_sreg_keep++;   // an empty slot, but the incoming expert cannot be made device-readable: no admission
+        return { nullptr, false };
+    }
+    if (slot < 0) {
+        if (cold_ok && out_cold != nullptr) {
+            *out_cold = true;
+            g_acc_colds++;
+            g_cold_bytes += (int64_t) t.expert_bytes;
+            kvl_note_cold_locked(t, expert);
+        }
+        return { nullptr, false };
+    }
+
+    t.slot_expert[slot] = expert;
+    t.expert_slot[expert] = slot;
+    t.slot_dirty = true;
+    if (g_defer_tab == &t) {
+        slot_seq_set_locked(t, slot, -2);
+        t.defer_slots.push_back(slot);
+    } else {
+        slot_seq_set_locked(t, slot, -1);
+    }
+    if (slot < (int) t.slot_prov.size()) {
+        t.slot_prov[slot] = 0;   // a real (policy-chosen) admission is not provisional
+    }
+    t.count[expert]++;
+    // The expert is resident now, so its outstanding demand is served: reset the doorkeeper.  A
+    // later eviction starts the touch count from scratch, which is what makes `touch` a
+    // "2nd use since last resident" rule rather than a lifetime-frequency rule.
+    if (expert >= 0 && expert < (int32_t) t.ghost.size()) {
+        t.ghost[expert] = 0;
+    }
+    t.last[expert] = t.clock;
+    t.fills++;
+
+    if (g_fill && t.host != nullptr) {
+        g_acc_fills++;
+        g_fill_bytes += (int64_t) t.expert_bytes;
+        char * dst = (char *) t.arena + (size_t) slot * t.expert_bytes;
+        host_pool_t * pool = t.ram_base != nullptr ? nullptr : table_pool_locked(t);   // the tier is the pool
+
+        // TODO #87 -- the pool is a LAYOUT, not a churning cache.  Its content is decided in bulk by
+        // `pool_rerank_from_heat_locked` (the arena's complement, ranked by the persisted heat prior), and
+        // the demand path only ever reads it: a resident expert is the source (one D2D copy, needed anyway),
+        // a miss takes an EMPTY slot (never evicting a resident) and otherwise falls through to the pinned
+        // bounce.  No copy is spent moving the arena victim into the pool: measured on the IQ4_NL field
+        // config, the hand-over cost 2x decode throughput while the offline model put every hand-over
+        // policy within 250 MiB of the others' L3 reads, against a 15x difference for the pool's CONTENT.
+        expert_src_t hsrc;
+        cudaError_t  err = cudaSuccess;
+        bool         local_src = false;   // local: the RAM tier / sparse alias copied the expert itself
+        if (t.ram_base != nullptr) {
+            local_src = true;
+            // the incoming expert's victim copy (if any) is the fill source: pinned so keeping the outgoing one cannot
+            // take its slot first
+            const int kv_src = expert >= 0 && expert < (int32_t) kvl_kvv(t).size() && stream == g_kvl_stream ? kvl_kvv(t)[(size_t) expert] : -1;
+            g_kvl_pin = kv_src;
+            const int kv_keep = kvl_keep_locked(t, victim, dst, (cudaStream_t) stream);
+            g_kvl_pin = -1;
+            const bool fb = fb_takes(t, expert);
+            err = tier_swap_locked(t, dst, expert, victim, stream, kv_src >= 0 ? kvl_ptr(g_kvl_slots[(size_t) kv_src]) : nullptr,
+                                   fb && kv_keep >= 0 ? (uintptr_t) kvl_ptr(g_kvl_slots[(size_t) kv_keep]) : 0);
+            if (fb && err == cudaSuccess) {   // after the push: a flush inside it empties the list and launches the earlier jobs
+                fb_kv_mark(kv_src);
+                fb_kv_mark(kv_keep);
+            }
+            g_kvl_fills += err == cudaSuccess && kv_src >= 0;
+            if (err == cudaSuccess && kv_keep >= 0 && !fb) {
+                // after the swap's own cold-pointer write for the victim (RAM copy-back / file): serve it from VRAM
+                moe_cache_set_ptr_kernel<<<1, 1, 0, (cudaStream_t) stream>>>(t.cold_ptrs, victim,
+                                                                             (uintptr_t) kvl_ptr(g_kvl_slots[(size_t) kv_keep]));
+                err = cudaGetLastError();
+            }
+            if (err != cudaSuccess) {
+                (void) cudaGetLastError();
+                GGML_LOG_WARN("%s: RAM tier swap failed table layer=%d role=%s expert=%d: %s\n",
+                              __func__, t.layer, t.role.c_str(), expert, cudaGetErrorString(err));
+                t.expert_slot.erase(expert);
+                t.slot_expert[slot] = -1;
+                tier_drop_all_locked("swap failed");   // the victim may be in neither place: fall back to the file
+                return { nullptr, false };
+            }
+        } else if (t.host_sparse && t.host_dev != nullptr) {
+            local_src = true;
+            // the expert was cold, so it is registered: a device copy from the alias
+            err = sparse_fill_locked(t, dst, expert, stream);
+            if (err != cudaSuccess) {
+                // never fall back to a pageable copy (the 2-D form faults on ROCm 7.14): undo the admission
+                GGML_LOG_WARN("%s: sparse fill failed table layer=%d role=%s expert=%d: %s\n",
+                              __func__, t.layer, t.role.c_str(), expert, cudaGetErrorString(err));
+                t.expert_slot.erase(expert);
+                t.slot_expert[slot] = -1;
+                return { nullptr, false };
+            }
+        } else if (!expert_host_src(t, expert, pool, /*allow_empty_fill*/ true, &hsrc)) {
+            err = cudaErrorInvalidDeviceFunction;
+        }
+        // GGML_MOE_FILL_FAULT=<n> (debug, default off): every host-source fill from the n-th on fails.
+        static const int64_t fill_fault = [] { const char * e = getenv("GGML_MOE_FILL_FAULT"); return e != nullptr ? (int64_t) atoll(e) : (int64_t) 0; }();
+        static int64_t fill_seen = 0;
+        if (fill_fault > 0 && err == cudaSuccess && !local_src && ++fill_seen >= fill_fault) {
+            err = cudaErrorInvalidValue;
+        }
+        if (err == cudaSuccess && !local_src) {
+            err = copy_slot_from_src(t, dst, hsrc, (cudaStream_t) stream);
+        }
+        if (err == cudaSuccess && !local_src) {
+            // Keep a pool-resident source resident: the pool holds the arena's complement, and this expert
+            // being in VRAM now does not mean the pool should forget where to find it next time.
+            expert_src_done(t, pool, hsrc, stream, /*retire*/ false);
+        }
+        if (err != cudaSuccess) {
+            // The remap is built from expert_slot, so a slot whose bytes never arrived serves stale data: wrong output, no
+            // fault.  Undo the admission and stand the table down; the scheduler serves it from the host master.  Same
+            // rule as stew r219 (issue #274).  GGML_MOE_FILL_ROLLBACK=0: the old warn-only behaviour, A/B only.
+            static const bool rollback = [] { const char * e = getenv("GGML_MOE_FILL_ROLLBACK"); return e == nullptr || atoi(e) != 0; }();
+            (void) cudaGetLastError();   // consume it, or the next launch check aborts on this stale error
+            if (!rollback) {
+                GGML_LOG_WARN("%s: async fill failed table layer=%d role=%s expert=%d: %s\n",
+                              __func__, t.layer, t.role.c_str(), expert, cudaGetErrorString(err));
+            } else {
+                t.expert_slot.erase(expert);
+                t.slot_expert[slot] = -1;
+                t.slot_dirty = true;
+                t.count[expert] = 0;
+                t.fills--;
+                g_acc_fills--;
+                g_fill_bytes -= (int64_t) t.expert_bytes;
+                g_fill_fail++;
+                if (!t.fill_failed) {
+                    GGML_LOG_WARN("%s: fill failed table layer=%d role=%s expert=%d: %s; rolled back, the table declines from now on (%lld failed fills)\n",
+                                  __func__, t.layer, t.role.c_str(), expert, cudaGetErrorString(err), (long long) g_fill_fail);
+                }
+                t.fill_failed = true;
+                return { nullptr, false };
+            }
+        }
+    }
+    return { (char *) t.arena + (size_t) slot * t.expert_bytes, true };
+}
+
+static bool tier_devremap_ok_locked(const table_t & t, int64_t n_used, int64_t n_tok, int device) {
+    return g_sized && !g_tier_off && g_cold_uva && !t.dr_failed && t.ram_base != nullptr && !t.ram_partial &&
+           t.cold_ptrs != nullptr && t.cold_safe && t.host_dev != nullptr && !t.identity &&
+           t.arena != nullptr && t.slots > 0 && t.device == device && t.n_experts > 0 &&
+           n_used < t.n_experts && t.remap_dev != nullptr && n_used * n_tok <= t.remap_cap &&
+           (t.dr_device < 0 || (t.dr_device == device && t.dr_cap == t.remap_cap));
+}
+
+static bool tier_devremap_prep_locked(table_t & t, void * stream) {
+    {
+        static const int64_t verify_at = getenv("GGML_MOE_VERIFY_AT") ? atoll(getenv("GGML_MOE_VERIFY_AT")) : 0;
+        static int64_t       n_calls   = 0;
+        static const int64_t verify_every = getenv("GGML_MOE_VERIFY_EVERY") ? atoll(getenv("GGML_MOE_VERIFY_EVERY")) : 0;
+        ++n_calls;
+        if ((verify_at > 0 && n_calls == verify_at) || (verify_every > 0 && n_calls % verify_every == 0)) {
+            verify_all_locked(verify_at > 0 && n_calls == verify_at);   // the data compare only at VERIFY_AT (slow)
+        }
+    }
+    if (t.dr_device < 0 && !devremap_alloc_locked(t)) {
+        return false;
+    }
+    const cudaStream_t s = (cudaStream_t) stream;
+    // the caller commits (the remap launch's lag flag) or flushes (events) whatever this defers
+    struct defer_scope {
+        explicit defer_scope(const table_t * p) { g_defer_tab = g_fill_fence ? p : nullptr; }
+        ~defer_scope() { g_defer_tab = nullptr; }
+    };
+
+    // 1. The residency policy on the previous call's routing (the old pass 1, one call late).  Its admissions and
+    //    tier swaps are enqueued on `s`, ahead of this call's remap and op.  The event is in the past: the host read
+    //    that step's logits before building this graph.
+    // Never block the host here: it sits between splits whose all-reduces pair the two devices, and a host wait on one
+    // device can hold back the other device's half of an all-reduce (the internal AR then times out and returns a
+    // partial sum).  Work that is not ready yet is skipped for this call; residency never changes the output.
+    tier_release_pending_locked(t, false);
+    defer_scope ds(&t);
+    if (t.dr_lag_n > 0) {
+        const bool lag_ready = t.dr_lag_flag ? __atomic_load_n(&t.dr_lag_host[t.dr_cap], __ATOMIC_ACQUIRE) == t.dr_lag_seq
+                                             : cudaEventQuery(t.dr_lag_ev) == cudaSuccess;
+        if (!lag_ready) {
+            (void) cudaGetLastError();
+            t.dr_lag_n = 0;   // the previous routing is not back yet: skip this call's policy
+            route_log_locked(t, 'K', nullptr, 0);
+        }
+    }
+    if (t.dr_lag_n > 0) {
+        const int n = (int) t.dr_lag_n;
+        t.dr_lag_n = 0;
+        route_log_locked(t, 'C', t.dr_lag_host, n);
+        pf_lend_maybe_locked(s);
+        g_kvl_in_decode = true;   // victims only from the decode policy, on the stream that reads cold_ptrs
+        for (int i = 0; i < n && !g_tier_off; i++) {
+            bool cold = false;
+            (void) access_locked(t, t.dr_lag_host[i], stream, t.dr_lag_host, n, &cold);
+        }
+        g_kvl_in_decode = false;
+        if (g_tier_off || t.ram_base == nullptr || t.arena == nullptr || t.slots <= 0) {
+            return false;   // an admission failed and dropped the tier: the host path takes over from here
+        }
+        precopy_plan_locked(t, stream, t.dr_lag_host, n);
+    }
+
+    // 2. The device map, re-uploaded only after a residency change.
+    // (declines while the previous map upload still reads the staging buffer; the host path then serves this input)
+    return dr_map_refresh_locked(t, s);
+}
+
+// update_host, after the failed-fill check.  False: decline (the scheduler serves it).
+static bool tier_update_begin_locked(table_t & t) {
+    tier_release_pending_locked(t);
+    if (t.sparse_off) {
+        g_decline_all++;   // pageable master without registration: the scheduler path serves it
+        return false;
+    }
+    // Sparse registration: re-trim to the cold set every 10 s (an admitted expert stays registered until then), but only
+    // while the registration is over its budget: each trim remaps the dropped runs, which costs the GPU a mapping
+    // update, and a model whose master fits the budget gains nothing from it.
+    static const int64_t sreg_env = [] {
+        const char * e = getenv("GGML_MOE_SREG_BUDGET_MIB");
+        return e != nullptr ? (int64_t) atoll(e) << 20 : (int64_t) -1;
+    }();
+    // default: what the tier leaves of the pin budget, at most 40 % of RAM (the previous threshold); a registration the
+    // pin budget refused also asks for a trim, so admitted experts' registrations are given back to the cold set
+    const size_t sreg_budget = (size_t) (sreg_env >= 0 ? sreg_env
+                                         : std::max<int64_t>(0, std::min<int64_t>(pin_budget_bytes() - g_tier_bytes,
+                                                                                  (int64_t) (sreg_phys_bytes() / 10 * 4))));
+    static int64_t capped_seen = 0;
+    if (!g_sreg.empty() && (g_sreg_bytes > sreg_budget || g_sreg_capped > capped_seen)) {
+        static int64_t last_us = 0;
+        const int64_t now_us = ggml_time_us();
+        if (last_us == 0) {
+            last_us = now_us;
+        } else if (now_us - last_us > 10 * 1000 * 1000) {
+            last_us = now_us;
+            capped_seen = g_sreg_capped;
+            sparse_trim_locked("periodic");
+        }
+    }
+    return true;
+}
+
+// update_host, prefill band: a small prefill ubatch on a sparse master: the routed experts come from the arena / registered alias.
+static bool tier_prefill_routed_locked(table_t & t, const ggml_tensor * weight_cpy, const int32_t * ids, int64_t n_used, int64_t n_tok,
+                                       size_t ids_nb0, size_t ids_nb1, void * stream) {
+    return weight_cpy != nullptr &&
+           ((g_prefill_inplace && prefill_inplace_prepare_locked(t, weight_cpy, ids, n_used, n_tok, ids_nb0, ids_nb1, stream)) ||
+            sparse_fill_routed_locked(t, weight_cpy->data, ids, n_used, n_tok, ids_nb0, ids_nb1, stream));
+}
+
+// update_host: a sparse table without a RAM tier is bounded when the forced admission is on: it needs a slot (or a victim
+// outside this call's experts) for every routed expert it cannot register, and only this bound guarantees one.  A partial
+// tier can decline the same way, so it is forced too, but only for shapes that fit the bound: a larger shape keeps the cold
+// reads (a deterministic decline would send a RAM-tier table to the scheduler copy, FINDINGS 716).
+static bool tier_force_locked(const table_t & t, int64_t n) {
+    return g_force_admit && t.host_sparse && (t.ram_base == nullptr || (t.ram_partial && t.slots >= (int) n));
+}
+
+// remap_dev entry: the prefill prefetch band.  True: *ret is the answer.
+static bool tier_pf_take(const ggml_tensor * weight, const ggml_tensor * weight_cpy, const ggml_tensor * ids, void * stream, int device,
+                         bool check_only, bool * ret) {
+    static const int64_t pf_min_tok = [] {
+        const char * e = getenv("GGML_MOE_PF_MIN_TOK");
+        return e != nullptr ? (int64_t) atoll(e) : (int64_t) 512;
+    }();
+    if (g_pf_prefetch && ids != nullptr && ids->ne[1] > MOE_EXPERT_CACHE_MAX_TOK && ids->ne[1] >= pf_min_tok) {
+        *ret = moe_cache_pf_take(weight, weight_cpy, stream, device, check_only);
+        return true;
+    }
+    return false;
+}
+
+tier_fb_scope_end::~tier_fb_scope_end() {
+    if (g_fb.n_save + g_fb.n_fill > 0) {
+        g_fb_late++;
+        (void) fb_flush_locked();
+    }
+}
+
+// remap_dev: the layer's queued saves, fills and map uploads, before the remap kernel that makes the op read them.
+static bool tier_flush_before_remap_locked(const int * job_id, int n_jobs, int64_t n_used, int64_t n_tok, int device) {
+    bool ok = fb_flush_locked();
+    for (int j = 0; ok && j < n_jobs; j++) {
+        ok = devremap_ok_locked(g_tables[job_id[j]], n_used, n_tok, device);
+    }
+    if (!ok) {
+        for (int j = 0; j < n_jobs; j++) {
+            table_t & u = g_tables[job_id[j]];
+            fence_flush_locked(u);
+            u.remap_n_used = 0;
+            u.dr_lag_n     = 0;
+        }
+    }
+    return ok;
+}
+
+// table_serves: a RAM-tier table served by the device remap takes every decode-band input over (the decision is constant
+// once sized), so the cache-aware fusions can read it too.  The gate and up tables place experts independently, so the
+// gate+up+GLU kernel reads the gate lane through the gate table's own remap.  GGML_MOE_DEVREMAP_FUSE=0 turns this off.
+static bool tier_table_serves_locked(const table_t & t, int device) {
+    static const bool fuse = [] {
+        const char * e = getenv("GGML_MOE_DEVREMAP_FUSE");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return fuse && g_devremap && g_sized && !g_tier_off && g_cold_uva && !t.dr_failed && t.ram_base != nullptr &&
+           t.cold_ptrs != nullptr && t.cold_safe && t.host_dev != nullptr && t.arena != nullptr && t.slots > 0 &&
+           t.device == device;
+}
+
+
+// moe_cache_evict_slab_range: a RAM tier is the complement of its arena: a table that loses its arena (re-armed later from the
+// file) breaks it, so drop every tier first.  Only when a table on this device actually loses arena bytes: the drop latches the
+// tier off for good, and a boundary move into free arena chunks takes nothing from any table.
+static void tier_evict_slab_locked(int device, uintptr_t a_lo, uintptr_t a_hi, size_t unit) {
+    bool victim = false;
+    for (const table_t & t : g_tables) {
+        if (t.arena == nullptr || t.device != device || t.arena_reserved == 0) {
+            continue;
+        }
+        const size_t bytes = unit > 0 ? unit * ((t.arena_reserved + unit - 1) / unit) : t.arena_reserved;
+        if ((uintptr_t) t.arena < a_hi && (uintptr_t) t.arena + bytes > a_lo) {
+            victim = true;
+            break;
+        }
+    }
+    if (victim) {
+        for (const table_t & t : g_tables) {
+            if (t.ram_base != nullptr && t.arena != nullptr && t.device == device && t.arena_reserved != 0) {
+                tier_drop_all_locked("slab eviction (a wider compute graph took arena chunks)");
+                break;
+            }
+        }
+    }
+}
+
+static void tier_report_locked() {
+    if (!g_any_sparse) {
+        return;
+    }
+    if (g_sreg_calls > 0 || g_sreg_fail > 0) {
+        GGML_LOG_WARN("%s: sparse registration: %.1f MiB registered now (peak %.1f), %zu runs, %lld register calls, "
+                      "%lld refused, %lld admissions skipped, %lld kept (victim not in RAM), %lld trims, %lld not mlocked, "
+                      "%lld tables staged from the cache, %lld remaps, %lld routed fills\n",
+                      __func__, g_sreg_bytes / 1048576.0, g_sreg_peak / 1048576.0, g_sreg.size(), (long long) g_sreg_calls,
+                      (long long) g_sreg_fail, (long long) g_sreg_keep, (long long) g_sreg_stay, (long long) g_sreg_trims,
+                      (long long) g_sreg_nolock, (long long) g_stage_tables, (long long) g_sreg_remaps,
+                      (long long) g_route_fills);
+        if (g_force_admits > 0) {
+            GGML_LOG_WARN("%s: sparse tables without a tier: %lld routed experts admitted through the bounce "
+                          "(GGML_MOE_FORCE_ADMIT)\n", __func__, (long long) g_force_admits);
+        }
+    }
+    if (g_tier_swaps > 0 || g_tier_bytes > 0) {
+        GGML_LOG_WARN("%s: RAM tier: %lld tables with a partial tier, %lld fills from the file, %lld victims back to the "
+                      "file, %lld filled through into the tier, %lld declines\n", __func__, (long long) g_tier_share_tables,
+                      (long long) g_tier_file_fills, (long long) g_tier_file_victims, (long long) g_tier_thru,
+                      (long long) g_decline_all);
+        GGML_LOG_WARN("%s: RAM tier: %.1f MiB pinned, %lld swaps%s; pin budget %.0f MiB, %lld tables without a tier, "
+                      "%lld registrations refused by it\n", __func__, g_tier_bytes / 1048576.0, (long long) g_tier_swaps,
+                      g_tier_off ? " (off)" : "", pin_budget_bytes() / 1048576.0, (long long) g_tier_partial,
+                      (long long) g_sreg_capped);
+        if (kvl_on()) {
+            int64_t held = 0;
+            for (const kvl_slot_t & sl : g_kvl_slots) {
+                held += sl.table >= 0;
+            }
+            GGML_LOG_WARN("%s: KV lending: %zu victim slots (%lld held), line %lld of %lld rows; %lld kept, %lld cold reads served "
+                          "from VRAM (%lld kept cold), %lld not, %lld dropped, %lld fills from a victim; %lld takes (%.1f ms), %lld gives\n", __func__, g_kvl_slots.size(),
+                          (long long) held, (long long) g_kvl_line, (long long) g_kvl_rows, (long long) g_kvl_inserts,
+                          (long long) g_kvl_hits, (long long) g_kvl_stays, (long long) g_kvl_misses, (long long) g_kvl_drops, (long long) g_kvl_fills, (long long) g_kvl_takes,
+                          g_kvl_ms, (long long) g_kvl_gives);
+            if (g_pf_lends > 0 || g_pf_takes > 0) {
+                int64_t pf_held = 0;
+                for (const kvl_slot_t & sl : g_kvl_slots) {
+                    pf_held += sl.table >= 0 && g_kvl_tensors[(size_t) sl.tensor].pf;
+                }
+                GGML_LOG_WARN("%s: KV lending: the prefill prefetch staging lent %lld times, taken back %lld times (%.1f ms), "
+                              "%lld victims held there now\n", __func__, (long long) g_pf_lends, (long long) g_pf_takes,
+                              g_pf_ms, (long long) pf_held);
+            }
+        }
+        GGML_LOG_WARN("%s: RAM tier: %d spares, precopy %s: %lld issued, %lld used (%lld waited), %lld reclaimed; %lld swaps copied back "
+                      "in-stream; %lld misses cold for lack of a spare\n", __func__, g_tier_spares, g_precopy ? "on" : "off",
+                      (long long) g_pc_issued, (long long) g_pc_used, (long long) g_pc_waited, (long long) g_pc_reclaimed,
+                      (long long) g_tier_swaps_d2h, (long long) g_tier_nospare);
+        GGML_LOG_WARN("%s: device remap: %lld calls%s; fill fence %s: %lld take-overs marked by the lag flag, %lld by events; %lld precopy plans waited (pol_ev)\n",
+                      __func__, (long long) g_devremap_calls, g_devremap ? "" : " (GGML_MOE_DEVREMAP=0)",
+                      g_fill_fence ? "on" : "off (GGML_MOE_FILL_FENCE=0)", (long long) g_fence_commits, (long long) g_fence_flushes,
+                      (long long) g_pc_polev);
+        int n_pairs = 0, n_diff = 0;
+        for (const table_t & g : g_tables) {
+            if (g.role.find("ffn_gate_exps") == std::string::npos || g.ram_base == nullptr) {
+                continue;
+            }
+            for (const table_t & u : g_tables) {
+                if (u.layer == g.layer && u.device == g.device && u.role.find("ffn_up_exps") != std::string::npos) {
+                    n_pairs++;
+                    n_diff += u.slot_expert != g.slot_expert ? 1 : 0;
+                }
+            }
+        }
+        GGML_LOG_WARN("%s: device remap: gate/up slot layouts differ in %d of %d layer-devices\n", __func__, n_diff, n_pairs);
+    }
+    if (g_fb_flushes > 0) {
+        GGML_LOG_WARN("%s: fill batch: %lld flushes, %lld jobs, %lld late, %lld failed\n", __func__, (long long) g_fb_flushes,
+                      (long long) g_fb_jobs, (long long) g_fb_late, (long long) g_fb_failed);
+    }
+}
