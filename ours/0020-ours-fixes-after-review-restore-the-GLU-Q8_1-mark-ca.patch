From 978888ad87b7294a79bd2d07148746372d5bf71f Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Fri, 30 Oct 2026 12:41:15 +0000
Subject: [PATCH 20/21] ours fixes after review: restore the GLU -> Q8_1 mark
 call that the r176 rebase dropped from ggml_cuda_try_fuse (the publish was
 dead: Qwen3.6-35B-A3B tg128 +8.3 % vs r176 with it, R9700); the shared-expert
 gate fold admits only BF16 / F32 weights (F16 would take the half-accumulator
 mmvf path, which has no fusion and aborts)

---
 ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu | 6 ++++++
 ggml/src/ggml-cuda/mmvf.cu               | 2 +-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
index c3bdb8f7f..8150b0673 100644
--- a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
@@ -1969,6 +1969,12 @@ int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgrap
         return n_cpy_batch;
     }
 
+    // GLU -> Q8_1 (GGML_CUDA_FUSE_GLU_Q8_1=0: off): an F32 GLU whose next node (or the one after a reshape) is a verify-band
+    // mmvq matmul over it is marked here (RDNA4 / RDNA3_0 only, through ggml_cuda_should_fuse_mul_mat_vec_q(mm, true)); the regular
+    // GLU launcher then also writes the matmul's Q8_1 blocks into the quantize cache, which the matmul finds.
+    // GLU -> Q8_1 marking (owned by mmvq.cu).
+    ggml_cuda_glu_q8_1_mark(*cuda_ctx, cgraph, i);
+
     // Upstream fused shared-expert MMVQ (owned by mmvq.cu).
     if (const int n_shared_expert = ggml_cuda_match_shared_expert_try_fuse(*cuda_ctx, cgraph, i)) {
         return n_shared_expert;
diff --git a/ggml/src/ggml-cuda/mmvf.cu b/ggml/src/ggml-cuda/mmvf.cu
index 654914058..35cf2a653 100644
--- a/ggml/src/ggml-cuda/mmvf.cu
+++ b/ggml/src/ggml-cuda/mmvf.cu
@@ -1391,7 +1391,7 @@ int ggml_cuda_shexp_gate_sigmoid_try_fuse(ggml_backend_cuda_context & ctx, const
     const int warp_size = ggml_cuda_info().devices[ctx.device].warp_size;
     const int64_t nt    = y->ne[1];
     if (w->ne[1] != 1 || w->ne[2] != 1 || w->ne[3] != 1 || w->view_src || !ggml_is_contiguous(w) ||
-            (w->type != GGML_TYPE_BF16 && w->type != GGML_TYPE_F32 && w->type != GGML_TYPE_F16) ||
+            (w->type != GGML_TYPE_BF16 && w->type != GGML_TYPE_F32) ||   // F16 would take the half-accumulator mmvf path, which has no fusion (abort)
             y->type != GGML_TYPE_F32 || y->ne[2] != 1 || y->ne[3] != 1 || nt < 1 || nt > MMVF_MAX_BATCH_SIZE ||
             gate->type != GGML_TYPE_F32 || !ggml_is_contiguous(gate) || gate->ne[0] != 1 || gate->ne[1] != nt ||
             mul->ne[1] != nt || add->ne[0] > INT_MAX ||
-- 
2.53.0

