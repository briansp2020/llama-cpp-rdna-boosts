-        k = std::max(1, std::min(k, t.n_experts));
-        budget         += (int64_t) uni * (int64_t) t.host_bytes;
-        uniform_slots += uni;
-        plan.push_back({ t.host, k, t.n_experts, t.host_bytes });
-    }
-    if (plan.empty() || budget <= 0) {
