 // the probe is also the tensor-parallel safety condition.
-static bool qsa3_op_supported(const llama_model & model, const llama_hparams & hparams, int il, ggml_type type_kv) {
+static bool qsa3_op_supported(const llama_model & model, const llama_hparams & hparams, int il, ggml_type type_kv,
+                               ggml_type type_pack = GGML_TYPE_F16) {
     ggml_backend_dev_t dev = model.dev_layer(il);
     if (dev == nullptr) {
         return false;
@@ -313,8 +314,9 @@ static bool qsa3_op_supported(const llama_model & model, const llama_hparams & h
     ggml_tensor * v   = ggml_new_tensor_4d(ctx, type_kv,       D,       n_kv, 1,  1);
     ggml_tensor * idx = ggml_new_tensor_4d(ctx, GGML_TYPE_I32, 1,       128, 1,  1);
     ggml_tensor * msk = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, n_kv,    128, 1,  1);
-    ggml_tensor * pk  = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, D,       1,   n_kv, 1);
-    ggml_tensor * pv  = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, D,       1,   n_kv, 1);
+    // the packs in the form the graph will attach: F16 copies, or the Q8_0 cache views (LLAMA_QSA3_PACK_Q8)
+    ggml_tensor * pk  = ggml_new_tensor_4d(ctx, type_pack,     D,       1,   n_kv, 1);
+    ggml_tensor * pv  = ggml_new_tensor_4d(ctx, type_pack,     D,       1,   n_kv, 1);
 
     ggml_tensor * op = ggml_flash_attn_qsa(ctx, q, k, v, idx, msk, 1.0f, 0.0f, nullptr, nullptr);
     ggml_flash_attn_qsa_set_packed(op, pk, pv);
@@ -2473,8 +2475,16 @@ ggml_tensor * llama_model_qwen4exp::graph::build_attn_qsa(
         // backend probe: never materialise the F16 packs when the acting device's qsa3 predicate
         // will not read them (the runtime arch/env policy lives there; issue #59/#60).
         constexpr bool qsa3_pack = LLAMA_QSA3_ENABLE != 0;
+        // LLAMA_QSA3_PACK_Q8 (default on): a Q8_0 cache is handed to the launcher as is - it dequantizes while it
+        // packs (same bits as the F16 copy) - so the graph builds no F16 copies of K and V at all.  Only on a
+        // non-CPU layer device (the CPU backend has no qsa3 launcher); =0 restores the F16 copies (A/B).
+        static const bool pack_q8_env = [] { const char * e = getenv("LLAMA_QSA3_PACK_Q8"); return e == nullptr || atoi(e) != 0; }();
+        ggml_backend_dev_t pack_dev = model.dev_layer(il);
+        const bool pack_q8 = pack_q8_env && k_raw->type == GGML_TYPE_Q8_0 && v_raw->type == GGML_TYPE_Q8_0 &&
+            pack_dev != nullptr && ggml_backend_dev_type(pack_dev) != GGML_BACKEND_DEVICE_TYPE_CPU;
         if (qsa3_pack && n_stream == 1 && q_p->ne[1] >= 128 && k_raw->ne[0] == 256 && k_raw->ne[2] % 4 == 0 &&
-            qwen4exp_qsa3_kv_type(k_raw->type) && qsa3_op_supported(model, hparams, il, k_raw->type)) {
+            qwen4exp_qsa3_kv_type(k_raw->type) &&
+            qsa3_op_supported(model, hparams, il, k_raw->type, pack_q8 ? GGML_TYPE_Q8_0 : GGML_TYPE_F16)) {
             // The launcher packs these into the block layouts itself (one fused pass, session 7);
             // the graph only materialises the natural contiguous F16 view [D, n_head_kv, n_kv].
             // LLAMA_QSA3_DIRECT_F16=0: the Q8_0 cache goes through the F32 intermediate again (A/B)
@@ -2482,9 +2492,13 @@ ggml_tensor * llama_model_qwen4exp::graph::build_attn_qsa(
             ggml_backend_dev_t layer_dev = model.dev_layer(il);
             const bool direct_q8_0 = direct_env && layer_dev != nullptr &&
                 ggml_backend_dev_type(layer_dev) != GGML_BACKEND_DEVICE_TYPE_CPU;
-            ggml_tensor * k16 = qsa3_f16_natural(ctx0, k_raw, direct_q8_0);
-            ggml_tensor * v16 = qsa3_f16_natural(ctx0, v_raw, direct_q8_0);
-            ggml_flash_attn_qsa_set_packed(cur, k16, v16);
+            if (pack_q8) {
