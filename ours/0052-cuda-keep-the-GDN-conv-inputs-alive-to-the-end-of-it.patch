From 99cc6d15580347f72ffbc24da3f35842752d3448 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Thu, 5 Nov 2026 17:58:08 -0800
Subject: [PATCH 52/53] cuda: keep the GDN conv inputs alive to the end of its
 q/k norm pair

The direct conv kernel also writes the q/k l2 norm SCALE outputs when they do
not overlap its inputs.  x and the conv state are dead after the CONCAT, so the
allocator could place those outputs over them and the fold declined depending
on the graph layout: Qwen3.6-35B-A3B Q4_K_M folded in 0 of 30 GDN layers with
GGML_SCHED_UPFRONT_INPUTS=1 and 28 of 30 without.

Add alloc deps from x and state to the second SCALE, 1..255 tokens only.  The
overlap check stays.  GGML_CUDA_GDN_CONV_NORM_HOLD=0 turns it off.

7900 XTX, prod env: tg128 178.6 vs 166.0 t/s, at depth 4096 176.5 vs 163.0; 642
vs 733 launches per token.  Text identical on q36 and q38m; MTP server identical,
VERIFY 0 differ.  FINDINGS 789.
---
 ggml/src/ggml-cuda/gdn-conv.cu  | 27 +++++++++++++++++++++++++--
 ggml/src/ggml-cuda/gdn-conv.cuh |  1 +
 ggml/src/ggml-cuda/ggml-cuda.cu |  4 ++++
 3 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/gdn-conv.cu b/ggml/src/ggml-cuda/gdn-conv.cu
index 88d194d34..a0d70fa71 100644
--- a/ggml/src/ggml-cuda/gdn-conv.cu
+++ b/ggml/src/ggml-cuda/gdn-conv.cu
@@ -351,7 +351,9 @@ static bool gdn_conv_norm_one(const ggml_cgraph * cgraph, int j, const ggml_cuda
 
 // The q / k l2 norm pair right after the conv (only no-op nodes between): the direct kernel also writes both normalized
 // outputs.  Returns the index of the second SCALE, -1 when the pattern is not there.  GGML_CUDA_FUSE_GDN_CONV_NORM=0: off.
-static int gdn_conv_norm_match(const ggml_cgraph * cgraph, const ggml_cuda_gdn_conv_match & m, gdn_conv_norm_args & na) {
+// The structural part of the match below, no data pointers (also used before allocation, see ggml_cuda_gdn_conv_norm_hold_until).
+static int gdn_conv_norm_pair(const ggml_cgraph * cgraph, const ggml_cuda_gdn_conv_match & m, int & j1, int & j2_out, int & nk_out,
+                              float & eps_out, float & scale_out) {
     static const bool fuse = [] { const char * e = getenv("GGML_CUDA_FUSE_GDN_CONV_NORM"); return e == nullptr || atoi(e) != 0; }();
     if (!fuse || !m.silu || m.C % 256 != 0) return -1;
     int j = m.conv_idx + 2;
@@ -374,6 +376,14 @@ static int gdn_conv_norm_match(const ggml_cgraph * cgraph, const ggml_cuda_gdn_c
                     t->src[s]->view_src == cgraph->nodes[j] || t->src[s]->view_src == cgraph->nodes[j2]) return -1;
         }
     }
+    j1 = j; j2_out = j2; nk_out = (int) nk; eps_out = eps0; scale_out = sc0;
+    return j2 + 1;
+}
+
+static int gdn_conv_norm_match(const ggml_cgraph * cgraph, const ggml_cuda_gdn_conv_match & m, gdn_conv_norm_args & na) {
+    int j, j2, nk;
+    float eps0, sc0;
+    if (gdn_conv_norm_pair(cgraph, m, j, j2, nk, eps0, sc0) < 0) return -1;
     // the SCALE outputs are written while the conv still reads x / state / w straight from their buffers; the allocator
     // can place them over the state or x (both dead after the CONCAT in graph order), so the fold needs disjoint memory
     const auto overlap = [](const ggml_tensor * a, const ggml_tensor * b) {
@@ -387,10 +397,23 @@ static int gdn_conv_norm_match(const ggml_cgraph * cgraph, const ggml_cuda_gdn_c
     }
     na.dst0 = (float *) cgraph->nodes[j + 1]->data;
     na.dst1 = (float *) cgraph->nodes[j2 + 1]->data;
-    na.nk = (int) nk; na.eps = eps0; na.scale_out = sc0;
+    na.nk = nk; na.eps = eps0; na.scale_out = sc0;
     return j2 + 1;
 }
 
+// Before allocation: the second SCALE of the q / k l2 norm pair the direct kernel can also write, nullptr when there is none.  Keeping
+// x and state alive until that SCALE stops the allocator from placing the outputs over them, which would make
+// gdn_conv_norm_match decline depending on the layout.  1..255 tokens only (decode and verify; a prefill x is large).
+// GGML_CUDA_GDN_CONV_NORM_HOLD=0: off.
+ggml_tensor * ggml_cuda_gdn_conv_norm_hold_until(const ggml_cgraph * cgraph, const ggml_cuda_gdn_conv_match & m) {
+    static const bool hold = [] { const char * e = getenv("GGML_CUDA_GDN_CONV_NORM_HOLD"); return e == nullptr || atoi(e) != 0; }();
+    if (!hold || m.T >= 256) return nullptr;
+    int j, j2, nk;
+    float eps, scale;
+    const int last = gdn_conv_norm_pair(cgraph, m, j, j2, nk, eps, scale);
+    return last > 0 ? cgraph->nodes[last] : nullptr;
+}
+
 // One token (decode; GGML_CUDA_FUSE_GDN_CONV_DECODE=0: off): the direct conv only where it also takes the q / k l2 norm pair (otherwise the ssm_conv_in epilogue,
 // which writes the CONCAT inside the in-proj GEMV, is cheaper) and only where the decode-only ssm_prescan fusion would not
 // take the conv.  Uses data pointers: compute time only.  Every compute-time caller (CONCAT, SSM_CONV, the ssm_conv_in
diff --git a/ggml/src/ggml-cuda/gdn-conv.cuh b/ggml/src/ggml-cuda/gdn-conv.cuh
index dcfad68c6..125789024 100644
--- a/ggml/src/ggml-cuda/gdn-conv.cuh
+++ b/ggml/src/ggml-cuda/gdn-conv.cuh
@@ -19,6 +19,7 @@ struct ggml_cuda_gdn_conv_match {
 };
 bool ggml_cuda_gdn_conv_match_at_concat(const ggml_cgraph * cgraph, int i, ggml_cuda_gdn_conv_match & m);
 bool ggml_cuda_gdn_conv_pattern_at_concat(const ggml_cgraph * cgraph, int i, ggml_cuda_gdn_conv_match & m);
+ggml_tensor * ggml_cuda_gdn_conv_norm_hold_until(const ggml_cgraph * cgraph, const ggml_cuda_gdn_conv_match & m);
 bool ggml_cuda_gdn_conv_match_at_conv(const ggml_cgraph * cgraph, int j, ggml_cuda_gdn_conv_match & m);
 void ggml_cuda_gdn_conv_write_tail(ggml_backend_cuda_context & ctx, const ggml_cuda_gdn_conv_match & m);
 struct gdn_conv_norm_args;
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index b09450431..631d0d99b 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -8419,6 +8419,10 @@ static void ggml_backend_cuda_graph_optimize(ggml_backend_t backend, ggml_cgraph
                 if (ggml_cuda_gdn_conv_pattern_at_concat(cgraph, i, gm)) {
                     params->add_alloc_dep(params->user_data, const_cast<ggml_tensor *>(gm.x), cgraph->nodes[gm.conv_idx]);
                     params->add_alloc_dep(params->user_data, const_cast<ggml_tensor *>(gm.state), cgraph->nodes[gm.conv_idx]);
+                    if (ggml_tensor * until = ggml_cuda_gdn_conv_norm_hold_until(cgraph, gm)) {
+                        params->add_alloc_dep(params->user_data, const_cast<ggml_tensor *>(gm.x), until);
+                        params->add_alloc_dep(params->user_data, const_cast<ggml_tensor *>(gm.state), until);
+                    }
                 }
                 continue;
             }
-- 
