From 3d8ed2894ca5ac990a861988c51e78395d68357d Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Mon, 2 Nov 2026 06:07:22 +0000
Subject: [PATCH 28/53] moe cache: a fused MoE op whose lanes the cache cannot
 redirect together runs unfused when a lane was taken over (the scheduler
 skipped its copy; GGML_MOE_FUSED_LANE_GUARD)

---
 ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu |  3 +++
 ggml/src/ggml-cuda/mmvq.cu               |  2 ++
 ggml/src/ggml-cuda/moe-expert-cache.cu   | 30 ++++++++++++++++++++++++
 ggml/src/ggml-cuda/moe-expert-cache.h    |  3 +++
 4 files changed, 38 insertions(+)

diff --git a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
index b9f0e7551..da35ee1e2 100644
--- a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
@@ -2740,6 +2740,9 @@ int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgrap
                     fusion_local.gate     = &gate_c;
                     fusion_local.gate_ids = &gate_ids_c;
                     ggml_cuda_mul_mat_vec_q(*cuda_ctx, &src0_c, src1, &ids_c, glu, &fusion_local);
+                } else if (ids != nullptr &&
+                           moe_cache_fused_lane_taken(glu, src0, fusion_data.gate, cuda_ctx->device)) {
+                    continue;   // a taken-over lane has no full copy: run gate, up and the GLU unfused
                 } else {
                     ggml_cuda_mul_mat_vec_q(*cuda_ctx, src0, src1, ids, glu, &fusion_data);
                 }
diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 7a2cd9bb9..2fa95dfcd 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -3229,6 +3229,8 @@ int ggml_cuda_moe_down_fold_try_fuse(ggml_backend_cuda_context & ctx, const ggml
             if (moe_cache_redirect_fused(mm_node, mm_node->src[0], nullptr, mm_node->src[2],
                                          ctx.device, ctx.stream(), &src0_c, &ids_c, nullptr, nullptr)) {
                 ggml_cuda_mul_mat_vec_q(ctx, &src0_c, mm_node->src[1], &ids_c, mul_node, &fusion_data);
+            } else if (moe_cache_fused_lane_taken(mm_node, mm_node->src[0], nullptr, ctx.device)) {
+                return 0;   // taken over but not redirectable: the unfused consumer reads the arena
             } else {
                 ggml_cuda_mul_mat_vec_q(ctx, mm_node->src[0], mm_node->src[1], mm_node->src[2], mul_node, &fusion_data);
             }
diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index 24dc08eff..1c90b5d74 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -8848,6 +8848,36 @@ bool moe_cache_get_table(const ggml_tensor * op, const ggml_tensor * weight_cpy,
     return true;
 }
 
+// After a failed `moe_cache_redirect_fused`: true when the cache took over either lane anyway (one lane declined, or a
+// remap shape the fused kernel cannot take).  The scheduler skipped the copy of every taken-over input, so the original
+// tensors are stale for that lane: the caller must not fuse, and each op reads its own table through the per-op
+// consumer.
+bool moe_cache_fused_lane_taken(const ggml_tensor * op, const ggml_tensor * src0, const ggml_tensor * gate, int device) {
+    if (!g_enabled) {
+        return false;
+    }
+    static const bool on = [] {
+        const char * e = getenv("GGML_MOE_FUSED_LANE_GUARD");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    if (!on) {
+        return false;
+    }
+    void *  a = nullptr, * r = nullptr;
+    int64_t s = 0, nu = 0, nt = 0;
+    size_t  eb = 0;
+    const bool taken = moe_cache_get_table(op, src0, device, &a, &s, &eb, &r, &nu, &nt) ||
+                       (gate != nullptr && moe_cache_get_table(op, gate, device, &a, &s, &eb, &r, &nu, &nt));
+    if (taken) {
+        static std::atomic<int64_t> n{0};
+        if (n.fetch_add(1) == 0) {
+            GGML_LOG_WARN("moe_cache: a fused MoE op has a lane the cache took over but cannot redirect together: "
+                          "running it unfused (GGML_MOE_FUSED_LANE_GUARD=0 restores the fused read)\n");
+        }
+    }
+    return taken;
+}
+
 // Per-table fusion-guard query (wip/moe-verify-fusions OPEN 2).  Mirrors `moe_cache_take_over`'s
 // `identity` decision for THIS table, with no side effects, so the fusion guard and the scheduler
 // take-over agree per table instead of on the whole-graph `moe_cache_has_arena()`.
diff --git a/ggml/src/ggml-cuda/moe-expert-cache.h b/ggml/src/ggml-cuda/moe-expert-cache.h
index 33b5a27d5..0b2b40c61 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.h
+++ b/ggml/src/ggml-cuda/moe-expert-cache.h
@@ -366,6 +366,9 @@ bool moe_cache_take_over(const struct ggml_tensor * weight, const struct ggml_te
 // op (declined for the shape, or disabled), in which case the caller keeps the original tensors - which
 // the scheduler copied in full.  Both tables must be redirected together: the hook takes over each of
 // them independently and skips the scheduler's copy, so a mixed redirect would read a stale table.
+bool moe_cache_fused_lane_taken(const struct ggml_tensor * op, const struct ggml_tensor * src0,
+                                const struct ggml_tensor * gate, int device);
+
 bool moe_cache_redirect_fused(const struct ggml_tensor * op,
                               const struct ggml_tensor * src0,
                               const struct ggml_tensor * gate,
-- 
2.53.0

