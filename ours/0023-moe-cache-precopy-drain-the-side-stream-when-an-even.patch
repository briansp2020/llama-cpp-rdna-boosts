From 31f1571c44be8ddb412b6f2eb8f92a5d177cee76 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Sun, 1 Nov 2026 16:15:27 +0000
Subject: [PATCH 23/50] moe cache precopy: drain the side stream when an event
 record fails after a launch; a failed wait fails the swap

---
 ggml/src/ggml-cuda/moe-expert-cache.cu | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index 01f47d2bc..1ad50aefd 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -1201,6 +1201,8 @@ static void precopy_plan_locked(table_t & t, void * stream, const int32_t * prot
         moe_cache_copy_kernel<<<32, 256, 0, ss>>>(t.ram_base + (size_t) q * eb,
                                                   (const char *) t.arena + (size_t) rs->second * eb, eb);
         if (cudaGetLastError() != cudaSuccess || cudaEventRecord(ev, ss) != cudaSuccess) {
+            (void) cudaGetLastError();
+            (void) cudaStreamSynchronize(ss);   // a copy may be in flight into q: drain it before q is reused
             (void) cudaGetLastError();
             t.precopy_idle.push_back(ev);   // a failed record leaves it unrecorded; the slot stays free
             return;
@@ -1232,7 +1234,8 @@ static cudaError_t tier_swap_locked(table_t & t, void * dst, int32_t e, int32_t
             g_pc_waited++;
         }
         if (cudaStreamWaitEvent(s, pc->ev, 0) != cudaSuccess) {
-            return cudaGetLastError();
+            (void) cudaGetLastError();
+            return cudaErrorInvalidValue;
         }
         set_e = victim;
         set_v = (uintptr_t) (t.ram_base + (size_t) q * eb);
-- 
2.53.0

