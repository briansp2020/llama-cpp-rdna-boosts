+static bool ggml_cuda_mmvq_cat2_ok(ggml_type type, ggml_type type_b, int cc) {
+    static const bool on = getenv("GGML_CUDA_MMVQ_ROW_CONCAT_MIXED") == nullptr || atoi(getenv("GGML_CUDA_MMVQ_ROW_CONCAT_MIXED")) != 0;
+    return on && GGML_CUDA_CC_IS_RDNA4(cc) && type_b == GGML_TYPE_Q6_K &&
+           (type == GGML_TYPE_Q4_K || type == GGML_TYPE_Q5_K || type == GGML_TYPE_IQ4_XS);
