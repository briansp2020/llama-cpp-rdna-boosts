+
+// Mixed-type dense row concat (1 token, RDNA4; ggml_cuda_mmvq_cat2_ok): the row blocks of segment fusion.cat2_k run the body
+// of its own type (type_b, row stride fusion.cat2_stride_row), every other block the launch type's.  The type is chosen once
+// per block, so the RDNA4 decode grid loop (a block walking several row groups) is off for these launches.  Both types take the
+// same nwarps and the launch's rows per block, and each row keeps its own one-warp dot product, so every row computes
+// exactly what its standalone launch does.
+template <ggml_type type, ggml_type type_b, int rows_per_block, bool long_k, bool small_m>
+__launch_bounds__(calc_nwarps_weight(type, 1, get_device_table_id(), long_k, small_m)*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_ksplit_cat2(
+        const void * vx_ptr, const void * vy_ptr, const int32_t * ids_ptr, const ggml_cuda_mm_fusion_args_device fusion, float * dst_ptr,
+        const uint32_t ncols_x, const uint3 nchannels_y, const uint32_t stride_row_x, const uint32_t stride_col_y,
+        uint32_t stride_col_dst, const uint3 channel_ratio, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y, const uint32_t stride_channel_dst, const uint3 sample_ratio,
+        const uint32_t stride_sample_x, const uint32_t stride_sample_y, const uint32_t stride_sample_dst,
+        const uint32_t ids_stride, const uint32_t nrows_loop) {
+    constexpr mmvq_parameter_table_id table_id = get_device_table_id();
+    if constexpr (table_id == MMVQ_PARAMETERS_RDNA4) {
+        static_assert(calc_nwarps_weight(type, 1, table_id, long_k, small_m) == calc_nwarps_weight(type_b, 1, table_id, long_k, small_m),
+                      "mixed row concat: both types must take the same nwarps");
+        constexpr int rpb = rows_per_block > 0 ? rows_per_block :
+            calc_rows_per_block_weight(type, 1, table_id, false, calc_nwarps_weight(type, 1, table_id, long_k, small_m));
+        const uint32_t row0 = rpb*blockIdx.x;
+        const int      kb   = fusion.cat2_k;
+        const uint32_t lo   = fusion.cat_row[kb];
+        const uint32_t hi   = (kb == 0 && fusion.cat_dst[1] != nullptr) ? fusion.cat_row[1] : 0xFFFFFFFFu;
+        if (row0 >= lo && row0 < hi) {
+            mul_mat_vec_q_ksplit_body<type_b, 1, false, false, false, rpb, long_k, small_m, true>(vx_ptr, vy_ptr, ids_ptr, fusion, dst_ptr, ncols_x, nchannels_y, fusion.cat2_stride_row, stride_col_y, stride_col_dst, channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst, sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst, ids_stride, nrows_loop);
+        } else {
+            mul_mat_vec_q_ksplit_body<type, 1, false, false, false, rpb, long_k, small_m, true>(vx_ptr, vy_ptr, ids_ptr, fusion, dst_ptr, ncols_x, nchannels_y, stride_row_x, stride_col_y, stride_col_dst, channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst, sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst, ids_stride, nrows_loop);
+        }
+    } else {
+        GGML_UNUSED_VARS(vx_ptr, vy_ptr, ids_ptr, fusion, dst_ptr, ncols_x, nchannels_y, stride_row_x, stride_col_y, stride_col_dst,
+                         channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst, sample_ratio, stride_sample_x,
+                         stride_sample_y, stride_sample_dst, ids_stride, nrows_loop);
+        NO_DEVICE_CODE;
+    }
+}
