From 8dcb8f3a2ff88d5cc63878a2c02decd796c14ba2 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Tue, 10 Nov 2026 01:31:54 +0000
Subject: [PATCH 18/23] llama-context: DeepSeek-V4 cache size probes use a
 full-cache context

The host-expert narrow-floor probes reserve n_verify tokens, but the
DeepSeek-V4 raw cache sizes k_idxs from the memory context own write
ubatch. Against the live context the two disagree and cpy_k aborts
(GGML_ASSERT(sinfo.n_stream() > 1)) on the first DeepSeek-V4.1 decode.
Add LLM_ARCH_DEEPSEEK41 to the dsv4 check and probe those caches with
memory->init_full() and n_seq_max, the shape sched_reserve() uses.
Other architectures are unchanged. LLAMA_DSV4_PROBE_FULL=0 restores
the old probe.
---
 src/llama-context.cpp | 41 +++++++++++++++++++++++++++++++----------
 1 file changed, 31 insertions(+), 10 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 14bd5fbba..0915f9e01 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -2676,6 +2676,13 @@ static bool llama_slab_ring_prefill() {
     return v;
 }
 
+// LLAMA_DSV4_PROBE_FULL=0: the DeepSeek-V4 cache size probes use the live memory context and ubatch.n_seqs again
+// (the previous behaviour, which aborts in cpy_k on a host-expert DeepSeek-V4.1 load).
+static bool llama_dsv4_probe_full() {
+    static const bool v = [] { const char * e = getenv("LLAMA_DSV4_PROBE_FULL"); return e == nullptr || atoi(e) != 0; }();
+    return v;
+}
+
 llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, llm_graph_type gtype, llama_memory_context_i * mctx, ggml_status & ret) {
     if (mctx && !mctx->apply()) {
         LLAMA_LOG_ERROR("%s: failed to apply memory context\n", __func__);
@@ -2706,12 +2713,26 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
     // short-prompt workload.  Without a slab the classic wide-pass condition is kept, because there
     // reclaiming the wide layout is exactly what used to abort.
     // The dsv4 compressed cache builds its raw attention from the per-stream index fanout, so its
-    // synthetic reserve probe has always used ubatch.n_seqs (a multi-stream shape) and must keep
-    // doing so: a one-stream reserve left the next real decode reading a one-stream sinfo and
-    // aborting in cpy_k.  Every other arch uses the real sequence count below, because the 4-D kq
-    // mask derives its stream dim from it and must agree with the single-stream query tensor.
-    const bool dsv4_cache = model.arch == LLM_ARCH_DEEPSEEK4 ||
+    // synthetic reserve probe uses a multi-stream shape: n_seq_max against a full-cache context (see
+    // probe_mctx below; LLAMA_DSV4_PROBE_FULL=0 restores ubatch.n_seqs against the live context).
+    // Every other arch uses the real sequence count below, because the 4-D kq mask derives its
+    // stream dim from it and must agree with the single-stream query tensor.
+    const bool dsv4_cache = model.arch == LLM_ARCH_DEEPSEEK4 || model.arch == LLM_ARCH_DEEPSEEK41 ||
             (model.arch == LLM_ARCH_DFLASH && model.hparams.dsv4_hc_mult > 0);
+    // The DeepSeek-V4 caches size the write indices (k_idxs) from the memory context's own write ubatch,
+    // not from the reserve's token count, so a size probe of n_verify tokens against the LIVE context (built
+    // for this ubatch) disagrees with k_cur and aborts in cpy_k.  Probe those caches with a full-cache
+    // context and the load-time sequence count instead -- the shape sched_reserve() already uses.
+    llama_memory_context_ptr dsv4_probe_owned;
+    auto probe_mctx = [&]() -> llama_memory_context_i * {
+        if (!dsv4_cache || !memory || !llama_dsv4_probe_full()) {
+            return mctx;
+        }
+        if (!dsv4_probe_owned) {
+            dsv4_probe_owned = memory->init_full();
+        }
+        return dsv4_probe_owned.get();
+    };
     bool drop_now = false;
     // The work region actually observed before the drop.  The reference must be at least this: the narrow
     // layout varies with the graph (the MTP decode/verify graph is wider than the `n_rs_batch` reserve the
@@ -2759,11 +2780,11 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
     if (llama_slab_ring_prefill() && !slab_narrow_pinned && !model.moe_host_expert_bytes.empty() &&
             cparams.ctx_type != LLAMA_CONTEXT_TYPE_MTP) {
         slab_narrow_pinned = true;
-        const uint32_t n_rs_seqs = std::max<uint32_t>(1, dsv4_cache ? ubatch.n_seqs : ubatch.n_seqs_unq);
+        const uint32_t n_rs_seqs = std::max<uint32_t>(1, dsv4_cache ? (llama_dsv4_probe_full() ? cparams.n_seq_max : ubatch.n_seqs) : ubatch.n_seqs_unq);
         size_t narrow_sizes[16] = {0};
         // TODO #96: reserve the width the run will actually issue, not the unclamped safety bound
         const uint32_t n_verify = verify_batch_width();
-        if (graph_reserve(n_verify, n_rs_seqs, n_verify, mctx, /*split_only=*/true,
+        if (graph_reserve(n_verify, n_rs_seqs, n_verify, probe_mctx(), /*split_only=*/true,
                           narrow_sizes, kq_mask_packed_reachable()) != nullptr) {
             size_t narrow_bytes = 0;
             for (int i = 0; i < 16; i++) {
@@ -2829,7 +2850,7 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
         // (`mctx`) spans this ubatch's streams, and `build_attn_mha`/`ggml_flash_attn_ext` require the
         // query and the cache to agree on the stream dim (`q->ne[3] == k->ne[3]`).  A hard-coded 1
         // against a multi-sequence batch took `q->ne[2]/n_stream` to zero and aborted (issue #48).
-        const uint32_t n_rs_seqs = std::max<uint32_t>(1, dsv4_cache ? ubatch.n_seqs : ubatch.n_seqs_unq);
+        const uint32_t n_rs_seqs = std::max<uint32_t>(1, dsv4_cache ? (llama_dsv4_probe_full() ? cparams.n_seq_max : ubatch.n_seqs) : ubatch.n_seqs_unq);
         // wip/slab-ring-region: measure the narrow (decode/verify) layout BEFORE allocating it, so the slab
         // can pin its narrow floor AHEAD of the cache's deferred sizing (which runs later in this same pass).
         // `split_only` + a `sizes` array is a size-only reserve (no allocation); the real reserve follows.
@@ -2838,7 +2859,7 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
         const uint32_t n_verify = verify_batch_width();
         {
             size_t narrow_sizes[16] = {0};
-            if (graph_reserve(n_verify, n_rs_seqs, n_verify, mctx, /*split_only=*/true,
+            if (graph_reserve(n_verify, n_rs_seqs, n_verify, probe_mctx(), /*split_only=*/true,
                               narrow_sizes, kq_mask_packed_reachable()) != nullptr) {
                 size_t narrow_bytes = 0;
                 for (int i = 0; i < 16; i++) {
@@ -2858,7 +2879,7 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
                 }
             }
         }
-        const bool narrow_ok = graph_reserve(n_verify, n_rs_seqs, n_verify, mctx, false) != nullptr;
+        const bool narrow_ok = graph_reserve(n_verify, n_rs_seqs, n_verify, probe_mctx(), false) != nullptr;
         if (!narrow_ok) {
             LLAMA_LOG_WARN("%s: failed to re-reserve the post-prefill compute layout; a later"
                     " growth may not fit next to the MoE expert cache arena\n", __func__);
