From 30024f397ad6107e2b1ed7471dbf006589190711 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Tue, 3 Nov 2026 03:15:53 +0000
Subject: [PATCH 37/50] moe cache KV lending: the victims' stream is the lowest
 remapped layer's

A fully resident layer 0 never records a remap stream, so on prod (-ncmoe 47) no victim was ever made.  Take the lowest
layer whose remap has run, never the highest layer (the MTP draft's own tables).
---
 ggml/src/ggml-cuda/moe-expert-cache.cu | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index 137768a65..e134fb635 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -1176,10 +1176,16 @@ static int kvl_keep_locked(table_t & t, int32_t victim, const char * src, cudaSt
         return -1;
     }
     if (g_kvl_stream == nullptr) {
+        // the lowest layer whose remap has run (fully resident layers never record one); never the highest layer, which
+        // is the MTP draft's own when it has MoE tables
+        int max_layer = -1, lo = 1 << 30;
         for (const table_t & o : g_tables) {
-            if (o.layer == 0 && o.dr_last_stream != nullptr) {
+            max_layer = std::max(max_layer, o.layer);
+        }
+        for (const table_t & o : g_tables) {
+            if (o.dr_last_stream != nullptr && o.layer < lo && o.layer < max_layer) {
+                lo           = o.layer;
                 g_kvl_stream = o.dr_last_stream;
-                break;
             }
         }
     }
