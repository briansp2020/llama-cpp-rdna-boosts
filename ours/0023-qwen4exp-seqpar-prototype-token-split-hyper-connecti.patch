+// ggml_token_scatter
+
+struct ggml_tensor * ggml_token_scatter(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        bool                  allow_reduce_scatter) {
+    GGML_ASSERT(ggml_is_contiguous(a));
+
+    struct ggml_tensor * result = ggml_dup_tensor(ctx, a);
+
+    // the token axis: the slowest dim with more than one element
+    const int32_t params[3] = { ggml_n_dims(a) - 1, 0, allow_reduce_scatter ? 1 : 0 };
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_TOKEN_SCATTER;
+    result->src[0] = a;
+
+    return result;
+}
