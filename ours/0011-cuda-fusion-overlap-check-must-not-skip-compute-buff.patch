From 1a4f17fad37a6ed4b81ea7b132c943a9a3167df7 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Sun, 8 Nov 2026 16:15:37 +0000
Subject: [PATCH 11/20] cuda: fusion overlap check must not skip compute-buffer
 leaves

ggml_cuda_check_fusion_memory_ranges skipped every GGML_OP_NONE source on the
assumption that leaves are weights.  A scheduler copy of a host-resident expert
weight (-ncmoe + op offload) is also a leaf, but it lives in the compute buffer,
and the allocator may hand its memory to the fused output once the last unfused
consumer is done with it.  The fused routed gate+up+GLU then writes its output
over the gate weights it is still reading: NaN logits, "!!!!" output, whenever
the expert cache is off (or a table falls back to the scheduler copy) and a 9-16
token batch takes the fused MMVQ path.

Skip a leaf only when it is not in a compute buffer.  With the cache on the
output is bit-identical and prefill/decode speed unchanged (1 GPU and 2-GPU
tensor split); with the cache off Qwen3.6-35B and the prod IQ3_S model are
coherent again.  GGML_CUDA_FUSION_CHECK_LEAVES=0 restores the old check.
---
 ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
index b5062fa9c..9ab03f91d 100644
--- a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
@@ -788,6 +788,12 @@ bool ggml_cuda_topk_moe_fusion(const struct ggml_cgraph * cgraph, int node_idx,
     return true;
 }
 
+// GGML_CUDA_FUSION_CHECK_LEAVES=0: the old check (every leaf skipped).
+static bool fusion_check_compute_leaves() {
+    static const bool on = [] { const char * e = getenv("GGML_CUDA_FUSION_CHECK_LEAVES"); return e == nullptr || atoi(e) != 0; }();
+    return on;
+}
+
 // returns whether the write (out) nodes overwrite the read nodes in operation
 bool ggml_cuda_check_fusion_memory_ranges(const ggml_cgraph * cgraph,
                                                  const int           node_idx,
@@ -827,7 +833,15 @@ bool ggml_cuda_check_fusion_memory_ranges(const ggml_cgraph * cgraph,
             for (int src_idx = 0; src_idx < GGML_MAX_SRC; ++src_idx) {
                 const ggml_tensor * src = cgraph->nodes[j]->src[src_idx];
 
-                if (!src || src->op == GGML_OP_NONE || src == logits_may_alias) {
+                if (!src || src == logits_may_alias) {
+                    continue;
+                }
+                // A leaf is skipped only when it cannot share memory with a graph result.  A scheduler copy of a host
+                // weight (-ncmoe + op offload) is a leaf too, but it lives in the compute buffer, and the allocator may
+                // already have given its memory to the fused output after the last unfused consumer of the copy.
+                if (src->op == GGML_OP_NONE &&
+                    (!fusion_check_compute_leaves() || src->buffer == nullptr ||
+                     ggml_backend_buffer_get_usage(src->buffer) != GGML_BACKEND_BUFFER_USAGE_COMPUTE)) {
                     continue;
                 }
 
