From dcba8a8ea5ed7155df1242212581973e1024f053 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Fri, 30 Oct 2026 03:03:02 +0000
Subject: [PATCH 02/20] Dense row concat also on RDNA4 (bit-identical)

On RDNA4 a single-token row's dot product does not depend on the row count (one warp per row, no small_m variant), so
the V / K / Q projections can share one ksplit launch there too.  The combined launch may take two rows per block, so every
segment must have an even row count.  Needs the Q / K / V adjacency of 0001.  Stock r176 + 0001 on a Radeon AI PRO R9700:
Qwen3-30B-A3B tg128 163.05 -> 167.6 (+2.8 %), greedy server replies identical.  GGML_CUDA_MMVQ_ROW_CONCAT_RDNA4=0: off on RDNA4.
---
 ggml/src/ggml-cuda/mmvq.cu | 37 +++++++++++++++++++++++++------------
 1 file changed, 25 insertions(+), 12 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 194ab5598..0477308b0 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -3285,14 +3285,19 @@ int ggml_cuda_mul_mat_dual_output_try_fuse(ggml_backend_cuda_context & ctx, cons
 
 // Dense row concat: two or three 1-token matmuls over the same activation with the same weight type and K (e.g. the
 // V, K and Q projections of an attention layer) run as one ksplit launch, the rows of the others appended after the
-// largest weight.  Every row keeps its own unchanged dot product; RDNA3_0 only, where the launch config depends on the
-// row count only through small_m and the rows per block, which must agree for each weight and the total.
-// Returns the index offset of the last fused matmul.  GGML_CUDA_MMVQ_ROW_CONCAT=0: off.
+// largest weight.  Every row keeps its own unchanged dot product.  RDNA3_0: the launch config depends on the row count
+// only through small_m and the rows per block, which must agree for each weight and the total.  RDNA4: a row's dot
+// product does not depend on the row count at all (one warp, no small_m); the total may take two rows per block, so
+// every segment must have an even row count (Qwen3-30B-A3B -1 launch per layer).
+// Returns the index offset of the last fused matmul.  GGML_CUDA_MMVQ_ROW_CONCAT=0: off; GGML_CUDA_MMVQ_ROW_CONCAT_RDNA4=0:
+// off on RDNA4 only.
 int ggml_cuda_mul_mat_row_concat_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
     static const bool on = getenv("GGML_CUDA_MMVQ_ROW_CONCAT") == nullptr || atoi(getenv("GGML_CUDA_MMVQ_ROW_CONCAT")) != 0;
+    static const bool on_rdna4 = getenv("GGML_CUDA_MMVQ_ROW_CONCAT_RDNA4") == nullptr || atoi(getenv("GGML_CUDA_MMVQ_ROW_CONCAT_RDNA4")) != 0;
     ggml_tensor * node = cgraph->nodes[i];
+    const int table_id = get_device_table_id(ggml_cuda_info().devices[ctx.device].cc);
     if (!on || node->op != GGML_OP_MUL_MAT ||
-            get_device_table_id(ggml_cuda_info().devices[ctx.device].cc) != MMVQ_PARAMETERS_RDNA3_0) {
+            (table_id != MMVQ_PARAMETERS_RDNA3_0 && !(table_id == MMVQ_PARAMETERS_RDNA4 && on_rdna4))) {
         return 0;
     }
     const auto ok = [&](const ggml_tensor * t) {
@@ -3335,14 +3340,22 @@ int ggml_cuda_mul_mat_row_concat_try_fuse(ggml_backend_cuda_context & ctx, const
     for (int k = 0; k < n_mm; ++k) {
         total += mm[k]->ne[0];
     }
-    const bool small_m = mmvq_rdna3_0_small_m_weight(type, total);
-    const int rpb = calc_rows_per_block_weight(type, 1, MMVQ_PARAMETERS_RDNA3_0, false,
-                                               calc_nwarps_weight(type, 1, MMVQ_PARAMETERS_RDNA3_0, long_k, small_m));
-    for (int k = 0; k < n_mm; ++k) {
-        const int64_t n = mm[k]->ne[0];
-        if (mmvq_rdna3_0_small_m_weight(type, n) != small_m ||
-                (rpb > 1 && (n % rpb != 0 || n < rpb * GGML_MMVQ_RDNA4_WEIGHT_MIN_BLOCKS))) {
-            return 0;
+    if (table_id == MMVQ_PARAMETERS_RDNA4) {
+        for (int k = 0; k < n_mm; ++k) {
+            if (mm[k]->ne[0] % 2 != 0) {
+                return 0;
+            }
+        }
+    } else {
+        const bool small_m = mmvq_rdna3_0_small_m_weight(type, total);
+        const int rpb = calc_rows_per_block_weight(type, 1, MMVQ_PARAMETERS_RDNA3_0, false,
+                                                   calc_nwarps_weight(type, 1, MMVQ_PARAMETERS_RDNA3_0, long_k, small_m));
+        for (int k = 0; k < n_mm; ++k) {
+            const int64_t n = mm[k]->ne[0];
+            if (mmvq_rdna3_0_small_m_weight(type, n) != small_m ||
+                    (rpb > 1 && (n % rpb != 0 || n < rpb * GGML_MMVQ_RDNA4_WEIGHT_MIN_BLOCKS))) {
+                return 0;
+            }
         }
     }
     ggml_cuda_mm_fusion_args_host fusion_data{};
-- 
