+// Pre-touched spare buffers for context checkpoints.  A new checkpoint used to resize a fresh vector of ~100 MB:
+// the zero-fill and the first-touch page faults cost ~20 ms on the critical path, ~3 times per short chat turn.
+// A detached thread keeps K spares per kind (target / draft state) allocated, zero-filled and mlock'ed (so cgroup
+// reclaim cannot swap an idle spare out); a new checkpoint takes one instead.  Plain 4 KiB pages: no THP / madvise
+// (THP-backed heap under GPU copies crashed the server before).  The bytes a checkpoint holds are written by
+// llama_state_seq_get_data_ext exactly as before, so its contents are unchanged.  Sizes round up to 2 MiB (the slack a taken spare keeps) and grow
+// on a miss.  The pool is leaked on purpose (no static destruction while the thread runs).
+// LLAMA_CKPT_POOL=0: resize a fresh vector as before (A/B only).
+namespace {
+struct ckpt_pool {
+    static constexpr size_t K = 3;
+    std::mutex mtx;
+    std::condition_variable cv;
+    std::vector<std::vector<uint8_t>> spares[2];
+    size_t want[2] = { 0, 0 };
+    bool on = false;
+
+    ckpt_pool() {
+        const char * e = getenv("LLAMA_CKPT_POOL");
+        on = e == nullptr || atoi(e) != 0;
+        if (on) {
+            std::thread([this] { run(); }).detach();
+        }
+    }
+
+    static void lock_pages(std::vector<uint8_t> & v, bool lock) {
+#if !defined(_WIN32)
+        if (!v.empty()) {
+            if (lock) { (void) mlock(v.data(), v.size()); } else { (void) munlock(v.data(), v.size()); }
+        }
+#else
+        GGML_UNUSED(v); GGML_UNUSED(lock);
+#endif
+    }
+
+    bool take(int kind, std::vector<uint8_t> & dst, size_t n) {
+        bool ok = false;
+        std::vector<std::vector<uint8_t>> drop;
+        {
+            std::lock_guard<std::mutex> lk(mtx);
+            if (want[kind] < n) {
+                const size_t a = (size_t) 2 << 20;
+                want[kind] = (n + a - 1) / a * a;
+            }
+            auto & sp = spares[kind];
+            for (auto it = sp.begin(); it != sp.end(); ++it) {
+                if (it->size() >= n) {
+                    dst.swap(*it);
+                    sp.erase(it);
+                    ok = true;
+                    break;
+                }
+            }
+            // spares too small for the (grown) size are dropped, so the thread refills them at the new size
+            for (auto it = sp.begin(); it != sp.end(); ) {
+                if (it->size() < want[kind]) {
+                    drop.push_back(std::move(*it));
+                    it = sp.erase(it);
+                } else {
+                    ++it;
+                }
+            }
+        }
+        cv.notify_one();
+        for (auto & d : drop) {
+            lock_pages(d, false);
+        }
+        if (ok) {
+            lock_pages(dst, false);
+            dst.resize(n);   // shrink: no reallocation, no fill
+        }
+        return ok;
+    }
+
+    void run() {
+        for (;;) {
+            int kind = -1;
+            size_t n = 0;
+            {
+                std::unique_lock<std::mutex> lk(mtx);
+                cv.wait(lk, [&] { return (want[0] && spares[0].size() < K) || (want[1] && spares[1].size() < K); });
+                kind = want[0] && spares[0].size() < K ? 0 : 1;
+                n = want[kind];
+            }
+            std::vector<uint8_t> v(n);   // value-initialized: every page is touched here, off the critical path
+            lock_pages(v, true);
+            {
+                std::lock_guard<std::mutex> lk(mtx);
+                auto & sp = spares[kind];
+                if (v.size() >= want[kind] && sp.size() < K) {
+                    sp.push_back(std::move(v));
+                }
+            }
+            if (!v.empty()) {
+                lock_pages(v, false);
+            }
+        }
+    }
+};
+
+static bool ckpt_pool_take(int kind, std::vector<uint8_t> & dst, size_t n) {
+    static ckpt_pool * pool = new ckpt_pool();
+    return pool->on && dst.empty() && pool->take(kind, dst, n);
+}
