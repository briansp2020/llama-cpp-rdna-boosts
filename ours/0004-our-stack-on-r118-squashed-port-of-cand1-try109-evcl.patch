+        if (sscanf(line, "%lx-%lx %7s %lx %31s %lu %2047[^\n]", &lo, &hi, perms, &off, dev, &inode, path) < 7) {
+            continue;
+        }
+        if (a < lo || a >= hi || path[0] != '/') {
+            continue;
+        }
+        const size_t pg       = sreg_page();
+        const size_t file_off = (size_t) off + (size_t) (a - lo);
