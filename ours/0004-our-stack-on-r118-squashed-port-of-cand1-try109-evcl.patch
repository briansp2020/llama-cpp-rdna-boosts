+            if (p < cap_c) {
+                v[p]  = xv;
+                id[p] = (int32_t) (c0 + i);
+            }
+        }
+    }
+    __syncthreads();
+    if (tid == 0) {
+        tn[2*slot + 0] = min(s_n, cap_c);
+        tn[2*slot + 1] = s_flags | (s_n > cap_c ? 2 : 0);
+    }
+}
+
+// Stage 2: block row: the same selection over the row's chunk candidates, into the output record (ids + id_offset).
+static __global__ void __launch_bounds__(TOPK_ROWS_BLOCK, 1) topk_rows_merge_kernel(
+        const int k, const int cap_c, const int cap, const int nchunk, const int32_t id_offset,
+        const float * __restrict__ tv, const int32_t * __restrict__ ti, const int32_t * __restrict__ tn,
+        char * __restrict__ dst) {
+    const int       row = blockIdx.x;
+    const int       tid = threadIdx.x;
+    const int       n   = nchunk*cap_c;
+    const float   * v   = tv + (size_t) row*n;
+    const int32_t * id  = ti + (size_t) row*n;
+    const int32_t * cn  = tn + (size_t) row*nchunk*2;
+
+    char    * rec  = dst + (size_t) row*ggml_cuda_topk_rows_record_bytes(cap);
+    float   * vals = (float *) rec;
+    int32_t * ids  = (int32_t *) (rec + (size_t) cap*sizeof(float));
+    int32_t * meta = ids + cap;
+
+    __shared__ float s_max[TOPK_ROWS_BLOCK];
+    __shared__ int   s_n;
+    __shared__ int   s_flags;
+    __shared__ int   s_valid;
+    if (tid == 0) {
+        s_n     = 0;
+        s_flags = 0;
+        s_valid = 0;
+    }
+    __syncthreads();
+    int flags = 0;
+    int valid = 0;
+    for (int c = tid; c < nchunk; c += TOPK_ROWS_BLOCK) {
+        flags |= cn[2*c + 1];
+        valid += cn[2*c + 0];
+    }
+    if (flags) {
+        atomicOr(&s_flags, flags);
+    }
+    if (valid) {
+        atomicAdd(&s_valid, valid);
+    }
+    // slot i = (chunk i / cap_c, entry i % cap_c): strided over the threads, so every chunk's entries spread out
+    float m = -INFINITY;
+    for (int i = tid; i < n; i += TOPK_ROWS_BLOCK) {
+        if (i % cap_c < cn[2*(i / cap_c)]) {
+            m = v[i] > m ? v[i] : m;
+        }
+    }
+    s_max[tid] = m;
+    __syncthreads();
+    topk_rows_sort_desc(s_max);
+    const float thr = s_valid <= k ? -INFINITY : s_max[k - 1];
+    for (int i = tid; i < n; i += TOPK_ROWS_BLOCK) {
+        if (i % cap_c < cn[2*(i / cap_c)] && v[i] >= thr) {
+            const int p = atomicAdd(&s_n, 1);
+            if (p < cap) {
+                vals[p] = v[i];
+                ids[p]  = id[i] + id_offset;
+            }
+        }
+    }
+    __syncthreads();
+    if (tid == 0) {
+        meta[0] = min(s_n, cap);
+        meta[1] = (s_flags & 1) | ((s_flags & 2) || s_n > cap ? 2 : 0);
+    }
+}
+
+void ggml_cuda_topk_rows(ggml_cuda_pool & pool, cudaStream_t stream, const float * src, int64_t ncols, int64_t nrows,
+        int64_t stride, int k, int32_t id_offset, char * dst) {
+    GGML_ASSERT(k > 0 && k <= GGML_CUDA_TOPK_ROWS_MAX_K && k <= TOPK_ROWS_BLOCK);
+    if (nrows <= 0) {
+        return;
+    }
+    const int    cap    = ggml_cuda_topk_rows_cap(k);
+    const int    cap_c  = cap;
+    const int    nchunk = (int) ((ncols + TOPK_ROWS_CHUNK - 1)/TOPK_ROWS_CHUNK);
+    const size_t nslot  = (size_t) nrows*nchunk;
+    ggml_cuda_pool_alloc<float>   tv(pool, nslot*cap_c);
+    ggml_cuda_pool_alloc<int32_t> ti(pool, nslot*cap_c);
+    ggml_cuda_pool_alloc<int32_t> tn(pool, nslot*2);
+    topk_rows_chunk_kernel<<<dim3(nchunk, (unsigned) nrows), TOPK_ROWS_BLOCK, 0, stream>>>(
+            src, ncols, stride, k, cap_c, tv.get(), ti.get(), tn.get());
+    topk_rows_merge_kernel<<<(unsigned) nrows, TOPK_ROWS_BLOCK, 0, stream>>>(
+            k, cap_c, cap, nchunk, id_offset, tv.get(), ti.get(), tn.get(), dst);
+    CUDA_CHECK(cudaGetLastError());
+}
