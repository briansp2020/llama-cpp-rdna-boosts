+        return false;
+    }
+    if (t.dr_device < 0 && !devremap_alloc_locked(t)) {
+        return false;
+    }
+    const cudaStream_t s = (cudaStream_t) stream;
+    const bool    do2d = t.split_axis == 0 && t.host_pitch != 0;
+    const int64_t rows = do2d ? (int64_t) (t.host_bytes / t.host_pitch) : 0;
+    if (do2d && rows <= 0) {
+        return false;
+    }
+    const auto inplace_slot = [&](int32_t e) {
+        const auto it = t.expert_slot.find(e);
+        return it != t.expert_slot.end() && it->second >= 0 && it->second < t.slots - 1;
+    };
+    std::vector<uint8_t> used((size_t) t.n_experts, 0);
+    for (int64_t tok = 0; tok < n_tok; tok++) {
+        for (int64_t j = 0; j < n_used; j++) {
+            const int32_t e = *(const int32_t *) ((const char *) ids + (size_t) tok * ids_nb1 + (size_t) j * ids_nb0);
+            if (e < 0 || e >= t.n_experts) {
+                return false;
+            }
+            used[(size_t) e] = 1;
+        }
+    }
+    // stage: used experts not read in place, plus the successor of each; in place: the other used experts.
+    // pad: the unused successor of an in-place expert.  MMQ reads up to 512 bytes past an expert; the compact kernel
+    // reads an in-place expert (and so its tail) from the arena, but a consumer that reads the whole staged table
+    // (any non-compact path, after resolve copies the in-place bodies too) needs those bytes to be the neighbour's real
+    // (finite) data, as the plain fill provides, not whatever the compute buffer held before.  The pads are packed
+    // last and copied only by that full resolve.
+    std::vector<uint8_t> stage((size_t) t.n_experts, 0);
+    std::vector<uint8_t> pad((size_t) t.n_experts, 0);
+    for (int32_t e = 0; e < t.n_experts; e++) {
+        if (used[(size_t) e] && !inplace_slot(e)) {
+            stage[(size_t) e] = 1;
+            if (e + 1 < t.n_experts) {
+                stage[(size_t) e + 1] = 1;
+            }
+        }
+    }
+    for (int32_t e = 0; e + 1 < t.n_experts; e++) {
+        if (used[(size_t) e] && !used[(size_t) e + 1] && !stage[(size_t) e + 1]) {
+            pad[(size_t) e + 1] = 1;
+        }
+    }
+    const size_t n = (size_t) t.n_experts;
+    t.route_pack.resize(n * (sizeof(void *) + sizeof(int32_t) + 1));
+    const char ** srcs = (const char **) t.route_pack.data();
+    int32_t *     eids = (int32_t *) (t.route_pack.data() + n * sizeof(void *));
+    uint8_t *     cold = t.route_pack.data() + n * (sizeof(void *) + sizeof(int32_t));
+    int k = 0;
+    const auto add = [&](int32_t e) -> bool {
+        const auto it = t.expert_slot.find(e);
+        if (it != t.expert_slot.end()) {
+            srcs[k] = (const char *) t.arena + (size_t) it->second * t.expert_bytes;
+            cold[k] = 0;
+        } else if (t.ram_base != nullptr) {
+            if (t.ram_slot[(size_t) e] < 0) {
+                return false;
+            }
+            srcs[k] = t.ram_base + (size_t) t.ram_slot[(size_t) e] * t.expert_bytes;
+            cold[k] = 0;
+        } else {
+            if (!sparse_need_locked(t, e)) {
+                return false;
+            }
+            srcs[k] = (const char *) t.host_dev + (size_t) e * t.host_bytes + t.src_off;
+            cold[k] = 1;
+        }
+        eids[k++] = e;
+        return true;
+    };
+    for (int32_t e = 0; e < t.n_experts; e++) {
+        if (stage[(size_t) e] && !add(e)) {
+            return false;
+        }
+    }
+    const int k_stage = k;
+    for (int32_t e = 0; e < t.n_experts; e++) {
+        if (used[(size_t) e] && !stage[(size_t) e] && !add(e)) {
+            return false;
+        }
+    }
+    const int k_in = k - k_stage;
+    for (int32_t e = 0; e < t.n_experts; e++) {
+        if (pad[(size_t) e] && !add(e)) {
+            return false;
+        }
+    }
+    const int k_pad = k - k_stage - k_in;
+
+    device_guard dg(t.device);
+    // the map the kernel reads: current residency (re-uploaded only after a change; decline while the previous upload
+    // still reads the staging buffer)
+    if (t.slot_dirty || !t.dr_map_ok) {
+        if (cudaEventQuery(t.dr_map_ev) != cudaSuccess) {
+            (void) cudaGetLastError();
+            return false;
+        }
+        for (int e = 0; e < t.n_experts; e++) {
+            t.dr_map_host[e] = t.slots + e;
+        }
+        for (int sl = 0; sl < t.slots && sl < (int) t.slot_expert.size(); sl++) {
+            const int32_t e = t.slot_expert[sl];
+            if (e >= 0 && e < t.n_experts) {
+                t.dr_map_host[e] = sl;
+            }
+        }
+        moe_cache_copy_kernel<<<4, 256, 0, s>>>((char *) t.dr_map_dev, (const char *) t.dr_map_hdev,
+                                                (size_t) t.n_experts * sizeof(int32_t));
+        if (cudaGetLastError() != cudaSuccess) {
+            (void) cudaGetLastError();
+            t.dr_map_ok = false;
+            return false;
+        }
+        (void) cudaEventRecord(t.dr_map_ev, s);
+        t.slot_dirty = false;
+        t.dr_map_ok  = true;
+    }
+    if (k > 0) {
+        if (t.route_dev == nullptr && cudaMalloc(&t.route_dev, t.route_pack.size()) != cudaSuccess) {
+            (void) cudaGetLastError();
+            t.route_dev = nullptr;
+            return false;
+        }
+        if (cudaMemcpyAsync(t.route_dev, t.route_pack.data(), t.route_pack.size(), cudaMemcpyHostToDevice, s) != cudaSuccess) {
+            (void) cudaGetLastError();
+            return false;
+        }
+    }
+    if (t.pf_pending) {
+        GGML_LOG_ERROR("%s: layer=%d role=%s device=%d: the previous prefill fill was never resolved by its consumer\n",
+                       __func__, t.layer, t.role.c_str(), t.device);
+    }
+    t.pf_pending = true;
+    t.pf_dst     = weight_cpy->data;
+    t.pf_k_stage = k_stage;
+    t.pf_k_in    = k_in;
+    t.pf_k_pad   = k_pad;
+    t.pf_rows    = rows;
+    t.pf_do2d    = do2d;
+    g_alias_to_id[weight_cpy] = (int) (&t - g_tables.data());
+    g_route_fills++;
+    return true;
+}
+
+// ---- wip/prefill-prefetch (GGML_MOE_PF_PREFETCH=1) ----
+static __global__ void moe_cache_pf_fill_kernel(char * __restrict__ dst, const char * __restrict__ arena,
+                                                const char * __restrict__ stage, const int32_t * __restrict__ map,
+                                                int inpl, int64_t expert_bytes) {
+    const int     e = blockIdx.y;
+    const int32_t m = map[e];
+    const char *  s = m < inpl ? arena + (int64_t) m * expert_bytes : stage + (int64_t) (m - inpl) * expert_bytes;
+    char *        d = dst + (int64_t) e * expert_bytes;
+    const int64_t chunk = 4096;
+    for (int64_t o = (int64_t) blockIdx.x * chunk; o < expert_bytes; o += (int64_t) gridDim.x * chunk) {
+        const int64_t n = expert_bytes - o < chunk ? expert_bytes - o : chunk;
+        moe_cache_policy_copy(d + o, s + o, (size_t) n, threadIdx.x, blockDim.x);
+    }
+}
+
+static __global__ void moe_cache_pf_copy1_kernel(char * __restrict__ dst, const char * __restrict__ src, int64_t bytes) {
+    const int64_t chunk = 4096;
+    for (int64_t o = (int64_t) blockIdx.x * chunk; o < bytes; o += (int64_t) gridDim.x * chunk) {
+        const int64_t n = bytes - o < chunk ? bytes - o : chunk;
+        moe_cache_policy_copy(dst + o, src + o, (size_t) n, threadIdx.x, blockDim.x);
+    }
+}
+
+namespace {
+struct pf_dev_t {
+    bool         tried = false;
+    bool         ok    = false;
+    cudaStream_t cs    = nullptr;                 // copy stream
+    char *       buf[2]      = { nullptr, nullptr };
+    size_t       buf_bytes   = 0;
+    cudaEvent_t  ev_free[2]  = { nullptr, nullptr };   // compute stream: the buffer's earlier readers are behind this
+    cudaEvent_t  ev_ready[2] = { nullptr, nullptr };   // copy stream: the buffer is filled
+    std::map<int, std::vector<int>> layer_tables;      // layer -> table ids laid out in the staging
+    int          cur_layer   = -1;
+    int          cur_buf     = -1;
+    int          ahead_layer = -1;
+    int          ahead_buf   = -1;
+    uint64_t     ahead_seq   = 0;
+    int64_t      n_hit = 0, n_miss = 0, n_map = 0, n_take = 0;
+};
+pf_dev_t g_pf[16];
+}
+
+static size_t pf_align(size_t x) { return (x + 255) & ~(size_t) 255; }
+
+static bool pf_table_ok(const table_t & t, int device) {
+    return g_sized && !g_tier_off && t.host_sparse && !t.sparse_off && t.arena != nullptr && t.slots >= 2 &&
+           !t.identity && t.device == device && t.ram_base != nullptr && t.ram_bytes > 0 && t.expert_bytes > 0 &&
+           t.n_experts > 0 && (int) t.slot_expert.size() == t.slots && (int) t.ram_slot.size() == t.n_experts;
+}
+
+static bool pf_init_locked(pf_dev_t & P, int device) {
+    if (P.tried) {
+        return P.ok;
+    }
+    P.tried = true;
+    size_t maxb = 0;
+    for (int id = 0; id < (int) g_tables.size(); id++) {
+        table_t & t = g_tables[id];
+        if (pf_table_ok(t, device) && t.ram_bytes >= t.expert_bytes) {
+            P.layer_tables[t.layer].push_back(id);
+        }
+    }
+    device_guard dg(device);
+    int n_tab = 0;
+    for (auto & kv : P.layer_tables) {
+        std::vector<int> & v = kv.second;
+        std::sort(v.begin(), v.end(), [](int a, int b) { return g_tables[a].role < g_tables[b].role; });
+        size_t off = 0;
+        for (int id : v) {
+            table_t & t = g_tables[id];
+            t.pf_ram_n = t.ram_bytes / t.expert_bytes;
+            t.pf_off   = (int64_t) off;
+            off += pf_align((t.pf_ram_n + 2) * t.expert_bytes);   // the mirror, the scratch slot, a zeroed pad slot
+            const size_t mb = (size_t) t.n_experts * sizeof(int32_t);
+            if (cudaMalloc((void **) &t.pf_map_dev, mb) != cudaSuccess ||
+                cudaHostAlloc((void **) &t.pf_map_host, mb, cudaHostAllocPortable | cudaHostAllocMapped) != cudaSuccess ||
+                cudaHostGetDevicePointer((void **) &t.pf_map_hdev, t.pf_map_host, 0) != cudaSuccess ||
+                cudaEventCreateWithFlags(&t.pf_map_ev, cudaEventDisableTiming) != cudaSuccess) {
+                (void) cudaGetLastError();
+                GGML_LOG_WARN("%s: device %d: map allocation failed; prefill prefetch off\n", __func__, device);
+                return false;
+            }
+            t.pf_map_last.clear();
+            n_tab++;
+        }
+        maxb = std::max(maxb, off);
+    }
+    if (maxb == 0) {
+        GGML_LOG_WARN("%s: device %d: no table with a RAM tier; prefill prefetch off\n", __func__, device);
+        return false;
+    }
+    if (cudaStreamCreateWithFlags(&P.cs, cudaStreamNonBlocking) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return false;
+    }
+    for (int b = 0; b < 2; b++) {
+        if (cudaMalloc((void **) &P.buf[b], maxb) != cudaSuccess ||
+            cudaEventCreateWithFlags(&P.ev_free[b], cudaEventDisableTiming) != cudaSuccess ||
+            cudaEventCreateWithFlags(&P.ev_ready[b], cudaEventDisableTiming) != cudaSuccess) {
+            (void) cudaGetLastError();
+            GGML_LOG_WARN("%s: device %d: 2 x %.1f MiB staging allocation failed; prefill prefetch off\n", __func__,
+                          device, maxb / 1048576.0);
+            return false;
+        }
+        (void) cudaMemsetAsync(P.buf[b], 0, maxb, P.cs);   // finite pad bytes past the last staged expert
+    }
+    P.buf_bytes = maxb;
+    P.ok = true;
+    GGML_LOG_WARN("moe_cache prefill prefetch: device %d: %d tables in %zu layers, staging 2 x %.1f MiB\n", device,
+                  n_tab, P.layer_tables.size(), maxb / 1048576.0);
+    return true;
+}
+
+// expert -> in-place slot (< inpl) or inpl + staging index: RAM-tier slot r -> r, the scratch slot's expert -> pf_ram_n
+static bool pf_build_map_locked(const table_t & t, std::vector<int32_t> & m) {
+    const int32_t inpl = t.slots - 1;
+    m.assign((size_t) t.n_experts, -1);
+    for (int32_t e = 0; e < t.n_experts; e++) {
+        const auto    it = t.expert_slot.find(e);
+        const int32_t sl = it != t.expert_slot.end() ? it->second : -1;
+        if (sl >= 0 && sl < inpl) {
+            m[(size_t) e] = sl;
+        } else if (sl == inpl) {
+            m[(size_t) e] = inpl + (int32_t) t.pf_ram_n;
+        } else {
+            const int32_t r = t.ram_slot[(size_t) e];
+            if (r < 0 || (size_t) r >= t.pf_ram_n) {
+                return false;   // a cold (file) expert: not in the mirror
+            }
+            m[(size_t) e] = inpl + r;
+        }
+    }
+    return true;
+}
+
+// Fill staging buffer b with layer L's tables on the copy stream, after everything enqueued on `s` so far.
+static void pf_issue_locked(pf_dev_t & P, int L, int b, cudaStream_t s) {
+    (void) cudaEventRecord(P.ev_free[b], s);
+    (void) cudaStreamWaitEvent(P.cs, P.ev_free[b], 0);
+    for (int id : P.layer_tables[L]) {
+        table_t & t   = g_tables[id];
+        char *    dst = P.buf[b] + t.pf_off;
+        (void) cudaMemcpyAsync(dst, t.ram_base, t.pf_ram_n * t.expert_bytes, cudaMemcpyHostToDevice, P.cs);
+        // Zero the scratch and pad slots on every fill: regions of different layers overlap in this buffer, so bytes zeroed
+        // once at init can hold another table's data, and MMQ reads past the last expert (a foreign quant type there can
+        // decode to inf / NaN scales).  The consumer copies the scratch expert, if any, over its slot.
+        (void) cudaMemsetAsync(dst + t.pf_ram_n * t.expert_bytes, 0, 2 * t.expert_bytes, P.cs);
+        // The scratch slot's expert is copied by the consumer (moe_cache_prefill_resolve): that slot is the cache's
+        // staging slot, so its bytes are settled only at the op, which is where the in-place path reads them too.
+    }
+    (void) cudaEventRecord(P.ev_ready[b], P.cs);
+    if (cudaGetLastError() != cudaSuccess) {
+        GGML_ABORT("moe_cache prefill prefetch: device copy enqueue failed (layer %d)", L);
+    }
+}
+
+static bool moe_cache_pf_take(const ggml_tensor * weight, const ggml_tensor * weight_cpy, void * stream, int device,
+                              bool check_only) {
+    if (!g_enabled || weight == nullptr || weight_cpy == nullptr || weight_cpy->data == nullptr || stream == nullptr ||
+        device < 0 || device >= 16) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(g_mutex);
+    const auto it = g_key_to_id.find({ (const void *) weight, device });
+    if (it == g_key_to_id.end() || it->second < 0 || it->second >= (int) g_tables.size()) {
+        return false;
+    }
+    const int  id = it->second;
+    table_t &  t  = g_tables[id];
+    pf_dev_t & P  = g_pf[device];
+    if (!pf_table_ok(t, device) || !pf_init_locked(P, device) || t.pf_off < 0) {
+        return false;
+    }
+    std::vector<int32_t> m;
+    if (!pf_build_map_locked(t, m)) {
+        return false;
+    }
+    const bool map_changed = m != t.pf_map_last;
+    if (map_changed && cudaEventQuery(t.pf_map_ev) != cudaSuccess) {
+        (void) cudaGetLastError();   // the previous map upload still reads the pinned source
+        return false;
+    }
+    if (check_only) {
+        return true;
+    }
+    const cudaStream_t s = (cudaStream_t) stream;
+    device_guard dg(device);
+    if (map_changed) {
+        memcpy(t.pf_map_host, m.data(), m.size() * sizeof(int32_t));
+        moe_cache_copy_kernel<<<4, 256, 0, s>>>((char *) t.pf_map_dev, (const char *) t.pf_map_hdev, m.size() * sizeof(int32_t));
+        (void) cudaEventRecord(t.pf_map_ev, s);
+        t.pf_map_last = std::move(m);
+        P.n_map++;
+    }
+    const int L = t.layer;
+    if (L != P.cur_layer) {
+        const uint64_t seq = g_pf_policy_seq.load();
+        int b;
+        if (P.ahead_layer == L && P.ahead_seq == seq) {
+            b = P.ahead_buf;
+            P.n_hit++;
+        } else {
+            b = P.cur_buf < 0 ? 0 : (P.cur_buf ^ 1);
+            pf_issue_locked(P, L, b, s);
+            P.n_miss++;
+        }
+        (void) cudaStreamWaitEvent(s, P.ev_ready[b], 0);
+        P.cur_layer = L;
+        P.cur_buf   = b;
+        const auto nx = P.layer_tables.upper_bound(L);
+        if (nx != P.layer_tables.end()) {
+            pf_issue_locked(P, nx->first, b ^ 1, s);
+            P.ahead_layer = nx->first;
+            P.ahead_buf   = b ^ 1;
+            P.ahead_seq   = seq;
+        } else {
+            P.ahead_layer = -1;
+        }
+        if ((P.n_hit + P.n_miss) % 1000 == 0) {
+            GGML_LOG_WARN("moe_cache prefill prefetch: device %d: %lld layers (%lld ahead, %lld on demand), %lld map uploads, %lld tables\n",
+                          device, (long long) (P.n_hit + P.n_miss), (long long) P.n_hit, (long long) P.n_miss,
+                          (long long) P.n_map, (long long) P.n_take);
+        }
+    }
+    P.n_take++;
+    t.dr_lag_n     = 0;
+    t.remap_n_used = 0;
+    if (t.pf_pending) {
+        GGML_LOG_ERROR("%s: layer=%d role=%s device=%d: the previous prefill fill was never resolved by its consumer\n",
+                       __func__, t.layer, t.role.c_str(), t.device);
+    }
+    t.pf_pending = true;
+    t.pf_pref    = true;
+    t.pf_scratch = false;
+    for (int32_t v : t.pf_map_last) {
+        if (v == t.slots - 1 + (int32_t) t.pf_ram_n) {
+            t.pf_scratch = true;
+            break;
+        }
+    }
+    t.pf_stage   = P.buf[P.cur_buf] + t.pf_off;
+    t.pf_dst     = weight_cpy->data;
+    g_alias_to_id[weight_cpy] = id;
+    return true;
+}
+
+bool moe_cache_prefill_resolve(const ggml_tensor * weight_cpy, int device, void * stream, bool inplace,
+                               const char ** arena, const int32_t ** map, int64_t * arena_bytes, int * slots,
+                               const char ** stage) {
+    if (!g_enabled || !g_prefill_inplace || weight_cpy == nullptr) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(g_mutex);
+    table_t * tp = nullptr;
+    const auto it = g_alias_to_id.find(weight_cpy);
+    if (it != g_alias_to_id.end() && it->second >= 0 && it->second < (int) g_tables.size()) {
+        tp = &g_tables[it->second];
+    }
+    if (tp == nullptr || !tp->pf_pending || tp->device != device || tp->pf_dst != weight_cpy->data) {
+        // a meta graph rebuild can hand the op a different tensor pointer than the hook saw: match the buffer
+        tp = nullptr;
+        for (table_t & c : g_tables) {
+            if (c.pf_pending && c.device == device && c.pf_dst == weight_cpy->data) {
+                tp = &c;
+                break;
+            }
+        }
+        if (tp == nullptr) {
+            return false;
+        }
+    }
+    table_t & t = *tp;
+    t.pf_pending = false;
+    if (t.pf_pref) {
+        t.pf_pref = false;
+        if (t.pf_scratch) {
+            moe_cache_pf_copy1_kernel<<<16, 256, 0, (cudaStream_t) stream>>>(
+                (char *) t.pf_stage + t.pf_ram_n * t.expert_bytes,
+                (const char *) t.arena + (size_t) (t.slots - 1) * t.expert_bytes, (int64_t) t.expert_bytes);
+        }
+        if (!inplace || stage == nullptr) {
+            // a consumer that reads the whole table: every expert from the arena or the staging
+            moe_cache_pf_fill_kernel<<<dim3(16, (unsigned) t.n_experts), 256, 0, (cudaStream_t) stream>>>(
+                (char *) t.pf_dst, (const char *) t.arena, t.pf_stage, t.pf_map_dev, t.slots - 1, (int64_t) t.expert_bytes);
+            const cudaError_t err = cudaGetLastError();
+            if (err != cudaSuccess) {
+                GGML_ABORT("%s: layer=%d role=%s: prefetched fill launch failed: %s", __func__, t.layer, t.role.c_str(),
+                           cudaGetErrorString(err));
+            }
+            return false;
+        }
+        if (arena)       *arena       = (const char *) t.arena;
+        if (map)         *map         = t.pf_map_dev;
+        if (arena_bytes) *arena_bytes = (int64_t) t.expert_bytes;
+        if (slots)       *slots       = t.slots - 1;
+        *stage = t.pf_stage;
+        return true;
+    }
+    const int k = inplace ? t.pf_k_stage : t.pf_k_stage + t.pf_k_in + t.pf_k_pad;
+    if (k > 0) {
+        const size_t n  = (size_t) t.n_experts;
+        const char * rd = (const char *) t.route_dev;
+        moe_cache_route_kernel<<<dim3(16, (unsigned) k), 256, 0, (cudaStream_t) stream>>>(
+            (char *) t.pf_dst, (const char * const *) rd, (const int32_t *) (rd + n * sizeof(void *)),
+            (const uint8_t *) (rd + n * (sizeof(void *) + sizeof(int32_t))),
+            (int64_t) t.expert_bytes, t.pf_rows, t.pf_rows > 0 ? (int64_t) (t.expert_bytes / (size_t) t.pf_rows) : 0,
