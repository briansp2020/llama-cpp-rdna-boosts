+int ggml_backend_meta_tensor_row_pieces(ggml_backend_t meta_backend, const struct ggml_tensor * tensor,
+        struct ggml_backend_meta_row_piece * pieces, int max_pieces) {
+    if (meta_backend == nullptr || !ggml_backend_is_meta(meta_backend) || tensor->buffer == nullptr ||
+            !ggml_backend_buffer_is_meta(tensor->buffer)) {
+        return -2;
+    }
+    if (tensor->ne[2] != 1 || tensor->ne[3] != 1 || max_pieces < 1) {
+        return -1;
+    }
+    const size_t n_bufs = ggml_backend_meta_buffer_n_bufs(tensor->buffer);
+    const ggml_backend_meta_split_state split_state = ggml_backend_meta_get_split_state(tensor, /*assume_sync =*/ false);
+    if (split_state.axis == GGML_BACKEND_SPLIT_AXIS_MIRRORED) {
+        pieces[0] = { ggml_backend_meta_simple_backend(meta_backend, 0), ggml_backend_meta_buffer_simple_tensor(tensor, 0), 0, 0, tensor->ne[0] };
+        return 1;
+    }
+    if (split_state.axis != GGML_BACKEND_SPLIT_AXIS_0 || ggml_blck_size(tensor->type) != 1) {
+        return -1;
+    }
+    int     n        = 0;
+    int64_t col_full = 0;
+    if (split_state.n_segments != 1 || split_state.nr[0] != 1) {
+        std::vector<int64_t> col_simple(n_bufs, 0);
+        for (size_t s = 0; s < split_state.n_segments; s++) {
+            for (size_t r = 0; r < split_state.nr[s]; r++) {
+                for (size_t j = 0; j < n_bufs; j++) {
+                    const int64_t ne = split_state.ne[s*n_bufs + j];
+                    if (ne == 0) {
+                        continue;
+                    }
+                    if (n == max_pieces) {
+                        return -1;
+                    }
+                    pieces[n++] = { ggml_backend_meta_simple_backend(meta_backend, j), ggml_backend_meta_buffer_simple_tensor(tensor, j),
+                                    col_simple[j], col_full, ne };
+                    col_simple[j] += ne;
+                    col_full      += ne;
+                }
+            }
+        }
+    } else {
+        for (size_t j = 0; j < n_bufs; j++) {
+            const ggml_tensor * simple = ggml_backend_meta_buffer_simple_tensor(tensor, j);
+            if (simple->ne[0] == 0) {
+                continue;
+            }
+            if (n == max_pieces) {
+                return -1;
+            }
+            pieces[n++] = { ggml_backend_meta_simple_backend(meta_backend, j), simple, 0, col_full, simple->ne[0] };
+            col_full += simple->ne[0];
+        }
+    }
+    if (col_full != tensor->ne[0]) {
+        return -1;
+    }
+    return n;
+}
