+#include "topk-rows.cuh"
+
+// Candidate selection by a threshold instead of an exact top-K: in each block every thread takes the max of its share,
+// the block sorts the thread maxima and takes the K-th largest as the threshold L, and every element >= L is kept.
+// At least K elements are >= L (K threads hold one), and every element left out is < L, i.e. below at least K kept
+// ones; that is all the sampler needs (llama_get_logits_topk_ith), with no tie handling: equal values are all kept.
+// Applied per 4096-column chunk, then per row over the chunks' candidates (the property composes).  A row whose
+// candidates do not fit (more than cap) or that holds a NaN is flagged, and the caller reads it in full.
+
+static constexpr int TOPK_ROWS_BLOCK = 256;
+static constexpr int TOPK_ROWS_CHUNK = 4096;
+// stage 2 relies on a chunk's cap_c = 4K entries landing on distinct threads (slot i -> thread i % TOPK_ROWS_BLOCK), so
+// a chunk that kept >= K values gives >= K threads a valid maximum (otherwise thr = -inf, overflow, full read)
+static_assert(4*GGML_CUDA_TOPK_ROWS_MAX_K <= TOPK_ROWS_BLOCK, "a chunk's candidates must fit one slot per thread");
+
+// descending bitonic sort of s[0, TOPK_ROWS_BLOCK) in shared memory, one element per thread
+static __device__ void topk_rows_sort_desc(float * s) {
+    const int tid = threadIdx.x;
+    for (int size = 2; size <= TOPK_ROWS_BLOCK; size <<= 1) {
+        for (int stride = size >> 1; stride > 0; stride >>= 1) {
+            const int partner = tid ^ stride;
+            if (partner > tid) {
+                const bool  desc = (tid & size) == 0;
+                const float a    = s[tid];
+                const float b    = s[partner];
+                if (desc ? a < b : a > b) {
+                    s[tid]     = b;
+                    s[partner] = a;
+                }
+            }
+            __syncthreads();
+        }
+    }
+}
+
+// Stage 1: block (chunk, row): the chunk's candidates (count, values, column ids) in the chunk's slot, flags bit 0 =
+// NaN, bit 1 = overflow (more than cap_c candidates).
+static __global__ void __launch_bounds__(TOPK_ROWS_BLOCK, 1) topk_rows_chunk_kernel(
+        const float * __restrict__ src, const int64_t ncols, const int64_t stride, const int k, const int cap_c,
+        float * __restrict__ tv, int32_t * __restrict__ ti, int32_t * __restrict__ tn) {
+    const int     c      = blockIdx.x;
+    const int     row    = blockIdx.y;
+    const int     nchunk = gridDim.x;
+    const int64_t c0     = (int64_t) c*TOPK_ROWS_CHUNK;
+    const int     n      = (int) min((int64_t) TOPK_ROWS_CHUNK, ncols - c0);
+    const float * x      = src + (int64_t) row*stride + c0;
