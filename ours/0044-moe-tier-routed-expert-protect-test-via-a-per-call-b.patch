Subject: [PATCH 44/49] moe tier: routed-expert protect test via a per-call
 bitmap instead of a linear scan per candidate (GGML_MOE_PROTECT_BITMAP=0:
 scan)

(cherry picked from commit a082fe0343078b09fd4b4b30918102cd825b0923)
(cherry picked from commit 3bc75f2cc5adf57b98db50e7041934db0caf4a8c)
---
 ggml/src/ggml-cuda/moe-expert-tier.inc | 71 ++++++++++++++++++--------
 1 file changed, 51 insertions(+), 20 deletions(-)

diff --git a/ggml/src/ggml-cuda/moe-expert-tier.inc b/ggml/src/ggml-cuda/moe-expert-tier.inc
index 172af09ce4..eb1bf2dfad 100644
--- a/ggml/src/ggml-cuda/moe-expert-tier.inc
+++ b/ggml/src/ggml-cuda/moe-expert-tier.inc
@@ -965,6 +965,49 @@ static void kvl_seg_seed_locked(table_t & t, void * stream) {
 // Phase 1: a decode miss served cold (no arena admission) enters this table's share: a free lent slot while the share
 // is not full, else it displaces the share's least-used resident (decaying count, then oldest use) when its demand since
 // it was last resident (ghost) exceeds that resident's count.  GGML_MOE_KV_SEG_TOUCH (default 2): touches needed first.
+// GGML_MOE_PROTECT_BITMAP (on unless 0): the policy's "is this one of the call's routed experts" test reads a bitmap
+// built once per call instead of scanning the protect list for every candidate.  The decode victim search scanned the
+// 40-entry list for each of a table's ~350 slots on every miss: ~6 ms of host time per decode step (FINDINGS 1055).
+// contains() gives the scan's answer for every id (ids < 0 or >= 1024 fall back to the scan), so no decision changes.
+static bool protect_bitmap_on() {
+    static const bool v = !getenv("GGML_MOE_PROTECT_BITMAP") || atoi(getenv("GGML_MOE_PROTECT_BITMAP")) != 0;
+    return v;
+}
+struct protect_set {
+    static constexpr int32_t kMax = 1024;
+    const int32_t * p;
+    int             n;
+    bool            bm = false;
+    uint64_t        w[kMax / 64];
+    protect_set(const int32_t * p_, int n_) : p(p_), n(n_) {
+        if (!protect_bitmap_on() || n <= 0) {
+            return;
+        }
+        bm = true;
+        for (int i = 0; i < kMax / 64; i++) {
+            w[i] = 0;
+        }
+        for (int i = 0; i < n; i++) {
+            if (p[i] >= 0 && p[i] < kMax) {
+                w[p[i] >> 6] |= 1ull << (p[i] & 63);
+            }
+        }
+    }
+    bool scan(int32_t e) const {
+        for (int i = 0; i < n; i++) {
+            if (p[i] == e) {
+                return true;
+            }
+        }
+        return false;
+    }
+    bool contains(int32_t e) const {
+        if (bm && e >= 0 && e < kMax) {
+            return (w[e >> 6] >> (e & 63)) & 1;
+        }
+        return scan(e);
+    }
+};
 static bool seg_tier_on() {
     static const bool v = !getenv("GGML_MOE_KV_SEG_TIER") || atoi(getenv("GGML_MOE_KV_SEG_TIER")) != 0;
     return v;
@@ -998,6 +1041,7 @@ static void kvl_seg_admit_locked(table_t & t, int32_t e, void * stream, const in
     bool repl = false;
     if (i < 0) {
         // the least-used resident of the share, never one this batch routes; a copy of an arena resident goes first
