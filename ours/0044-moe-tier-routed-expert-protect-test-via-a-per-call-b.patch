                 continue;
             }
             const bool dup = t.expert_slot.find(x) != t.expert_slot.end();
@@ -1445,9 +1485,10 @@ static void precopy_plan_locked(table_t & t, void * stream, const int32_t * prot
     device_guard dg(t.device);
     std::vector<int32_t> cand;
     cand.reserve((size_t) t.slots);
+    const protect_set prot(protect, n_protect);
     for (int sl = 0; sl < t.slots; sl++) {
         const int32_t e = t.slot_expert[(size_t) sl];
-        if (e < 0 || std::find(protect, protect + n_protect, e) != protect + n_protect) {
+        if (e < 0 || prot.contains(e)) {
             continue;
         }
         cand.push_back(e);
@@ -2207,13 +2248,10 @@ static int force_admit_locked(table_t & t, int32_t expert, void * stream, const
     }
     if (slot < 0) {
         // the victim rule of access_locked: the smallest decaying count, tie -> oldest use, never this call's experts
+        const protect_set prot(protect, n_protect);
         for (int s = 0; s < t.slots; s++) {
             const int32_t e = t.slot_expert[s];
-            bool prot = false;
-            for (int i = 0; i < n_protect && !prot; i++) {
-                prot = protect[i] == e;
-            }
-            if (e < 0 || prot) { continue; }
+            if (e < 0 || prot.contains(e)) { continue; }
             if (victim < 0 || t.count[e] < t.count[victim] ||
                 (t.count[e] == t.count[victim] && t.last[e] < t.last[victim])) {
                 victim = e;
@@ -3866,14 +3904,6 @@ static moe_cache_alias tier_access_locked(table_t & t, int32_t expert, void * st
     // (Sparse masters register lazily: every in-place cold read takes its expert id from the pass-2 remap of
