         int32_t worst = -1;
         bool    worst_dup = false;
         for (int32_t x = 0; x < t.n_experts; x++) {
@@ -1005,11 +1049,7 @@ static void kvl_seg_admit_locked(table_t & t, int32_t e, void * stream, const in
             if (k < 0 || (int) k == g_kvl_pin || fb_kv_busy(k) || !kvl_avail(g_kvl_slots[(size_t) k])) {
                 continue;
             }
-            bool routed = false;
-            for (int j = 0; j < n_protect && !routed; j++) {
-                routed = protect[j] == x;
-            }
-            if (routed) {
