From ee7573c69560162a22d56711bf9aab2a978bba89 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Sat, 31 Oct 2026 15:32:19 +0000
Subject: [PATCH 18/23] MoE expert dedup: at most 2 pairs per owner warp, only
 the owner's activation loaded ahead

A group of more than GGML_CUDA_MOE_DDK (2) pairs is split into chunks, each computed by its first pair.  Cuts the dedup
instantiations registers (gfx1100: IQ3_S pfiq2 187 -> 103 VGPRs, occupancy 8 -> 12; IQ4_NL down 107 -> 63, 12 -> 16),
so a launch without groups costs +7 % instead of +16..+28 %.  Same per-pair arithmetic: bit-identical.
---
 ggml/src/ggml-cuda/mmvq-moe.cu | 38 +++++++++++++++++++++-------------
 1 file changed, 24 insertions(+), 14 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmvq-moe.cu b/ggml/src/ggml-cuda/mmvq-moe.cu
index 653d28b25..9a25ca23d 100644
--- a/ggml/src/ggml-cuda/mmvq-moe.cu
+++ b/ggml/src/ggml-cuda/mmvq-moe.cu
@@ -303,7 +303,11 @@ static __global__ void mul_mat_vec_q_moe(
     // that pair's activation, in the same item order, so each output is bit-identical; the other pairs' warps return.  A
     // duplicate cold expert is then read over PCIe once per verify instead of once per token.  A token lists an expert at
     // most once, so a group has at most ncols_dst <= 4 pairs.
-    constexpr int DDK = c_dd ? 4 : 1;
+#ifndef GGML_CUDA_MOE_DDK
+#define GGML_CUDA_MOE_DDK 2
+#endif
+    // a group of more than DDK pairs is split into chunks of DDK, each computed by the chunk's first pair
+    constexpr int DDK = c_dd ? GGML_CUDA_MOE_DDK : 1;
     int      dd_n = 1;
     uint32_t dd_s[DDK];
     uint32_t dd_t[DDK];
@@ -334,11 +338,15 @@ static __global__ void mul_mat_vec_q_moe(
                 m[c] = (uint64_t) __ballot_sync(0xFFFFFFFFULL, match) & 0xFFFFFFFFULL;
             }
             const uint64_t mm = m[0] | (m[1] << 32);   // contains myp
-            if ((uint32_t) __builtin_ctzll(mm) != myp) {
+            const int      j  = __builtin_popcountll(mm & ((1ull << myp) - 1));   // myp's index in the group
+            if (j % DDK != 0) {
                 return;
             }
-            dd_n = 0;
             uint64_t b = mm;
+            for (int l = 0; l < j; ++l) {
+                b &= b - 1;
+            }
+            dd_n = 0;
 #pragma unroll
             for (int k = 0; k < DDK; ++k) {
                 if (b != 0) {
@@ -383,7 +391,8 @@ static __global__ void mul_mat_vec_q_moe(
         for (int it0 = threadIdx.x / (qi/vdr); it0 < n_items; it0 += c_pfu*n_groups) {
             moe_iq_raw<type> ru[c_pfu];
             moe_iq_raw<type> rg[c_pfu];
-            moe_q8_raw       ry[c_pfu][DDK];
+            // the owner's activation is loaded ahead with the weights; the other pair's with its use (registers: occupancy)
+            moe_q8_raw       ry[c_pfu];
 #pragma unroll
             for (int u = 0; u < c_pfu; ++u) {
                 const int it = it0 + u*n_groups;
@@ -395,13 +404,7 @@ static __global__ void mul_mat_vec_q_moe(
                     if (use_gate) {
                         moe_iq_load<type>(rg[u], vgate_use, kbx_offset_gate + i*gate_row_x_st + kbx, kqs);
                     }
-#pragma unroll
-                    for (int k = 0; k < DDK; ++k) {
-                        if (k < dd_n) {
-                            const block_q8_1 * yk = ((const block_q8_1 *) vy) + fastmodulo(dd_s[k], nchannels_y)*stride_channel_y + dd_t[k]*stride_col_y;
-                            moe_q8_load(ry[u][k], &yk[kby], kqs);
-                        }
-                    }
+                    moe_q8_load(ry[u], &y[kby], kqs);
                 }
             }
 #pragma unroll
@@ -409,12 +412,19 @@ static __global__ void mul_mat_vec_q_moe(
                 const int it = it0 + u*n_groups;
                 if (it < n_items) {
                     const int i = it / blocks_per_row_x;
+                    tmpd[0][i] += moe_iq_dot<type>(ru[u], ry[u], kqs);
+                    if (use_gate) {
+                        tmpgd[0][i] += moe_iq_dot<type>(rg[u], ry[u], kqs);
+                    }
 #pragma unroll
-                    for (int k = 0; k < DDK; ++k) {
+                    for (int k = 1; k < DDK; ++k) {
                         if (k < dd_n) {
-                            tmpd[k][i] += moe_iq_dot<type>(ru[u], ry[u][k], kqs);
+                            const block_q8_1 * yk = ((const block_q8_1 *) vy) + fastmodulo(dd_s[k], nchannels_y)*stride_channel_y + dd_t[k]*stride_col_y;
+                            moe_q8_raw ryk;
+                            moe_q8_load(ryk, &yk[(it % blocks_per_row_x) * (qk/QK8_1)], kqs);
+                            tmpd[k][i] += moe_iq_dot<type>(ru[u], ryk, kqs);
                             if (use_gate) {
-                                tmpgd[k][i] += moe_iq_dot<type>(rg[u], ry[u][k], kqs);
+                                tmpgd[k][i] += moe_iq_dot<type>(rg[u], ryk, kqs);
                             }
                         }
                     }
