From 7b314670b6fa0b3326ce1fb579926096b0594d78 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Mon, 9 Nov 2026 03:16:58 +0000
Subject: [PATCH 17/20] cuda: qwen4exp prefill producers leave the BF16 copy
 for the cuBLAS BF16 GEMMs (GGML_CUDA_BF16_PRODUCER)

---
 ggml/src/ggml-cuda/common.cuh   |  9 ++++++++
 ggml/src/ggml-cuda/dsv4-hc.cu   |  6 +++++
 ggml/src/ggml-cuda/ggml-cuda.cu | 40 +++++++++++++++++++++++++++++++++
 ggml/src/ggml-cuda/norm.cu      |  5 +++++
 4 files changed, 60 insertions(+)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 877896d91..5a70a167c 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -2847,6 +2847,15 @@ static inline bool ggml_cuda_bf16_src1_cache_on() {
     return on;
 }
 
+// Producer-written BF16 src1 (GGML_CUDA_BF16_PRODUCER, default 1; 0: off; 2: also verify every hit against the
+// conversion it replaces, debug only, slow): the qwen4exp prefill producers of the cuBLAS/rocBLAS BF16 GEMM
+// activations (dsv4_hc_post_rms's xn, dsv4_hc_pre's mixed stream) write the RNE BF16 copy in the same pass and leave
+// it in bf16_src1_cache, so the GEMM skips its F32 -> BF16 pass.  The F32 output is always written too.
+static inline int ggml_cuda_bf16_producer_mode() {
+    static const int m = [] { const char * e = getenv("GGML_CUDA_BF16_PRODUCER"); return e == nullptr ? 1 : atoi(e); }();
+    return m;
+}
+
 // Fusion-window alias check (defined in ggml-cuda.cu): true when none of the output nodes alias
 // an input that is not produced inside the window.  Shared by the extracted fusion helpers.
 bool ggml_cuda_check_fusion_memory_ranges(const ggml_cgraph * cgraph,
diff --git a/ggml/src/ggml-cuda/dsv4-hc.cu b/ggml/src/ggml-cuda/dsv4-hc.cu
index ecb0a13f6..9c99c71dd 100644
--- a/ggml/src/ggml-cuda/dsv4-hc.cu
+++ b/ggml/src/ggml-cuda/dsv4-hc.cu
@@ -340,6 +340,12 @@ void ggml_cuda_op_dsv4_hc_pre(ggml_backend_cuda_context & ctx, ggml_tensor * dst
     } else if (ggml_cuda_mmb_wants_bf16_copy(dst)) {
         dst16 = ggml_cuda_mmb_reserve_auto(ctx, dst, (size_t) ggml_nelements(dst));
     }
+    // no MMB copy: leave the mixed stream's BF16 copy for the cuBLAS BF16 GEMMs that read it (router, indexer, beta/alpha)
+    if (dst16 == nullptr && store_f32 && ggml_cuda_bf16_producer_mode() != 0 && ggml_cuda_bf16_src1_cache_on() &&
+            dst->view_src == nullptr && ggml_is_contiguous(dst) && n_tokens >= 64 &&
+            nbd0 == sizeof(float) && nbd1 == (size_t) n_embd*sizeof(float)) {
+        dst16 = (uint16_t *) ctx.bf16_src1_cache_put(dst, ggml_nelements(dst));
+    }
     ggml_cuda_kernel_launch(kernel, launch_params,
             xptr, wptr, (float *) dst->data,
             n_embd, hc, n_tokens,
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 1c7e56383..fc5750ae1 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -5297,6 +5297,43 @@ struct cuda_gc_timer {
 
 // GGML_CUDA_BF16_SRC1_CACHE=0 disables the per-graph BF16 src1 reuse (bf16_src1_cache in common.cuh).
 
+// GGML_CUDA_BF16_PRODUCER=2 (debug): compare a cached BF16 src1 with the conversion it replaced, element by element.
+static __global__ void ggml_cuda_bf16_src1_cmp(const nv_bfloat16 * a, const nv_bfloat16 * b, int64_t n, unsigned long long * bad) {
+    for (int64_t i = blockIdx.x * (int64_t) blockDim.x + threadIdx.x; i < n; i += (int64_t) gridDim.x * blockDim.x) {
+        if (__bfloat16_as_ushort(a[i]) != __bfloat16_as_ushort(b[i])) atomicAdd(bad, 1ull);
+    }
+}
+static void ggml_cuda_bf16_src1_verify(ggml_backend_cuda_context & ctx, const ggml_tensor * src1, const nv_bfloat16 * cached, int64_t n, cudaStream_t stream) {
+    static unsigned long long hits = 0, bad_total = 0, skipped = 0;
+#if defined(GGML_USE_HIP)
+    hipStreamCaptureStatus cap = hipStreamCaptureStatusNone;
+    CUDA_CHECK(hipStreamIsCapturing(stream, &cap));
+    const bool capturing = cap != hipStreamCaptureStatusNone;
+#else
+    cudaStreamCaptureStatus cap = cudaStreamCaptureStatusNone;
+    CUDA_CHECK(cudaStreamIsCapturing(stream, &cap));
+    const bool capturing = cap != cudaStreamCaptureStatusNone;
+#endif
+    if (capturing) {   // a graph capture cannot synchronize: those hits are not checked
+        ++skipped;
+        return;
+    }
+    ggml_cuda_pool_alloc<nv_bfloat16> ref(ctx.pool(), n);
+    ggml_get_to_bf16_cuda(GGML_TYPE_F32)(src1->data, ref.get(), n, stream);
+    ggml_cuda_pool_alloc<unsigned long long> cnt(ctx.pool(), 1);
+    unsigned long long * dbad = cnt.get();
+    CUDA_CHECK(cudaMemsetAsync(dbad, 0, sizeof(*dbad), stream));
+    ggml_cuda_bf16_src1_cmp<<<256, 256, 0, stream>>>(cached, ref.get(), n, dbad);
+    unsigned long long bad = 0;
+    CUDA_CHECK(cudaMemcpyAsync(&bad, dbad, sizeof(bad), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    ++hits; bad_total += bad;
+    if (bad != 0 || hits % 500 == 1) {
+        GGML_LOG_WARN("BF16_PRODUCER verify: %s n=%lld mismatches %llu (hits %llu, total mismatches %llu, %llu captured hits not checked)\n",
+                      src1->name, (long long) n, bad, hits, bad_total, skipped);
+    }
+}
+
 template<ggml_type compute_type>
 
 static void ggml_cuda_mul_mat_cublas_impl(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
@@ -5359,6 +5396,9 @@ static void ggml_cuda_mul_mat_cublas_impl(ggml_backend_cuda_context & ctx, const
             const auto & c = ctx.bf16_src1_cache;
             if (c.buf && c.src1 == root && c.data == root->data && c.stream_no == ctx.curr_stream_no && c.n == n) {
                 src1_bf16 = c.buf->get();
+                if (ggml_cuda_bf16_producer_mode() == 2) {
+                    ggml_cuda_bf16_src1_verify(ctx, src1, (const nv_bfloat16 *) src1_bf16, n, main_stream);
+                }
             } else {
                 src1_bf16     = ctx.bf16_src1_cache_put(root, n);
                 src1_bf16_new = true;
diff --git a/ggml/src/ggml-cuda/norm.cu b/ggml/src/ggml-cuda/norm.cu
index dc5eec4f6..d3530a038 100644
--- a/ggml/src/ggml-cuda/norm.cu
+++ b/ggml/src/ggml-cuda/norm.cu
@@ -1463,6 +1463,11 @@ bool ggml_cuda_op_dsv4_hc_post_rms_fused(ggml_backend_cuda_context & ctx, ggml_t
     } else if (ggml_cuda_mmb_wants_bf16_copy(mul)) {
         dst16 = ggml_cuda_mmb_reserve_auto(ctx, mul, (size_t) ggml_nelements(mul));
     }
+    // no MMB copy: leave xn's BF16 copy for the cuBLAS BF16 hc_down GEMM that follows (same gates as its lookup)
+    if (dst16 == nullptr && store_f32 && ggml_cuda_bf16_producer_mode() != 0 && ggml_cuda_bf16_src1_cache_on() &&
+            mul->view_src == nullptr && ggml_nrows(mul) / hc >= 64) {
+        dst16 = (uint16_t *) ctx.bf16_src1_cache_put(mul, ggml_nelements(mul));
+    }
 
     const dim3 grid_dims((unsigned) hc, (unsigned) std::min<int64_t>(n_tokens, UINT16_MAX), 1);
     const dim3 block_dims(block_size, 1, 1);
-- 
