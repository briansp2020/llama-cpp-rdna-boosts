From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Fri, 13 Nov 2026 23:18:20 +0000
Subject: [PATCH 37/38] meta: drain before the synchronous splice after a
 segmented async write to a weight buffer

Under -sm tensor with --load-mode none, the loader uploads weights in staging-ring chunks through
ggml_backend_meta_set_tensor_async.  For a segmented (fused) tensor, a chunk that starts on a row
boundary takes the async arm; if it ends mid-row, its tail also queues a zero guard of up to 512 B
per (segment, repeat, device) slice past its data.  The next chunk starts mid-row and takes the
synchronous splice, which did not wait for the device streams for weight buffers, so a late zero
guard could overwrite weight bytes the synchronous write had just stored.  Random per load, stable
within a load (FINDINGS 948: 2-3 of 6 loads off the clean state; -lm mmap / buffered and
GGML_META_SEG_ASYNC=0 clean).

The backend context now records that the async arm queued writes into a non-compute buffer, and the
synchronous splice drains once when that is set (once per async-then-sync transition at load).
GGML_META_SEG_LOAD_DRAIN=0: old behaviour.
---
 ggml/src/ggml-backend-meta.cpp | 31 ++++++++++++++++++++++++++++++-
 1 file changed, 30 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-backend-meta.cpp b/ggml/src/ggml-backend-meta.cpp
index 1c7e12522..021a0d05c 100644
--- a/ggml/src/ggml-backend-meta.cpp
+++ b/ggml/src/ggml-backend-meta.cpp
@@ -3195,6 +3195,10 @@ static ggml_guid_t ggml_backend_meta_guid() {
 }
 
 struct ggml_backend_meta_context {
+    // FINDINGS 948: the segmented async arm of set_tensor_async queued writes into a weight buffer that
+    // a later synchronous splice on this backend must not overtake (see ggml_backend_meta_set_tensor_async).
+    bool seg_weight_async_pending = false;
+
     struct cgraph_config {
         ggml_cgraph * cgraph_main = nullptr;
         int           offset      = 0; // Node offset vs. original graph
@@ -3366,6 +3370,22 @@ static void ggml_backend_meta_free(ggml_backend_t backend) {
 
 static void ggml_backend_meta_synchronize(ggml_backend_t backend);
 
+// FINDINGS 948: the segmented async arm below can queue writes into a WEIGHT buffer (the loader's
+// --load-mode none chunks: a row-aligned chunk that ends mid-row also queues a zero guard of up to
+// 512 B per (segment, repeat, device) slice past its data).  The loader's next chunk starts mid-row
+// and takes the synchronous splice, a blocking copy that does not wait for the device streams;
+// unless the queued writes are drained first, a late zero guard overwrites weight bytes the
+// synchronous write just stored (random per load).  The backend context's seg_weight_async_pending
+// records that such writes may be in flight, so the synchronous splice drains once per
+// async-then-sync transition instead of on every chunk.  GGML_META_SEG_LOAD_DRAIN=0: old behaviour.
+static bool ggml_backend_meta_seg_load_drain_on() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_META_SEG_LOAD_DRAIN");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return on;
+}
+
 static void ggml_backend_meta_set_tensor_async(ggml_backend_t backend, ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
     const size_t n_backends = ggml_backend_meta_n_backends(backend);
     GGML_ASSERT(ggml_is_contiguous(tensor));
@@ -3490,6 +3510,9 @@ static void ggml_backend_meta_set_tensor_async(ggml_backend_t backend, ggml_tens
                     }
                 }
             }
+            if (tensor->buffer != nullptr && ggml_backend_buffer_get_usage(tensor->buffer) != GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+                ((ggml_backend_meta_context *) backend->context)->seg_weight_async_pending = true;
+            }
             return;
         }
 
@@ -3497,8 +3520,14 @@ static void ggml_backend_meta_set_tensor_async(ggml_backend_t backend, ggml_tens
         // the device streams first or the copy could overwrite data a queued kernel still reads
         // (compute buffers only: a weight upload at load time has no queued readers, and draining there would
         // serialize the loader for every partial chunk)
-        if (tensor->buffer != nullptr && ggml_backend_buffer_get_usage(tensor->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+        // A weight buffer is drained only when the async arm above may have queued writes into one on this
+        // backend (FINDINGS 948, seg_weight_async_pending): once per async-then-sync transition at load.
+        auto * meta_ctx = (ggml_backend_meta_context *) backend->context;
+        const bool compute_buf = tensor->buffer != nullptr && ggml_backend_buffer_get_usage(tensor->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE;
+        const bool weight_drain = ggml_backend_meta_seg_load_drain_on() && meta_ctx->seg_weight_async_pending;
+        if (compute_buf || weight_drain) {
             ggml_backend_meta_synchronize(backend);
+            meta_ctx->seg_weight_async_pending = false;
         }
         ggml_backend_tensor_set(tensor, data, offset, size);
         return;
-- 
