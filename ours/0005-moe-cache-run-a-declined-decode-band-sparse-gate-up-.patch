From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Sat, 7 Nov 2026 14:24:54 +0000
Subject: [PATCH 05/52] moe cache: run a declined decode-band sparse
 gate+up+GLU unfused (GGML_MOE_FUSED_DECLINE_UNFUSE)

The fused read of the scheduler copies gave NaN output at tight pin budgets; the per-op path reads the same copies correctly.

(cherry picked from commit 16eb44c94c83c66c9ade58bc104b23650a8a48ed)
(cherry picked from commit 675401cd0bfd75cea7f9afa19c75c17fbe3d0032)
(cherry picked from commit 37528d7e2644fa6bc81ec5baff31cb818d8cd677)
(cherry picked from commit 565eb6e9efc3045a702a5c86df04ed654ec616a0)
---
 ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu | 5 +++--
 ggml/src/ggml-cuda/moe-expert-cache.h    | 5 +++++
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
index e6b1242a3f..c6db149420 100644
--- a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
@@ -2805,9 +2805,10 @@ int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgrap
                     fusion_local.gate_ids = &gate_ids_c;
                     ggml_cuda_mul_mat_vec_q(*cuda_ctx, &src0_c, src1, &ids_c, glu, &fusion_local);
                 } else if (ids != nullptr &&
-                           moe_cache_fused_lane_taken(glu, src0, fusion_data.gate, cuda_ctx->device)) {
+                           (moe_cache_fused_lane_taken(glu, src0, fusion_data.gate, cuda_ctx->device) ||
+                            moe_cache_fused_declined_sparse(glu, src0, fusion_data.gate, cuda_ctx->device))) {
                     moe_cache_fusion_launched(MOE_CACHE_SERVE_MIXED, 5);
-                    break;   // a taken-over lane has no full copy: run gate, up and the GLU unfused
+                    break;   // no redirect: run gate, up and the GLU unfused
                 } else {
                     if (ids != nullptr) {
                         moe_cache_fusion_launched(MOE_CACHE_SERVE_NONE, 5);
diff --git a/ggml/src/ggml-cuda/moe-expert-cache.h b/ggml/src/ggml-cuda/moe-expert-cache.h
index 7686adc656..7a854814ff 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.h
+++ b/ggml/src/ggml-cuda/moe-expert-cache.h
@@ -473,6 +473,11 @@ bool moe_cache_prefill_in_place_enabled();
 bool moe_cache_fused_lane_taken(const struct ggml_tensor * op, const struct ggml_tensor * src0,
                                 const struct ggml_tensor * gate, int device);
 
+// A decode-band fused gate+up+GLU with a sparse (mmap) table that was not redirected: the fused read of the scheduler copies
+// gives wrong output (FINDINGS 817), so the caller runs the ops unfused.
+bool moe_cache_fused_declined_sparse(const struct ggml_tensor * op, const struct ggml_tensor * src0,
+                                     const struct ggml_tensor * gate, int device);
+
 bool moe_cache_redirect_fused(const struct ggml_tensor * op,
                               const struct ggml_tensor * src0,
                               const struct ggml_tensor * gate,
-- 
2.53.0

