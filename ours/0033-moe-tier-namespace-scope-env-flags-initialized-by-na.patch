From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Tue, 17 Nov 2026 03:11:06 +0000
Subject: [PATCH 33/38] moe tier: namespace-scope env flags initialized by
 named functions, not lambdas

clang names a lambda in a namespace-scope initializer per anonymous-namespace block ($_0, $_1, ...), so
lambdas in different reopened namespace {} blocks of one TU can share a mangled name and the first emitted
body is reused for the others. In the r292 build g_pf_prefetch / g_prefill_inplace were initialized from
GGML_MOE_FILL_FENCE / GGML_MOE_TIER_PRECOPY (right values by luck, their own switches ignored); on r299 Stew
r298 lambdas (MOE_EXPERT_ALIAS_ROLE_CHECK / MOE_EXPERT_TAKEOVER_FAULT) took those slots and g_prefill_inplace
read 0 -> prefill fills never resolved, garbage output. The 7 namespace-scope lambda initializers of
moe-expert-tier.inc become <name>_init() functions; function-local ones are named by their function and stay.

(cherry picked from commit 96e57c2e20da996a80f8eaeb187639087aaad0d2)
(cherry picked from commit 8f66667ef43b2b97e044ab5dd03813616dfb5d08)
(cherry picked from commit 8b155c972f99cc91bff16d43bd11c64a67c4c8eb)
(cherry picked from commit 6111be65b916e93479b86bd440a4f8f0b88a7724)
(cherry picked from commit c3bd4b2becb2d1338dcd3de2fd533e940e1fc56e)
(cherry picked from commit c3c427d4fdec4bcad669223457f7ea8a19bad108)
(cherry picked from commit 690a9cd6f63629bf616316bbf21b7df4ba7a04a4)
---
 ggml/src/ggml-cuda/moe-expert-tier.inc | 33 ++++++++++++++++----------
 1 file changed, 20 insertions(+), 13 deletions(-)

diff --git a/ggml/src/ggml-cuda/moe-expert-tier.inc b/ggml/src/ggml-cuda/moe-expert-tier.inc
index 0add00a4e7..172af09ce4 100644
--- a/ggml/src/ggml-cuda/moe-expert-tier.inc
+++ b/ggml/src/ggml-cuda/moe-expert-tier.inc
@@ -280,10 +280,11 @@ static int64_t g_pc_issued = 0, g_pc_used = 0, g_pc_reclaimed = 0;
 // GGML_MOE_FILL_FENCE (default on): a decode take-over's swaps and map upload are marked done by the remap kernel's lag
 // flag instead of an event record each (every record is a marker packet the GPU spends ~4-6 us on, FINDINGS 745).
 // =0: an event after every swap and map upload, as before.
-static const bool g_fill_fence = [] {
+static bool g_fill_fence_init() {
     const char * e = getenv("GGML_MOE_FILL_FENCE");
     return e == nullptr || atoi(e) != 0;
-}();
+}
+static const bool g_fill_fence = g_fill_fence_init();
 static const void * g_defer_tab = nullptr;   // the table whose decode take-over defers its markers (else none)
 static int64_t g_fence_commits = 0, g_fence_flushes = 0;
 static int64_t g_pc_polev = 0;   // precopy plans that still waited on the compute stream (pol_ev)
@@ -291,16 +292,18 @@ static bool    fence_done_locked(const table_t & t, int32_t seq);
 static int32_t slot_seq_get_locked(const table_t & t, int slot);
 static int64_t g_pc_waited = 0;   // admissions whose precopy had not completed yet (the GPU waited for it)
 // GGML_MOE_TIER_PRECOPY=0: no copy-back ahead (each swap copies its victim back on the compute stream, as before).
-static const bool g_precopy = [] {
+static bool g_precopy_init() {
     const char * e = getenv("GGML_MOE_TIER_PRECOPY");
     return e == nullptr || atoi(e) != 0;
-}();
+}
+static const bool g_precopy = g_precopy_init();
 // GGML_MOE_TIER_SPARES=K: spare RAM slots per tier table (K - 1 can hold precopies, one stays free for the in-stream
 // fallback).  Default 8 with precopy, 1 without (the previous layout).
-static const int g_tier_spares = [] {
+static int g_tier_spares_init() {
     const char * e = getenv("GGML_MOE_TIER_SPARES");
     return e != nullptr && atoi(e) > 0 ? atoi(e) : (g_precopy ? 8 : 1);
-}();
+}
+static const int g_tier_spares = g_tier_spares_init();
 // GGML_MOE_TIER_TOUCH=N: the `touch` admission threshold for RAM-tier tables (MOE_EXPERT_CACHE_TOUCH for the others).
 // With several spares a tier table can admit every re-touched expert, and a short detour of the routing then evicts the
 // hot set; admitting from the 3rd touch damps that churn.  Default 3 with precopy, else MOE_EXPERT_CACHE_TOUCH.
@@ -391,7 +394,8 @@ struct fill_batch_t {
 };
 static fill_batch_t g_fb;
 static int64_t g_fb_flushes = 0, g_fb_jobs = 0, g_fb_late = 0, g_fb_failed = 0;
-static const bool g_fill_batch = [] { const char * e = getenv("GGML_MOE_FILL_BATCH"); return e == nullptr || atoi(e) != 0; }();
+static bool g_fill_batch_init() { const char * e = getenv("GGML_MOE_FILL_BATCH"); return e == nullptr || atoi(e) != 0; }
+static const bool g_fill_batch = g_fill_batch_init();
 static bool fb_flush_locked();   // launches what is queued; false: a launch failed, the tier is dropped
 static inline bool fb_on(const table_t & t) {
     return g_fill_batch && g_defer_tab == &t;
@@ -2167,10 +2171,11 @@ static cudaError_t seed_fill_slot_locked(table_t & t, void * dst, int32_t e) {
 // route, filled from the mapping through the pinned bounce (no registration).  The bytes are the file's, as on every
 // other path.  Returns the slot, or -1 (no slot, or a copy error: the admission is undone and the call declines).
 // GGML_MOE_FORCE_ADMIT=0: off (the call declines, as before).
-static bool g_force_admit = [] {
+static bool g_force_admit_init() {
     const char * e = getenv("GGML_MOE_FORCE_ADMIT");
     return e == nullptr || atoi(e) != 0;
-}();
+}
+static bool g_force_admit = g_force_admit_init();
 // A victim of force_admit_locked leaving VRAM on a tier table: with a copy-back ahead the fill waited for, it keeps that
 // exact RAM copy (as tier_swap_locked does); otherwise (a partial tier, no tier_swap) its cold pointer, which may still
 // name the RAM slot it was admitted from, goes back to the file alias.  On the compute stream, before the op.
@@ -2573,15 +2578,17 @@ int moe_cache_owner_device(const void * host) {
     return owner;
 }
 namespace {
-static const bool g_pf_prefetch = [] {
+static bool g_pf_prefetch_init() {
     const char * e = getenv("GGML_MOE_PF_PREFETCH");
     return e != nullptr && atoi(e) != 0;
-}();
+}
+static const bool g_pf_prefetch = g_pf_prefetch_init();
 // bumped by every decode-band policy call: residency (arena slots, RAM-tier slots) may have moved since a prefetch
-static bool g_prefill_inplace = [] {
+static bool g_prefill_inplace_init() {
     const char * e = getenv("GGML_MOE_PREFILL_INPLACE");
     return e != nullptr && atoi(e) != 0;
-}();
+}
+static bool g_prefill_inplace = g_prefill_inplace_init();
 // Remap freshness.  A published remap (remap_n_used > 0) is only valid for the split whose input hook published it:
 // a later split can consume the same table without any hook call (e.g. qwen4exp's last layer in a prompt chunk, where
 // the deferred MTP export gives the table two MUL_MAT_ID consumers and the scheduler copies the whole table), and the
