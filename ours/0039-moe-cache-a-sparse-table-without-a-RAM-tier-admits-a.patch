+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -486,6 +486,7 @@ int64_t                             g_cold_reaches    = 0;
 //   2 = touch  : fill only on the expert's 2nd+ use since it was last resident (doorkeeper)
 int                                 g_admit           = 0;
 int64_t                             g_cold_admits     = 0;  // misses served cold by the admission rule (not by a full/declined table)
+int64_t                             g_force_admits    = 0;  // routed experts of a sparse table without a tier filled through the bounce (see force_admit_locked)
 int64_t                             g_touch           = 2;  // `admit=touch`: uses since last resident before a fill is allowed
 int64_t                             g_takeover        = 0;
 int64_t                             g_decline_all     = 0;
@@ -3356,6 +3357,55 @@ static int bounce_acquire(table_t & t) {
     return (int) t.bounce.size() - 1;
 }
 
+// A pinned per-table bounce entry for a copy out of a sparse (mmap) master: one whose copy has drained, else a new one,
+// at most 8 per table (a declined read can be a whole master, and an unbounded ring would pin a copy of it outside the
+// pin budget); a full ring waits for one copy and reuses its entry.  -1 when no entry can be allocated.
+static int bounce_acquire_capped(table_t & t) {
+    int idx = -1;
+    for (int i = 0; i < (int) t.bounce.size(); i++) {
+        if (t.bounce[(size_t) i].busy) {
+#if defined(GGML_USE_HIP)
+            const bool ready = hipEventQuery((hipEvent_t) t.bounce[(size_t) i].ev) != hipErrorNotReady;
+#else
+            const bool ready = cudaEventQuery(t.bounce[(size_t) i].ev) != cudaErrorNotReady;
+#endif
+            (void) cudaGetLastError();
+            if (!ready) {
+                continue;
+            }
+            t.bounce[(size_t) i].busy = false;
+        }
+        idx = i;
+        break;
+    }
+    if (idx < 0 && t.bounce.size() >= 8) {
+        idx         = t.bounce_rr % (int) t.bounce.size();
+        t.bounce_rr = idx + 1;
+        (void) cudaEventSynchronize(t.bounce[(size_t) idx].ev);
+        (void) cudaGetLastError();
+        t.bounce[(size_t) idx].busy = false;
+    }
+    if (idx < 0) {
+        device_guard dg(t.device);
+        void *      mem = nullptr;
+        cudaEvent_t ev  = nullptr;
+        if (cudaHostAlloc(&mem, t.host_bytes, cudaHostAllocPortable | cudaHostAllocMapped) != cudaSuccess ||
+            cudaEventCreateWithFlags(&ev, cudaEventDisableTiming) != cudaSuccess) {
+            (void) cudaGetLastError();
+            if (mem != nullptr) { (void) cudaFreeHost(mem); }
+            if (ev  != nullptr) { (void) cudaEventDestroy(ev); }
+            return -1;
+        }
+        bounce_t b;
+        b.host = (char *) mem;
+        b.ev   = ev;
+        b.busy = false;
+        t.bounce.push_back(b);
+        idx = (int) t.bounce.size() - 1;
+    }
+    return idx;
+}
+
 // `protect`/`n_protect`: experts that belong to the token currently being staged and must NOT be chosen as
 // an eviction victim.  Without this, an expert admitted earlier in the same token can be evicted by a later
 // one (its freshly-seeded count is the smallest), which is what made the hook's `all` flag flip from token
@@ -3807,6 +3857,98 @@ moe_cache_alias access_locked(table_t & t, int32_t expert, void * stream,
 
 
 
+// A routed expert of a sparse (mmap) table without a RAM tier that is neither resident nor registrable (the pin budget
+// refused it) has no read path, and declining the call for it would make the hook's outcome depend on the routing: a CUDA
+// graph captured on one outcome and replayed on the other reads the wrong source (wrong output for the whole load).  So
+// it is admitted regardless of the admission rule: into a free slot, else over the coldest resident this call does not
+// route, filled from the mapping through the pinned bounce (no registration).  The bytes are the file's, as on every
+// other path.  Returns the slot, or -1 (no slot, or a copy error: the admission is undone and the call declines).
+// GGML_MOE_FORCE_ADMIT=0: off (the call declines, as before).
+static bool g_force_admit = [] {
+    const char * e = getenv("GGML_MOE_FORCE_ADMIT");
+    return e == nullptr || atoi(e) != 0;
+}();
+
+static int force_admit_locked(table_t & t, int32_t expert, void * stream, const int32_t * protect, int n_protect) {
+    if (t.slots <= 0 || t.arena == nullptr || t.host == nullptr || stream == nullptr || expert < 0 ||
+        expert >= t.n_experts) {
+        return -1;
+    }
+    int     slot   = -1;
+    int32_t victim = -1;
+    if ((int) t.expert_slot.size() < t.slots) {
+        for (int s = 0; s < t.slots; s++) {
+            if (t.slot_expert[s] < 0) { slot = s; break; }
+        }
+    }
+    if (slot < 0) {
+        // the victim rule of access_locked: the smallest decaying count, tie -> oldest use, never this call's experts
+        for (int s = 0; s < t.slots; s++) {
+            const int32_t e = t.slot_expert[s];
+            bool prot = false;
+            for (int i = 0; i < n_protect && !prot; i++) {
+                prot = protect[i] == e;
+            }
+            if (e < 0 || prot) { continue; }
+            if (victim < 0 || t.count[e] < t.count[victim] ||
+                (t.count[e] == t.count[victim] && t.last[e] < t.last[victim])) {
+                victim = e;
+                slot   = s;
+            }
+        }
+    }
+    if (slot < 0) {
+        return -1;
+    }
+    const int idx = bounce_acquire_capped(t);
+    if (idx < 0) {
+        return -1;
+    }
+    char * buf = t.bounce[(size_t) idx].host;
+    memcpy(buf, (const char *) t.host + (size_t) expert * t.host_bytes, t.host_bytes);
+    expert_src_t src;
+    src.base   = buf;
+    src.kind   = cudaMemcpyHostToDevice;
+    src.bounce = idx;
+    char * dst = (char *) t.arena + (size_t) slot * t.expert_bytes;
+    if (copy_slot_from_src(t, dst, src, (cudaStream_t) stream) != cudaSuccess) {
+        GGML_LOG_WARN("%s: bounce fill failed table layer=%d role=%s expert=%d: %s\n", __func__, t.layer, t.role.c_str(),
+                      expert, cudaGetErrorString(cudaGetLastError()));
+        // a fused table issues one copy per slice: earlier slices may be in flight from the entry and in the slot, so the
+        // entry stays busy until they drain and the victim's slot is freed (its bytes may be partly overwritten)
+        expert_src_done(t, nullptr, src, stream, /*retire*/ false);
+        if (victim >= 0) {
+            t.expert_slot.erase(victim);
+            t.slot_expert[slot] = -1;
+            t.slot_dirty = true;
+            t.evictions++;
+        }
+        return -1;
+    }
+    expert_src_done(t, nullptr, src, stream, /*retire*/ false);
+    if (victim >= 0) {
+        t.expert_slot.erase(victim);
+        t.slot_expert[slot] = -1;
+        t.evictions++;
+    }
+    t.slot_expert[slot]   = expert;
+    t.expert_slot[expert] = slot;
+    t.slot_dirty          = true;
+    if (slot < (int) t.slot_prov.size()) {
+        t.slot_prov[slot] = 0;
+    }
+    t.count[expert]++;
+    if (expert < (int32_t) t.ghost.size()) {
+        t.ghost[expert] = 0;
+    }
+    t.last[expert] = t.clock;
+    t.fills++;
+    g_acc_fills++;
+    g_fill_bytes += (int64_t) t.expert_bytes;
+    g_force_admits++;
+    return slot;
+}
