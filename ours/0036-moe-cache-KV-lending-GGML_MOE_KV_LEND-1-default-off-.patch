+    auto reg_fn   = (llama_kv_lend_register_t)   ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_moe_kv_register");
+    auto need_fn  = (llama_kv_lend_need_t)       ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_moe_kv_need");
+    auto unreg_fn = (llama_kv_lend_unregister_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_moe_kv_unregister");
+    if (reg_fn == nullptr || need_fn == nullptr || unreg_fn == nullptr) {
