+// KV lending (GGML_MOE_KV_LEND=1, default off): the KV cache's rows past the context in use hold copies of experts the
+// arena evicted ("victim slots").  The decode kernel reads a cold expert of a RAM-tier table through cold_ptrs, so
+// pointing cold_ptrs[e] at a victim slot serves it from VRAM.  The expert's RAM copy (or file alias) is still made as
+// without lending, so a victim slot is a disposable duplicate: dropping it points cold_ptrs[e] back at that fallback.
+// llama reports the rows a batch can read or write (moe_cache_kv_need); the rows below the lend line are the KV's.
+// Victims are made and dropped only on the decode policy's stream (the only reader of cold_ptrs); taking rows back
+// for the KV synchronises the device first.
+struct kvl_tensor_t {
+    char *  data;
+    size_t  bytes;
+    size_t  row_bytes;
+};
+struct kvl_slot_t {
+    int     tensor;
+    size_t  off;
+    int     table  = -1;
+    int32_t expert = -1;
+    bool    ref    = false;   // CLOCK reference bit: read since the hand last passed
+};
+static std::vector<kvl_tensor_t> g_kvl_tensors;
+static std::vector<kvl_slot_t>   g_kvl_slots;           // a fixed grid over every tensor's lendable range
+static int64_t g_kvl_rows       = 0;                    // the KV's cells (every registered tensor has them)
+static int64_t g_kvl_line       = 0;                    // first lent row (g_kvl_rows: nothing lent)
+static int     g_kvl_device     = -1;
+static size_t  g_kvl_slot_bytes = 0;                    // the largest tier table's expert, set when the grid is built
+static size_t  g_kvl_hand       = 0;
+static bool    g_kvl_in_decode  = false;                // set around devremap_prep's policy loop
+static void *  g_kvl_stream     = nullptr;              // the main model's decode stream (its layer-0 tables'): the
+                                                        // only stream that makes or drops victims (the MTP draft is
+                                                        // another context with its own stream)
+static int     g_kvl_pin        = -1;                   // a slot the next fill reads: not reused meanwhile
+static int64_t g_kvl_fills = 0;                         // admissions filled from a victim slot (device to device)
+static int64_t g_kvl_inserts = 0, g_kvl_hits = 0, g_kvl_misses = 0, g_kvl_drops = 0, g_kvl_takes = 0, g_kvl_gives = 0;
+static double  g_kvl_ms = 0;
+
+// per table (by index in g_tables): expert -> the victim slot holding a copy of it (-1: none); kept outside table_t
+static std::vector<std::vector<int32_t>> g_kvl_kvv;
+static std::vector<int32_t> & kvl_kvv(const table_t & t) {
+    const size_t id = (size_t) (&t - g_tables.data());
+    if (g_kvl_kvv.size() <= id) {
+        g_kvl_kvv.resize(id + 1);
+    }
+    return g_kvl_kvv[id];
+}
+
+static bool kvl_on() {
+    static const bool v = getenv("GGML_MOE_KV_LEND") != nullptr && atoi(getenv("GGML_MOE_KV_LEND")) > 0;
+    return v;
+}
+static int64_t kvl_step() {
+    return 4096;   // rows; a multiple of every n_kv pad
+}
+static int64_t kvl_margin() {
+    static const int64_t v = getenv("GGML_MOE_KV_LEND_MARGIN") ? std::max<int64_t>(0, atoll(getenv("GGML_MOE_KV_LEND_MARGIN"))) : 16384;
+    return v;
+}
+static bool kvl_log() {
+    static const bool v = getenv("GGML_MOE_KV_LEND_LOG") != nullptr;
+    return v;
+}
+static char * kvl_ptr(const kvl_slot_t & sl) {
+    return g_kvl_tensors[(size_t) sl.tensor].data + sl.off;
+}
+static bool kvl_avail(const kvl_slot_t & sl) {
+    return (int64_t) sl.off >= g_kvl_line * (int64_t) g_kvl_tensors[(size_t) sl.tensor].row_bytes;
+}
+static bool kvl_eligible(const table_t & t) {
+    return kvl_on() && !g_kvl_tensors.empty() && t.device == g_kvl_device && t.cold_ptrs != nullptr && t.cold_safe &&
+           t.ram_base != nullptr && t.host_dev != nullptr && !t.identity && t.slots > 0 &&
+           (g_kvl_slot_bytes == 0 || t.expert_bytes <= g_kvl_slot_bytes);
+}
+// where cold_ptrs[e] points without a victim: the RAM copy, else the file alias (as the tier code sets it)
+static uintptr_t kvl_fallback(const table_t & t, int32_t e) {
+    const int32_t r = e < (int32_t) t.ram_slot.size() ? t.ram_slot[(size_t) e] : -1;
+    return r >= 0 ? (uintptr_t) (t.ram_base + (size_t) r * t.expert_bytes) : tier_file_ptr(t, e);
+}
+// The grid: slots of the largest tier table's expert (4 KiB aligned) from row 2 * step of each tensor to its end.
+static void kvl_build_locked() {
+    if (!g_kvl_slots.empty() || g_kvl_tensors.empty()) {
+        return;
+    }
+    size_t eb = 0;
+    for (const table_t & t : g_tables) {
+        if (t.device == g_kvl_device && t.cold_ptrs != nullptr && t.ram_base != nullptr) {
+            eb = std::max(eb, t.expert_bytes);
+        }
+    }
+    if (eb == 0) {
+        return;
+    }
+    g_kvl_slot_bytes = (eb + 4095) & ~(size_t) 4095;
+    for (int i = 0; i < (int) g_kvl_tensors.size(); i++) {
+        const kvl_tensor_t & kt = g_kvl_tensors[(size_t) i];
+        const uintptr_t lo = (uintptr_t) kt.data + (uintptr_t) (2 * kvl_step()) * kt.row_bytes;
+        size_t off = (size_t) (((lo + 4095) & ~(uintptr_t) 4095) - (uintptr_t) kt.data);
+        for (; off + g_kvl_slot_bytes <= kt.bytes; off += g_kvl_slot_bytes) {
+            kvl_slot_t sl;
+            sl.tensor = i;
+            sl.off    = off;
+            g_kvl_slots.push_back(sl);
+        }
+    }
+    GGML_LOG_WARN("moe_cache KV lending: %zu victim slots of %.2f MiB in %zu KV tensors (%.0f MiB at most)\n",
+                  g_kvl_slots.size(), g_kvl_slot_bytes / 1048576.0, g_kvl_tensors.size(),
+                  g_kvl_slots.size() * (double) g_kvl_slot_bytes / 1048576.0);
+}
+// Drop a slot's expert: its cold pointer back to the fallback, on `s` (ordered before the slot's reuse), or into
+// `sync_out` when the caller writes it after a device synchronize.
+static void kvl_release_locked(kvl_slot_t & sl, cudaStream_t s, std::vector<std::pair<uintptr_t *, uintptr_t>> * sync_out) {
+    if (sl.table < 0) {
+        return;
+    }
+    table_t & t = g_tables[(size_t) sl.table];
+    if (sl.expert < (int32_t) kvl_kvv(t).size()) {
+        kvl_kvv(t)[(size_t) sl.expert] = -1;
+    }
+    if (t.cold_ptrs != nullptr && t.ram_base != nullptr) {
+        const uintptr_t v = kvl_fallback(t, sl.expert);
+        if (sync_out != nullptr) {
+            sync_out->push_back({ t.cold_ptrs + sl.expert, v });
+        } else {
+            moe_cache_set_ptr_kernel<<<1, 1, 0, s>>>(t.cold_ptrs, sl.expert, v);
+        }
+    }
+    sl.table  = -1;
+    sl.expert = -1;
+    sl.ref    = false;
+    g_kvl_drops++;
+}
+// CLOCK: a free slot, else one whose expert is resident again, else the first without its reference bit.
+static int kvl_alloc_locked(cudaStream_t s) {
+    const size_t n = g_kvl_slots.size();
+    for (size_t k = 0; n > 0 && k < 2 * n + 1; k++) {
+        const size_t i  = g_kvl_hand;
+        g_kvl_hand      = (g_kvl_hand + 1) % n;
+        kvl_slot_t & sl = g_kvl_slots[i];
+        if (!kvl_avail(sl) || (int) i == g_kvl_pin) {
+            continue;
+        }
+        if (sl.table < 0) {
+            return (int) i;
+        }
+        const table_t & o = g_tables[(size_t) sl.table];
+        if (sl.ref && o.expert_slot.find(sl.expert) == o.expert_slot.end()) {
+            sl.ref = false;
+            continue;
+        }
+        kvl_release_locked(sl, s, nullptr);
+        return (int) i;
+    }
+    return -1;
+}
+// The arena evicts `victim`, whose bytes are still at `src`: keep a copy in a victim slot (the copy is on `s`, before
+// the caller's fill overwrites `src`).  Returns the slot, or -1; the caller points cold_ptrs at it after the tier swap.
+static int kvl_keep_locked(table_t & t, int32_t victim, const char * src, cudaStream_t s) {
+    if (!g_kvl_in_decode || victim < 0 || victim >= t.n_experts || !kvl_eligible(t)) {
+        return -1;
+    }
+    if (g_kvl_stream == nullptr) {
+        for (const table_t & o : g_tables) {
+            if (o.layer == 0 && o.dr_last_stream != nullptr) {
+                g_kvl_stream = o.dr_last_stream;
+                break;
+            }
+        }
+    }
+    if (g_kvl_stream == nullptr || (void *) s != g_kvl_stream) {
+        return -1;
+    }
+    kvl_build_locked();
+    if (g_kvl_slots.empty() || t.expert_bytes > g_kvl_slot_bytes) {
+        return -1;
+    }
+    if ((int) kvl_kvv(t).size() != t.n_experts) {
+        kvl_kvv(t).assign((size_t) t.n_experts, -1);
+    }
+    int i = kvl_kvv(t)[(size_t) victim];
+    if (i >= 0) {
+        return i;   // still holds it (kept while the expert was resident)
+    }
+    i = kvl_alloc_locked(s);
+    if (i < 0) {
+        return -1;
+    }
+    kvl_slot_t & sl = g_kvl_slots[(size_t) i];
+    moe_cache_copy_kernel<<<128, 256, 0, s>>>(kvl_ptr(sl), src, t.expert_bytes);
+    if (cudaGetLastError() != cudaSuccess) {
+        return -1;
+    }
+    sl.table  = (int) (&t - g_tables.data());
+    sl.expert = victim;
+    sl.ref    = false;
+    kvl_kvv(t)[(size_t) victim] = i;
+    g_kvl_inserts++;
+    return i;
+}
+// Forget one expert's victim: the caller re-points its cold pointer itself (on the victims' stream).
+static void kvl_forget_locked(table_t & t, int32_t e) {
+    if (e < 0 || e >= (int32_t) kvl_kvv(t).size() || kvl_kvv(t)[(size_t) e] < 0) {
+        return;
+    }
+    kvl_slot_t & sl = g_kvl_slots[(size_t) kvl_kvv(t)[(size_t) e]];
+    sl.table  = -1;
+    sl.expert = -1;
+    sl.ref    = false;
+    kvl_kvv(t)[(size_t) e] = -1;
+}
+// Forget every victim (the caller rewrote or is about to rewrite the cold pointers it touched).
+static void kvl_forget_all_locked() {
+    for (kvl_slot_t & sl : g_kvl_slots) {
+        sl.table  = -1;
+        sl.expert = -1;
+        sl.ref    = false;
+    }
+    for (table_t & t : g_tables) {
+        kvl_kvv(t).clear();
+    }
+}
+
