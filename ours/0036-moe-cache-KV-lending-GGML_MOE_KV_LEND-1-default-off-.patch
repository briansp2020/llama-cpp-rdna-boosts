+        if (layer.k == nullptr || layer.v == nullptr || layer.k->buffer == nullptr || layer.v->buffer == nullptr ||
+            !ggml_is_contiguous(layer.k) || !ggml_is_contiguous(layer.v) || layer.k->ne[1] != (int64_t) get_size() ||
+            layer.v->ne[1] != (int64_t) get_size() || layer.k->ne[2] != 1 || layer.v->ne[2] != 1) {
+            return;
+        }
+    }
+    ggml_backend_dev_t dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(layers[0].k->buffer));
+    ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    if (reg == nullptr) {
+        return;
