+    // MoE down + weighted reduction (fusion.red_dst, 1 token, no shared lane): each expert lane of a row block counts in; the
+    // last one sums the block's rows over the experts as moe_weighted_reduction does (same order, same expression).
+    if constexpr (has_fusion) {
+        if (warp_size == 32 && fusion.red_dst != nullptr && !shared_expert) {
+            int * cnt = fusion.red_cnt + blockIdx.x;
+            __threadfence();
+            int prev = 0;
+            if (threadIdx.x == 0) {
+                prev = atomicAdd(cnt, 1);
+            }
+            prev = __shfl_sync(0xFFFFFFFF, prev, 0, 32);
+            if (prev == (int) nchannels_dst - 1) {
+                __threadfence();
+                if ((int) threadIdx.x < rows_valid) {
+                    const int   r  = row0 + threadIdx.x;
+                    const float s0 = fusion.red_scale != nullptr ? fusion.red_scale[0] : 1.0f;
+                    float sum = (__builtin_nontemporal_load(&dst[r]) * s0) * fusion.red_w[0];
+                    for (int e = 1; e < (int) nchannels_dst; ++e) {
+                        const float s = fusion.red_scale != nullptr ? fusion.red_scale[e] : 1.0f;
+                        sum += (__builtin_nontemporal_load(&dst[e*stride_channel_dst + r]) * s) * fusion.red_w[e];
+                    }
+                    fusion.red_dst[r] = sum;
+                }
+                if (threadIdx.x == 0) {
+                    *cnt = 0;
+                }
+            }
+        }
+    }
