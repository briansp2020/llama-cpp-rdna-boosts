-// Sync-free decode device remap (GGML_MOE_DEVREMAP, TODO #269): forward to every simple device, exactly as
-// the gather above does.  The remap is per (table, device) BY CONSTRUCTION -- the routing ids are global
-// expert ids, so each device maps them through its OWN expert -> slot map into its OWN `remap_dev`, and the
-// cold half of that map (`slots + e` for a pinned master, `slots + pool slot` for a covering host pool) is
-// expressed with THIS device's slot count, which is what the consumer (`moe_cache_get_table` +
-// `moe_cache_get_cold` on that device) expects.  Nothing here is device-shared: `t.slots`, the arena, the
-// map and the lag buffer are per table, and a table is per (host tensor, device).
-//
-// The two-call protocol is what makes the all-or-nothing skip-copy decision safe: `check_only` answers for
-// every device without changing anything, and only when ALL of them say yes does the scheduler issue the
-// committing call.  A decline in the committing pass (a residency change that landed in between) returns
-// false, and the scheduler falls through to the gather / eager path, which repopulates the split input and
-// clears `remap_n_used` -- i.e. a partial commit can only cost a synchronize, never a wrong read.
-static bool ggml_backend_meta_moe_cache_remap(ggml_backend_t backend, const struct ggml_tensor * weight,
-        const struct ggml_tensor * weight_cpy, const struct ggml_tensor * ids, bool check_only) {
-    if (weight == nullptr || weight_cpy == nullptr || ids == nullptr || weight->ne[2] < 2) {
-        return false;
-    }
-    if (!ggml_backend_buffer_is_meta(weight_cpy->buffer)) {
-        return false;
-    }
-    const size_t              n_backends = ggml_backend_meta_n_backends(backend);
-    const ggml_backend_meta_split_state ss = ggml_backend_meta_get_split_state(weight_cpy, /*assume_sync =*/ false);
-    if (ss.n_segments != 1 || ss.nr[0] != 1 || ss.axis < 0 || ss.axis >= GGML_MAX_DIMS) {
-        return false;   // a fused or mirrored table has no per-device slot geometry
-    }
-    const bool ids_meta = ggml_backend_buffer_is_meta(ids->buffer);
-    if (!ids_meta && n_backends > 1) {
-        return false;   // a single device routing tensor cannot be read by every device
-    }
-    bool all = true;
-    for (size_t j = 0; j < n_backends; j++) {
-        ggml_backend_t simple_backend = ggml_backend_meta_simple_backend(backend, j);
-        ggml_tensor *  simple_tensor  = ggml_backend_meta_buffer_simple_tensor(weight_cpy, j);
-        if (simple_tensor == nullptr || simple_backend->iface.moe_cache_remap == nullptr) {
-            return false;
-        }
-        const ggml_tensor * ids_j = ids;
-        if (ids_meta) {
-            ggml_tensor * si = ggml_backend_meta_buffer_simple_tensor(ids, j);
-            if (si == nullptr) {
-                return false;
-            }
-            ids_j = si;
-        }
-        if (!simple_backend->iface.moe_cache_remap(simple_backend, weight, simple_tensor, ids_j, check_only)) {
-            // Short-circuit BOTH passes: on the check pass one device's no is the whole answer, and on the
-            // committing pass the scheduler must stop redirecting and take the fallback (which resets the
-            // tables that did commit).
-            all = false;
-            break;
-        }
-    }
-    return all;
-}
