From 6d334c7b7fc560d938c9ee5f043c4b25aa9135f7 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Fri, 6 Nov 2026 08:26:34 -0800
Subject: [PATCH 53/53] fattn-tile: q8_0 convert through v_perm

The q8_0 tile dequant on RDNA3/RDNA4 converts int8 to f16 with v_perm:
byte ^ 0x80 under 0x64 is the f16 1024 + (q + 128) exactly, and one packed
subtract of 1152 gives q exactly, so d * q is the same product of the same
operands. Only the convert; no fetch-ahead (that form changed text at depth).

7900 XTX tg128: q30 d32768 +2.01 %, q30 d4096 +0.11 %, q36 d32768 +0.33 %.
Text same as off on q30, q36, l1 at four depths up to about 30K tokens.
GGML_CUDA_FA_TILE_PERM=0 turns it off.
---
 ggml/src/ggml-cuda/fattn-tile.cuh | 80 +++++++++++++++++++++++--------
 1 file changed, 60 insertions(+), 20 deletions(-)

diff --git a/ggml/src/ggml-cuda/fattn-tile.cuh b/ggml/src/ggml-cuda/fattn-tile.cuh
index 2b4f1258b..9e9d542c8 100644
--- a/ggml/src/ggml-cuda/fattn-tile.cuh
+++ b/ggml/src/ggml-cuda/fattn-tile.cuh
@@ -492,7 +492,31 @@ static __device__ __forceinline__ void flash_attn_tile_load_tile(
 // `KV` points at row 0 of the tile's column slice (i.e. a byte-addressed equivalent of the half2 call
 // above).  The staged values are identical to the F16 conversion's, so the rest of the kernel is
 // unchanged.
-template<ggml_type type_KV, int warp_size, int nwarps, int I, int J, int J_padding, bool oob_check>
+// GGML_CUDA_FA_TILE_PERM=0 (env, default on) turns this off: the q8_0 tile's int8 -> f16 through v_perm.  byte ^ 0x80 spliced
+// under 0x64 is the f16 1024 + (q + 128) exactly, and one packed subtract of 1152 gives q exactly (every int8 is exact in f16),
+// so d2 * q is the same product of the same operands.
+static __device__ __forceinline__ void fa_tile_q8_convert_perm(const ggml_cuda_fattn_q8_0_chunk_raw & raw, half2 * const __restrict__ dst) {
+#if defined(GGML_USE_HIP) && (defined(RDNA3) || defined(RDNA4))
+    const half2 d2   = __half2half2(raw.d);
+    const half2 bias = __halves2half2(__float2half(1152.0f), __float2half(1152.0f));
+#pragma unroll
+    for (int w = 0; w < GGML_CUDA_FA_Q8_CHUNK/4; ++w) {
+        const uint32_t b = (uint32_t) raw.q[w] ^ 0x80808080u;
+        // v_perm_b32 (src0, src1, sel): selector bytes 0-3 pick src1's bytes, 4-7 src0's
+        const uint32_t lo = __builtin_amdgcn_perm(0x64646464u, b, 0x04010400u);   // [b0, 0x64, b1, 0x64]
+        const uint32_t hi = __builtin_amdgcn_perm(0x64646464u, b, 0x04030402u);   // [b2, 0x64, b3, 0x64]
+        half2 h0, h1;
+        memcpy(&h0, &lo, 4);
+        memcpy(&h1, &hi, 4);
+        dst[2*w + 0] = d2 * __hsub2(h0, bias);
+        dst[2*w + 1] = d2 * __hsub2(h1, bias);
+    }
+#else
+    ggml_cuda_fattn_convert_q8_0_chunk(raw, dst);
+#endif
+}
+
