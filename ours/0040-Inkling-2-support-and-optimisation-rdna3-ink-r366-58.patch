diff --git a/ggml/src/ggml-cuda/clip-rows.cu b/ggml/src/ggml-cuda/clip-rows.cu
new file mode 100644
index 0000000000..3b4b7666c8
--- /dev/null
+++ b/ggml/src/ggml-cuda/clip-rows.cu
@@ -0,0 +1,78 @@
+#include "clip-rows.cuh"
+
+// one block per row; the sum of squares is accumulated exactly like reduce_row_f32 (reduce_rows.cuh) so that the
+// result is bit-identical to SQR + SUM_ROWS for the same block size
+template <bool has_w>
+static __global__ void clip_rows_f32(const float * __restrict__ x, const float * __restrict__ w, const float * __restrict__ limit,
+        float * __restrict__ dst, const int ncols, const int w_rows, const float limit_value, const float bias,
+        const float lo, const float hi) {
+    const int64_t row = blockIdx.x;
+    const int     col = threadIdx.x;
+
+    const float * xr = x + row*ncols;
+    const float * wr = has_w ? w + int64_t(row % w_rows)*ncols : nullptr;
+
+    auto value = [&](int i) {
+        return has_w ? __fmul_rn(xr[i], wr[i]) : xr[i];
+    };
+
+    const int num_unroll = 8;
+    float     temp[num_unroll];
+    float     sum_temp[num_unroll] = { 0.0f };
+
+    ggml_cuda_pdl_sync();
+    for (int i = col; i < ncols;) {
+        for (int j = 0; j < num_unroll; ++j) {
+            if (i < ncols) {
+                const float c = value(i);
+                temp[j] = __fmul_rn(c, c);
+            } else {
+                temp[j] = 0;
+            }
+            i += blockDim.x;
+        }
+        for (int j = 0; j < num_unroll; ++j) {
+            sum_temp[j] = __fadd_rn(sum_temp[j], temp[j]);
+        }
+    }
+    float sum = 0.0f;
+    for (int j = 0; j < num_unroll; ++j) {
+        sum = __fadd_rn(sum, sum_temp[j]);
+    }
+
+    __shared__ float shared_vals[32];
+    sum = block_reduce<block_reduce_method::SUM>(sum, shared_vals);
+    ggml_cuda_pdl_lc();
+
+    // SQRT, SCALE (scale 1: x*1 + bias rounds once either way), DIV, CLAMP as in their own kernels
+    const float norm   = sqrtf(sum) + bias;
+    const float factor = fminf(fmaxf((limit ? limit[row] : limit_value) / norm, lo), hi);
+
+    for (int i = col; i < ncols; i += blockDim.x) {
+        dst[row*ncols + i] = __fmul_rn(value(i), factor);
+    }
+}
+
+void ggml_cuda_op_clip_rows_fused(ggml_backend_cuda_context & ctx, const ggml_tensor * x, const ggml_tensor * w,
+        const ggml_tensor * limit, float limit_value, float bias, float lo, float hi, ggml_tensor * dst) {
+    const int     ncols = x->ne[0];
+    const int64_t nrows = ggml_nrows(x);
+
+    // the block size of sum_rows_f32_cuda for this shape
+    const int nsm = ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+    const int block_size = (nrows / nsm) < 2 ? 512 : (ncols < 1024 ? 32 : 128);
+
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(dim3(nrows, 1, 1), dim3(block_size, 1, 1), 0, ctx.stream());
+
+    const float * w_d     = w ? (const float *) w->data : nullptr;
+    const float * limit_d = limit ? (const float *) limit->data : nullptr;
+    const int     w_rows  = w ? (int) ggml_nrows(w) : 1;
+
+    if (w) {
+        ggml_cuda_kernel_launch(clip_rows_f32<true>, launch_params, (const float *) x->data, w_d, limit_d, (float *) dst->data,
+            ncols, w_rows, limit_value, bias, lo, hi);
+    } else {
+        ggml_cuda_kernel_launch(clip_rows_f32<false>, launch_params, (const float *) x->data, w_d, limit_d, (float *) dst->data,
+            ncols, w_rows, limit_value, bias, lo, hi);
+    }
+}
diff --git a/ggml/src/ggml-cuda/clip-rows.cuh b/ggml/src/ggml-cuda/clip-rows.cuh
new file mode 100644
index 0000000000..bfe58f5b34
--- /dev/null
+++ b/ggml/src/ggml-cuda/clip-rows.cuh
@@ -0,0 +1,15 @@
+#pragma once
+
+#include "common.cuh"
+
+// Fused row L2 clip, the chain
+//   c = x (* w)                                  (MUL, optional, w broadcast over dims 2 and 3)
+//   n = sqrt(sum_rows(c*c)) + bias               (SQR, SUM_ROWS, SQRT, SCALE with scale 1)
+//   f = clamp(limit/n, lo, hi)                   (DIV by n, CLAMP; limit is a tensor or a constant)
+//   y = c*f                                      (MUL)
+// in one kernel, with the same rounding as the separate ops: the row sum follows the reduction of
+// sum_rows_f32_cuda for the same row count, the products are not contracted.
+// x, w, limit and dst are contiguous F32; x is [ncols, nrows], w is [ncols, w_rows] (row r reads row r % w_rows),
+// limit (if not null) holds one value per row.
+void ggml_cuda_op_clip_rows_fused(ggml_backend_cuda_context & ctx, const ggml_tensor * x, const ggml_tensor * w,
+        const ggml_tensor * limit, float limit_value, float bias, float lo, float hi, ggml_tensor * dst);
diff --git a/ggml/src/ggml-cuda/clip-scaled.cu b/ggml/src/ggml-cuda/clip-scaled.cu
new file mode 100644
index 0000000000..2e8dbfe0cd
--- /dev/null
+++ b/ggml/src/ggml-cuda/clip-scaled.cu
@@ -0,0 +1,485 @@
+#include "clip-scaled.cuh"
+#include "reduce_rows.cuh"
+#include "convert.cuh"
+
+// Inkling 2 row clip, [MUL(x, s)] -> L2_NORM(eps = t) -> SCALE(t), in one launch.  Bit-identical to the three kernels:
+// the product x*s is rounded as the MUL kernel rounds it, the sum of squares runs the loop, the block size and the
+// reduction of l2_norm_f32 (block_size = WARP_SIZE below 1024 columns), the norm factor is rsqrtf(fmaxf(sum, eps*eps))
+// as there, the product factor*m rounded as the L2_NORM kernel rounds it, then the SCALE kernel's t*y + bias (one FMA).
+// GGML_CUDA_DISABLE_CLIP_SCALED_FUSION=1 turns the fusion off.
+
+// one row of the clip; `tau` (or null): the product with a per-token scalar after the SCALE (the MUL the graph puts there,
+// rounded as that kernel rounds it: the clipped value first, then one multiply)
+struct clip_scaled_job {
+    const float * x; const float * s; float * dst; const float * tau;
+    int ncols, ne1, s_ne1, nrows;
+    int64_t x_s1, x_s2;
+    float eps, t, bias;
+};
+
+template <int block_size, bool has_s>
+static __device__ __forceinline__ void clip_scaled_row(const clip_scaled_job & p, const int64_t row, float * s_sum) {
+    const int     i1  = (int) (row % p.ne1);
+    const int64_t i2  = row / p.ne1;
+    const int     tid = threadIdx.x;
+    const int ncols = p.ncols;
+
+    const float * xr = p.x + i2*p.x_s2 + i1*p.x_s1;
+    const bool    use_s = has_s && p.s != nullptr;   // the pair kernel: a job without a channel scale has s null
+    const float * sr = use_s ? p.s + (p.s_ne1 == 1 ? 0 : (int64_t) i1*ncols) : nullptr;
+    float       * dr = p.dst + row*ncols;
+
+    float tmp = 0.0f;
+    for (int col = tid; col < ncols; col += block_size) {
+        const float xi = use_s ? __fmul_rn(xr[col], sr[col]) : xr[col];
+        tmp += xi * xi;
+    }
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+
+    const float scale = rsqrtf(fmaxf(tmp, p.eps * p.eps));
+
+    for (int col = tid; col < ncols; col += block_size) {
+        const float xi = use_s ? __fmul_rn(xr[col], sr[col]) : xr[col];
+        float v = __fmaf_rn(p.t, __fmul_rn(scale, xi), p.bias);   // scale_f32: scale*x + bias, contracted
+        if (p.tau != nullptr) {
+#if defined(GGML_USE_HIP)
+            asm volatile("" : "+v"(v));   // the SCALE result is rounded on its own before the product
+#endif
+            v = v * p.tau[i2];
+        }
+        dr[col] = v;
+    }
+}
+
+template <int block_size, bool has_s>
+static __global__ void clip_scaled_f32(
+        const float * x, const float * s, float * dst, const int ncols, const int ne1, const int s_ne1,
+        const int64_t x_s1, const int64_t x_s2, const float eps, const float t, const float bias) {
+    extern __shared__ float s_sum[];
+    ggml_cuda_pdl_sync();
+    const clip_scaled_job p = { x, s, dst, nullptr, ncols, ne1, s_ne1, 0, x_s1, x_s2, eps, t, bias };
+    clip_scaled_row<block_size, has_s>(p, blockIdx.x, s_sum);
+}
+
+// two clips (ggml_cuda_try_fuse_clip_scaled_pair): the first a.nrows blocks are a's rows, the rest b's
+template <int block_size, bool has_s>
+static __global__ void clip_scaled_pair_f32(const clip_scaled_job a, const clip_scaled_job b) {
+    extern __shared__ float s_sum[];
+    ggml_cuda_pdl_sync();
+    const bool in_a = (int) blockIdx.x < a.nrows;
+    clip_scaled_row<block_size, has_s>(in_a ? a : b, in_a ? blockIdx.x : blockIdx.x - a.nrows, s_sum);
+}
+
+static const ggml_tensor * clip_scaled_skip_views(const ggml_cgraph * cgraph, int & j) {
+    while (j < cgraph->n_nodes) {
+        const ggml_op op = cgraph->nodes[j]->op;
+        if (op != GGML_OP_VIEW && op != GGML_OP_RESHAPE) {
+            return cgraph->nodes[j];
+        }
+        ++j;
+    }
+    return nullptr;
+}
+
+// [MUL,] L2_NORM, SCALE at node i (the conditions of ggml_cuda_try_fuse_clip_scaled): fills job (no tau) and has_s,
+// returns the index of the SCALE, 0 if it does not match
+static int clip_scaled_match(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i, clip_scaled_job & job, bool & has_s) {
+    GGML_UNUSED(ctx);
+    static const bool disabled = [] { const char * e = getenv("GGML_CUDA_DISABLE_CLIP_SCALED_FUSION"); return e != nullptr && atoi(e) != 0; }();
+    if (disabled) {
+        return 0;
+    }
+    const ggml_tensor * n0 = cgraph->nodes[i];
+    const ggml_tensor * mul = nullptr;
+    const ggml_tensor * l2  = nullptr;
+    int i_l2 = i;
+    if (n0->op == GGML_OP_MUL) {
+        mul = n0;
+        int j = i + 1;
+        l2 = clip_scaled_skip_views(cgraph, j);
+        i_l2 = j;
+        if (!l2 || l2->op != GGML_OP_L2_NORM || l2->src[0] != mul) {
+            return 0;
+        }
+    } else if (n0->op == GGML_OP_L2_NORM) {
+        l2 = n0;
+    } else {
+        return 0;
+    }
+    int j = i_l2 + 1;
+    const ggml_tensor * scl = clip_scaled_skip_views(cgraph, j);
+    const int i_scl = j;
+    if (!scl || scl->op != GGML_OP_SCALE || scl->src[0] != l2) {
+        return 0;
+    }
+    float eps, t, bias;
+    memcpy(&eps,  l2->op_params,            sizeof(float));
+    memcpy(&t,    scl->op_params,           sizeof(float));
+    memcpy(&bias, (const float *) scl->op_params + 1, sizeof(float));
+    if (bias != 0.0f || eps < 0.0f) {
+        return 0;
+    }
+    const ggml_tensor * x = mul ? mul->src[0] : l2->src[0];
+    const ggml_tensor * s = mul ? mul->src[1] : nullptr;
+    const int64_t ncols = x->ne[0];
+    if (x->type != GGML_TYPE_F32 || l2->type != GGML_TYPE_F32 || scl->type != GGML_TYPE_F32 || x->nb[0] != sizeof(float) ||
+            x->ne[3] != 1 || ncols >= 1024 || !ggml_is_contiguous(scl) || !ggml_are_same_shape(scl, x) ||
+            !ggml_is_contiguous(l2) || (mul && (!ggml_is_contiguous(mul) || !ggml_are_same_shape(mul, x) || mul->type != GGML_TYPE_F32))) {
+        return 0;
+    }
+    if (s && (s->type != GGML_TYPE_F32 || !ggml_is_contiguous(s) || s->ne[0] != ncols || (s->ne[1] != 1 && s->ne[1] != x->ne[1]) ||
+            s->ne[2] != 1 || s->ne[3] != 1)) {
+        return 0;
+    }
+    if (x->nb[1] % sizeof(float) != 0 || x->nb[2] % sizeof(float) != 0 || (x->ne[2] > 1 && x->nb[2] < x->nb[1])) {
+        return 0;
+    }
+    // the elided intermediates must not be read elsewhere; the caller skips the nodes after i up to the SCALE
+    const int n_fuse = i_scl - i;
+    if (mul && ggml_node_get_use_count(cgraph, i) != 1) {
+        return 0;
+    }
+    if (ggml_node_get_use_count(cgraph, i_l2) != 1) {
+        return 0;
+    }
+    for (int k = i + 1; k < i_scl; ++k) {
+        const ggml_tensor * v = cgraph->nodes[k];
+        if (k != i_l2 && (v->view_src == mul || v->view_src == l2) && v != mul && v != l2) {
+            return 0;
+        }
+    }
+    // the output may share memory with x (the allocator runs MUL, L2_NORM and SCALE in place): every row is read in
+    // full before it is written, so only an identical layout is safe; any other overlap is declined
+    {
+        const char * d0 = (const char *) scl->data, * d1 = d0 + ggml_nbytes(scl);
+        const char * x0 = (const char *) x->data,   * x1 = x0 + ggml_nbytes(x);
+        const bool overlap = d0 < x1 && x0 < d1;
+        if (overlap && !(d0 == x0 && ggml_is_contiguous(x))) {
+            return 0;
+        }
+        if (s) {
+            const char * s0 = (const char *) s->data, * s1 = s0 + ggml_nbytes(s);
+            if (d0 < s1 && s0 < d1) {
+                return 0;
+            }
+        }
+    }
+    const int64_t nrows = x->ne[1]*x->ne[2];
+    if (nrows > INT_MAX) {
+        return 0;
+    }
+    job = { (const float *) x->data, s ? (const float *) s->data : nullptr, (float *) scl->data, nullptr,
+            (int) ncols, (int) x->ne[1], s ? (int) s->ne[1] : 1, (int) nrows,
+            (int64_t) (x->nb[1]/sizeof(float)), (int64_t) (x->nb[2]/sizeof(float)), eps, t, bias };
+    has_s = s != nullptr;
+    GGML_UNUSED(n_fuse);
+    return i_scl;
+}
+
+int ggml_cuda_try_fuse_clip_scaled(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    clip_scaled_job job;
+    bool has_s;
+    const int i_scl = clip_scaled_match(ctx, cgraph, i, job, has_s);
+    if (i_scl == 0) {
+        return 0;
+    }
+    const dim3 blocks((unsigned) job.nrows, 1, 1);
+    const dim3 threads(WARP_SIZE, 1, 1);
+    const ggml_cuda_kernel_launch_params p = { blocks, threads, 0, ctx.stream() };
+    if (has_s) {
+        ggml_cuda_kernel_launch(clip_scaled_f32<WARP_SIZE, true>, p, job.x, job.s, job.dst,
+            job.ncols, job.ne1, job.s_ne1, job.x_s1, job.x_s2, job.eps, job.t, job.bias);
+    } else {
+        ggml_cuda_kernel_launch(clip_scaled_f32<WARP_SIZE, false>, p, job.x, (const float *) nullptr, job.dst,
+            job.ncols, job.ne1, 1, job.x_s1, job.x_s2, job.eps, job.t, job.bias);
+    }
+    return i_scl - i;
+}
+
+// the clip at node i plus the per-token scalar product right after it, if any (Inkling's q*tau, r*tau): MUL(SCALE, tau)
+// with tau [1, 1, T], the SCALE read only there; fills job, returns the index of the last node, 0 if no clip
+static int clip_scaled_match_tau(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i, clip_scaled_job & job, bool & has_s) {
+    const int i_scl = clip_scaled_match(ctx, cgraph, i, job, has_s);
+    if (i_scl == 0) {
+        return 0;
+    }
+    int j = i_scl + 1;
+    const ggml_tensor * mul = clip_scaled_skip_views(cgraph, j);
+    const ggml_tensor * scl = cgraph->nodes[i_scl];
+    if (!mul || mul->op != GGML_OP_MUL || (mul->src[0] != scl && mul->src[1] != scl) || mul->src[0] == mul->src[1]) {
+        return i_scl;
+    }
+    const ggml_tensor * tau = mul->src[0] == scl ? mul->src[1] : mul->src[0];
+    const int64_t T = job.nrows / job.ne1;
+    if (tau->type != GGML_TYPE_F32 || !ggml_is_contiguous(tau) || tau->ne[0] != 1 || tau->ne[1] != 1 || tau->ne[2] != T ||
+            tau->ne[3] != 1 || mul->type != GGML_TYPE_F32 || !ggml_is_contiguous(mul) || !ggml_are_same_shape(mul, scl) ||
+            (scl->flags & GGML_TENSOR_FLAG_OUTPUT) || ggml_node_get_use_count(cgraph, i_scl) != 1) {
+        return i_scl;
+    }
+    for (int k = i_scl + 1; k < j; ++k) {
+        if (cgraph->nodes[k]->view_src == scl) {
+            return i_scl;
+        }
+    }
+    // the product's output: as the SCALE's (in place over x only with x's layout), never over the scale or tau
+    const char * d0 = (const char *) mul->data, * d1 = d0 + ggml_nbytes(mul);
+    const char * x0 = (const char *) job.x;
+    const size_t xn = (size_t) T * job.x_s2 * sizeof(float);
+    if (d0 < x0 + xn && x0 < d1 && !(d0 == x0 && job.x_s1 == job.ncols && job.x_s2 == (int64_t) job.ncols*job.ne1)) {
+        return i_scl;
+    }
+    const char * t0 = (const char *) tau->data;
+    if (d0 < t0 + ggml_nbytes(tau) && t0 < d1) {
+        return i_scl;
+    }
+    if (job.s) {
+        const char * s0 = (const char *) job.s;
+        const size_t sn = (size_t) job.ncols * job.s_ne1 * sizeof(float);
+        if (d0 < s0 + sn && s0 < d1) {
+            return i_scl;
+        }
+    }
+    job.dst = (float *) mul->data;
+    job.tau = (const float *) tau->data;
+    return j;
+}
+
+// Two consecutive clips (views between them allowed), each with its per-token product if the graph has one, with or
+// without a channel scale each, neither writing what the other reads (Inkling's q and r of one attention visit): one
+// launch, each block the single clip's row code (plus the product, rounded as the MUL kernel rounds it): bit-identical.
+// GGML_CUDA_CLIP_SCALED_PAIR=0: off.
+int ggml_cuda_try_fuse_clip_scaled_pair(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool on = [] { const char * e = getenv("GGML_CUDA_CLIP_SCALED_PAIR"); return e == nullptr || atoi(e) != 0; }();
+    if (!on) {
+        return 0;
+    }
+    clip_scaled_job a, b;
+    bool sa, sb;
+    const int ea = clip_scaled_match_tau(ctx, cgraph, i, a, sa);
+    if (ea == 0) {
+        return 0;
+    }
+    int j = ea + 1;
+    if (clip_scaled_skip_views(cgraph, j) == nullptr) {
+        return 0;
+    }
+    const int eb = clip_scaled_match_tau(ctx, cgraph, j, b, sb);
+    if (eb == 0) {
+        return 0;
+    }
+    const auto ranges_apart = [](const clip_scaled_job & w, const clip_scaled_job & r) {
+        const char * d0 = (const char *) w.dst;
+        const char * d1 = d0 + (size_t) w.nrows * w.ncols * sizeof(float);
+        const auto apart = [&](const void * p, size_t n) { const char * c = (const char *) p; return !p || d1 <= c || c + n <= d0; };
+        const int64_t T = r.nrows / r.ne1;
+        return apart(r.x, (size_t) T * r.x_s2 * sizeof(float)) && apart(r.s, (size_t) r.ncols * r.s_ne1 * sizeof(float)) &&
+               apart(r.tau, (size_t) T * sizeof(float)) && apart(r.dst, (size_t) r.nrows * r.ncols * sizeof(float));
+    };
+    if (!ranges_apart(a, b) || !ranges_apart(b, a) || (int64_t) a.nrows + b.nrows > INT_MAX) {
+        return 0;
+    }
+    const ggml_cuda_kernel_launch_params p = { dim3((unsigned) (a.nrows + b.nrows), 1, 1), dim3(WARP_SIZE, 1, 1), 0, ctx.stream() };
+    if (sa || sb) {
+        ggml_cuda_kernel_launch(clip_scaled_pair_f32<WARP_SIZE, true>, p, a, b);   // a job without a scale: s null
+    } else {
+        ggml_cuda_kernel_launch(clip_scaled_pair_f32<WARP_SIZE, false>, p, a, b);
+    }
+    return eb - i;
+}
+
+// Inkling 2 K/V store at the attention input: Kcur = clip(K) (L2_NORM -> SCALE, no channel scale), Vcur = RMS_NORM(V),
+// then SET_ROWS of each into its F16 cache, in one launch.  Bit-identical to the four kernels: the K rows replay
+// clip_scaled_f32<WARP_SIZE, false> (threads 0..31 of the block, the others leave), the V rows replay the scalar
+// rms_norm_f32<256, 1> launch (the one rms_norm_f32_dispatch takes below 1024 columns when the float4 form is off and
+// the device is not RDNA2), and each value is stored as k_set_rows converts it (ggml_cuda_cast<half>).  The F32 Kcur /
+// Vcur are not written: the matcher requires the SET_ROWS to be their only reader.
+// GGML_CUDA_KV_STORE_FUSION=0 turns it off.
+
+// the F32 value is rounded before the F16 conversion, as the unfused kernels store it in between: without the barrier
+// the compiler may fold the last multiply-add into the conversion (gfx11 v_fma_mix*, one rounding) and differ by 1 ulp
+static __device__ __forceinline__ half kv_store_f16(float v) {
+#if defined(GGML_USE_HIP)
+    asm volatile("" : "+v"(v));
+#endif
+    return ggml_cuda_cast<half>(v);
+}
+
+struct kv_store_params {
+    const float * xk; const float * xv;            // K before the clip, V before the norm: [D, H, T]
+    int64_t xk_s1, xk_s2, xv_s1, xv_s2;            // row / token strides in floats
+    const int64_t * idxk; const int64_t * idxv;    // cache row per token
+    int64_t idxk_s, idxv_s;                        // idx stride in elements
+    half * ck; half * cv;                          // F16 caches
+    int64_t ck_s1, cv_s1;                          // cache row stride in halves
+    int D, H, T, nk;                               // nk = H*T: the first nk blocks are K rows
+    float eps_k, t_k, b_k, eps_v;
+};
+
+static __global__ void __launch_bounds__(256) kv_store_f32(const kv_store_params p) {
+    extern __shared__ float s_sum[];
+    ggml_cuda_pdl_sync();
+    const int tid = threadIdx.x;
+    if ((int) blockIdx.x < p.nk) {
+        if (tid >= WARP_SIZE) {
+            return;
+        }
+        const int h = blockIdx.x % p.H, t = blockIdx.x / p.H;
+        const float * xr = p.xk + t*p.xk_s2 + h*p.xk_s1;
+        half * dr = p.ck + p.idxk[t*p.idxk_s]*p.ck_s1 + (int64_t) h*p.D;
+        float tmp = 0.0f;
+        for (int col = tid; col < p.D; col += WARP_SIZE) {
+            const float xi = xr[col];
+            tmp += xi * xi;
+        }
+        tmp = block_reduce<block_reduce_method::SUM, WARP_SIZE>(tmp, s_sum);
+        const float scale = rsqrtf(fmaxf(tmp, p.eps_k * p.eps_k));
+        for (int col = tid; col < p.D; col += WARP_SIZE) {
+            dr[col] = kv_store_f16(__fmaf_rn(p.t_k, __fmul_rn(scale, xr[col]), p.b_k));
+        }
+        return;
+    }
+    const int r = blockIdx.x - p.nk;
+    const int h = r % p.H, t = r / p.H;
+    const float * xr = p.xv + t*p.xv_s2 + h*p.xv_s1;
+    half * dr = p.cv + p.idxv[t*p.idxv_s]*p.cv_s1 + (int64_t) h*p.D;
+    float tmp = 0.0f;
+    for (int col = tid; col < p.D; col += 256) {
+        const float xi = xr[col];
+        tmp += xi * xi;
+    }
+    tmp = block_reduce<block_reduce_method::SUM, 256>(tmp, s_sum);
+    const float mean  = tmp / p.D;
+    const float scale = rsqrtf(mean + p.eps_v);
+    for (int col = tid; col < p.D; col += 256) {
+        const float v = scale * xr[col];
+        dr[col] = kv_store_f16(v);
+    }
+}
+
+static bool kv_store_is_view_op(ggml_op op) {
+    return op == GGML_OP_VIEW || op == GGML_OP_RESHAPE || op == GGML_OP_PERMUTE || op == GGML_OP_TRANSPOSE || op == GGML_OP_NONE;
+}
+
+// the SET_ROWS source must be the whole F32 result (directly or one view of it, as cpy_k / cpy_v make it), rows D*H
+static bool kv_store_src_ok(const ggml_cgraph * cgraph, const ggml_tensor * sr, const ggml_tensor * res, int i_res, int i_lo, int i_hi) {
+    const ggml_tensor * s = sr->src[0];
+    if (s == res) {
+        return ggml_node_get_use_count(cgraph, i_res) == 1;
+    }
+    if (s->view_src != res || s->view_offs != 0 || ggml_node_get_use_count(cgraph, i_res) != 1) {
+        return false;
+    }
+    for (int k = i_lo; k <= i_hi; ++k) {
+        if (cgraph->nodes[k] == s) {
+            return s->src[0] == res && ggml_node_get_use_count(cgraph, k) == 1;
+        }
+    }
+    return false;   // a leaf view: not expected here
+}
+
+int ggml_cuda_try_fuse_kv_store(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool on = [] { const char * e = getenv("GGML_CUDA_KV_STORE_FUSION"); return e == nullptr || atoi(e) != 0; }();
+    // K and V come from two graph branches: on a concurrent branch stream the other branch's input is not ordered
+    if (!on || ctx.curr_stream_no != 0 || ggml_cuda_rms_norm_vec() || GGML_CUDA_CC_IS_RDNA2(ggml_cuda_info().devices[ctx.device].cc)) {
+        return 0;
+    }
+    const ggml_op op0 = cgraph->nodes[i]->op;
+    if (op0 != GGML_OP_RMS_NORM && op0 != GGML_OP_L2_NORM) {
+        return 0;
+    }
+    // collect the five compute nodes; only view-like nodes may sit between them
+    int i_rms = -1, i_l2 = -1, i_scl = -1, i_sk = -1, i_sv = -1, n = 0, k = i;
+    for (; k < cgraph->n_nodes && k < i + 16 && n < 5; ++k) {
+        const ggml_tensor * t = cgraph->nodes[k];
+        if (kv_store_is_view_op(t->op)) {
+            continue;
+        }
+        ++n;
+        if (t->op == GGML_OP_RMS_NORM && i_rms < 0) {
+            i_rms = k;
+        } else if (t->op == GGML_OP_L2_NORM && i_l2 < 0) {
+            i_l2 = k;
+        } else if (t->op == GGML_OP_SCALE && i_scl < 0 && i_l2 >= 0 && t->src[0] == cgraph->nodes[i_l2]) {
+            i_scl = k;
+        } else if (t->op == GGML_OP_SET_ROWS && i_sk < 0 && i_scl >= 0 &&
+                   (t->src[0] == cgraph->nodes[i_scl] || t->src[0]->view_src == cgraph->nodes[i_scl])) {
+            i_sk = k;
+        } else if (t->op == GGML_OP_SET_ROWS && i_sv < 0 && i_rms >= 0 &&
+                   (t->src[0] == cgraph->nodes[i_rms] || t->src[0]->view_src == cgraph->nodes[i_rms])) {
+            i_sv = k;
+        } else {
+            return 0;
+        }
+    }
+    if (n != 5 || i_rms < 0 || i_l2 < 0 || i_scl < 0 || i_sk < 0 || i_sv < 0) {
+        return 0;
+    }
+    const int i_last = k - 1;
+    const ggml_tensor * rms = cgraph->nodes[i_rms], * l2 = cgraph->nodes[i_l2], * scl = cgraph->nodes[i_scl];
+    const ggml_tensor * sk = cgraph->nodes[i_sk], * sv = cgraph->nodes[i_sv];
+    const ggml_tensor * xk = l2->src[0], * xv = rms->src[0];
+    float eps_k, t_k, bias, eps_v;
+    memcpy(&eps_k, l2->op_params, sizeof(float));
+    memcpy(&t_k,   scl->op_params, sizeof(float));
+    memcpy(&bias,  (const float *) scl->op_params + 1, sizeof(float));
+    memcpy(&eps_v, rms->op_params, sizeof(float));
+    if (bias != 0.0f || eps_k < 0.0f) {
+        return 0;
+    }
+    const int64_t D = xk->ne[0], H = xk->ne[1], T = xk->ne[2];
+    // shapes: K and V [D, H, T] F32 rows of unit stride, D < 1024 (both replayed launches); results contiguous
+    for (const ggml_tensor * x : { xk, xv }) {
+        if (x->type != GGML_TYPE_F32 || x->nb[0] != sizeof(float) || x->ne[0] != D || x->ne[1] != H || x->ne[2] != T ||
+                x->ne[3] != 1 || x->nb[1] % sizeof(float) || x->nb[2] % sizeof(float)) {
+            return 0;
+        }
+    }
+    if (D >= 1024 || H*T > INT_MAX/2 || l2->type != GGML_TYPE_F32 || scl->type != GGML_TYPE_F32 || rms->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(l2) || !ggml_is_contiguous(scl) || !ggml_is_contiguous(rms) ||
+            !ggml_are_same_shape(l2, xk) || !ggml_are_same_shape(scl, xk) || !ggml_are_same_shape(rms, xv)) {
+        return 0;
+    }
+    // results not written: none may be a graph output or a view that writes through to another tensor
+    if ((scl->flags & GGML_TENSOR_FLAG_OUTPUT) || (rms->flags & GGML_TENSOR_FLAG_OUTPUT) || (l2->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+            scl->view_src != nullptr || rms->view_src != nullptr || l2->view_src != nullptr ||
+            ggml_node_get_use_count(cgraph, i_l2) != 1 || !kv_store_src_ok(cgraph, sk, scl, i_scl, i, i_last) ||
+            !kv_store_src_ok(cgraph, sv, rms, i_rms, i, i_last)) {
+        return 0;
+    }
+    // SET_ROWS: F16 rows of D*H halves, one I64 index per token, the source [D*H, T] contiguous
+    for (const ggml_tensor * s : { sk, sv }) {
+        const ggml_tensor * src = s->src[0], * idx = s->src[1];
+        if (s->type != GGML_TYPE_F16 || s->nb[0] != sizeof(half) || s->ne[0] != D*H || s->ne[2] != 1 || s->ne[3] != 1 ||
+                src->type != GGML_TYPE_F32 || ggml_nelements(src) != D*H*T || src->ne[0] != D*H || !ggml_is_contiguous(src) ||
+                idx->type != GGML_TYPE_I64 || idx->ne[0] != T || ggml_nelements(idx) != T || s->nb[1] % sizeof(half)) {
+            return 0;
+        }
+    }
+    // the K and V caches must not overlap each other or the inputs
+    {
+        const char * a0 = (const char *) sk->data, * a1 = a0 + ggml_nbytes(sk);
+        const char * b0 = (const char *) sv->data, * b1 = b0 + ggml_nbytes(sv);
+        if (a0 < b1 && b0 < a1) {
+            return 0;
+        }
+        for (const ggml_tensor * x : { xk, xv }) {
+            const char * x0 = (const char *) x->data, * x1 = x0 + ggml_nbytes(x);
+            if ((a0 < x1 && x0 < a1) || (b0 < x1 && x0 < b1)) {
+                return 0;
+            }
+        }
+    }
+    kv_store_params p;
+    p.xk = (const float *) xk->data; p.xv = (const float *) xv->data;
+    p.xk_s1 = xk->nb[1]/sizeof(float); p.xk_s2 = xk->nb[2]/sizeof(float);
+    p.xv_s1 = xv->nb[1]/sizeof(float); p.xv_s2 = xv->nb[2]/sizeof(float);
+    p.idxk = (const int64_t *) sk->src[1]->data; p.idxv = (const int64_t *) sv->src[1]->data;
+    p.idxk_s = sk->src[1]->nb[0]/sizeof(int64_t); p.idxv_s = sv->src[1]->nb[0]/sizeof(int64_t);
+    p.ck = (half *) sk->data; p.cv = (half *) sv->data;
+    p.ck_s1 = sk->nb[1]/sizeof(half); p.cv_s1 = sv->nb[1]/sizeof(half);
+    p.D = (int) D; p.H = (int) H; p.T = (int) T; p.nk = (int) (H*T);
+    p.eps_k = eps_k; p.t_k = t_k; p.b_k = bias; p.eps_v = eps_v;
+    const ggml_cuda_kernel_launch_params lp = { dim3((unsigned) (2*H*T), 1, 1), dim3(256, 1, 1), 256/WARP_SIZE*sizeof(float), ctx.stream() };
+    ggml_cuda_kernel_launch(kv_store_f32, lp, p);
+    return i_last - i;
+}
