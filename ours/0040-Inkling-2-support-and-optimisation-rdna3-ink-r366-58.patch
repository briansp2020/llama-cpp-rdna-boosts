+
+// The fused GEMVs below run src0 through mul_mat_vec_f; ggml_cuda_mul_mat sends a view in a compute buffer whose padding
+// would need clearing elsewhere (the depth-mix fusion's takes_mmvf has the same test), so such a src0 is not fused
+static bool mmvf_fuse_src0_ok(const ggml_tensor * w) {
+    return w->buffer == nullptr || !(ggml_backend_buffer_get_usage(w->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE &&
+        ggml_nbytes(w) != ggml_backend_buffer_get_alloc_size(w->buffer, w) && w->view_src);
+}
+
+// The Inkling loop control (inkling2.cpp control()): out = (c - tanh(Wf g)*c) + tanh(Wg g)*m, as the graph runs it
+// MUL_MAT(Wf, g), TANH, MUL(., c), SUB(c, .), MUL_MAT(Wg, g), TANH, [views], MUL(., m), ADD(sub, .) -- two GEMVs and two
+// tanh_mul_addsub_f32 launches -> one: the forget GEMV's launch (same instantiation and block size) also accumulates the
+// gain row from the same y in its own registers (the GLU gate lane, the same K order and reduction, so each dot product
+// is the unfused one) and applies tanh_mul_addsub_f32's arithmetic to both before the store.  Bit-identical.  One token.
+// GGML_CUDA_DISABLE_CTL_GATE_FUSION=1: off.
+struct mmvf_ctl_parts {
+    const ggml_tensor * mf, * add, * wf, * wg, * y, * c, * m;
+    int i_ad;
+};
+
+// the loop-control chain at node i (see ggml_cuda_ctl_gate_try_fuse); fills p, returns the nodes to skip, 0 if it does not match
+static int mmvf_ctl_match(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i, mmvf_ctl_parts & p) {
+    static const bool disabled = [] { const char * e = getenv("GGML_CUDA_DISABLE_CTL_GATE_FUSION"); return e != nullptr && atoi(e) != 0; }();
+    const int n = cgraph->n_nodes;
+    if (disabled || cgraph->nodes[i]->op != GGML_OP_MUL_MAT) {
+        return 0;
+    }
+    const auto is_view = [](const ggml_op op) {
+        return op == GGML_OP_VIEW || op == GGML_OP_RESHAPE || op == GGML_OP_PERMUTE || op == GGML_OP_TRANSPOSE;
+    };
+    const auto skip_views = [&](int j) {
+        while (j < n && is_view(cgraph->nodes[j]->op)) {
+            ++j;
+        }
+        return j;
+    };
+    const int i_tf = i + 1;
+    const int i_pf = skip_views(i + 2);
+    const int i_sb = i_pf + 1;
+    const int i_mg = i_sb + 1;
+    const int i_tg = i_mg + 1;
+    const int i_pg = skip_views(i_mg + 2);
+    const int i_ad = i_pg + 1;
+    if (i_ad >= n) {
+        return 0;
+    }
+    ggml_tensor * mf  = cgraph->nodes[i];
+    ggml_tensor * tf  = cgraph->nodes[i_tf];
+    ggml_tensor * pf  = cgraph->nodes[i_pf];
+    ggml_tensor * sb  = cgraph->nodes[i_sb];
+    ggml_tensor * mg  = cgraph->nodes[i_mg];
+    ggml_tensor * tg  = cgraph->nodes[i_tg];
+    ggml_tensor * pg  = cgraph->nodes[i_pg];
+    ggml_tensor * add = cgraph->nodes[i_ad];
+    if (tf->op != GGML_OP_UNARY || ggml_get_unary_op(tf) != GGML_UNARY_OP_TANH || tf->src[0] != mf ||
+            pf->op != GGML_OP_MUL || sb->op != GGML_OP_SUB || mg->op != GGML_OP_MUL_MAT ||
+            tg->op != GGML_OP_UNARY || ggml_get_unary_op(tg) != GGML_UNARY_OP_TANH || tg->src[0] != mg ||
+            pg->op != GGML_OP_MUL || add->op != GGML_OP_ADD) {
+        return 0;
+    }
+    const ggml_tensor * c = pf->src[0] == tf ? pf->src[1] : (pf->src[1] == tf ? pf->src[0] : nullptr);
+    const ggml_tensor * m = pg->src[0] == tg ? pg->src[1] : (pg->src[1] == tg ? pg->src[0] : nullptr);
+    // c and m are read by the fused kernel, so neither may be a node of the chain (nobody writes those)
+    for (const ggml_tensor * t : { (const ggml_tensor *) mf, (const ggml_tensor *) tf, (const ggml_tensor *) pf, (const ggml_tensor *) sb,
+                                   (const ggml_tensor *) mg, (const ggml_tensor *) tg, (const ggml_tensor *) pg }) {
+        if (c == t || m == t || (c && c->view_src == t) || (m && m->view_src == t)) {
+            return 0;
+        }
+    }
+    if (!c || !m || c == tf || m == tg || sb->src[0] != c || sb->src[1] != pf ||
+            !((add->src[0] == sb && add->src[1] == pg) || (add->src[0] == pg && add->src[1] == sb))) {
+        return 0;
+    }
+    const ggml_tensor * wf = mf->src[0];
+    const ggml_tensor * wg = mg->src[0];
+    const ggml_tensor * y  = mf->src[1];
+    const int64_t nr = wf->ne[1];
+    const int cc        = ggml_cuda_info().devices[ctx.device].cc;
+    const int warp_size = ggml_cuda_info().devices[ctx.device].warp_size;
+    if (mg->src[1] != y || (wf->type != GGML_TYPE_BF16 && wf->type != GGML_TYPE_F32) || wg->type != wf->type ||
+            !ggml_are_same_shape(wf, wg) || !ggml_are_same_stride(wf, wg) || wf->ne[2] != 1 || wf->ne[3] != 1 ||
+            wf->nb[0] != ggml_type_size(wf->type) ||
+            y->type != GGML_TYPE_F32 || !ggml_is_contiguous(y) || y->ne[0] != wf->ne[0] || y->ne[2] != 1 || y->ne[3] != 1 ||
+            y->ne[1] < 1 || y->ne[1] > MMVF_MAX_BATCH_SIZE ||
+            ggml_cuda_mmb_supported_mm(wf, y, mf) || ggml_cuda_mmb_supported_mm(wg, y, mg) ||
+            ggml_cuda_op_mul_mat_use_fwht(mf) || ggml_cuda_op_mul_mat_use_fwht(mg) ||
+            !ggml_cuda_should_use_mmvf(wf, cc, warp_size, y->ne[1]) || !ggml_cuda_should_use_mmvf(wg, cc, warp_size, y->ne[1]) ||
+            !mmvf_fuse_src0_ok(wf) || !mmvf_fuse_src0_ok(wg)) {
+        return 0;
+    }
+    const int64_t nt = y->ne[1];
+    for (const ggml_tensor * t : { (const ggml_tensor *) mf, (const ggml_tensor *) tf, (const ggml_tensor *) pf,
+                                   (const ggml_tensor *) sb, (const ggml_tensor *) mg, (const ggml_tensor *) tg,
+                                   (const ggml_tensor *) pg, (const ggml_tensor *) add }) {
+        if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) || t->ne[0] != nr || t->ne[1] != nt || ggml_nelements(t) != nr*nt) {
+            return 0;
+        }
+    }
+    // c and m: [nr, nt] rows of floats, any column stride (a token's row of a wider tensor)
+    for (const ggml_tensor * t : { c, m }) {
+        if (t->type != GGML_TYPE_F32 || t->nb[0] != sizeof(float) || t->ne[0] != nr || t->ne[1] != nt || t->ne[2] != 1 ||
+                t->ne[3] != 1 || t->nb[1] % sizeof(float) != 0) {
+            return 0;
+        }
+    }
+    // the skipped views must not be views of an elided node
+    for (int k = i + 1; k < i_ad; ++k) {
+        const ggml_tensor * v = cgraph->nodes[k];
+        if (is_view(v->op) && (v->view_src == mf || v->view_src == tf || v->view_src == pf || v->view_src == sb ||
+                               v->view_src == mg || v->view_src == tg || v->view_src == pg)) {
+            return 0;
+        }
+    }
+    const ggml_op ops[8]  = { GGML_OP_MUL_MAT, GGML_OP_UNARY, GGML_OP_MUL, GGML_OP_SUB, GGML_OP_MUL_MAT, GGML_OP_UNARY, GGML_OP_MUL, GGML_OP_ADD };
+    const int     idxs[8] = { i, i_tf, i_pf, i_sb, i_mg, i_tg, i_pg, i_ad };
+    const int     outs[1] = { i_ad };
+    if (!ggml_can_fuse_subgraph_ext(cgraph, idxs, 8, ops, outs, 1)) {
+        return 0;
+    }
+    // every block reads all of y and its weight rows; c and m only its own row, before its store
+    const auto disjoint = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const char * a0 = (const char *) a->data;
+        const char * b0 = (const char *) b->data;
+        return a0 + ggml_nbytes(a) <= b0 || b0 + ggml_nbytes(b) <= a0;
+    };
+    if (!disjoint(add, y) || !disjoint(add, wf) || !disjoint(add, wg) ||
+            !(disjoint(add, c) || (add->data == c->data && c->nb[1] == add->nb[1])) ||
+            !(disjoint(add, m) || (add->data == m->data && m->nb[1] == add->nb[1]))) {
+        return 0;
+    }
+    p = { mf, add, wf, wg, y, c, m, i_ad };
+    return i_ad - i;
+}
+
+int ggml_cuda_ctl_gate_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    mmvf_ctl_parts p;
+    if (mmvf_ctl_match(ctx, cgraph, i, p) == 0) {
+        return 0;
+    }
+    const ggml_tensor * mf = p.mf, * add = p.add, * wf = p.wf, * wg = p.wg, * y = p.y, * c = p.c, * m = p.m;
+    const int i_ad = p.i_ad;
+    ggml_cuda_mm_fusion_args_device ctl{};
+    ctl.gate  = wg->data;
+    ctl.ctl_c    = (const float *) c->data;
+    ctl.ctl_m    = (const float *) m->data;
+    ctl.ctl_c_s1 = c->nb[1] / sizeof(float);
+    ctl.ctl_m_s1 = m->nb[1] / sizeof(float);
+    ggml_tensor dst_flat = *mf;
+    dst_flat.data = add->data;
+    ggml_cuda_mul_mat_vec_f(ctx, wf, y, nullptr, &dst_flat, nullptr, &ctl);
+    return i_ad - i;
+}
