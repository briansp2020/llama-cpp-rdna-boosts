+            S == nullptr || S->type != GGML_TYPE_F32 || S->ne[0] != 1 || S->ne[1] != mm->ne[1] || S->ne[2] != mm->ne[2] || S->ne[3] != 1 ||
+            !ggml_are_same_shape(sub, pad) || pad->ne[0] != mm->ne[0] + 1 || (sub->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+    // the product and the padded table feed only the next op; the table only flash attention's pos-bias slot
+    if (ggml_node_get_use_count(cgraph, i) != 1 || ggml_node_get_use_count(cgraph, j) != 1) {
+        return 0;
+    }
+    int n_fa = 0;
+    for (int n = k + 1; n < cgraph->n_nodes; ++n) {
+        const ggml_tensor * t = cgraph->nodes[n];
+        for (int q = 0; q < GGML_MAX_SRC; ++q) {
+            if (t->src[q] == sub) {
+                if (t->op != GGML_OP_FLASH_ATTN_EXT || q != 9) {
+                    return 0;
+                }
+                ++n_fa;
+            }
+        }
+    }
+    if (n_fa == 0 || n_fa != ggml_node_get_use_count(cgraph, k)) {
+        return 0;
+    }
+    // the kernel writes the table while it still reads R and S: the allocator placed the table for the unfused chain (R is
+    // dead after the MUL_MAT there), so its buffer may overlap R; decline unless no output aliases an input from outside
+    {
+        const int out_nodes[1] = { k };
+        if (!ggml_cuda_check_fusion_memory_ranges(cgraph, i, k - i + 1, out_nodes, 1)) {
+            return 0;
+        }
+    }
+    const int M = (int) W->ne[1];
+    const int H = (int) mm->ne[1];
+    const int T = (int) mm->ne[2];
+    const dim3 nums((unsigned) ((M + 1 + 255)/256), (unsigned) H, (unsigned) T);
+    rel_table_f32<<<nums, 256, 0, ctx.stream()>>>((const float *) W->data, (const float *) R->data, (const char *) S->data,
+        (float *) sub->data, M, (int) (W->nb[1]/sizeof(float)), (int) (R->nb[1]/sizeof(float)/2), (int) (R->nb[2]/sizeof(float)),
+        (int64_t) S->nb[1], (int64_t) S->nb[2], H);
+    CUDA_CHECK(cudaGetLastError());
+    return k - i;
+}
