 struct ggml_cuda_kernel_launch_params {
diff --git a/ggml/src/ggml-cuda/conv-chain.cu b/ggml/src/ggml-cuda/conv-chain.cu
new file mode 100644
index 0000000000..4ac82c84c7
--- /dev/null
+++ b/ggml/src/ggml-cuda/conv-chain.cu
@@ -0,0 +1,761 @@
+#include "conv-chain.cuh"
+#include "ggml-cuda-try-fuse.cuh"
+#include "ggml-impl.h"
+
+#include <algorithm>
+#include <cstring>
+
+#define CONV_CHAIN_BLOCK_SIZE 128
+
+// the longest per-sequence ubatch fused: decode, batched decode and speculative verify
+#define CONV_CHAIN_MAX_TOKENS 32
+
+struct conv_chain_params {
+    const float * cur;     // [C, T*ns] contiguous
+    const float * past;    // [n_conv - 1, C, ns], strides in floats
+    int64_t       past_nb1;
+    int64_t       past_nb2;
+    const int32_t * past_ids;   // ours: a deferred gather (one sequence): past is at row past_ids[0] of past_cache,
+    const char    * past_cache; // past_offs bytes into the row, row stride cache_nb1 bytes; null: past as above
+    int64_t         cache_nb1;
+    int64_t         past_offs;
+    const float * w;       // [n_conv, C], row stride in floats
+    int64_t       w_nb1;
+    const float * dyn;     // [n_conv, n_head, T*ns] contiguous, or null
+    int           ch_per_head;
+    int           n_head;
+    float       * dst;     // [C, T*ns] contiguous, may be cur or res
+    const float * res;     // [C, T*ns] contiguous, added after the SCALE (the residual ADD after the chain), or null
+    float         scale;
+    float         bias;
+    float         conv_bias; // 0: the bias add of ssm_conv_f32
+    char        * st;      // state window of slot 0, column 0, channel 0, sequence 0
+    int64_t       st_slot; // bytes
+    int64_t       st_ch;
+    int64_t       st_seq;
+    int           n_win;   // windows stored: start columns T - n_win + 1 .. T go to slots n_win - 1 .. 0
+    int           C;
+    int           T;
+};
+
+// pair: two independent chains in one launch (ggml_cuda_try_fuse_conv_chain_pair), blockIdx.z picks the chain
+template <int n_conv, bool has_dyn, bool pair = false>
+static __global__ void conv_chain_f32(const conv_chain_params p0, const conv_chain_params p1) {
+    const conv_chain_params & p = pair && blockIdx.z != 0 ? p1 : p0;
+    ggml_cuda_pdl_lc();
+    const int c = blockIdx.y*CONV_CHAIN_BLOCK_SIZE + threadIdx.x;
+    const int s = blockIdx.x;
+
+    ggml_cuda_pdl_sync();
+    if (c >= p.C) {
+        return;
+    }
+
+    float w[n_conv];
+#pragma unroll
+    for (int j = 0; j < n_conv; ++j) {
+        w[j] = p.w[c*p.w_nb1 + j];
+    }
+
+    // xr[j] = column t + j of x; every input is read before the output of its token is written, so dst may be cur
+    float xr[n_conv];
+    const float * past = p.past_ids ? (const float *) (p.past_cache + int64_t(p.past_ids[0])*p.cache_nb1 + p.past_offs) : p.past;
+#pragma unroll
+    for (int j = 0; j < n_conv - 1; ++j) {
+        xr[j] = past[j + c*p.past_nb1 + s*p.past_nb2];
+    }
+
+    const int64_t tok0 = int64_t(s)*p.T;
+    const float * cur  = p.cur + tok0*p.C + c;
+    float       * dst  = p.dst + tok0*p.C + c;
+    char        * st   = p.st + c*p.st_ch + s*p.st_seq;
+    const int     h    = has_dyn ? c / p.ch_per_head : 0;
+
+    auto store = [&](int slot) {
+        float * d = (float *) (st + slot*p.st_slot);
+#pragma unroll
+        for (int j = 0; j < n_conv - 1; ++j) {
+            d[j] = xr[j];
+        }
+    };
+
+    for (int t = 0; t < p.T; ++t) {
+        xr[n_conv - 1] = cur[int64_t(t)*p.C];
+
+        // the window starting at column t
+        if (t >= p.T - p.n_win + 1) {
+            store(p.T - t);
+        }
+
+        // SSM_CONV as ssm_conv_f32: contracted products in tap order, then the (zero) bias
+        float sumf = 0.0f;
+#pragma unroll
+        for (int j = 0; j < n_conv; ++j) {
+            sumf = __fmaf_rn(xr[j], w[j], sumf);
+        }
+        sumf = __fadd_rn(sumf, p.conv_bias);
+
+        if (has_dyn) {
+            // MUL, ADD per lag: window lag starts n_conv - 1 - lag columns into x; the product rounded as the MUL kernel
+            // does (HIP: __fmul_rn / __fadd_rn are plain operators that clang would contract into an FMA, so plain
+            // operators with contraction off)
+            const float * tap = p.dyn + ((tok0 + t)*p.n_head + h)*n_conv;
+#pragma unroll
+            for (int lag = 0; lag < n_conv; ++lag) {
+#if defined(GGML_USE_HIP)
+#pragma clang fp contract(off)
+                const float prod = xr[n_conv - 1 - lag]*tap[lag];
+                sumf = sumf + prod;
+#else
+                sumf = __fadd_rn(sumf, __fmul_rn(xr[n_conv - 1 - lag], tap[lag]));
+#endif // defined(GGML_USE_HIP)
+            }
+        }
+
+        // ADD cur + out, then SCALE as scale_f32 (contracted), then the residual ADD
+        float y = __fmaf_rn(p.scale, __fadd_rn(xr[n_conv - 1], sumf), p.bias);
+        if (p.res) {
+            y = __fadd_rn(p.res[(tok0 + t)*p.C + c], y);
+        }
+        dst[int64_t(t)*p.C] = y;
+
+#pragma unroll
+        for (int j = 0; j < n_conv - 1; ++j) {
+            xr[j] = xr[j + 1];
+        }
+    }
+    // the last window, the next tokens' history
+    store(0);
+}
+
+template <int n_conv>
+static void conv_chain_launch(const conv_chain_params & p, int ns, bool has_dyn, cudaStream_t stream) {
+    const dim3 blocks(ns, (p.C + CONV_CHAIN_BLOCK_SIZE - 1)/CONV_CHAIN_BLOCK_SIZE, 1);
+    const ggml_cuda_kernel_launch_params lp = ggml_cuda_kernel_launch_params(blocks, dim3(CONV_CHAIN_BLOCK_SIZE, 1, 1), 0, stream);
+    if (has_dyn) {
+        ggml_cuda_kernel_launch(conv_chain_f32<n_conv, true>, lp, p, p);
+    } else {
+        ggml_cuda_kernel_launch(conv_chain_f32<n_conv, false>, lp, p, p);
+    }
+}
+
+template <int n_conv>
+static void conv_chain_launch_pair(const conv_chain_params & p0, const conv_chain_params & p1, int ns, bool has_dyn, cudaStream_t stream) {
+    const dim3 blocks(ns, (p0.C + CONV_CHAIN_BLOCK_SIZE - 1)/CONV_CHAIN_BLOCK_SIZE, 2);
+    const ggml_cuda_kernel_launch_params lp = ggml_cuda_kernel_launch_params(blocks, dim3(CONV_CHAIN_BLOCK_SIZE, 1, 1), 0, stream);
+    if (has_dyn) {
+        ggml_cuda_kernel_launch(conv_chain_f32<n_conv, true, true>, lp, p0, p1);
+    } else {
+        ggml_cuda_kernel_launch(conv_chain_f32<n_conv, false, true>, lp, p0, p1);
+    }
+}
+
+static bool conv_chain_is_view(const ggml_tensor * t) {
+    return t->op == GGML_OP_VIEW || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_TRANSPOSE || t->op == GGML_OP_PERMUTE;
+}
+
+// the tensor a chain of RESHAPE nodes is computed from
+static const ggml_tensor * conv_chain_unreshape(const ggml_tensor * t) {
+    while (t && t->op == GGML_OP_RESHAPE) {
+        t = t->src[0];
+    }
+    return t;
+}
+
+static bool conv_chain_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    if (!a || !b || !a->data || !b->data) {
+        return false;
+    }
+    const char * a0 = (const char *) a->data;
+    const char * b0 = (const char *) b->data;
+    return a0 < b0 + ggml_nbytes(b) && b0 < a0 + ggml_nbytes(a);
+}
+
+static int conv_chain_decline(int line, const ggml_tensor * at = nullptr) {
+    static const bool dbg = getenv("GGML_CUDA_CONV_CHAIN_DEBUG") != nullptr;
+    if (dbg) {
+        static int n = 0;
+        if (n++ < 64) {
+            GGML_LOG_WARN("ggml_cuda_try_fuse_conv_chain: declined at conv-chain.cu:%d %s %s\n", line,
+                at ? ggml_op_name(at->op) : "-", at ? at->name : "-");
+        }
+    }
+    return 0;
+}
+
+static const ggml_tensor * conv_chain_root(const ggml_tensor * t) {
+    while (t && t->view_src) {
+        t = t->view_src;
+    }
+    return t;
+}
+
+// what a dry run (ctx == nullptr) reports about a chain it would take
+struct conv_chain_info {
+    const ggml_tensor * past;
+    const ggml_tensor * store; // the store node (CPY / SET_ROWS)
+    const ggml_tensor * cell;  // the cache cells it writes (the CPY's destination) for n_win == 1
+    int64_t ns;
+    int     n_win;
+};
+
+// a matched chain collected instead of launched (ggml_cuda_try_fuse_conv_chain_pair): its params and the bytes it reads
+// and writes; a deferred past reads a row of `cache` at [past_lo, past_hi) of the row
+struct conv_chain_job {
+    conv_chain_params p;
+    int  ns;
+    bool dyn;
+    int  nc;
+    const char * rd[4]; size_t rdn[4]; int n_rd;    // cur, w, dyn, res
+    const char * wr[10]; size_t wrn[10]; int n_wr;  // dst, the state cells
+    const char * past; size_t pastn;                // the past as a tensor (not deferred)
+    const ggml_tensor * cache;                      // deferred: the cache root
+    int64_t row, past_lo, past_hi;
+};
+
+static int conv_chain_fuse(ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph, int i, conv_chain_info * info,
+        conv_chain_job * job = nullptr) {
+    const ggml_tensor * x = cgraph->nodes[i];
+    if (x->op != GGML_OP_CONCAT || x->type != GGML_TYPE_F32 || ggml_get_op_params_i32(x, 0) != 0 || !ggml_is_contiguous(x)) {
+        return 0;
+    }
+
+    // the compute nodes after x in order, views skipped: store, SSM_CONV, [CONT, (MUL, ADD) x n_conv], ADD, SCALE
+    const int n_scan_max = 64;
+    const ggml_tensor * store = nullptr; // CPY or SET_ROWS
+    // ours: a run of CPYs, one per rollback slot (llama-graph's per-slot store of Inkling 2 under a tensor split):
+    // the first is `store`, the others follow it here
+    const ggml_tensor * store_run[8] = {};
+    int n_run = 0;
+    const ggml_tensor * arange = nullptr, * slot_scale = nullptr, * slot_cast = nullptr;
+    const ggml_tensor * ssm = nullptr, * xt = nullptr;
+    const ggml_tensor * muls[16] = {}, * adds[16] = {};
+    int n_mul = 0, n_add = 0;
+    const ggml_tensor * scl = nullptr;
+    int j = i + 1;
+    for (; j < cgraph->n_nodes && j - i < n_scan_max && !scl; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (conv_chain_is_view(n)) {
+            continue;
+        }
+        if (!store) {
+            if (n->op == GGML_OP_ARANGE && !arange) { arange = n; continue; }
+            if (n->op == GGML_OP_SCALE && arange && !slot_scale) { slot_scale = n; continue; }
+            if (n->op == GGML_OP_CPY && slot_scale && !slot_cast) { slot_cast = n; continue; } // ggml_cast
+            if ((n->op == GGML_OP_CPY && !arange) || (n->op == GGML_OP_SET_ROWS && slot_cast)) { store = n; continue; }
+            return conv_chain_decline(__LINE__, n);
+        }
+        if (!ssm && store->op == GGML_OP_CPY && n->op == GGML_OP_CPY && n_run < 8) {
+            store_run[n_run++] = n;
+            continue;
+        }
+        if (!ssm) {
+            if (n->op != GGML_OP_SSM_CONV) {
+                return conv_chain_decline(__LINE__, n);
+            }
+            ssm = n;
+            continue;
+        }
+        if (n->op == GGML_OP_CONT && !xt && n_add == 0) { xt = n; continue; }
+        if (n->op == GGML_OP_MUL && xt && n_mul == n_add && n_mul < 16) { muls[n_mul++] = n; continue; }
+        if (n->op == GGML_OP_ADD && n_add < 16 && n_add <= n_mul) { adds[n_add++] = n; continue; }
+        if (n->op == GGML_OP_SCALE && n_add == n_mul + 1) { scl = n; continue; }
+        return conv_chain_decline(__LINE__);
+    }
+    if (!scl || !store || !ssm) {
+        return conv_chain_decline(__LINE__);
+    }
+    int i_last = j - 1;
+
+    // ours: the residual ADD right after the chain (y = res + chain), when the chain's result feeds only it
+    const ggml_tensor * res_add = nullptr;
+    const ggml_tensor * res     = nullptr;
+    static const bool res_on = [] { const char * e = getenv("GGML_CUDA_CONV_CHAIN_RES"); return e == nullptr || atoi(e) != 0; }();
+    if (res_on) {
+        int k = j;
+        while (k < cgraph->n_nodes && conv_chain_is_view(cgraph->nodes[k])) {
+            ++k;
+        }
+        const ggml_tensor * a = k < cgraph->n_nodes ? cgraph->nodes[k] : nullptr;
+        if (a && a->op == GGML_OP_ADD && a->type == GGML_TYPE_F32 && ggml_is_contiguous(a) && ggml_are_same_shape(a, scl) &&
+                (a->src[0] == scl) != (a->src[1] == scl) && ggml_node_get_use_count(cgraph, i_last) == 1 &&
+                (scl->flags & GGML_TENSOR_FLAG_OUTPUT) == 0 && (a->flags & GGML_TENSOR_FLAG_COMPUTE)) {
+            const ggml_tensor * r = a->src[0] == scl ? a->src[1] : a->src[0];
+            if (r->type == GGML_TYPE_F32 && ggml_is_contiguous(r) && ggml_are_same_shape(r, a) && r->data) {
+                res_add = a;
+                res     = r;
+                i_last  = k;
+            }
+        }
+    }
+    const ggml_tensor * dst_node = res_add ? res_add : scl;
+
+    // SSM_CONV(x, w)
+    const ggml_tensor * w = ssm->src[1];
+    const int64_t nc = w->ne[0];
+    const int64_t C  = x->ne[1];
+    const int64_t ns = x->ne[2];
+    const int64_t T  = x->ne[0] - (nc - 1);
+    if (ssm->src[0] != x || ssm->type != GGML_TYPE_F32 || w->type != GGML_TYPE_F32 || w->nb[0] != sizeof(float) ||
+        w->ne[1] != C || T < 1 || T > CONV_CHAIN_MAX_TOKENS || !(nc >= 2 && nc <= 5) || x->ne[3] != 1) {
+        return conv_chain_decline(__LINE__);
+    }
+
+    // x = concat(past, transpose(cur)): cur is [C, T*ns] contiguous
+    const ggml_tensor * past = x->src[0];
+    const ggml_tensor * xT   = x->src[1];
+    const ggml_tensor * add_res = adds[n_add - 1];
+    if (scl->src[0] != add_res || add_res->type != GGML_TYPE_F32 || scl->type != GGML_TYPE_F32) {
+        return conv_chain_decline(__LINE__);
+    }
+    const bool dyn_chain = xt != nullptr;
+    if (dyn_chain ? n_mul != nc : n_mul != 0) {
+        return conv_chain_decline(__LINE__);
+    }
+    const ggml_tensor * cur = add_res->src[0];
+    const ggml_tensor * out = conv_chain_unreshape(add_res->src[1]);
+    if (out != (dyn_chain ? adds[n_add - 2] : ssm)) {
+        return conv_chain_decline(__LINE__);
+    }
+    if (cur->type != GGML_TYPE_F32 || !ggml_is_contiguous(cur) || cur->ne[0] != C || ggml_nelements(cur) != C*T*ns ||
+        !ggml_are_same_shape(cur, add_res) || !ggml_is_contiguous(add_res) || !ggml_are_same_shape(scl, add_res) ||
+        !ggml_is_contiguous(scl)) {
+        return conv_chain_decline(__LINE__);
+    }
+    if (past->type != GGML_TYPE_F32 || past->nb[0] != sizeof(float) || past->ne[0] != nc - 1 || past->ne[1] != C ||
+        past->ne[2] != ns || past->ne[3] != 1) {
+        return conv_chain_decline(__LINE__);
+    }
+    if (xT->type != GGML_TYPE_F32 || xT->data != cur->data || xT->ne[0] != T || xT->ne[1] != C || xT->ne[2] != ns ||
+        xT->nb[0] != (size_t) C*sizeof(float) || xT->nb[1] != sizeof(float) || (ns > 1 && xT->nb[2] != (size_t) (C*T)*sizeof(float))) {
+        return conv_chain_decline(__LINE__);
+    }
+
+    // the dynamic taps: out_l = out_{l-1} + window(x, n_conv - 1 - l)*tap(l)
+    const ggml_tensor * dyn = nullptr;
+    int64_t n_head = 0, ch_per_head = 0;
+    if (dyn_chain) {
+        if (xt->src[0]->op != GGML_OP_TRANSPOSE || xt->src[0]->src[0] != x || xt->type != GGML_TYPE_F32 ||
+            xt->ne[0] != C || xt->ne[1] != x->ne[0] || xt->ne[2] != ns || !ggml_is_contiguous(xt)) {
+            return conv_chain_decline(__LINE__);
+        }
+        const ggml_tensor * prev = ssm;
+        for (int l = 0; l < nc; ++l) {
+            const ggml_tensor * m = muls[l];
+            const ggml_tensor * a = adds[l];
+            if (conv_chain_unreshape(a->src[0]) != prev || conv_chain_unreshape(a->src[1]) != m || a->type != GGML_TYPE_F32 ||
+                m->type != GGML_TYPE_F32 || !ggml_is_contiguous(a) || ggml_nelements(a) != C*T*ns) {
+                return conv_chain_decline(__LINE__);
+            }
+            const ggml_tensor * win = m->src[0];
+            const ggml_tensor * tap = m->src[1];
+            if (l == 0) {
+                n_head      = win->ne[1];
+                ch_per_head = win->ne[0];
+                dyn         = tap->view_src;
+                if (!dyn || dyn->type != GGML_TYPE_F32 || !ggml_is_contiguous(dyn) || n_head*ch_per_head != C ||
+                    ggml_nelements(dyn) != nc*n_head*T*ns) {
+                    return conv_chain_decline(__LINE__);
+                }
+            }
+            if (win->op != GGML_OP_VIEW || win->view_src != xt || win->view_offs != (size_t) (nc - 1 - l)*xt->nb[1] ||
+                win->ne[0] != ch_per_head || win->ne[1] != n_head || win->ne[2] != T || win->ne[3] != ns ||
+                win->nb[1] != (size_t) ch_per_head*sizeof(float) || win->nb[2] != xt->nb[1] || win->nb[3] != xt->nb[2]) {
+                return conv_chain_decline(__LINE__);
+            }
+            if (tap->op != GGML_OP_VIEW || tap->view_src != dyn || tap->view_offs != (size_t) l*sizeof(float) ||
+                tap->ne[0] != 1 || tap->ne[1] != n_head || tap->ne[2] != T || tap->ne[3] != ns ||
+                tap->nb[1] != (size_t) nc*sizeof(float) || tap->nb[2] != (size_t) (nc*n_head)*sizeof(float) ||
+                tap->nb[3] != (size_t) (nc*n_head*T)*sizeof(float)) {
+                return conv_chain_decline(__LINE__);
+            }
+            prev = a;
+        }
+    }
+
+    // the state store
+    conv_chain_params p = {};
+    const ggml_tensor * st_dst = nullptr;
+    const ggml_tensor * st_cells[9] = {};   // every cell written (the CPY run), for the overlap checks
+    int n_cells = 0;
+    if (store->op == GGML_OP_CPY && n_run > 0) {
+        // window w of n_win starts at column T - (n_win - 1) + w and goes to slot n_win - 1 - w, one CPY each, in w order;
+        // the slots are planes st_slot bytes apart (slot 0 = the last window)
+        const int n_win = n_run + 1;
+        const ggml_tensor * cpys[9] = { store };
+        for (int k = 0; k < n_run; ++k) {
+            cpys[k + 1] = store_run[k];
+        }
+        if (n_win > T) {
+            return conv_chain_decline(__LINE__);
+        }
+        const char * base = (const char *) cpys[n_win - 1]->src[1]->data;
+        const int64_t st_slot = (const char *) cpys[n_win - 2]->src[1]->data - base;
+        if (st_slot <= 0) {
+            return conv_chain_decline(__LINE__);
+        }
+        for (int wi = 0; wi < n_win; ++wi) {
+            const ggml_tensor * last = cpys[wi]->src[0];
+            const ggml_tensor * cell = cpys[wi]->src[1];
+            if (last->view_src != x || last->view_offs != (size_t) (T - (n_win - 1) + wi)*sizeof(float) || last->ne[0] != nc - 1 ||
+                last->ne[1] != C || last->ne[2] != ns || last->nb[1] != x->nb[1] || last->nb[2] != x->nb[2] ||
+                cell->type != GGML_TYPE_F32 || cell->ne[0] != (nc - 1)*C || cell->ne[1] != ns || cell->ne[2] != 1 ||
+                cell->nb[0] != sizeof(float) || cell->nb[1] != cpys[0]->src[1]->nb[1] ||
+                (const char *) cell->data != base + (int64_t) (n_win - 1 - wi)*st_slot) {
+                return conv_chain_decline(__LINE__);
+            }
+            st_cells[n_cells++] = cell;
+        }
+        st_dst    = cpys[n_win - 1]->src[1];
+        p.st      = (char *) base;
+        p.st_slot = st_slot;
+        p.st_ch   = (nc - 1)*sizeof(float);
+        p.st_seq  = cpys[0]->src[1]->nb[1];
+        p.n_win   = n_win;
+    } else if (store->op == GGML_OP_CPY) {
+        // the last n_conv - 1 columns of x into [(n_conv - 1)*C, ns] rows
+        const ggml_tensor * last = store->src[0];
+        const ggml_tensor * cell = store->src[1];
+        if (last->view_src != x || last->view_offs != (size_t) T*sizeof(float) || last->ne[0] != nc - 1 || last->ne[1] != C ||
+            last->ne[2] != ns || last->nb[1] != x->nb[1] || last->nb[2] != x->nb[2] ||
+            cell->type != GGML_TYPE_F32 || cell->ne[0] != (nc - 1)*C || cell->ne[1] != ns || cell->ne[2] != 1 ||
+            cell->nb[0] != sizeof(float)) {
+            return conv_chain_decline(__LINE__);
+        }
+        st_dst    = cell;
+        st_cells[n_cells++] = cell;
+        p.st      = (char *) cell->data;
+        p.st_slot = 0;
+        p.st_ch   = (nc - 1)*sizeof(float);
+        p.st_seq  = cell->nb[1];
+        p.n_win   = 1;
+    } else {
+        // SET_ROWS(slots, windows, slot_order): window k starts at column T - (n_win - 1) + k and goes to slot n_win - 1 - k
+        const ggml_tensor * wins  = store->src[0];
+        const ggml_tensor * order = store->src[1];
+        const ggml_tensor * slots = store->src[2];
+        const int64_t n_win = wins->ne[1];
+        const int64_t K     = arange->ne[0];
+        float ar[3];
+        memcpy(ar, arange->op_params, sizeof(ar));
+        float sb[2];
+        memcpy(sb, slot_scale->op_params, sizeof(sb));
+        if (ar[0] != 0.0f || ar[2] != 1.0f || arange->type != GGML_TYPE_F32 || K < 1 || ar[1] != (float) K ||
+            slot_scale->src[0] != arange || sb[0] != -1.0f || sb[1] != (float) (K - 1) ||
+            slot_cast->src[0] != slot_scale || slot_cast->type != GGML_TYPE_I32 || (slot_cast->src[1] && slot_cast->src[1] != slot_cast) ||
+            !order || order->view_src != slot_cast || order->ne[0] != n_win || order->ne[1] != 1 ||
+            order->view_offs != (size_t) (K - n_win)*sizeof(int32_t) || n_win < 1 || n_win > K || n_win > T) {
+            return conv_chain_decline(__LINE__);
+        }
+        if (wins->view_src != x || wins->ne[0] != nc - 1 || wins->ne[2] != C || wins->ne[3] != ns ||
+            wins->nb[1] != sizeof(float) || wins->nb[2] != x->nb[1] || wins->nb[3] != x->nb[2] ||
+            wins->view_offs != (size_t) (T - (n_win - 1))*sizeof(float)) {
+            return conv_chain_decline(__LINE__);
+        }
+        if (slots->type != GGML_TYPE_F32 || slots->nb[0] != sizeof(float) || slots->ne[0] != nc - 1 || slots->ne[1] != K ||
+            slots->ne[2] != C || slots->ne[3] != ns || store->type != GGML_TYPE_F32) {
+            return conv_chain_decline(__LINE__);
+        }
+        st_dst    = slots;
+        st_cells[n_cells++] = slots;
+        p.st      = (char *) slots->data;
+        p.st_slot = slots->nb[1];
+        p.st_ch   = slots->nb[2];
+        p.st_seq  = slots->nb[3];
+        p.n_win   = (int) n_win;
+    }
+
+    // every intermediate is read only inside the chain; the store and the final SCALE are the outputs
+    for (int k = i; k <= i_last; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        if ((n->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            return conv_chain_decline(__LINE__);
+        }
+        bool in_run = false;
+        for (int k = 0; k < n_run; ++k) {
+            in_run = in_run || n == store_run[k];
+        }
+        if (n == dst_node || n == store || in_run) {
+            continue;
+        }
+        if (n->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            return conv_chain_decline(__LINE__);
+        }
+        int uses = 0;
+        for (int m = k; m <= i_last; ++m) { // from k: a cast reads itself as src[1]
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                uses += cgraph->nodes[m]->src[s] == n;
+            }
+        }
+        if (uses != ggml_node_get_use_count(cgraph, k)) {
+            return conv_chain_decline(__LINE__);
+        }
+    }
+    // dst may be cur (in place), nothing else may alias an output
+    // ... or res (in place); res is read only where it is written
+    if (conv_chain_overlap(dst_node, w) || (dst_node->data != cur->data && conv_chain_overlap(dst_node, cur)) ||
+        conv_chain_overlap(dst_node, past) || conv_chain_overlap(dst_node, dyn) ||
+        (res && dst_node->data != res->data && conv_chain_overlap(dst_node, res))) {
+        return conv_chain_decline(__LINE__);
+    }
+    for (int k = 0; k < n_cells; ++k) {
+        const ggml_tensor * cell = st_cells[k];
+        if (conv_chain_overlap(cell, w) || conv_chain_overlap(dst_node, cell) || conv_chain_overlap(cell, cur) ||
+            conv_chain_overlap(cell, res) ||
+            conv_chain_overlap(cell, past) || conv_chain_overlap(cell, dyn)) {
+            return conv_chain_decline(__LINE__);
+        }
+    }
+
+    float sc[2];
+    memcpy(sc, scl->op_params, sizeof(sc));
+
+    p.cur         = (const float *) cur->data;
+    p.past        = (const float *) past->data;
+    p.past_nb1    = past->nb[1]/sizeof(float);
+    p.past_nb2    = past->nb[2]/sizeof(float);
+    p.w           = (const float *) w->data;
+    p.w_nb1       = w->nb[1]/sizeof(float);
+    p.dyn         = dyn ? (const float *) dyn->data : nullptr;
+    p.ch_per_head = (int) ch_per_head;
+    p.n_head      = (int) n_head;
+    p.dst         = (float *) dst_node->data;
+    p.res         = res ? (const float *) res->data : nullptr;
+    p.scale       = sc[0];
+    p.bias        = sc[1];
+    p.conv_bias   = 0.0f;
+    p.C           = (int) C;
+    p.T           = (int) T;
+    if (past->nb[1] % sizeof(float) || past->nb[2] % sizeof(float) || w->nb[1] % sizeof(float)) {
+        return conv_chain_decline(__LINE__);
+    }
+
+    if (ctx == nullptr) {
+        info->past  = past;
+        info->store = store;
+        info->cell  = st_dst;
+        info->ns    = ns;
+        info->n_win = p.n_win;
+        return i_last - i;
+    }
+
+    // ours: the gather of the history deferred (ggml_cuda_conv_chain_gather_deferrable): read the cache row
+    const ggml_tensor * proot = conv_chain_root(past);
+    if (proot->op == GGML_OP_GET_ROWS &&
+            std::find(ctx->gdn_deferred_gathers.begin(), ctx->gdn_deferred_gathers.end(), proot) != ctx->gdn_deferred_gathers.end()) {
+        GGML_ASSERT(ns == 1 && p.n_win == 1);
+        p.past_ids   = (const int32_t *) proot->src[1]->data;
+        p.past_cache = (const char *) proot->src[0]->data;
+        p.cache_nb1  = proot->src[0]->nb[1];
+        p.past_offs  = (const char *) past->data - (const char *) proot->data;
+    }
+
+    // GGML_CUDA_CONV_CHAIN_DEBUG=N logs the first N fused chains
+    static const int n_debug = getenv("GGML_CUDA_CONV_CHAIN_DEBUG") ? atoi(getenv("GGML_CUDA_CONV_CHAIN_DEBUG")) : 0;
+    if (n_debug > 0 && job == nullptr) {   // a collected chain logs nothing (its pair launch is not this chain alone)
+        static int n_logged = 0;
+        if (n_logged++ < n_debug) {
+            GGML_LOG_WARN("%s: fused %d nodes at %d: C %lld T %lld ns %lld n_conv %lld dyn %d store %s n_win %d\n", __func__,
+                i_last - i + 1, i, (long long) C, (long long) T, (long long) ns, (long long) nc, dyn_chain ? 1 : 0,
+                ggml_op_name(store->op), p.n_win);
+        }
+    }
+
+    if (job != nullptr) {
+        *job = {};
+        job->p   = p;
+        job->ns  = (int) ns;
+        job->dyn = dyn_chain;
+        job->nc  = (int) nc;
+        const auto add_rd = [&](const ggml_tensor * t) {
+            if (t) { job->rd[job->n_rd] = (const char *) t->data; job->rdn[job->n_rd++] = ggml_nbytes(t); }
+        };
+        add_rd(cur); add_rd(w); add_rd(dyn); add_rd(res);
+        job->wr[job->n_wr] = (const char *) dst_node->data; job->wrn[job->n_wr++] = ggml_nbytes(dst_node);
+        for (int k = 0; k < n_cells; ++k) {
+            job->wr[job->n_wr] = (const char *) st_cells[k]->data; job->wrn[job->n_wr++] = ggml_nbytes(st_cells[k]);
+        }
+        if (p.past_ids != nullptr) {
+            job->cache   = proot->src[0];
+            job->row     = (int64_t) proot->src[0]->nb[1];
+            job->past_lo = p.past_offs;
+            job->past_hi = p.past_offs + (int64_t) ggml_nbytes(past);
+        } else {
+            job->past  = (const char *) past->data;
+            job->pastn = ggml_nbytes(past);
+        }
+        return i_last - i;
+    }
+
+    cudaStream_t stream = ctx->stream();
+    switch (nc) {
+        case 2: conv_chain_launch<2>(p, (int) ns, dyn_chain, stream); break;
+        case 3: conv_chain_launch<3>(p, (int) ns, dyn_chain, stream); break;
+        case 4: conv_chain_launch<4>(p, (int) ns, dyn_chain, stream); break;
+        case 5: conv_chain_launch<5>(p, (int) ns, dyn_chain, stream); break;
+        default: GGML_ABORT("unreachable");
+    }
+    return i_last - i;
+}
+
+int ggml_cuda_try_fuse_conv_chain(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    return conv_chain_fuse(&ctx, cgraph, i, nullptr);
+}
+
+// the bytes job a writes never touch what job b reads or writes (a deferred past by its window in the cache row)
+static bool conv_chain_job_apart(const conv_chain_job & a, const conv_chain_job & b) {
+    const auto apart = [](const char * x, size_t xn, const char * y, size_t yn) { return x + xn <= y || y + yn <= x; };
+    for (int k = 0; k < a.n_wr; ++k) {
+        for (int l = 0; l < b.n_rd; ++l) {
+            if (!apart(a.wr[k], a.wrn[k], b.rd[l], b.rdn[l])) {
+                return false;
+            }
+        }
+        for (int l = 0; l < b.n_wr; ++l) {
+            if (!apart(a.wr[k], a.wrn[k], b.wr[l], b.wrn[l])) {
+                return false;
+            }
+        }
+        if (b.past && !apart(a.wr[k], a.wrn[k], b.past, b.pastn)) {
+            return false;
+        }
+        if (b.cache) {
+            // a write into b's cache: its offset in a row against b's window (any row: rows are not known on the host)
+            const char * c0 = (const char *) b.cache->data;
+            if (apart(a.wr[k], a.wrn[k], c0, ggml_nbytes(b.cache))) {
+                continue;
+            }
+            const int64_t rel = (int64_t) (a.wr[k] - c0) % b.row;
+            if (a.wr[k] < c0 || rel + (int64_t) a.wrn[k] > b.row || !(rel + (int64_t) a.wrn[k] <= b.past_lo || b.past_hi <= rel)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+// Two consecutive conv chains (views between them allowed) with the same shape and kind, none touching what the other
+// reads or writes (Inkling's K and V short convolutions of one layer): one launch, blockIdx.z picking the chain, each
+// block the single chain's code: bit-identical.  GGML_CUDA_CONV_CHAIN_PAIR=0: off.
+int ggml_cuda_try_fuse_conv_chain_pair(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool on = [] { const char * e = getenv("GGML_CUDA_CONV_CHAIN_PAIR"); return e == nullptr || atoi(e) != 0; }();
+    if (!on || cgraph->nodes[i]->op != GGML_OP_CONCAT) {
+        return 0;
+    }
+    conv_chain_job a, b;
+    const int na = conv_chain_fuse(&ctx, cgraph, i, nullptr, &a);
+    if (na == 0) {
+        return 0;
+    }
+    int j = i + na + 1;
+    while (j < cgraph->n_nodes && conv_chain_is_view(cgraph->nodes[j])) {
+        ++j;
+    }
+    if (j >= cgraph->n_nodes || cgraph->nodes[j]->op != GGML_OP_CONCAT) {
+        return 0;
+    }
+    const int nb = conv_chain_fuse(&ctx, cgraph, j, nullptr, &b);
+    if (nb == 0 || a.nc != b.nc || a.dyn != b.dyn || a.ns != b.ns || a.p.C != b.p.C || a.p.T != b.p.T ||
+            !conv_chain_job_apart(a, b) || !conv_chain_job_apart(b, a)) {
+        return 0;
+    }
+    cudaStream_t stream = ctx.stream();
+    switch (a.nc) {
+        case 2: conv_chain_launch_pair<2>(a.p, b.p, a.ns, a.dyn, stream); break;
+        case 3: conv_chain_launch_pair<3>(a.p, b.p, a.ns, a.dyn, stream); break;
+        case 4: conv_chain_launch_pair<4>(a.p, b.p, a.ns, a.dyn, stream); break;
+        case 5: conv_chain_launch_pair<5>(a.p, b.p, a.ns, a.dyn, stream); break;
+        default: GGML_ABORT("unreachable");
+    }
+    return j + nb - i;
+}
+
+bool ggml_cuda_conv_chain_gather_deferrable(const ggml_cgraph * cgraph, int node_idx, const ggml_cuda_gdn_gather_index & idx) {
+    static const bool on = [] { const char * e = getenv("GGML_CUDA_CONV_CHAIN_GATHER"); return e == nullptr || atoi(e) != 0; }();
+    static const bool fusion_off = getenv("GGML_CUDA_DISABLE_SHORT_CONV_FUSION") != nullptr && atoi(getenv("GGML_CUDA_DISABLE_SHORT_CONV_FUSION")) != 0;
+    const ggml_tensor * gr = cgraph->nodes[node_idx];
+    const auto g = idx.gathers.find(gr);
+    if (!on || fusion_off || g == idx.gathers.end() || g->second.n_gdn != 0 || g->second.other_reader || g->second.n_concat < 1 ||
+            g->second.n_concat > 8 || g->second.concat <= node_idx || gr->src[1]->ne[0] != 1 || ggml_nrows(gr) != 1) {
+        return false;
+    }
+    // every use of the gathered rows must be in this cgraph: the graph-wide use counts against the references here
+    {
+        const auto r = idx.refs.find(gr);
+        if ((r == idx.refs.end() ? 0 : r->second) != ggml_node_get_use_count(cgraph, node_idx)) {
+            return false;
+        }
+        for (const int v : g->second.views) {
+            const auto rv = idx.refs.find(cgraph->nodes[v]);
+            if ((rv == idx.refs.end() ? 0 : rv->second) != ggml_node_get_use_count(cgraph, v)) {
+                return false;
+            }
+        }
+    }
+    const ggml_tensor * states = gr->src[0];
+    const ggml_tensor * cache  = conv_chain_root(states);
+    const int64_t row = states->nb[1];
+
+    // every reader: a chain's history, its byte range in the row, and the bytes of the row its store writes
+    struct chain { int idx; int64_t lo, hi, so, se; const ggml_tensor * store; };
+    chain ch[8];
+    int n = 0;
+    for (int j = node_idx + 1; j <= g->second.concat; ++j) {
+        const ggml_tensor * c = cgraph->nodes[j];
+        if (c->op != GGML_OP_CONCAT || c->src[0] == nullptr || conv_chain_root(c->src[0]) != gr) {
+            continue;
+        }
+        conv_chain_info info = {};
+        if (n == 8 || conv_chain_fuse(nullptr, cgraph, j, &info) == 0 || info.ns != 1 || info.n_win != 1 ||
+                info.past != c->src[0] || conv_chain_root(info.past) != gr || info.store->op != GGML_OP_CPY ||
+                conv_chain_root(info.cell) != cache || !info.cell->data || !states->data) {
+            return false;
+        }
+        const int64_t lo = (const char *) info.past->data - (const char *) gr->data;
+        const int64_t co = (const char *) info.cell->data - (const char *) states->data;
+        if (lo < 0 || co < 0) {
+            return false;
+        }
+        ch[n].idx   = j;
+        ch[n].lo    = lo;
+        ch[n].hi    = lo + (int64_t) ggml_nbytes(info.past);
+        ch[n].so    = co % row;
+        ch[n].se    = ch[n].so + (int64_t) ggml_nbytes(info.cell);
+        ch[n].store = info.store;
+        if (ch[n].hi > row || ch[n].se > row) {
+            return false;
+        }
+        // the chain's own store: on other bytes, or on exactly its past window with the store's channel pitch
+        // ((n_conv - 1) floats = past->ne[0]), so each thread overwrites only the values it has already read
+        if (!(ch[n].se <= ch[n].lo || ch[n].hi <= ch[n].so) &&
+                !(ch[n].so == ch[n].lo && ch[n].se == ch[n].hi && info.past->nb[1] == info.past->ne[0]*sizeof(float))) {
+            return false;
+        }
+        n++;
+    }
+    if (n != g->second.n_concat) {
+        return false;
+    }
+    // before a chain runs, the cache is written only by the stores of the chains before it, on other bytes of the row
+    const auto w = idx.writers.find(cache);
+    if (w != idx.writers.end()) {
+        for (const int j : w->second) {
+            if (j <= node_idx) {
+                continue;
+            }
+            for (int k = 0; k < n; ++k) {
+                if (j >= ch[k].idx) {
+                    continue;
+                }
+                bool ok = false;
+                for (int m = 0; m < k && !ok; ++m) {
+                    ok = cgraph->nodes[j] == ch[m].store && (ch[m].se <= ch[k].lo || ch[k].hi <= ch[m].so);
+                }
+                if (!ok) {
+                    return false;
+                }
+            }
+        }
+    }
+    return true;
+}
diff --git a/ggml/src/ggml-cuda/conv-chain.cuh b/ggml/src/ggml-cuda/conv-chain.cuh
new file mode 100644
index 0000000000..f55671671c
--- /dev/null
+++ b/ggml/src/ggml-cuda/conv-chain.cuh
@@ -0,0 +1,24 @@
+#pragma once
+
+#include "common.cuh"
+
+// Fused causal short convolution with a residual, the chain
+//   x   = concat(past, transpose(cur), 0)                         (CONCAT; past: the last n_conv - 1 inputs per sequence)
+//   the tail of x stored into the recurrent state                 (CPY of the last n_conv - 1 columns, or SET_ROWS of
+//                                                                  one window per rollback slot after ARANGE, SCALE, CAST)
+//   out = ssm_conv(x, w)                                          (SSM_CONV)
+//   out = out + window(x, lag) * tap(lag), lag = 0 .. n_conv - 1  (optional: CONT of transpose(x), then MUL, ADD per lag)
+//   y   = scale*(cur + out) + bias                                (ADD, SCALE)
+// in one kernel per sequence and channel, with the same rounding as the separate kernels.
+// Returns the number of nodes after node i taken by the fused chain, 0 if the nodes at i do not form one.
+int ggml_cuda_try_fuse_conv_chain(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i);
+
+// ours: the conv-state gather (build_rs's GET_ROWS of the recurrent conv cache) at node_idx whose every reader is the
+// history of a conv chain this fusion takes: single sequence, one stored window, and nothing but the earlier chains'
+// own stores (on other bytes of the row) writing the cache before a chain runs.  The chains then read the cache row
+// (row id = the gather's src[1]) and the gather launches nothing.  GGML_CUDA_CONV_CHAIN_GATHER=0: off.
+struct ggml_cuda_gdn_gather_index;
+bool ggml_cuda_conv_chain_gather_deferrable(const ggml_cgraph * cgraph, int node_idx, const ggml_cuda_gdn_gather_index & idx);
+
+// two consecutive independent conv chains as one launch; returns the nodes to skip after i, 0 if not fused
+int ggml_cuda_try_fuse_conv_chain_pair(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i);
diff --git a/ggml/src/ggml-cuda/depth-mix.cu b/ggml/src/ggml-cuda/depth-mix.cu
new file mode 100644
index 0000000000..607dc69748
--- /dev/null
+++ b/ggml/src/ggml-cuda/depth-mix.cu
@@ -0,0 +1,671 @@
+#include "depth-mix.cuh"
+#include "mmvf.cuh"
+#include "fwht.cuh"
+#include "ggml-backend-impl.h"
+
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include <algorithm>
+#include <cmath>
+
+#define DEPTH_MIX_BLOCK 1024
+#define DEPTH_MIX_MAX_N 32
+#define DEPTH_MIX_MAX_NQ 4
+#define DEPTH_MIX_MAX_NCOLS 8192
+
+struct depth_mix_params {
+    const float * normed; int64_t normed_s2;                // [ncols, 1, T], the RMS_NORM output (computed by its own kernel)
+    const float * raw;    int64_t raw_s2;    float eps;     // or the RMS_NORM input, normed here (ours: the norm in the chain)
+    const float * prev;   int64_t prev_s1,   prev_s2;       // [ncols, n - 1, T]
+    const float * prev_t; int64_t prev_t_s1, prev_t_s2;     // [n - 1, ncols, T]
+    const float * q;      int64_t q_s1,      q_s2;          // [ncols, nq, T], q_s2 = 0 for a repeated query
+    float * states;       int64_t states_s1, states_s2;     // CONCAT outputs, if used outside the chain
+    float * states_t;     int64_t states_t_s1, states_t_s2;
+    float * scores;       int64_t scores_s1, scores_s2;     // SOFT_MAX output, if used outside the chain
+    float * out;          int64_t out_s1,    out_s2;        // the second MUL_MAT, if fused
+    int   ncols;
+    int   n;                                                // rows of the mix, the earlier blocks + x
+    float scale;
+    int   mm_block;                                         // the block size mul_mat_vec_f picks for ncols
+    int   rows_per_block;                                   // rows of out (and of the written intermediates) per block
+};
+
+template <int nq>
+static __global__ void __launch_bounds__(DEPTH_MIX_BLOCK, 1) depth_mix_f32(const depth_mix_params p) {
+    extern __shared__ float4 depth_mix_smem[];
+    float * normed = (float *) depth_mix_smem; // [ncols]
+    __shared__ float red_mm[nq][DEPTH_MIX_BLOCK / WARP_SIZE];
+    __shared__ float raw[nq * DEPTH_MIX_MAX_N];
+    __shared__ float sc[nq * DEPTH_MIX_MAX_N];
+
+    const int     tid   = threadIdx.x;
+    const int     warp  = tid / WARP_SIZE;
+    const int     lane  = tid % WARP_SIZE;
+    const int64_t t     = blockIdx.y;
+    const int     ncols = p.ncols;
+    const int     n     = p.n;
+
+    ggml_cuda_pdl_sync();
+    if (p.raw) {
+        // rms_norm_f32<float, 1024, 1, false> (the launch RMS_NORM takes for ncols >= 1024 without the opt-in float4
+        // grouping), with the same block size: the same partial sums, block reduction, scale and products
+        static_assert(DEPTH_MIX_BLOCK == 1024, "the norm replicates the 1024-thread RMS_NORM launch");
+        __shared__ float s_rms[DEPTH_MIX_BLOCK / WARP_SIZE];
+        const float * xr = p.raw + t*p.raw_s2;
+        float tmp = 0.0f;
+        for (int col = tid; col < ncols; col += DEPTH_MIX_BLOCK) {
+            const float xi = xr[col];
+            tmp += xi * xi;
+        }
+        tmp = block_reduce<block_reduce_method::SUM, DEPTH_MIX_BLOCK>(tmp, s_rms);
+        const float mean  = tmp / ncols;
+        const float scale = rsqrtf(mean + p.eps);
+        for (int col = tid; col < ncols; col += DEPTH_MIX_BLOCK) {
+            const float xi = xr[col];
+            normed[col] = scale * xi;
+        }
+    } else {
+        for (int col = tid; col < ncols; col += DEPTH_MIX_BLOCK) {
+            normed[col] = p.normed[col + t*p.normed_s2];
+        }
+    }
+    ggml_cuda_pdl_lc();
+    __syncthreads();
+
+    // scores = states^T q as mul_mat_vec_f<float, float, nq, mm_block>: one group of mm_block threads per row
+    {
+        const int g_size  = p.mm_block;
+        const int ngroups = DEPTH_MIX_BLOCK / g_size;
+        const int g       = tid / g_size;
+        const int gt      = tid % g_size;
+        const int ncols2  = ncols / 2;
+        const float2 * q2 = (const float2 *) (p.q + t*p.q_s2);
+        const int64_t q_s1_2 = p.q_s1 / 2;
+
+        for (int k0 = 0; k0 < n; k0 += ngroups) {
+            const int k = k0 + g;
+            float sumf[nq] = {0.0f};
+            if (g < ngroups && k < n) {
+                const float2 * x2 = (const float2 *) (k < n - 1 ? p.prev + k*p.prev_s1 + t*p.prev_s2 : normed);
+                for (int col2 = gt; col2 < ncols2; col2 += g_size) {
+                    const float2 tmpx = x2[col2];
+#pragma unroll
+                    for (int j = 0; j < nq; ++j) {
+                        const float2 tmpy = q2[j*q_s1_2 + col2];
+                        ggml_cuda_mad(sumf[j], tmpx.x, tmpy.x);
+                        ggml_cuda_mad(sumf[j], tmpx.y, tmpy.y);
+                    }
+                }
+            }
+#pragma unroll
+            for (int j = 0; j < nq; ++j) {
+                sumf[j] = warp_reduce_sum(sumf[j]);
+            }
+            if (g_size > WARP_SIZE) {
+                if (lane == 0) {
+#pragma unroll
+                    for (int j = 0; j < nq; ++j) {
+                        red_mm[j][warp] = sumf[j];
+                    }
+                }
+                __syncthreads();
+                if (g < ngroups && gt < WARP_SIZE) {
+                    const int nw = g_size / WARP_SIZE;
+#pragma unroll
+                    for (int j = 0; j < nq; ++j) {
+                        float v = 0.0f;
+                        if (lane < nw) {
+                            v = red_mm[j][g*nw + lane];
+                        }
+                        sumf[j] = warp_reduce_sum(v);
+                    }
+                }
+                __syncthreads();
+            }
+            if (g < ngroups && k < n && gt == 0) {
+#pragma unroll
+                for (int j = 0; j < nq; ++j) {
+                    raw[j*n + k] = sumf[j];
+                }
+            }
+        }
+    }
+    __syncthreads();
+
+    // SOFT_MAX_EXT without mask and sinks as soft_max_f32 with one warp per row (n <= WARP_SIZE)
+    if (warp < nq) {
+        const int col = lane;
+        float max_val = -INFINITY;
+        float val     = 0.0f;
+        if (col < n) {
+            val = raw[warp*n + col]*p.scale + 0.0f;
+            max_val = max(max_val, val);
+        }
+        max_val = warp_reduce_max(max_val);
+        float tmp = 0.0f;
+        if (col < n) {
+            val = expf(val - max_val);
+            tmp += val;
+        }
+        tmp = warp_reduce_sum(tmp);
+        const float inv_sum = 1.0f / tmp;
+        if (col < n) {
+            const float s = val * inv_sum;
+            sc[warp*n + col] = s;
+            if (p.scores && blockIdx.x == 0) {
+                p.scores[col + warp*p.scores_s1 + t*p.scores_s2] = s;
+            }
+        }
+    }
+    __syncthreads();
+
+    const int e0 = blockIdx.x*p.rows_per_block;
+    const int e1 = min(ncols, e0 + p.rows_per_block);
+
+    // out = states_t^T scores as mul_mat_vec_f<float, float, nq, WARP_SIZE> computes it with one warp per row: lane l
+    // accumulates columns 2l and 2l + 1 (n <= 32, one iteration), then warp_reduce_sum adds lane l^o to lane l for
+    // o = 16, 8, 4, 2, 1. Here one thread per row forms the same 32 lane partials (zero past n/2) and the same additions
+    // that end in lane 0. Floating-point addition is commutative, so a + b and b + a round alike.
+    if (p.out) {
+        // odd n (GGML_CUDA_DEPTH_MIX_ODD, one token): the last pair takes a zero for the missing column, as
+        // mul_mat_vec_f would on a zero-padded K (the separate op is rocBLAS's GEMV there: not bit-identical)
+        const int nh = (n + 1) / 2;
+        for (int e = e0 + tid; e < e1; e += DEPTH_MIX_BLOCK) {
+            // the earlier rows transposed: a CONCAT of their own, or the plain rows read across (the same values)
+            const float * xr  = p.prev_t ? p.prev_t + e*p.prev_t_s1 + t*p.prev_t_s2 : p.prev + e + t*p.prev_s2;
+            const int64_t xs  = p.prev_t ? 1 : p.prev_s1;
+            const float   xn  = normed[e];
+            float v[nq][WARP_SIZE/2];
+#pragma unroll
+            for (int l = 0; l < WARP_SIZE/2; ++l) {
+#pragma unroll
+                for (int j = 0; j < nq; ++j) {
+                    v[j][l] = 0.0f;
+                }
+                if (l < nh) {
+                    const int k = 2*l;
+                    const bool  has1 = k + 1 < n;
+                    const float x0 = k     < n - 1 ? xr[k*xs]       : xn;
+                    const float x1 = !has1 ? 0.0f : k + 1 < n - 1 ? xr[(k + 1)*xs] : xn;
+#pragma unroll
+                    for (int j = 0; j < nq; ++j) {
+                        float sumf = 0.0f;
+                        ggml_cuda_mad(sumf, x0, sc[j*n + k]);
+                        ggml_cuda_mad(sumf, x1, has1 ? sc[j*n + k + 1] : 0.0f);
+                        v[j][l] = sumf;
+                    }
+                }
+            }
+#pragma unroll
+            for (int j = 0; j < nq; ++j) {
+                // o = 16: lanes 16..31 hold 0
+#pragma unroll
+                for (int l = 0; l < WARP_SIZE/2; ++l) {
+                    v[j][l] = __fadd_rn(v[j][l], 0.0f);
+                }
+#pragma unroll
+                for (int o = WARP_SIZE/4; o > 0; o >>= 1) {
+#pragma unroll
+                    for (int l = 0; l < o; ++l) {
+                        v[j][l] = __fadd_rn(v[j][l], v[j][l + o]);
+                    }
+                }
+                p.out[e + j*p.out_s1 + t*p.out_s2] = v[j][0];
+            }
+        }
+    }
+
+    // intermediates used outside the chain
+    if (p.states || p.states_t) {
+        for (int e = e0 + tid; e < e1; e += DEPTH_MIX_BLOCK) {
+            const float v = normed[e];
+            if (p.states) {
+                for (int k = 0; k < n; ++k) {
+                    p.states[e + k*p.states_s1 + t*p.states_s2] = k < n - 1 ? p.prev[e + k*p.prev_s1 + t*p.prev_s2] : v;
+                }
+            }
+            if (p.states_t) {
+                for (int k = 0; k < n; ++k) {
+                    p.states_t[k + e*p.states_t_s1 + t*p.states_t_s2] = k >= n - 1 ? v :
+                        p.prev_t ? p.prev_t[k + e*p.prev_t_s1 + t*p.prev_t_s2] : p.prev[e + k*p.prev_s1 + t*p.prev_s2];
+                }
+            }
+        }
+    }
+}
+
+// GGML_CUDA_DEPTH_MIX_SHADOW=1 (debug only, with GGML_CUDA_DISABLE_GRAPHS=1): run the fused kernel into scratch
+// buffers, let the separate ops run, and compare the bytes of every output of the chain before the next node runs
+struct depth_mix_shadow_entry {
+    const ggml_cgraph * graph;
+    int end;
+    const ggml_tensor * real;
+    float * scratch;
+    char desc[128];
+};
+
+static bool depth_mix_shadow() {
+    static const bool shadow = getenv("GGML_CUDA_DEPTH_MIX_SHADOW") != nullptr;
+    return shadow;
+}
+
+static std::vector<depth_mix_shadow_entry> & depth_mix_shadow_list() {
+    static std::vector<depth_mix_shadow_entry> pending;
+    return pending;
+}
+
+static void depth_mix_shadow_check(const ggml_cgraph * cgraph, int i, cudaStream_t stream) {
+    std::vector<depth_mix_shadow_entry> & pending = depth_mix_shadow_list();
+    std::vector<depth_mix_shadow_entry> keep;
+    for (auto & e : pending) {
+        if (e.graph == cgraph && e.end >= i) {
+            keep.push_back(e);
+            continue;
+        }
+        if (e.graph == cgraph) {
+            CUDA_CHECK(cudaStreamSynchronize(stream));
+            const size_t nb = ggml_nbytes(e.real);
+            std::vector<float> a(nb/sizeof(float)), b(nb/sizeof(float));
+            CUDA_CHECK(cudaMemcpy(a.data(), e.real->data, nb, cudaMemcpyDeviceToHost));
+            CUDA_CHECK(cudaMemcpy(b.data(), e.scratch, nb, cudaMemcpyDeviceToHost));
+            size_t ndiff = 0;
+            for (size_t k = 0; k < a.size(); ++k) {
+                ndiff += memcmp(&a[k], &b[k], sizeof(float)) != 0;
+            }
+            fprintf(stderr, "depth_mix_shadow: %s %s: %zu/%zu differ\n", e.desc, e.real->name, ndiff, a.size());
+        }
+        CUDA_CHECK(cudaFree(e.scratch));
+    }
+    pending = keep;
+}
+
+static void depth_mix_shadow_add(const ggml_cgraph * cgraph, int end, const ggml_tensor * real, float *& ptr, const char * desc) {
+    depth_mix_shadow_entry e;
+    e.graph = cgraph;
+    e.end   = end;
+    e.real  = real;
+    CUDA_CHECK(cudaMalloc(&e.scratch, ggml_nbytes(real)));
+    snprintf(e.desc, sizeof(e.desc), "%s", desc);
+    ptr = e.scratch;
+    depth_mix_shadow_list().push_back(e);
+}
+
+static bool depth_mix_debug() {
+    static const bool debug = getenv("GGML_CUDA_DEPTH_MIX_DEBUG") != nullptr;
+    return debug;
+}
+
+#define DEPTH_MIX_DECLINE(reason) do { if (depth_mix_debug()) { fprintf(stderr, "%s: node %d (%s): %s\n", __func__, i, cgraph->nodes[i]->name, reason); } return 0; } while (0)
+
+static bool depth_mix_rows_ok(const ggml_tensor * t) {
+    return t->type == GGML_TYPE_F32 && t->nb[0] == sizeof(float) && t->ne[3] == 1;
+}
+
+static int depth_mix_fuse(ggml_backend_cuda_context * ctx, ggml_cgraph * cgraph, int i, depth_mix_memory_check_t memory_ok, int i0);
+
+// ours: the RMS_NORM of the current state, and the views of it before the chain, join the chain when only the chain
+// reads them (the kernel normalizes the row itself, as the RMS_NORM launch would); otherwise the chain starts after it
+int ggml_cuda_try_fuse_depth_mix(ggml_backend_cuda_context * ctx, ggml_cgraph * cgraph, int i, depth_mix_memory_check_t memory_ok) {
+    static const bool rms_off = [] { const char * e = getenv("GGML_CUDA_DISABLE_DEPTH_MIX_RMS"); return e != nullptr && atoi(e) != 0; }();
+    if (!rms_off && !depth_mix_shadow() && cgraph->nodes[i]->op == GGML_OP_RMS_NORM) {
+        int j = i + 1;
+        while (j < cgraph->n_nodes && j <= i + 2 && cgraph->nodes[j]->op == GGML_OP_RESHAPE) {
+            ++j;
+        }
+        if (j < cgraph->n_nodes && cgraph->nodes[j]->op == GGML_OP_CONCAT) {
+            const int n = depth_mix_fuse(ctx, cgraph, j, memory_ok, i);
+            if (n > 0) {
+                return n;
+            }
+        }
+        return 0;
+    }
+    return depth_mix_fuse(ctx, cgraph, i, memory_ok, -1);
+}
+
+static int depth_mix_fuse(ggml_backend_cuda_context * ctx, ggml_cgraph * cgraph, int i, depth_mix_memory_check_t memory_ok, int i0) {
+    if (depth_mix_shadow()) {
+        depth_mix_shadow_check(cgraph, i, ctx->stream());
+    }
+
+    // the chain starts after the RMS_NORM of the current state, which stays its own op, in one of two forms:
+    //   (a) CONCAT (prev_t, RESHAPE(normed), dim 0), CONCAT (prev, normed, dim 1), [REPEAT,] MUL_MAT, SOFT_MAX, [MUL_MAT]
+    //   (b) CONCAT (prev, normed, dim 1), [REPEAT,] MUL_MAT, SOFT_MAX, [PERMUTE, CONT, MUL_MAT]: the transposed rows are a
+    //       copy of the plain ones made right before the product, in any order the graph puts these nodes
+    ggml_tensor * first = cgraph->nodes[i];
+    const bool form_b = first->op == GGML_OP_CONCAT && ggml_get_op_params_i32(first, 0) == 1 &&
+        first->src[1]->op == GGML_OP_RMS_NORM;
+    ggml_tensor * cat_t    = nullptr; // form (a): the transposed CONCAT; form (b): the CONT of the permuted rows
+    ggml_tensor * perm     = nullptr; // form (b) only
+    const ggml_tensor * normed_t = nullptr;
+    const ggml_tensor * rms      = nullptr;
+    if (form_b) {
+        rms = first->src[1];
+    } else {
+        cat_t = first;
+        if (cat_t->op != GGML_OP_CONCAT || ggml_get_op_params_i32(cat_t, 0) != 0 || cat_t->src[1]->op != GGML_OP_RESHAPE ||
+                cat_t->src[1]->src[0]->op != GGML_OP_RMS_NORM) {
+            return 0;
+        }
+        normed_t = cat_t->src[1];
+        rms      = normed_t->src[0];
+    }
+    if (!depth_mix_rows_ok(rms) || !ggml_is_contiguous(rms) || rms->ne[1] != 1 || rms->ne[3] != 1) {
+        return 0;
+    }
+    const ggml_tensor * raw = nullptr;
+    if (i0 >= 0) {
+        raw = rms->src[0];
+        if (cgraph->nodes[i0] != rms || rms->op != GGML_OP_RMS_NORM || ggml_cuda_rms_norm_vec() || rms->ne[0] < 1024 ||
+                !depth_mix_rows_ok(raw) || !ggml_are_same_shape(raw, rms) || raw->nb[1] != raw->ne[0]*sizeof(float) ||
+                (rms->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            return 0;
+        }
+    }
+    const int64_t ncols = rms->ne[0];
+    const int64_t T     = rms->ne[2];
+
+    ggml_tensor * cat_s = form_b ? first : nullptr;
+    ggml_tensor * rep   = nullptr;
+    ggml_tensor * mm1   = nullptr;
+    ggml_tensor * sm    = nullptr;
+    ggml_tensor * mm2   = nullptr;
+    int end = i;
+    for (int j = i + 1; j < cgraph->n_nodes && j <= i + 8; ++j) {
+        ggml_tensor * node = cgraph->nodes[j];
+        bool ok = false;
+        if (!cat_s && node->op == GGML_OP_CONCAT && node->src[1] == rms && ggml_get_op_params_i32(node, 0) == 1) {
+            cat_s = node; ok = true;
+        } else if (cat_s && !rep && !mm1 && node->op == GGML_OP_REPEAT) {
+            rep = node; ok = true;
+        } else if (cat_s && !mm1 && node->op == GGML_OP_MUL_MAT && node->src[0] == cat_s && (!rep || node->src[1] == rep)) {
+            mm1 = node; ok = true;
+        } else if (mm1 && !sm && node->op == GGML_OP_SOFT_MAX && node->src[0] == mm1) {
+            sm = node; ok = true;
+        } else if (form_b && !perm && node->op == GGML_OP_PERMUTE && node->src[0] == cat_s &&
+                node->op_params[0] == 1 && node->op_params[1] == 0 && node->op_params[2] == 2 && node->op_params[3] == 3) {
+            perm = node; ok = true;
+        } else if (form_b && perm && !cat_t && node->op == GGML_OP_CONT && node->src[0] == perm) {
+            cat_t = node; ok = true;
+        } else if (sm && cat_t && node->op == GGML_OP_MUL_MAT && node->src[0] == cat_t && node->src[1] == sm) {
+            mm2 = node; ok = true;
+        }
+        if (!ok) {
+            break;
+        }
+        end = j;
+        if (mm2) {
+            break;
+        }
+    }
+    if (!cat_s || !mm1 || !sm) {
+        return 0;
+    }
+    if (form_b && !mm2) {
+        // no product to fuse: keep the chain up to the SOFT_MAX, unless the copy of the rows sits inside it
+        cat_t = nullptr;
+        perm  = nullptr;
+    }
+
+    const ggml_tensor * prev   = cat_s->src[0];
+    const ggml_tensor * prev_t = form_b ? nullptr : cat_t->src[0];
+    const int64_t n  = cat_s->ne[1];
+    const int64_t nq = mm1->ne[1];
+
+    if (!depth_mix_rows_ok(prev) || !depth_mix_rows_ok(cat_s) || !depth_mix_rows_ok(mm1) || !depth_mix_rows_ok(sm) ||
+        (mm2 && !depth_mix_rows_ok(mm2)) ||
+        prev->ne[0] != ncols || prev->ne[1] != n - 1 || prev->ne[2] != T ||
+        (cat_t && (!depth_mix_rows_ok(cat_t) || cat_t->ne[0] != n || cat_t->ne[1] != ncols || cat_t->ne[2] != T)) ||
+        (form_b && cat_t && !ggml_is_contiguous(cat_t)) ||
+        (!form_b && (!depth_mix_rows_ok(prev_t) || prev_t->ne[0] != n - 1 || prev_t->ne[1] != ncols || prev_t->ne[2] != T ||
+            normed_t->ne[0] != 1 || normed_t->ne[1] != ncols || normed_t->ne[2] != T))) {
+        DEPTH_MIX_DECLINE("shapes");
+    }
+    // the scores read the earlier rows of the stack as float2: an F32 view at an odd float offset or with an odd row or
+    // token stride is left to the separate kernels (CONCAT copies it into an aligned stack first)
+    if ((uintptr_t) prev->data % (2*sizeof(float)) != 0 || prev->nb[1] % (2*sizeof(float)) != 0 ||
+        prev->nb[2] % (2*sizeof(float)) != 0) {
+        DEPTH_MIX_DECLINE("unaligned stack rows");
+    }
+    if (n < 2 || n > DEPTH_MIX_MAX_N || nq < 1 || nq > DEPTH_MIX_MAX_NQ || ncols % 2 != 0 || ncols > DEPTH_MIX_MAX_NCOLS ||
+        mm1->ne[0] != n || mm1->ne[2] != T) {
+        DEPTH_MIX_DECLINE("sizes");
+    }
+
+    // the query: a REPEAT of [ncols, nq, 1] or a tensor [ncols, nq, T]
+    const ggml_tensor * q = rep ? rep->src[0] : mm1->src[1];
+    if (!depth_mix_rows_ok(q) || q->ne[0] != ncols || q->ne[1] != nq || (rep ? q->ne[2] != 1 : q->ne[2] != T) ||
+        q->nb[1] % (2*sizeof(float)) != 0 || (uintptr_t) q->data % (2*sizeof(float)) != 0 ||
+        (rep && (rep->ne[0] != ncols || rep->ne[1] != nq || rep->ne[2] != T || rep->ne[3] != 1))) {
+        DEPTH_MIX_DECLINE("query");
+    }
+
+    // SOFT_MAX_EXT: no mask, no sinks, no ALiBi
+    float sm_params[2];
+    memcpy(sm_params, sm->op_params, sizeof(sm_params));
+    if (sm->src[1] || sm->src[2] || sm_params[1] != 0.0f || !ggml_is_contiguous(mm1) || !ggml_is_contiguous(sm)) {
+        DEPTH_MIX_DECLINE("softmax");
+    }
+
+    // both products must run as MMVF in ggml_cuda_mul_mat
+    const int device    = ctx->device;
+    const int cc        = ggml_cuda_info().devices[device].cc;
+    const int warp_size = ggml_cuda_info().devices[device].warp_size;
+    if (warp_size != WARP_SIZE) {
+        DEPTH_MIX_DECLINE("warp size");
+    }
+    // decode-size mixes (up to 8 tokens) before Ada (cc < 8.9) keep the separate kernels: measured ~1% slower fused
+    // at batch-1 decode on A100 (cc 8.0), within noise on T4 (cc 7.5), while prefill gains everywhere (5-12%)
+    if (GGML_CUDA_CC_IS_NVIDIA(cc) && cc < GGML_CUDA_CC_ADA_LOVELACE && T <= 8) {
+        DEPTH_MIX_DECLINE("decode-size mix before Ada");
+    }
+    auto takes_mmvf = [&](const ggml_tensor * mm) {
+        const ggml_tensor * src0 = mm->src[0];
+        const ggml_tensor * src1 = mm->src[1];
+        const bool bad_padding_clear = ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE
+            && ggml_nbytes(src0) != ggml_backend_buffer_get_alloc_size(src0->buffer, src0) && src0->view_src;
+        return !bad_padding_clear && src1->type == GGML_TYPE_F32 && mm->type == GGML_TYPE_F32 &&
+            !ggml_cuda_op_mul_mat_use_fwht(mm) && ggml_cuda_should_use_mmvf(src0, cc, warp_size, src1->ne[1]);
+    };
+    if (!takes_mmvf(mm1)) {
+        DEPTH_MIX_DECLINE("first product not MMVF");
+    }
+    // odd n: the separate product is rocBLAS's GEMV (mul_mat_vec_f takes even K only); fused here as a zero-padded
+    // pair, which changes its rounding (KLD-checked, one token only so prefill stays as it was).
+    // GGML_CUDA_DEPTH_MIX_ODD=0: off
+    static const bool odd_on = [] { const char * e = getenv("GGML_CUDA_DEPTH_MIX_ODD"); return e == nullptr || atoi(e) != 0; }();
+    const bool odd_ok = mm2 && odd_on && GGML_CUDA_CC_IS_AMD(cc) && n % 2 == 1 && T == 1 &&   // KLD measured on AMD only mm2->type == GGML_TYPE_F32 && mm2->src[1]->type == GGML_TYPE_F32 &&
+        !ggml_cuda_op_mul_mat_use_fwht(mm2);
+    if (mm2 && !(((takes_mmvf(mm2) && n % 2 == 0) || odd_ok) && sm->nb[1] == n*sizeof(float))) {
+        // the second product stays a separate op
+        mm2 = nullptr;
+        if (form_b) {
+            cat_t = nullptr;
+            perm  = nullptr;
+        }
+    }
+    if (!mm2) {
+        // end the chain at the SOFT_MAX; in form (b) the copy of the rows must then come after it
+        int k_sm = -1;
+        for (int j = i; j <= end; ++j) {
+            if (cgraph->nodes[j] == sm) {
+                k_sm = j;
+                break;
+            }
+        }
+        for (int j = i; j < k_sm; ++j) {
+            const ggml_tensor * node = cgraph->nodes[j];
+            if (node != cat_s && node != rep && node != mm1 && node != first) {
+                DEPTH_MIX_DECLINE("rows copy inside the chain without its product");
+            }
+        }
+        end = k_sm;
+    }
+
+    // the nodes of the chain, and which of them are used outside it
+    const int i_first = i0 >= 0 ? i0 : i;
+    const int count = end - i_first + 1;
+    ggml_op ops[20];
+    int     outs[20];
+    int     n_outs = 0;
+    if (count > 20) {
+        return 0;
+    }
+    for (int k = 0; k < count; ++k) {
+        const ggml_tensor * node = cgraph->nodes[i_first + k];
+        ops[k] = node->op;
+        int uses = 0;
+        for (int l = k + 1; l < count; ++l) {
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                uses += cgraph->nodes[i_first + l]->src[s] == node;
+            }
+        }
+        if (k == count - 1 || uses != ggml_node_get_use_count(cgraph, i_first + k) || (node->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            outs[n_outs++] = i_first + k;
+        }
+    }
+    bool write_cat_s = false;
+    bool write_cat_t = false;
+    bool write_sm    = mm2 == nullptr;
+    for (int k = 0; k < n_outs; ++k) {
+        const ggml_tensor * node = cgraph->nodes[outs[k]];
+        if (node == cat_s) {
+            write_cat_s = true;
+        } else if (node == cat_t) {
+            write_cat_t = true;
+        } else if (node == sm) {
+            write_sm = true;
+        } else if (node == perm) {
+            DEPTH_MIX_DECLINE("permuted rows used outside the chain");
+        } else if (i0 >= 0 && (node == rms || node->view_src == rms)) {
+            return 0;   // the norm is read elsewhere: the chain after it
+        } else if (node != mm2) {
+            DEPTH_MIX_DECLINE("intermediate used outside the chain");
+        }
+    }
+    if (!ggml_can_fuse_subgraph(cgraph, i_first, count, ops, outs, n_outs)) {
+        DEPTH_MIX_DECLINE("subgraph");
+    }
+    // an output may reuse the memory of the RMS_NORM output, which the separate CONCATs have consumed by then;
+    // every block loads its token's normed row before it writes, so one block per token is safe when only this token's
+    // rows can overlap
+    bool one_block = false;
+    if (i0 >= 0) {
+        if (!memory_ok(cgraph, i_first, count, outs, n_outs)) {
+            return 0;
+        }
+        for (int k = 0; k < n_outs; ++k) {
+            const ggml_tensor * o = cgraph->nodes[outs[k]];
+            const char * o0 = (const char *) o->data;
+            const char * r0 = (const char *) raw->data;
+            if (o0 < r0 + ggml_nbytes(raw) && r0 < o0 + ggml_nbytes(o)) {
+                return 0;
+            }
+        }
+    } else if (!memory_ok(cgraph, i, count, outs, n_outs)) {
+        auto overlap = [](const ggml_tensor * a, const ggml_tensor * b) {
+            const uintptr_t a0 = (uintptr_t) a->data, a1 = a0 + ggml_backend_buft_get_alloc_size(a->buffer->buft, a);
+            const uintptr_t b0 = (uintptr_t) b->data, b1 = b0 + ggml_backend_buft_get_alloc_size(b->buffer->buft, b);
+            return a0 < b1 && b0 < a1;
+        };
+        const ggml_tensor * srcs[4] = { prev, prev_t ? prev_t : prev, q, rms };
+        bool rms_overlap_ok = true;
+        for (int k = 0; k < n_outs && rms_overlap_ok; ++k) {
+            const ggml_tensor * o = cgraph->nodes[outs[k]];
+            for (const ggml_tensor * src : srcs) {
+                if (!overlap(o, src)) {
+                    continue;
+                }
+                // a single token, or the mix output in the same per-token layout as the normed rows
+                rms_overlap_ok = src == rms && (T == 1 || (o == mm2 && nq == 1 && o->data == rms->data && o->nb[2] == rms->nb[2]));
+            }
+        }
+        if (!rms_overlap_ok) {
+            DEPTH_MIX_DECLINE("memory ranges");
+        }
+        one_block = true;
+    }
+
+    depth_mix_params p = {};
+    p.normed = (const float *) rms->data;         p.normed_s2 = rms->nb[2] / sizeof(float);
+    if (raw) {
+        p.raw = (const float *) raw->data;        p.raw_s2 = raw->nb[2] / sizeof(float);
+        memcpy(&p.eps, rms->op_params, sizeof(float));
+    }
+    p.prev = (const float *) prev->data;          p.prev_s1 = prev->nb[1] / sizeof(float);     p.prev_s2 = prev->nb[2] / sizeof(float);
+    if (prev_t) {
+        p.prev_t = (const float *) prev_t->data;  p.prev_t_s1 = prev_t->nb[1] / sizeof(float); p.prev_t_s2 = prev_t->nb[2] / sizeof(float);
+    }
+    p.q = (const float *) q->data;                p.q_s1 = q->nb[1] / sizeof(float);           p.q_s2 = rep ? 0 : q->nb[2] / sizeof(float);
+    if (write_cat_s) {
+        p.states = (float *) cat_s->data;         p.states_s1 = cat_s->nb[1] / sizeof(float);   p.states_s2 = cat_s->nb[2] / sizeof(float);
+    }
+    if (write_cat_t) {
+        p.states_t = (float *) cat_t->data;       p.states_t_s1 = cat_t->nb[1] / sizeof(float); p.states_t_s2 = cat_t->nb[2] / sizeof(float);
+    }
+    if (write_sm) {
+        p.scores = (float *) sm->data;            p.scores_s1 = sm->nb[1] / sizeof(float);      p.scores_s2 = sm->nb[2] / sizeof(float);
+    }
+    if (mm2) {
+        p.out = (float *) mm2->data;              p.out_s1 = mm2->nb[1] / sizeof(float);        p.out_s2 = mm2->nb[2] / sizeof(float);
+    }
+    p.ncols = ncols;
+    p.n     = n;
+    p.scale = sm_params[0];
+
+    // the block size of launch_mul_mat_vec_f_cuda for the first product
+    {
+        int64_t block_size_best = warp_size;
+        int64_t niter_best      = (ncols + 2*warp_size - 1) / (2*warp_size);
+        int64_t max_block_size  = 256;
+        if (cc > GGML_CUDA_CC_OFFSET_AMD && cc < GGML_CUDA_CC_RDNA1) {
+            max_block_size = 128;
+        }
+        for (int64_t block_size = 2*warp_size; block_size <= max_block_size; block_size += warp_size) {
+            const int64_t niter = (ncols + 2*block_size - 1) / (2*block_size);
+            if (niter < niter_best) {
+                niter_best      = niter;
+                block_size_best = block_size;
+            }
+        }
+        p.mm_block = block_size_best;
+    }
+
+    // with work per row of the output, spread each token over several blocks
+    int nsplit = 1;
+    if (!one_block && (mm2 || write_cat_s || write_cat_t)) {
+        const int nsm = ggml_cuda_info().devices[device].nsm;
+        nsplit = std::max<int64_t>(1, std::min<int64_t>(4, (nsm + T - 1) / T));
+    }
+    p.rows_per_block = (ncols + nsplit - 1) / nsplit;
+
+    const bool shadow = depth_mix_shadow();
+    if (shadow) {
+        char desc[128];
+        snprintf(desc, sizeof(desc), "node %d n %d nq %d T %d out %d writes %d%d%d", i, (int) n, (int) nq, (int) T, mm2 != nullptr,
+            write_cat_s, write_cat_t, write_sm);
+        if (p.out)      { depth_mix_shadow_add(cgraph, end, mm2,   p.out,      desc); }
+        if (p.scores)   { depth_mix_shadow_add(cgraph, end, sm,    p.scores,   desc); }
+        if (p.states)   { depth_mix_shadow_add(cgraph, end, cat_s, p.states,   desc); }
+        if (p.states_t) { depth_mix_shadow_add(cgraph, end, cat_t, p.states_t, desc); }
+    }
+
+    const dim3 grid(nsplit, T, 1);
+    const size_t smem = ncols*sizeof(float);
+    const ggml_cuda_kernel_launch_params launch_params(grid, dim3(DEPTH_MIX_BLOCK, 1, 1), smem, ctx->stream());
+    switch (nq) {
+        case 1: ggml_cuda_kernel_launch(depth_mix_f32<1>, launch_params, p); break;
+        case 2: ggml_cuda_kernel_launch(depth_mix_f32<2>, launch_params, p); break;
+        case 3: ggml_cuda_kernel_launch(depth_mix_f32<3>, launch_params, p); break;
+        case 4: ggml_cuda_kernel_launch(depth_mix_f32<4>, launch_params, p); break;
+        default: GGML_ABORT("fatal error");
+    }
+
+    if (depth_mix_debug()) {
+        fprintf(stderr, "%s: node %d (%s): fused %d nodes, ncols %d, n %d, nq %d, T %d, out %d, writes %d%d%d, mm block %d, blocks %d\n",
+            __func__, i, cgraph->nodes[i]->name, count, (int) ncols, (int) n, (int) nq, (int) T, mm2 != nullptr,
+            write_cat_s, write_cat_t, write_sm, p.mm_block, nsplit);
+    }
+    return shadow ? 0 : count - 1;   // the nodes after i_first
+}
diff --git a/ggml/src/ggml-cuda/depth-mix.cuh b/ggml/src/ggml-cuda/depth-mix.cuh
new file mode 100644
index 0000000000..28f4d1e378
--- /dev/null
+++ b/ggml/src/ggml-cuda/depth-mix.cuh
@@ -0,0 +1,18 @@
+#pragma once
+
+#include "common.cuh"
+
+// Fused depth mix (attention over earlier block outputs), the chain after normed = rms_norm(x) [ncols, 1, T]
+// (the RMS_NORM stays its own op):
+//   states_t = concat(prev_t, reshape(normed), 0) (CONCAT, [n - 1, ncols, T] + [1, ncols, T])
+//   states   = concat(prev, normed, 1)            (CONCAT, [ncols, n - 1, T] + [ncols, 1, T])
+//   scores   = soft_max(states^T q * scale)       ([REPEAT,] MUL_MAT, SOFT_MAX_EXT without mask and sinks)
+//   out      = states_t^T scores                  (MUL_MAT, optional)
+// in one kernel, with the same rounding as the separate ops: both products follow mul_mat_vec_f for the block size
+// it picks, the softmax follows soft_max_f32.
+// Only taken where the separate ops would run exactly those kernels (MMVF for both products, one warp per softmax row).
+// Intermediates with uses outside the chain are written as well.
+// Returns the number of nodes after node i (the first CONCAT) taken by the fused kernel, 0 if the nodes at i do not form one.
+// memory_ok(cgraph, i, count, outs, n_outs): the outputs of nodes [i, i + count) overlap no input of the chain
+typedef bool (*depth_mix_memory_check_t)(const ggml_cgraph * cgraph, int node_idx, int node_count, const int * out_nodes, int out_count);
+int ggml_cuda_try_fuse_depth_mix(ggml_backend_cuda_context * ctx, ggml_cgraph * cgraph, int i, depth_mix_memory_check_t memory_ok);
diff --git a/ggml/src/ggml-cuda/elem-fuse.cu b/ggml/src/ggml-cuda/elem-fuse.cu
new file mode 100644
index 0000000000..94b5f09c54
--- /dev/null
+++ b/ggml/src/ggml-cuda/elem-fuse.cu
@@ -0,0 +1,283 @@
+#include "elem-fuse.cuh"
+#include "reduce_rows.cuh"
+
+#include <cstring>
+
+// ---------------------------------------------------------------------------------------------------------------------
+// y = c -/+ tanh(a)*b
+// each value is rounded as in the separate TANH (tanhf), MUL and SUB/ADD kernels: the product and the sum are not
+// contracted into an FMA
+
+template <bool sub>
+static __global__ void tanh_mul_addsub_f32(
+        const char * a_ptr, const char * b_ptr, const char * c_ptr, float * dst_ptr,
+        const int ne0, const int ne1, const int ne2,
+        const int64_t a1, const int64_t a2, const int64_t a3,
+        const int64_t b1, const int64_t b2, const int64_t b3,
+        const int64_t c1, const int64_t c2, const int64_t c3) {
+    const char * GGML_CUDA_RESTRICT a   = a_ptr;
+    const char * GGML_CUDA_RESTRICT b   = b_ptr;
+    const char * GGML_CUDA_RESTRICT c   = c_ptr;
+    float      * GGML_CUDA_RESTRICT dst = dst_ptr;
+    ggml_cuda_pdl_lc();
+    const int i0 = blockIdx.x*blockDim.x + threadIdx.x;
+    const int i1 = blockIdx.y;
+    const int i2 = blockIdx.z % ne2;
+    const int i3 = blockIdx.z / ne2;
+
+    ggml_cuda_pdl_sync();
+    if (i0 >= ne0) {
+        return;
+    }
+
+    const float av = *(const float *) (a + i1*a1 + i2*a2 + i3*a3 + i0*sizeof(float));
+    const float bv = *(const float *) (b + i1*b1 + i2*b2 + i3*b3 + i0*sizeof(float));
+    const float cv = *(const float *) (c + i1*c1 + i2*c2 + i3*c3 + i0*sizeof(float));
+
+    const float m = __fmul_rn(tanhf(av), bv);
+
+    dst[((int64_t(i3)*ne2 + i2)*ne1 + i1)*ne0 + i0] = sub ? __fsub_rn(cv, m) : __fadd_rn(cv, m);
+}
+
+bool ggml_cuda_elem_overlap_ok(const ggml_tensor * dst, const ggml_tensor * src) {
+    const char * d0 = (const char *) dst->data;
+    const char * d1 = d0 + ggml_nbytes(dst);
+    const char * s0 = (const char *) src->data;
+    const char * s1 = s0 + ggml_nbytes(src);
+    if (d1 <= s0 || s1 <= d0) {
+        return true;
+    }
+    return d0 == s0 && ggml_is_contiguous(dst) && ggml_is_contiguous(src) && ggml_nelements(dst) == ggml_nelements(src) &&
+        dst->type == src->type;
+}
+
+static bool elem_is_view_op(const ggml_op op) {
+    return op == GGML_OP_VIEW || op == GGML_OP_RESHAPE || op == GGML_OP_PERMUTE || op == GGML_OP_TRANSPOSE;
+}
+
+static bool elem_f32_rows_ok(const ggml_tensor * t, const ggml_tensor * shape) {
+    return t->type == GGML_TYPE_F32 && t->nb[0] == sizeof(float) && ggml_are_same_shape(t, shape);
+}
+
+int ggml_cuda_match_tanh_mul_addsub(const ggml_cgraph * cgraph, int i, ggml_cuda_tanh_mul_addsub_match & match) {
+    if (i + 2 >= cgraph->n_nodes) {
+        return 0;
+    }
+    // the views of b (no kernels) may sit between TANH and MUL
+    int j = i + 1;
+    while (j < i + 3 && j < cgraph->n_nodes && elem_is_view_op(cgraph->nodes[j]->op)) {
+        ++j;
+    }
+    if (j + 1 >= cgraph->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * t = cgraph->nodes[i];
+    const ggml_tensor * m = cgraph->nodes[j];
+    ggml_tensor       * y = cgraph->nodes[j + 1];
+    if (t->op != GGML_OP_UNARY || ggml_get_unary_op(t) != GGML_UNARY_OP_TANH || m->op != GGML_OP_MUL ||
+        (y->op != GGML_OP_SUB && y->op != GGML_OP_ADD)) {
+        return 0;
+    }
+
+    const ggml_tensor * b = nullptr;
+    if (m->src[0] == t) {
+        b = m->src[1];
+    } else if (m->src[1] == t) {
+        b = m->src[0];
+    } else {
+        return 0;
+    }
+
+    const ggml_tensor * c = nullptr;
+    bool sub = false;
+    if (y->op == GGML_OP_SUB) {
+        if (y->src[1] != m || y->src[0] == m) {
+            return 0;
+        }
+        c   = y->src[0];
+        sub = true;
+    } else {
+        if (y->src[0] == m && y->src[1] != m) {
+            c = y->src[1];
+        } else if (y->src[1] == m && y->src[0] != m) {
+            c = y->src[0];
+        } else {
+            return 0;
+        }
+    }
+
+    const ggml_tensor * a = t->src[0];
+    if (!elem_f32_rows_ok(a, y) || !elem_f32_rows_ok(b, y) || !elem_f32_rows_ok(c, y) || !elem_f32_rows_ok(t, y) ||
+        !elem_f32_rows_ok(m, y) || !ggml_is_contiguous(y) || !ggml_is_contiguous(t) || b == t || c == t) {
+        return 0;
+    }
+    if (y->ne[1] > 65535 || y->ne[2]*y->ne[3] > 65535 || y->ne[0] > INT_MAX) {
+        return 0;
+    }
+
+    // the skipped views must not be views of an elided node
+    for (int k = i + 1; k < j; ++k) {
+        if (cgraph->nodes[k]->view_src == t || cgraph->nodes[k]->view_src == m) {
+            return 0;
+        }
+    }
+
+    const ggml_op ops[3]  = { GGML_OP_UNARY, GGML_OP_MUL, y->op };
+    const int     idxs[3] = { i, j, j + 1 };
+    const int     outs[1] = { j + 1 };
+    if (!ggml_can_fuse_subgraph_ext(cgraph, idxs, 3, ops, outs, 1)) {
+        return 0;
+    }
+
+    if (!ggml_cuda_elem_overlap_ok(y, a) || !ggml_cuda_elem_overlap_ok(y, b) || !ggml_cuda_elem_overlap_ok(y, c)) {
+        return 0;
+    }
+
+    match.a   = a;
+    match.b   = b;
+    match.c   = c;
+    match.dst = y;
+    match.sub = sub;
+    return j + 2 - i;
+}
+
+void ggml_cuda_op_tanh_mul_addsub(ggml_backend_cuda_context & ctx, const ggml_cuda_tanh_mul_addsub_match & match) {
+    const ggml_tensor * a = match.a;
+    const ggml_tensor * b = match.b;
+    const ggml_tensor * c = match.c;
+    ggml_tensor       * y = match.dst;
+
+    const int block = 256;
+    const dim3 grid((y->ne[0] + block - 1)/block, y->ne[1], y->ne[2]*y->ne[3]);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid, dim3(block, 1, 1), 0, ctx.stream());
+
+    auto launch = [&](auto kernel) {
+        ggml_cuda_kernel_launch(kernel, launch_params,
+            (const char *) a->data, (const char *) b->data, (const char *) c->data, (float *) y->data,
+            (int) y->ne[0], (int) y->ne[1], (int) y->ne[2],
+            (int64_t) a->nb[1], (int64_t) a->nb[2], (int64_t) a->nb[3],
+            (int64_t) b->nb[1], (int64_t) b->nb[2], (int64_t) b->nb[3],
+            (int64_t) c->nb[1], (int64_t) c->nb[2], (int64_t) c->nb[3]);
+    };
+    if (match.sub) {
+        launch(tanh_mul_addsub_f32<true>);
+    } else {
+        launch(tanh_mul_addsub_f32<false>);
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// x / f(sum_rows(x)) [* scale + bias], f = SCALE (x*s + b) or CLAMP
+// one block per row with the block size of sum_rows_f32_cuda, so the row sum is reduce_row_f32's for the same shape;
+// SCALE as scale_f32's FMA, the division as op_div's a / b
+
+template <bool clamp, bool has_scale>
+static __global__ void row_norm_div_f32(const float * x_ptr, float * dst_ptr, const int ncols,
+        const float p0, const float p1, const float out_scale, const float out_bias) {
+    const float * GGML_CUDA_RESTRICT x   = x_ptr;
+    float       * GGML_CUDA_RESTRICT dst = dst_ptr;
+    const int64_t row = blockIdx.x;
+
+    const float * xr = x + row*ncols;
+    const float sum = reduce_row_f32(xr, ncols); // waits for the previous kernel
+    ggml_cuda_pdl_lc();
+
+    const float d = clamp ? fminf(fmaxf(sum, p0), p1) : __fmaf_rn(p0, sum, p1);
+
+    for (int col = threadIdx.x; col < ncols; col += blockDim.x) {
+        const float v = xr[col] / d;
+        dst[row*ncols + col] = has_scale ? __fmaf_rn(out_scale, v, out_bias) : v;
+    }
+}
+
+int ggml_cuda_match_row_norm_div(const ggml_cgraph * cgraph, int i, ggml_cuda_row_norm_div_match & match) {
+    if (i + 2 >= cgraph->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * sum = cgraph->nodes[i];
+    const ggml_tensor * f   = cgraph->nodes[i + 1];
+    const ggml_tensor * div = cgraph->nodes[i + 2];
+    if (sum->op != GGML_OP_SUM_ROWS || (f->op != GGML_OP_SCALE && f->op != GGML_OP_CLAMP) || div->op != GGML_OP_DIV) {
+        return 0;
+    }
+    const ggml_tensor * x = sum->src[0];
+    if (f->src[0] != sum || div->src[0] != x || div->src[1] != f) {
+        return 0;
+    }
+    if (x->type != GGML_TYPE_F32 || sum->type != GGML_TYPE_F32 || f->type != GGML_TYPE_F32 || div->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(x) || !ggml_is_contiguous(div) || !ggml_are_same_shape(x, div) || x->ne[0] > INT_MAX ||
+        ggml_nrows(x) > INT_MAX || !ggml_is_contiguous(sum) || !ggml_is_contiguous(f) || ggml_nelements(sum) != ggml_nrows(x)) {
+        return 0;
+    }
+
+    int n = 3;
+    ggml_op ops[5] = { GGML_OP_SUM_ROWS, f->op, GGML_OP_DIV, GGML_OP_RESHAPE, GGML_OP_SCALE };
+    ggml_tensor * out = cgraph->nodes[i + 2];
+    bool has_scale = false;
+    if (i + 4 < cgraph->n_nodes) {
+        const ggml_tensor * r = cgraph->nodes[i + 3];
+        ggml_tensor       * s = cgraph->nodes[i + 4];
+        if (r->op == GGML_OP_RESHAPE && r->src[0] == div && s->op == GGML_OP_SCALE && s->src[0] == r &&
+            s->type == GGML_TYPE_F32 && ggml_is_contiguous(s) && ggml_nelements(s) == ggml_nelements(div)) {
+            n = 5;
+            out = s;
+            has_scale = true;
+        }
+    }
+
+    const int outs[1] = { i + n - 1 };
+    if (!ggml_can_fuse_subgraph(cgraph, i, n, ops, outs, 1)) {
+        if (n == 5) {
+            // the plain division alone
+            n = 3;
+            out = cgraph->nodes[i + 2];
+            has_scale = false;
+            const int outs3[1] = { i + 2 };
+            if (!ggml_can_fuse_subgraph(cgraph, i, n, ops, outs3, 1)) {
+                return 0;
+            }
+        } else {
+            return 0;
+        }
+    }
+
+    // each thread reads x only at the columns it writes, after the row sum
+    if (!ggml_cuda_elem_overlap_ok(out, x)) {
+        return 0;
+    }
+
+    match.x     = x;
+    match.dst   = out;
+    match.clamp = f->op == GGML_OP_CLAMP;
+    memcpy(&match.p0, (const float *) f->op_params + 0, sizeof(float));
+    memcpy(&match.p1, (const float *) f->op_params + 1, sizeof(float));
+    match.has_scale = has_scale;
+    if (has_scale) {
+        memcpy(&match.out_scale, (const float *) out->op_params + 0, sizeof(float));
+        memcpy(&match.out_bias,  (const float *) out->op_params + 1, sizeof(float));
+    }
+    return n;
+}
+
+void ggml_cuda_op_row_norm_div(ggml_backend_cuda_context & ctx, const ggml_cuda_row_norm_div_match & match) {
+    const ggml_tensor * x = match.x;
+    const int     ncols = x->ne[0];
+    const int64_t nrows = ggml_nrows(x);
+
+    // the block size of sum_rows_f32_cuda for this shape
+    const int nsm = ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+    const int block_size = (nrows / nsm) < 2 ? 512 : (ncols < 1024 ? 32 : 128);
+
+    const ggml_cuda_kernel_launch_params launch_params =
+        ggml_cuda_kernel_launch_params(dim3(nrows, 1, 1), dim3(block_size, 1, 1), 0, ctx.stream());
+
+    auto launch = [&](auto kernel) {
+        ggml_cuda_kernel_launch(kernel, launch_params, (const float *) x->data, (float *) match.dst->data, ncols,
+            match.p0, match.p1, match.out_scale, match.out_bias);
+    };
+    if (match.clamp) {
+        match.has_scale ? launch(row_norm_div_f32<true, true>) : launch(row_norm_div_f32<true, false>);
+    } else {
+        match.has_scale ? launch(row_norm_div_f32<false, true>) : launch(row_norm_div_f32<false, false>);
+    }
+}
