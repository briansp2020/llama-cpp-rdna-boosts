+// CONCAT(a, b, dim 0) of two F32 vectors read only by the GEMV right after it: the GEMV reads a then b in place of the
+// concatenation (the same values in the same order), one launch less.  One token, BF16 / F32 weights, a's length even
+// (the kernel reads y as float2).  GGML_CUDA_DISABLE_YCAT_GEMV_FUSION=1: off.
+struct mmvf_ycat_parts {
+    const ggml_tensor * cat, * mm, * a, * b, * w;
+};
+
+// the CONCAT + GEMV at node i (see ggml_cuda_ycat_gemv_try_fuse); fills p, false if it does not match
+static bool mmvf_ycat_match(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i, mmvf_ycat_parts & p) {
+    static const bool disabled = [] { const char * e = getenv("GGML_CUDA_DISABLE_YCAT_GEMV_FUSION"); return e != nullptr && atoi(e) != 0; }();
+    if (disabled || i + 1 >= cgraph->n_nodes) {
+        return false;
+    }
+    const ggml_tensor * cat = cgraph->nodes[i];
+    const ggml_tensor * mm  = cgraph->nodes[i + 1];
+    if (cat->op != GGML_OP_CONCAT || ggml_get_op_params_i32(cat, 0) != 0 || mm->op != GGML_OP_MUL_MAT || mm->src[1] != cat) {
+        return false;
+    }
+    const ggml_tensor * a = cat->src[0];
+    const ggml_tensor * b = cat->src[1];
+    const ggml_tensor * w = mm->src[0];
+    const int cc        = ggml_cuda_info().devices[ctx.device].cc;
+    const int warp_size = ggml_cuda_info().devices[ctx.device].warp_size;
+    // a contiguous; b rows of floats with an even column stride (e.g. a token row of a wider tensor)
+    if (a->type != GGML_TYPE_F32 || b->type != GGML_TYPE_F32 || cat->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(a) || b->nb[0] != sizeof(float) || b->nb[1] % (2*sizeof(float)) != 0 || !ggml_is_contiguous(cat) ||
+            a->ne[1] != cat->ne[1] || b->ne[1] != cat->ne[1] || cat->ne[1] < 1 || cat->ne[1] > MMVF_MAX_BATCH_SIZE ||
+            cat->ne[2] != 1 || cat->ne[3] != 1 || a->ne[2] != 1 || b->ne[2] != 1 || a->ne[3] != 1 || b->ne[3] != 1 ||
+            a->ne[0] % 2 != 0 || b->ne[0] % 2 != 0 || (uintptr_t) a->data % (2*sizeof(float)) != 0 || (uintptr_t) b->data % (2*sizeof(float)) != 0 ||
+            (w->type != GGML_TYPE_BF16 && w->type != GGML_TYPE_F32) || w->ne[0] != cat->ne[0] || w->ne[2] != 1 || w->ne[3] != 1 ||
+            !ggml_is_contiguous(mm) || mm->ne[1] != cat->ne[1] ||
+            ggml_cuda_mmb_supported_mm(w, cat, mm) || ggml_cuda_op_mul_mat_use_fwht(mm) ||
+            !ggml_cuda_should_use_mmvf(w, cc, warp_size, cat->ne[1]) || !mmvf_fuse_src0_ok(w)) {
+        return false;
+    }
+    if ((cat->flags & GGML_TENSOR_FLAG_OUTPUT) || ggml_node_get_use_count(cgraph, i) != 1) {
+        return false;
+    }
+    const auto disjoint = [](const ggml_tensor * x, const ggml_tensor * y) {
+        const char * x0 = (const char *) x->data;
+        const char * y0 = (const char *) y->data;
+        return x0 + ggml_nbytes(x) <= y0 || y0 + ggml_nbytes(y) <= x0;
+    };
+    if (!disjoint(mm, a) || !disjoint(mm, b) || !disjoint(mm, w)) {
+        return false;
+    }
+    p = { cat, mm, a, b, w };
+    return true;
+}
+
+int ggml_cuda_ycat_gemv_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    mmvf_ycat_parts p;
+    if (!mmvf_ycat_match(ctx, cgraph, i, p)) {
+        return 0;
+    }
+    const ggml_tensor * cat = p.cat, * mm = p.mm, * a = p.a, * b = p.b, * w = p.w;
+    ggml_cuda_mm_fusion_args_device yc{};
+    yc.yc_b    = (const float *) b->data;
+    yc.yc_n2   = (int) (a->ne[0] / 2);
+    yc.yc_s1_2 = (int) (b->nb[1] / (2*sizeof(float)));
+    ggml_tensor y_a = *cat;   // the GEMV's K is the concatenation's; the y columns step by a's row
+    y_a.data  = a->data;
+    y_a.nb[1] = a->nb[1];
+    y_a.nb[2] = y_a.nb[3] = a->nb[1]*cat->ne[1];
+    ggml_cuda_mul_mat_vec_f(ctx, w, &y_a, nullptr, (ggml_tensor *) mm, nullptr, &yc);
+    return 1;
+}
+
+// Batched sibling chains: 2..3 consecutive copies (views between them allowed) of one loop-control chain
+// (mmvf_ctl_match) or of one two-part-input GEMV (mmvf_ycat_match), with the same weight type and shapes and one token,
+// none reading another's output (Inkling's Q, K and V loop controllers, put in the graph level by level), as one
+// launch of the multi mode: each block's row is the single fusion's code on its segment's weights, input and output,
+// so every output is bit-identical.  The outputs must be apart from every segment's inputs and weights (no in-place
+// result: the segments may share c).  GGML_CUDA_SIBLING_GEMV=0: off.
+int ggml_cuda_sibling_gemv_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool on = [] { const char * e = getenv("GGML_CUDA_SIBLING_GEMV"); return e == nullptr || atoi(e) != 0; }();
+    const int n = cgraph->n_nodes;
+    const ggml_op op0 = cgraph->nodes[i]->op;
+    if (!on || (op0 != GGML_OP_CONCAT && op0 != GGML_OP_MUL_MAT)) {
+        return 0;
+    }
+    const auto skip_views = [&](int j) {
+        while (j < n && ggml_cuda_is_view_or_noop(cgraph->nodes[j]) && !ggml_is_empty(cgraph->nodes[j])) {
+            ++j;
+        }
+        return j;
+    };
+    const auto disjoint = [](const ggml_tensor * x, const ggml_tensor * y) {
+        const char * x0 = (const char *) x->data;
+        const char * y0 = (const char *) y->data;
