+        tmp += x.x*x.x + x.y*x.y + x.z*x.z + x.w*x.w;
+    }
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+    const float scale = rsqrtf(__fadd_rn(tmp / ncols, eps));
