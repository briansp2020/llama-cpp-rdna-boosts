+    cb(feats, "inp_target_features", -1);
+
+    const auto build_mix = [&](ggml_tensor * mix, ggml_tensor * norm, int il) {
+        ggml_tensor * cur = ggml_reshape_2d(ctx0, ggml_mul_mat(ctx0, mix, feats), n_embd, n_tokens);
