+// GEMVs of the same input, consecutive in the graph (views between them allowed), in one mul_mat_vec_f launch: up to 6
+// MUL_MATs of [K, r_k] weights of one type and row stride with one token, each block's row computed by the plain
+// kernel's code on its own weights and written to its own output, so every output is bit-identical.  Each launch is
+// the instantiation the separate MUL_MAT takes (the block size depends on K only; no vb path: K > 512 rows are not
+// short, and the matcher declines what the vb path would take).  GGML_CUDA_DISABLE_MULTI_GEMV_FUSION=1: off.
+int ggml_cuda_multi_gemv_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool disabled = [] { const char * e = getenv("GGML_CUDA_DISABLE_MULTI_GEMV_FUSION"); return e != nullptr && atoi(e) != 0; }();
+    const int n = cgraph->n_nodes;
+    const ggml_tensor * m0 = cgraph->nodes[i];
+    if (disabled || m0->op != GGML_OP_MUL_MAT) {
+        return 0;
+    }
+    const ggml_tensor * w0 = m0->src[0];
+    const ggml_tensor * y  = m0->src[1];
+    const int cc        = ggml_cuda_info().devices[ctx.device].cc;
+    const int warp_size = ggml_cuda_info().devices[ctx.device].warp_size;
+    auto ok = [&](const ggml_tensor * mm) {
+        const ggml_tensor * w = mm->src[0];
+        return mm->op == GGML_OP_MUL_MAT && mm->src[1] == y && mm->type == GGML_TYPE_F32 && ggml_is_contiguous(mm) &&
+            mm->ne[1] == y->ne[1] && mm->ne[2] == 1 && mm->ne[3] == 1 &&
+            w->type == w0->type && w->ne[0] == w0->ne[0] && w->nb[0] == ggml_type_size(w->type) && w->nb[1] == w0->nb[1] &&
+            w->ne[2] == 1 && w->ne[3] == 1 && mm->ne[0] == w->ne[1] && w->ne[1] < 3072 &&
+            !ggml_cuda_mmb_supported_mm(w, y, mm) && !ggml_cuda_op_mul_mat_use_fwht(mm) &&
+            ggml_cuda_should_use_mmvf(w, cc, warp_size, y->ne[1]) && mmvf_fuse_src0_ok(w);
+    };
+    if ((w0->type != GGML_TYPE_BF16 && w0->type != GGML_TYPE_F32) || y->type != GGML_TYPE_F32 || !ggml_is_contiguous(y) ||
+            y->ne[2] != 1 || y->ne[3] != 1 || y->ne[1] < 1 || y->ne[1] > MMVF_MAX_BATCH_SIZE || y->ne[0] != w0->ne[0] || !ok(m0)) {
+        return 0;
+    }
+    const ggml_tensor * mms[6] = { m0 };
+    int nm = 1;
+    int last = i;
+    for (int j = i + 1; j < n && nm < 6; ++j) {
+        const ggml_tensor * node = cgraph->nodes[j];
+        if (node->op == GGML_OP_VIEW || node->op == GGML_OP_RESHAPE || node->op == GGML_OP_PERMUTE || node->op == GGML_OP_TRANSPOSE) {
+            continue;
+        }
+        if (!ok(node)) {
+            break;
+        }
+        // independent of the earlier products (they share only y), and its output apart from every input
+        bool indep = true;
+        for (int k = 0; k < nm; ++k) {
+            const char * a0 = (const char *) node->data;
+            const char * b0 = (const char *) mms[k]->data;
+            indep = indep && (a0 + ggml_nbytes(node) <= b0 || b0 + ggml_nbytes(mms[k]) <= a0);
+        }
+        if (!indep) {
+            break;
+        }
+        mms[nm++] = node;
+        last = j;
+    }
+    if (nm < 2) {
+        return 0;
+    }
+    // a GLU of the products is another fusion's (gate/up + GLU in one GEMV): leave it the chain
+    for (int j = last + 1; j < n; ++j) {
+        const ggml_op op = cgraph->nodes[j]->op;
+        if (op == GGML_OP_VIEW || op == GGML_OP_RESHAPE || op == GGML_OP_PERMUTE || op == GGML_OP_TRANSPOSE) {
+            continue;
+        }
+        if (op == GGML_OP_GLU) {
+            return 0;
+        }
+        break;
+    }
+    // no output may overlap y or a weight (other blocks still read them)
+    int64_t rows = 0;
+    ggml_cuda_mm_fusion_args_device mr{};
+    for (int k = 0; k < nm; ++k) {
+        const char * d0 = (const char *) mms[k]->data;
+        const char * d1 = d0 + ggml_nbytes(mms[k]);
+        for (int l = 0; l < nm; ++l) {
+            const ggml_tensor * w = mms[l]->src[0];
+            const char * w0p = (const char *) w->data;
+            if (d0 < w0p + ggml_nbytes(w) && w0p < d1) {
+                return 0;
+            }
+        }
+        const char * y0 = (const char *) y->data;
+        if (d0 < y0 + ggml_nbytes(y) && y0 < d1) {
+            return 0;
+        }
+        mr.mr_x[k]   = mms[k]->src[0]->data;
+        mr.mr_dst[k] = (float *) mms[k]->data;
+        mr.mr_row[k] = (int) rows;
+        mr.mr_s1[k]  = (int) (mms[k]->nb[1] / sizeof(float));
+        rows += mms[k]->src[0]->ne[1];
+    }
+    mr.mr_n = nm;
+    // one launch over all the rows: the first product's tensors with the summed row count
+    ggml_tensor w_all = *w0;
+    w_all.ne[1] = rows;
+    w_all.nb[2] = w_all.nb[3] = w0->nb[1]*rows;
+    ggml_tensor d_all = *m0;
+    d_all.ne[0] = rows;
+    d_all.nb[1] = rows*sizeof(float);   // not used for the stores (mr_s1), only the launch shape
+    d_all.nb[2] = d_all.nb[3] = rows*sizeof(float)*m0->ne[1];
+    ggml_cuda_mul_mat_vec_f(ctx, &w_all, y, nullptr, &d_all, nullptr, &mr);
+    return last - i;
+}
