+// Inkling's relative-bias table on the pos-bias path: SUB(PAD(MUL_MAT(W[K = 16, M], R[16, H, T]), one zero bin), s[1, H, T]) as one
+// launch (GGML_CUDA_REL_TABLE_FUSION=0: off).  Bin m < M is mul_mat_vec_f_smallk's dot product (the same ggml_cuda_mad pairs and
+// wave32 butterfly, which equal the plain kernel's) minus the sink, bin M is 0 - sink: the f32 values PAD then SUB produce, so
+// the table is bit-identical.  Only when the SUB is read by flash attention alone (the dense path's rel-mask fusion keeps
+// its PAD .. CPY chain), and only for the MUL_MAT that ggml_cuda_mul_mat would run through MMVF.
+static __global__ void rel_table_f32(
+        const float * __restrict__ x, const float * __restrict__ y, const char * __restrict__ s, float * __restrict__ dst,
+        const int M, const int stride_row, const int stride_col_y2, const int stride_channel_y,
+        const int64_t s_nb1, const int64_t s_nb2, const int H) {
+    const int row = blockIdx.x*blockDim.x + threadIdx.x;
+    if (row > M) {
+        return;
+    }
+    const int h = blockIdx.y;
+    const int t = blockIdx.z;
+    const float sink = *(const float *) (s + h*s_nb1 + t*s_nb2);
+    float out;
+    if (row == M) {
+        out = __fsub_rn(0.0f, sink);
+    } else {
+        const float2 * x2 = (const float2 *) (x + int64_t(row)*stride_row);
+        const float2 * y2 = (const float2 *) (y + int64_t(t)*stride_channel_y) + int64_t(h)*stride_col_y2;
+        float v[32];
+#pragma unroll
+        for (int k = 0; k < 32; ++k) {
+            v[k] = 0.0f;
+        }
+#pragma unroll
+        for (int k = 0; k < 8; ++k) {
+            const float2 tmpx = x2[k];
+            const float2 tmpy = y2[k];
+            ggml_cuda_mad(v[k], tmpx.x, tmpy.x);
+            ggml_cuda_mad(v[k], tmpx.y, tmpy.y);
+        }
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) {
+            float w[32];
+#pragma unroll
+            for (int k = 0; k < 32; ++k) {
+                w[k] = v[k] + v[k ^ off];
+            }
+#pragma unroll
+            for (int k = 0; k < 32; ++k) {
+                v[k] = w[k];
+            }
+        }
+        out = __fsub_rn(v[0], sink);
+    }
+    dst[(int64_t(t)*H + h)*(M + 1) + row] = out;
+}
+
+int ggml_cuda_rel_table_try_fuse(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool on = [] { const char * e = getenv("GGML_CUDA_REL_TABLE_FUSION"); return e == nullptr || atoi(e) != 0; }();
+    ggml_tensor * mm = cgraph->nodes[i];
+    if (!on || mm->op != GGML_OP_MUL_MAT) {
+        return 0;
+    }
+    const ggml_tensor * W = mm->src[0];
+    const ggml_tensor * R = mm->src[1];
+    if (W->type != GGML_TYPE_F32 || R->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32 || W->ne[0] != 16 ||
+            W->ne[2] != 1 || W->ne[3] != 1 || R->ne[3] != 1 || !ggml_is_contiguous(W) || !ggml_is_contiguous(R) ||
+            !ggml_is_contiguous(mm) || R->ne[2] > 65535 || (mm->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+    // the MMVF route of ggml_cuda_mul_mat (the small-K kernel's arithmetic is the plain kernel's)
+    const int cc        = ggml_cuda_info().devices[ctx.device].cc;
+    const int warp_size = ggml_cuda_info().devices[ctx.device].warp_size;
+    const int64_t ne11_mmvf = R->ne[1] <= MMVF_MAX_BATCH_SIZE_FLAT ? 1 : R->ne[1];
+    if (warp_size != 32 || ggml_get_op_params_i32(mm, 1) == GGML_HINT_SRC0_IS_HADAMARD || ggml_cuda_mmb_supported_mm(W, R, mm) ||
+            !ggml_cuda_should_use_mmvf(W, cc, warp_size, ne11_mmvf)) {
+        return 0;
+    }
+    // PAD of one zero bin at the end of dim 0, then SUB of a per (head, token) sink; views between them are no-ops
+    int j = i + 1;
+    while (j < cgraph->n_nodes && ggml_cuda_is_view_or_noop(cgraph->nodes[j])) { ++j; }
+    if (j >= cgraph->n_nodes) { return 0; }
+    ggml_tensor * pad = cgraph->nodes[j];
+    if (pad->op != GGML_OP_PAD || pad->src[0] != mm || pad->type != GGML_TYPE_F32 || (pad->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+    for (int k = 0; k < 9; ++k) {
+        if (ggml_get_op_params_i32(pad, k) != (k == 1 ? 1 : 0)) {
+            return 0;
+        }
+    }
+    int k = j + 1;
+    while (k < cgraph->n_nodes && ggml_cuda_is_view_or_noop(cgraph->nodes[k])) { ++k; }
+    if (k >= cgraph->n_nodes) { return 0; }
