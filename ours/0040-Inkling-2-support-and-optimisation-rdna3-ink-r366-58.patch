+#include "rel-mask.cuh"
+
+// The relative-position bias of a flash attention, gathered into its F16 mask (llm_graph_context::build_attn with
+// llm_graph_input_mem_hybrid_iswa_rel, the whole-ubatch form):
+//   [PAD (zero rows at the end),] SUB(table, sinks) -> PERMUTE -> CONT -> GET_ROWS(rel_pos) -> RESHAPE -> PERMUTE -> CONT (kq_b)
+//   -> ADD(kq_b, mask) -> CPY F16
+// as one kernel: each output element computes the chain's arithmetic for its own value, the difference rounded as the
+// SUB kernel rounds it, the sum as the ADD kernel, then the F16 conversion of the CPY.  Bit-identical; the dense F32
+// bias and its copies are never written.  GGML_CUDA_DISABLE_REL_MASK_FUSION=1: off.
+//
+// out[c, r, h, s] = f16((table[rp, h, t] - sinks[0, h, t]) + mask[c, r, 0, s]), t = r + s*nr, rp = rel_pos[c, t]
+
+struct rel_mask_params {
+    const char * table;   int64_t tb1, tb2;                  // [E, H, T]
+    const char * sinks;   int64_t sb1, sb2; int s_ne1, s_ne2; // [1, H or 1, T or 1]
+    const char * rel;     int64_t rb1;                       // I32 [n_kv, T]
+    const char * mask;    int64_t mb1, mb3; int m_ne1, m_ne3;  // F32 [n_kv, nr or 1, 1, S or 1]
+    char       * out;     int64_t ob1, ob2, ob3;             // F16 [n_kv, nr, H, S]
+    int n_kv, nr, H, S, E;
+};
+
+static __global__ void rel_mask_f16(const rel_mask_params p) {
+    const int c = blockIdx.x*blockDim.x + threadIdx.x;
+    const int r = blockIdx.y;
+    const int h = blockIdx.z % p.H;
+    const int s = blockIdx.z / p.H;
+    if (c >= p.n_kv) {
+        return;
+    }
+    const int t  = r + s*p.nr;
+    const int rp = *(const int32_t *) (p.rel + t*p.rb1 + c*sizeof(int32_t));
+    const float tv = (rp >= 0 && rp < p.E) ? *(const float *) (p.table + rp*sizeof(float) + h*p.tb1 + t*p.tb2) : 0.0f;
+    const float sv = *(const float *) (p.sinks + (h % p.s_ne1)*p.sb1 + (t % p.s_ne2)*p.sb2);
+    const float mv = *(const float *) (p.mask + c*sizeof(float) + (r % p.m_ne1)*p.mb1 + (s % p.m_ne3)*p.mb3);
+    const float b  = __fsub_rn(tv, sv);
+    *(half *) (p.out + c*sizeof(half) + r*p.ob1 + h*p.ob2 + s*p.ob3) = __float2half(__fadd_rn(b, mv));
+}
+
+static bool rel_mask_is_view(const ggml_op op) {
+    return op == GGML_OP_VIEW || op == GGML_OP_RESHAPE || op == GGML_OP_PERMUTE || op == GGML_OP_TRANSPOSE;
+}
+
+int ggml_cuda_try_fuse_rel_mask(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool disabled = [] { const char * e = getenv("GGML_CUDA_DISABLE_REL_MASK_FUSION"); return e != nullptr && atoi(e) != 0; }();
+    const int n = cgraph->n_nodes;
+    if (disabled || (cgraph->nodes[i]->op != GGML_OP_SUB && cgraph->nodes[i]->op != GGML_OP_PAD)) {
+        return 0;
+    }
+    // an optional PAD of the table's rows with zeros at the end, right before the SUB: the kernel reads those rows as 0
+    const ggml_tensor * pad = nullptr;
+    if (cgraph->nodes[i]->op == GGML_OP_PAD) {
+        pad = cgraph->nodes[i];
+        if (i + 1 >= n || cgraph->nodes[i + 1]->op != GGML_OP_SUB || cgraph->nodes[i + 1]->src[0] != pad) {
+            return 0;
+        }
+        for (int k = 0; k < 9; ++k) {
+            // lp0, rp0, lp1, rp1, ..., circular: only zeros after dim 0
+            if (ggml_get_op_params_i32(pad, k) != 0 && k != 1) {
+                return 0;
+            }
+        }
+        const ggml_tensor * ps = pad->src[0];
+        if (ps->type != GGML_TYPE_F32 || pad->type != GGML_TYPE_F32 || ps->ne[1] != pad->ne[1] || ps->ne[2] != pad->ne[2] ||
+                ps->ne[3] != pad->ne[3] || ps->ne[0] + ggml_get_op_params_i32(pad, 1) != pad->ne[0]) {
+            return 0;
+        }
+    }
+    // the chain, views included (each consumed only by the next node of the chain)
+    int idxs[16];
+    ggml_op ops[16];
+    int count = 0;
+    auto take = [&](int j) { idxs[count] = j; ops[count] = cgraph->nodes[j]->op; ++count; };
+    int j = i;
+    if (pad) {
+        take(j++);                                                   // PAD
+    }
+    const int i_sub = j;
+    take(j++);                                                       // SUB
+    while (j < n && count < 8 && rel_mask_is_view(cgraph->nodes[j]->op)) { take(j++); }
+    if (j >= n || cgraph->nodes[j]->op != GGML_OP_CONT) { return 0; }
+    const int i_c1 = j; take(j++);                                   // CONT (table transposed)
+    if (j >= n || cgraph->nodes[j]->op != GGML_OP_GET_ROWS) { return 0; }
+    const int i_g = j; take(j++);                                    // GET_ROWS
+    while (j < n && count < 12 && rel_mask_is_view(cgraph->nodes[j]->op)) { take(j++); }
+    if (j >= n || cgraph->nodes[j]->op != GGML_OP_CONT) { return 0; }
+    const int i_kqb = j; take(j++);                                  // CONT (kq_b)
+    if (j >= n || cgraph->nodes[j]->op != GGML_OP_ADD) { return 0; }
+    const int i_add = j; take(j++);                                  // ADD (kq_b + mask)
+    if (j >= n || cgraph->nodes[j]->op != GGML_OP_CPY) { return 0; }
+    const int i_out = j; take(j++);                                  // CPY to F16
+
+    const ggml_tensor * sub = cgraph->nodes[i_sub];
+    const ggml_tensor * c1  = cgraph->nodes[i_c1];
+    const ggml_tensor * g   = cgraph->nodes[i_g];
+    const ggml_tensor * kqb = cgraph->nodes[i_kqb];
+    const ggml_tensor * add = cgraph->nodes[i_add];
+    ggml_tensor       * out = cgraph->nodes[i_out];
+
+    const ggml_tensor * table = pad ? pad->src[0] : sub->src[0];   // the rows read (past them: the PAD's zeros)
+    const ggml_tensor * sinks = sub->src[1];
+    const ggml_tensor * rel   = g->src[1];
+    const ggml_tensor * mask  = add->src[0] == kqb ? add->src[1] : nullptr;
+    if (!mask || out->src[0] != add || g->src[0] != c1) {
+        return 0;
+    }
+    // c1 = cont(permute(sub, 1, 0, 2, 3)), kq_b = cont(permute(reshape(g), 2, 0, 1, 3)): check by the values' layout
+    const int64_t E = table->ne[0], H = table->ne[1], T = table->ne[2];
+    const int64_t E_all = sub->ne[0];   // the rows of the (padded) table the indices address
+    if (table->type != GGML_TYPE_F32 || sinks->type != GGML_TYPE_F32 || sub->type != GGML_TYPE_F32 || c1->type != GGML_TYPE_F32 ||
+            g->type != GGML_TYPE_F32 || kqb->type != GGML_TYPE_F32 || add->type != GGML_TYPE_F32 || mask->type != GGML_TYPE_F32 ||
+            rel->type != GGML_TYPE_I32 || out->type != GGML_TYPE_F16 || table->ne[3] != 1 || table->nb[0] != sizeof(float) ||
+            sub->ne[1] != H || sub->ne[2] != T || sub->ne[3] != 1 || (pad ? E_all < E : E_all != E) ||
+            sinks->ne[0] != 1 || sinks->ne[3] != 1 ||
+            (sinks->ne[1] != 1 && sinks->ne[1] != H) || (sinks->ne[2] != 1 && sinks->ne[2] != T) ||
+            c1->ne[0] != H || c1->ne[1] != E_all || c1->ne[2] != T || c1->ne[3] != 1 ||
+            rel->ne[1] != T || rel->ne[2] != 1 || rel->ne[3] != 1 || rel->nb[0] != sizeof(int32_t) ||
+            g->ne[0] != H || g->ne[1] != rel->ne[0] || g->ne[2] != T || g->ne[3] != 1) {
+        return 0;
+    }
+    const int64_t n_kv = rel->ne[0];
+    const int64_t nr   = kqb->ne[1];
+    const int64_t S    = kqb->ne[3];
+    if (kqb->ne[0] != n_kv || kqb->ne[2] != H || nr*S != T || !ggml_is_contiguous(kqb) ||
+            !ggml_are_same_shape(add, kqb) || !ggml_are_same_shape(out, kqb) ||
+            mask->ne[0] != n_kv || (mask->ne[1] != nr && mask->ne[1] != 1) || mask->ne[2] != 1 || (mask->ne[3] != S && mask->ne[3] != 1) ||
+            mask->nb[0] != sizeof(float) || out->nb[0] != sizeof(half) || n_kv > INT_MAX || nr > 65535 || H*S > 65535) {
+        return 0;
+    }
+    // the reshape/permute between GET_ROWS and kq_b: kq_b[c, r, h, s] must be g[h, c, r + s*nr] -- the source of the
+    // permute is a [H, n_kv, nr, S] view of g's memory, permuted (2, 0, 1, 3)
+    {
+        const ggml_tensor * pm = kqb->src[0];
+        if (pm->op != GGML_OP_PERMUTE || ggml_get_op_params_i32(pm, 0) != 2 || ggml_get_op_params_i32(pm, 1) != 0 ||
+                ggml_get_op_params_i32(pm, 2) != 1 || ggml_get_op_params_i32(pm, 3) != 3) {
+            return 0;
+        }
+        const ggml_tensor * rs = pm->src[0];
+        if (rs->op != GGML_OP_RESHAPE || rs->src[0] != g || rs->ne[0] != H || rs->ne[1] != n_kv || rs->ne[2] != nr || rs->ne[3] != S ||
+                !ggml_is_contiguous(g)) {
+            return 0;
+        }
+        const ggml_tensor * p1 = c1->src[0];
+        if (p1->op != GGML_OP_PERMUTE || p1->src[0] != sub || ggml_get_op_params_i32(p1, 0) != 1 || ggml_get_op_params_i32(p1, 1) != 0 ||
+                ggml_get_op_params_i32(p1, 2) != 2 || ggml_get_op_params_i32(p1, 3) != 3) {
+            return 0;
+        }
+    }
+    const int outs[1] = { i_out };
+    if (!ggml_can_fuse_subgraph_ext(cgraph, idxs, count, ops, outs, 1)) {
+        return 0;
+    }
+    auto disjoint = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const char * a0 = (const char *) a->data;
+        const char * b0 = (const char *) b->data;
+        return a0 + ggml_nbytes(a) <= b0 || b0 + ggml_nbytes(b) <= a0;
+    };
+    // Every thread reads the table, sinks, rel_pos and mask entries of its own element and writes one F16 value, so the
+    // output must not overlap them.  In the unfused graph each of them may be dead by the time the output is allocated
+    // (the table and the sinks once the transposed table exists, the per-graph mask after its last layer), and the
+    // allocator may then place the output over it (it does for the global layers' large masks): an overlapping input is
+    // read from a pool copy of its bytes (same strides) taken first.
+    if (ggml_nelements(rel) > INT_MAX) {
+        return 0;
+    }
+    ggml_cuda_pool_alloc<char> cpy_buf[4] = { ggml_cuda_pool_alloc<char>(ctx.pool()), ggml_cuda_pool_alloc<char>(ctx.pool()),
+                                              ggml_cuda_pool_alloc<char>(ctx.pool()), ggml_cuda_pool_alloc<char>(ctx.pool()) };
+    const ggml_tensor * ins[4] = { table, sinks, rel, mask };
+    const char * in_d[4];
+    for (int k = 0; k < 4; ++k) {
+        in_d[k] = (const char *) ins[k]->data;
+        if (!disjoint(out, ins[k])) {
+            in_d[k] = cpy_buf[k].alloc(ggml_nbytes(ins[k]));
+            CUDA_CHECK(cudaMemcpyAsync((void *) in_d[k], ins[k]->data, ggml_nbytes(ins[k]), cudaMemcpyDeviceToDevice, ctx.stream()));
+        }
+    }
+
+    rel_mask_params p;
+    p.table = in_d[0];                    p.tb1 = table->nb[1]; p.tb2 = table->nb[2];
+    p.sinks = in_d[1];                    p.sb1 = sinks->nb[1]; p.sb2 = sinks->nb[2]; p.s_ne1 = (int) sinks->ne[1]; p.s_ne2 = (int) sinks->ne[2];
+    p.rel   = in_d[2];                    p.rb1 = rel->nb[1];
+    p.mask  = in_d[3];                    p.mb1 = mask->nb[1]; p.mb3 = mask->nb[3]; p.m_ne1 = (int) mask->ne[1]; p.m_ne3 = (int) mask->ne[3];
+    p.out   = (char *) out->data;         p.ob1 = out->nb[1];  p.ob2 = out->nb[2];  p.ob3 = out->nb[3];
+    p.n_kv = (int) n_kv; p.nr = (int) nr; p.H = (int) H; p.S = (int) S; p.E = (int) E;
+
+    const int block = 256;
+    const dim3 grid((unsigned) ((n_kv + block - 1)/block), (unsigned) nr, (unsigned) (H*S));
+    const ggml_cuda_kernel_launch_params lp = { grid, dim3(block, 1, 1), 0, ctx.stream() };
+    ggml_cuda_kernel_launch(rel_mask_f16, lp, p);
+    return i_out - i;
+}
