From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Fri, 20 Nov 2026 06:35:49 +0000
Subject: [PATCH 46/52] cuda/hip: keep hipBLASLt on when it has a stable
 solution order (>= 1.5.0); MMB BF16 path only while it is off

FINDINGS 1020 set ROCBLAS_USE_HIPBLASLT=0 because hipBLASLt returned one of
two results for identical inputs, picked once per process. The cause is
known now: for an untuned shape hipBLASLt fell back to getAllSolutions(),
ordered by the heap address of its solution objects (ROCm/rocm-libraries
#13476, openxla/xla#47659); PR #11340 (c50ea60130f) sorts it, and
hipBLASLt 1.5.0 in ROCm 10.2 contains it (1.4.1 in 10.1 does not).

- ggml_cuda_init (HIP, not Windows): with neither ROCBLAS_USE_HIPBLASLT nor
  GGML_CUDA_HIPBLASLT set, read hipBLASLt's version (dlopen NOLOAD of the
  library librocblas already loaded, hipblasLtGetVersion on a temporary
  handle) and set ROCBLAS_USE_HIPBLASLT=0 only below 1.5.0 or when
  unreadable; one WARN line says which. GGML_CUDA_HIPBLASLT=0 / 1 forces
  off / on; an explicit ROCBLAS_USE_HIPBLASLT still wins.
- mmb: the RDNA4 BF16-dense-on-MMB default applies only while hipBLASLt is
  off (ggml_cuda_hipblaslt_off()).

IQ3_S Flash-Next on ROCm 10.2, one run each (auto = hipBLASLt on / forced
off = MMB): smallpf 878 / 855, pf31k 4082 / 4014, midpf prompt 3289 / 3202,
needle prefill 3630 / 3587 t/s. Both arms reproduce their ROCm 10.1 hashes.

(cherry picked from commit a43c1c1545b8d865fe803b029136fedadb82dd08)
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 71 +++++++++++++++++++++++++++++----
 ggml/src/ggml-cuda/mmb.cu       |  5 ++-
 2 files changed, 68 insertions(+), 8 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 77d76ef7da..eb4d3da979 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -562,6 +562,46 @@ static int ggml_cuda_parse_id(const char * devName) {
 }
 #endif // defined(GGML_USE_HIP)
 
+#if defined(GGML_USE_HIP) && !defined(_WIN32)
+#include <dlfcn.h>
+// hipBLASLt's version as major*100000 + minor*100 + patch (hipblasLtGetVersion), -1 when unreadable.  librocblas links
+// libhipblaslt.so.1, so it is already loaded; RTLD_NOLOAD never pulls in a library that is not.  The call needs a
+// handle (a null one returns NOT_INITIALIZED); creating one costs ~40-180 ms, once per process.
+static int ggml_cuda_hipblaslt_version() {
+    void * lib = dlopen("libhipblaslt.so.1", RTLD_NOW | RTLD_NOLOAD);
+    if (lib == nullptr) {
+        return -1;
+    }
+    typedef int (*create_t)(void **);
+    typedef int (*destroy_t)(void *);
+    typedef int (*getver_t)(void *, int *);
+    const auto cr = (create_t)  dlsym(lib, "hipblasLtCreate");
+    const auto de = (destroy_t) dlsym(lib, "hipblasLtDestroy");
+    const auto gv = (getver_t)  dlsym(lib, "hipblasLtGetVersion");
+    int v = -1;
+    void * h = nullptr;
+    if (cr != nullptr && de != nullptr && gv != nullptr && cr(&h) == 0 && h != nullptr) {
+        if (gv(h, &v) != 0) {
+            v = -1;
+        }
+        de(h);
+    }
+    dlclose(lib);   // drops only the NOLOAD reference
+    return v;
+}
+#endif
+
+// True when rocBLAS was told to keep GEMMs off hipBLASLt (ggml_cuda_init's decision, or an explicit
+// ROCBLAS_USE_HIPBLASLT=0).  Read after ggml_cuda_init; mmb.cu routes BF16 dense weights to MMB only then.
+bool ggml_cuda_hipblaslt_off() {
+#if defined(GGML_USE_HIP)
+    static const bool off = [] { const char * e = getenv("ROCBLAS_USE_HIPBLASLT"); return e != nullptr && atoi(e) == 0; }();
+    return off;
+#else
+    return false;
+#endif
+}
+
 static ggml_cuda_device_info ggml_cuda_init() {
     ggml_cuda_device_info info = {};
 
@@ -569,15 +609,32 @@ static ggml_cuda_device_info ggml_cuda_init() {
     // FINDINGS 1020: rocBLAS hands GEMMs to hipBLASLt by default, and hipBLASLt returned one of two different
     // results for bit-identical inputs (the choice made once per process) -- the same prompt gave two distinct
     // outputs across server starts.  rocBLAS's own Tensile path was single-outcome (FINDINGS 1019, 12 starts).
-    // Default it off before the first rocBLAS handle exists; an explicit ROCBLAS_USE_HIPBLASLT in the
-    // environment still wins, and GGML_CUDA_HIPBLASLT=1 keeps rocBLAS's default (kill switch).
-    {
+    // Cause (FINDINGS 1034/1035): for an untuned shape hipBLASLt fell back to getAllSolutions(), whose order was
+    // the heap address of its solution objects; fixed by ROCm/rocm-libraries PR #11340 (c50ea60130f), first
+    // shipped in hipBLASLt 1.5.0 (ROCm 10.2).  So: hipBLASLt >= 1.5.0 keeps rocBLAS's default (hipBLASLt on);
+    // an older or unreadable version gets ROCBLAS_USE_HIPBLASLT=0 before the first rocBLAS handle exists, and
+    // the MMB BF16 path takes those GEMMs instead (mmb_bf16_dense).  An explicit ROCBLAS_USE_HIPBLASLT wins;
+    // GGML_CUDA_HIPBLASLT=0 / 1 forces off / on (no probe).  Windows: always off (no probe there).
+    // Caveat: hipBLASLt's project version was already 1.5.0 for ~3.5 weeks BEFORE the fix (from 2026-09-09); a
+    // from-source / nightly build of that window reports 1.5.0 without it -- use GGML_CUDA_HIPBLASLT=0 there.
+    if (getenv("ROCBLAS_USE_HIPBLASLT") == nullptr) {
         const char * lt = getenv("GGML_CUDA_HIPBLASLT");
-        if (lt == nullptr || atoi(lt) == 0) {
+        bool off = true;
+        if (lt != nullptr) {
+            off = atoi(lt) == 0;
+        } else {
+#if !defined(_WIN32)
+            const int v = ggml_cuda_hipblaslt_version();
+            off = v < 100500;
+            // one line per process, at WARN: INFO is not shown this early in llama-server
+            GGML_LOG_WARN("%s: hipBLASLt %s%d.%d.%d -> %s\n", __func__, v < 0 ? "version unknown " : "",
+                    v < 0 ? 0 : v / 100000, v < 0 ? 0 : (v / 100) % 1000, v < 0 ? 0 : v % 100,
+                    off ? "ROCBLAS_USE_HIPBLASLT=0 (per-process solution order, MMB BF16 path)" : "hipBLASLt on (stable solution order)");
+#endif
+        }
+        if (off) {
 #if defined(_WIN32)
-            if (getenv("ROCBLAS_USE_HIPBLASLT") == nullptr) {
-                _putenv_s("ROCBLAS_USE_HIPBLASLT", "0");
-            }
+            _putenv_s("ROCBLAS_USE_HIPBLASLT", "0");
 #else
             setenv("ROCBLAS_USE_HIPBLASLT", "0", /*overwrite =*/ 0);
 #endif
diff --git a/ggml/src/ggml-cuda/mmb.cu b/ggml/src/ggml-cuda/mmb.cu
index 8d75933ba5..e999c5009c 100644
--- a/ggml/src/ggml-cuda/mmb.cu
+++ b/ggml/src/ggml-cuda/mmb.cu
@@ -5,6 +5,7 @@
 #include <map>
 #include <utility>
 #include "mmid.cuh"
+bool ggml_cuda_hipblaslt_off();   // ggml-cuda.cu (FINDINGS 1035)
 #include "mmvf.cuh"
 #include <cstdlib>
 #include <cstring>
@@ -1945,7 +1946,9 @@ static bool mmb_tiny_m_bf16_ok(const int64_t K, const int64_t M) {
 }
 // BF16 dense weights on MMB independently of mmb_dense_flag() (FINDINGS 1030).  GGML_CUDA_MMB_BF16_DENSE=0: only
 // mmb_dense_flag() decides again (kill switch; on RDNA4 the BF16 GEMMs then go back to rocBLAS).
-static bool mmb_bf16_dense() { return mmb_policy<int>([](int d) { const char * e = getenv("GGML_CUDA_MMB_BF16_DENSE"); return e ? atoi(e) : mmb_cfg_for_device(d).bf16_dense; }) != 0; }
+// The default applies only while hipBLASLt is off (FINDINGS 1035): with a hipBLASLt that keeps a stable solution order
+// (>= 1.5.0, see ggml_cuda_init) the BF16 GEMMs stay on it.
+static bool mmb_bf16_dense() { return mmb_policy<int>([](int d) { const char * e = getenv("GGML_CUDA_MMB_BF16_DENSE"); return e ? atoi(e) : (mmb_cfg_for_device(d).bf16_dense && ggml_cuda_hipblaslt_off() ? 1 : 0); }) != 0; }
 // Lowest n_tokens for a BF16 dense weight on MMB.  Never below MMVF_MAX_BATCH_SIZE_FLAT + 1, like the F32 split
 // tile: the decode/verify band must stay on MMVF.  GGML_CUDA_MMB_BF16_MIN_T overrides.
 static int mmb_bf16_min_t() {
-- 
