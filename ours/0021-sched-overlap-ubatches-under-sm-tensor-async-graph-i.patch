+                split_backend->iface.event_record != NULL && split_backend->iface.event_wait != NULL) {
+                // FINDINGS 882: recorded upload, waited for before any host rewrite (see sched_async_cpu_out)
+                sched_upload_async(sched, split_backend_id, split_backend, input, input_cpy);
             } else if (host_src && dev_dst && !host_large && split_backend->iface.set_tensor_async != NULL &&
                 split_backend->iface.event_wait != NULL) {
                 if (sched->events[split_backend_id][sched->cur_copy] != NULL) {
@@ -3846,6 +3935,9 @@ static void ggml_backend_sched_prefetch_inputs(ggml_backend_sched_t sched, int s
     if (split_id + 1 >= sched->n_splits) {
         return;
     }
+    if (sched_any_input_up_pending(sched)) {
+        return;   // a D2H on one device is not ordered against another device's queued upload (882)
+    }
     struct ggml_backend_sched_split * split = &sched->splits[split_id];
     struct ggml_backend_sched_split * next  = &sched->splits[split_id + 1];
     const int backend_id = split->backend_id;
@@ -3983,6 +4075,10 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
 
         sched_stage_issue(sched, split);
 
+        if (sched_any_input_up_pending(sched) && ggml_backend_dev_type(ggml_backend_get_device(split_backend)) == GGML_BACKEND_DEVICE_TYPE_CPU) {
