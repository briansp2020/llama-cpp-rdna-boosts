             }
         }
 
@@ -3571,6 +3574,19 @@ static bool ggml_backend_meta_stage_input(ggml_backend_t backend, ggml_tensor *
 
     const int slot = backend_ctx->stage_slot_next;
     backend_ctx->stage_slot_next = (backend_ctx->stage_slot_next + 1) % backend_ctx->stage_n_slots;
+    {
+        // FINDINGS 882 (GGML_META_STAGE_HOST_WAIT=0 off): with the host queuing a whole ubatch ahead, a slot can be
+        // reused (or grown, which frees it at issue time) while its last reader is still queued; wait for its free
