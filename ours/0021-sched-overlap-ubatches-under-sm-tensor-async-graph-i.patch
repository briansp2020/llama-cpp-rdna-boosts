@@ -4101,6 +4197,7 @@ ggml_backend_sched_t ggml_backend_sched_new(
             }
         }
         sched->lazy_events = sched_lazy_events(meta || n_gpu > 1);
+        sched->overlap_meta = meta;
     }
 
