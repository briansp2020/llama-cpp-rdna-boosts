 // from the live pointer when the stream reaches it, so its completion is recorded and the host waits for it before the
 // next graph's inputs are written (ggml_backend_sched_wait_input_uploads: top of alloc_graph, and by the caller before
-// set_inputs on a reused graph).  CPU-split outputs and other graph inputs keep the synchronous copy (r235).
+// set_inputs on a reused graph).  Other graph inputs keep the synchronous copy (r235); under -sm tensor, views of pinned
+// graph inputs and large pinned CPU-split outputs take the recorded async upload too (FINDINGS 882).
 static bool sched_async_user_input(void) {
     static const bool on = [] {
         const char * e = GGML_ENV_STR("GGML_SCHED_ASYNC_USER_INPUT");
@@ -3415,6 +3441,60 @@ static bool sched_buffer_pinned_host(ggml_backend_buffer_t buf) {
     return n > 5 && strcmp(name + n - 5, "_Host") == 0;
 }
 
+// GGML_SCHED_ASYNC_INPUT_VIEWS (default 1): a VIEW of a pinned graph input takes the asynchronous upload above too
+// (the 861 branch needs GGML_TENSOR_FLAG_INPUT on the tensor itself; views of inputs paid a host wait for the whole
+// previous split plus a synchronous copy on every split, FINDINGS 881).  Not for an input some node writes.
+static bool sched_async_input_views(void) {
+    static const bool on = [] {
+        const char * e = GGML_ENV_STR("GGML_SCHED_ASYNC_INPUT_VIEWS");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return on;
+}
+
+// GGML_SCHED_ASYNC_CPU_OUT (default 1): a large CPU-split output in PINNED host memory (the token embeddings,
+// model.input_embed) is uploaded asynchronously on the split backend's stream with its completion recorded in
+// input_up_ev, instead of a host wait for the backend plus a synchronous copy.  The r235 live-pointer hazard is
+// covered by waiting for input_up_ev before anything rewrites host memory: before every split on a host backend
+// (ggml_backend_sched_compute_splits), before a prefetch, at alloc_graph unless deferred, and by llama before
+// set_inputs.
+static bool sched_async_cpu_out(void) {
+    static const bool on = [] {
+        const char * e = GGML_ENV_STR("GGML_SCHED_ASYNC_CPU_OUT");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return on;
+}
+
+static bool sched_any_input_up_pending(ggml_backend_sched_t sched) {
+    for (int b = 0; b < sched->n_backends; b++) {
+        if (sched->input_up_pending[b]) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// set_tensor_async of the whole input_cpy on the split backend's stream after its own split event, then the upload
+// event (the 861 tail)
+static void sched_upload_async(ggml_backend_sched_t sched, int b, ggml_backend_t be, struct ggml_tensor * input, struct ggml_tensor * input_cpy) {
+    if (sched->events[b][sched->cur_copy] != NULL) {
+        sched_event_wait_self(sched, b);
+    } else {
+        ggml_backend_synchronize(be);
+    }
+    ggml_backend_tensor_set_async(be, input_cpy, input->data, 0, ggml_nbytes(input_cpy));
+    if (sched->input_up_ev[b] == NULL) {
+        sched->input_up_ev[b] = ggml_backend_event_new(be->device);
+    }
+    if (sched->input_up_ev[b] != NULL) {
+        ggml_backend_event_record(sched->input_up_ev[b], be);
+        sched->input_up_pending[b] = true;
+    } else {
+        ggml_backend_synchronize(be);   // no event: wait for the copy here (old ordering)
+    }
+}
+
 void ggml_backend_sched_wait_input_uploads(ggml_backend_sched_t sched) {
     for (int b = 0; b < sched->n_backends; b++) {
         if (sched->input_up_pending[b]) {
@@ -3452,9 +3532,12 @@ static void ggml_backend_sched_copy_input(ggml_backend_sched_t sched, struct ggm
