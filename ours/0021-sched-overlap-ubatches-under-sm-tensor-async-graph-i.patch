-    static cudaEvent_t order_ev[GGML_CUDA_MAX_DEVICES] = {};
+    // FINDINGS 882 (GGML_MOE_ORDER_EV_RING=0 restores the single event): the order event is re-recorded whenever the
+    // arena changed since the last staging, and a queued HIP wait may bind to the LATEST record (r220).  With the host
+    // queuing a whole ubatch ahead, two records can be queued at once, and a copy-stream wait re-bound to the later
+    // one waits for compute work that itself waits for this staging: a deadlock.  A ring of events, each host-synced
+    // before it is handed out again, never re-records an event a queued wait may still reference.
+    constexpr int ORDER_RING = 16;
+    static cudaEvent_t order_ev[GGML_CUDA_MAX_DEVICES][ORDER_RING] = {};
+    static int         order_next[GGML_CUDA_MAX_DEVICES] = {};
+    static const bool  ring = [] { const char * e = getenv("GGML_MOE_ORDER_EV_RING"); return e == nullptr || atoi(e) != 0; }();
     const int dev = cuda_ctx->device;
-    if (order_ev[dev] == nullptr && cudaEventCreateWithFlags(&order_ev[dev], cudaEventDisableTiming) != cudaSuccess) {
+    const int k   = ring ? order_next[dev] : 0;
+    if (order_ev[dev][k] == nullptr && cudaEventCreateWithFlags(&order_ev[dev][k], cudaEventDisableTiming) != cudaSuccess) {
         (void) cudaGetLastError();
-        order_ev[dev] = nullptr;
+        order_ev[dev][k] = nullptr;
         return false;
     }
+    if (ring) {
+        CUDA_CHECK(cudaEventSynchronize(order_ev[dev][k]));   // never recorded, or recorded ORDER_RING calls ago
+        order_next[dev] = (k + 1) % ORDER_RING;
+    }
     if (!moe_cache_stage_table(dev, src, offset, width, stride_src, n_copies, dst,
-                               cuda_ctx->stream(), s, order_ev[dev])) {
+                               cuda_ctx->stream(), s, order_ev[dev][k])) {
         return false;
     }
     CUDA_CHECK(cudaEventRecord((cudaEvent_t) ev->context, s));
