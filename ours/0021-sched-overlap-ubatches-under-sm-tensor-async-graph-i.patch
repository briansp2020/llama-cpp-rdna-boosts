+    // (follows view chains; recomputed by every split_graph) never take the asynchronous view upload.
+    bool                 defer_input_wait_once;
+    // the 882 paths (async input views, async CPU-split output, deferred input wait) run only on a scheduler with a
+    // META (-sm tensor) backend, whose stage ring host-waits slot reuse; a plain device's sched_stage_issue ring and
+    // -sm layer are not made safe for a host a whole ubatch ahead (Fable logic review)
+    bool                 overlap_meta;
+    std::unordered_set<const ggml_tensor *> * written_inputs;   // calloc'd struct: owned pointer, freed in sched_free
     bool                 prefetch_tried [GGML_SCHED_MAX_BACKENDS];
     struct ggml_tensor * prefetched[GGML_SCHED_MAX_SPLIT_INPUTS];
     int n_prefetched;
@@ -2751,6 +2760,22 @@ void ggml_backend_sched_split_graph(ggml_backend_sched_t sched, struct ggml_cgra
     for (int i = 0; i < sched->n_splits; ++i) {
         sched->splits[i].graph.uid = ggml_graph_next_uid();
     }
+
+    // graph inputs some node writes (a non-view op on the input or on a view of it: CPY, SET_ROWS, in-place ops)
+    if (sched->written_inputs == nullptr) {
+        sched->written_inputs = new std::unordered_set<const ggml_tensor *>();
