--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -1633,6 +1633,15 @@ struct ggml_backend_sched {
     // backend; the host must not rewrite those input buffers until it has completed (ggml_backend_sched_wait_input_uploads)
     ggml_backend_event_t input_up_ev[GGML_SCHED_MAX_BACKENDS];
     bool                 input_up_pending[GGML_SCHED_MAX_BACKENDS];
+    // ubatch overlap (FINDINGS 881/882): the next alloc_graph skips its input-upload wait once; the caller waits
