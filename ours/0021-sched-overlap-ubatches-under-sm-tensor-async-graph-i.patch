             split_backend->iface.event_wait != NULL) {
@@ -3796,6 +3879,12 @@ static void ggml_backend_sched_copy_input(ggml_backend_sched_t sched, struct ggm
                 !sched_async_large_host_input();
             if (host_src && dev_dst && sched_input_stage(sched, split_backend_id, split_backend, input, input_cpy)) {
                 // pipeline copies: snapshot through the pinned ring (any size up to the ring), uploaded on this stream
+            } else if (host_src && dev_dst && host_large && sched_async_cpu_out() && sched->overlap_meta && sched->n_copies == 1 &&
