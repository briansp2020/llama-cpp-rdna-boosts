+        static const bool hw = [] { const char * e = getenv("GGML_META_STAGE_HOST_WAIT"); return e == nullptr || atoi(e) != 0; }();
+        if (hw) {
+            for (size_t j = 0; j < backend_ctx->stage_free_ev.size(); j++) {
+                if (backend_ctx->stage_free_ev[j][slot] != nullptr && backend_ctx->stage_free_rec[j][slot]) {
