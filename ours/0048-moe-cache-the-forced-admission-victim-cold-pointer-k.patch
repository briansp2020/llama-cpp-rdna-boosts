From 6588c4dc2cc7ee32efe034f2e1b3f58177c47cc0 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Thu, 5 Nov 2026 14:05:32 +0000
Subject: [PATCH 48/54] moe cache: the forced admission victim cold pointer
 kernel launches with its device current

force_admit_locked runs on the eager hook, which does not set the device.  With two GPUs the launch ran with the other
device current: an invalid handle, unchecked, left the victim cold pointer on a reused RAM slot (wrong expert bytes).
One device: unchanged.
---
 ggml/src/ggml-cuda/moe-expert-cache.cu | 1 +
 1 file changed, 1 insertion(+)

diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index 3496d3b5e..60cccc72a 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -4041,6 +4041,7 @@ static bool g_force_admit = [] {
 // exact RAM copy (as tier_swap_locked does); otherwise (a partial tier, no tier_swap) its cold pointer, which may still
 // name the RAM slot it was admitted from, goes back to the file alias.  On the compute stream, before the op.
 static void victim_cold_locked(table_t & t, int32_t victim, std::vector<table_t::precopy_t>::iterator pc, void * stream) {
+    device_guard dg(t.device);   // the eager hook runs with whichever device computed last
     if (pc != t.precopy.end()) {
         const int32_t q = pc->ram;
         moe_cache_set_ptr_kernel<<<1, 1, 0, (cudaStream_t) stream>>>(t.cold_ptrs, victim,
