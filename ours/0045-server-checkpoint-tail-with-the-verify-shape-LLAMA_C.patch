From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Sat, 21 Nov 2026 20:41:03 +0000
Subject: [PATCH 45/49] server: checkpoint tail with the verify shape
 (LLAMA_CKPT_TAIL_OUTPUTS), no checkpoint within K tokens of the newest
 (LLAMA_CKPT_NEAR_SKIP, 64), opt-in no tail for short remainders
 (LLAMA_CKPT_TAIL_MIN)

(cherry picked from commit 5e25851b968ef65defcf4bb776b6d61c68a7afd0)
(cherry picked from commit 912dd88dd06f2cb544cc3f03aa265168faa852f6)
---
 tools/server/server-context.cpp | 44 ++++++++++++++++++++++++++++++++-
 1 file changed, 43 insertions(+), 1 deletion(-)

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 99e98a9905..2cc667cc4c 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -5195,7 +5195,18 @@ private:
                         //  - 4 + n_ubatch
                         //  - 4
                         // ref: https://github.com/ggml-org/llama.cpp/pull/20288
-                        if (do_checkpoint) {
+                        // LLAMA_CKPT_TAIL_MIN=K (local, default 0 = off): no separate tail when at most K tokens of this
+                        // request were uncached -- the checkpoint at the request start (or, with LLAMA_CKPT_NEAR_SKIP, one at
+                        // most that many tokens before it) is close behind, so a rewind re-decodes <= K + NEAR_SKIP tokens.  Saves the tail
+                        // pass and its graph rebuild on short follow-ups (FINDINGS 1054); changes the ubatch split, so the
+                        // outputs change like any ubatch change.
+                        static const int ckpt_tail_min = [] {
+                            const char * e = getenv("LLAMA_CKPT_TAIL_MIN");
+                            return e != nullptr ? std::max(0, atoi(e)) : 0;
+                        }();
+                        const bool tail_skip = ckpt_tail_min > 0 &&
+                                slot.task->n_tokens() - slot.stats.n_prompt_cached <= ckpt_tail_min;
+                        if (do_checkpoint && !tail_skip) {
                             static const int checkpoint_offsets[] = {4 + n_ubatch, 4};
 
                             bool should_break = false;
@@ -5234,6 +5245,23 @@ private:
                         // extract the logits only for the last token
                         batch.set_output(batch.size() - 1, true);
 
+                        // LLAMA_CKPT_TAIL_OUTPUTS (local, on unless 0): when this last chunk is the checkpoint tail and has
+                        // the verify width (draft n_max + 1), mark all its rows as outputs.  The tail graph then has the
+                        // first verify's shape (same n_tokens and n_outputs), so the verify reuses it instead of rebuilding
+                        // (~26 ms under -sm tensor, FINDINGS 991 / 1054).  Only the last row's logits are read.
+                        static const bool ckpt_tail_outputs = [] {
+                            const char * e = getenv("LLAMA_CKPT_TAIL_OUTPUTS");
+                            return e == nullptr || atoi(e) != 0;
+                        }();
+                        if (ckpt_tail_outputs && slot.spec != nullptr && slot.task->decision.label_pos.empty() &&
+                                (int32_t) n_tokens_cur > 1 &&
+                                (int32_t) n_tokens_cur == common_speculative_n_max(slot.spec) + 1 &&
+                                (int32_t) n_tokens_cur < slot.task->n_tokens()) {
+                            for (int32_t k = 1; k < (int32_t) n_tokens_cur; k++) {
+                                batch.set_output(batch.size() - 1 - k, true);
+                            }
+                        }
+
                         // and at the answer of each packed question
                         for (const int32_t pos : slot.task->decision.label_pos) {
                             batch.set_output(batch.size() - slot.task->n_tokens() + pos, true);
@@ -5268,6 +5296,20 @@ private:
                             slot.prompt.checkpoints.empty() ||
                             is_last_user_message || near_prompt_end ||
                             n_tokens_start > slot.prompt.checkpoints.back()->n_tokens + params_base.checkpoint_min_step);
+
+                    // LLAMA_CKPT_NEAR_SKIP=K (local, default 64, 0 = off): not within K tokens after the newest checkpoint,
+                    // even at the last user message / prompt end.  An agent's follow-up request starts 4 tokens after the
+                    // previous request's tail checkpoint (n_predict 1) and saved a second 112 MiB state there; a rewind
+                    // to between the two re-decodes at most K tokens.  Never changes outputs.
+                    static const int ckpt_near_skip = [] {
+                        const char * e = getenv("LLAMA_CKPT_NEAR_SKIP");
+                        return e != nullptr ? std::max(0, atoi(e)) : 64;
+                    }();
+                    if (do_checkpoint && ckpt_near_skip > 0 && !slot.prompt.checkpoints.empty() &&
+                            n_tokens_start >= slot.prompt.checkpoints.back()->n_tokens &&
+                            n_tokens_start - slot.prompt.checkpoints.back()->n_tokens <= ckpt_near_skip) {
+                        do_checkpoint = false;
+                    }
                     SLT_DBG(slot, "main/do_checkpoint = %s, pos_min = %d, pos_max = %d\n", do_checkpoint ? "yes" : "no", pos_min, pos_max);
 
                     // note: we create the checkpoint before calling llama_decode(), so the current batch is not
-- 
