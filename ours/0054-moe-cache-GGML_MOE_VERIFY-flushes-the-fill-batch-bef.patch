From de0fc0fc9000d743b70c7aef2e89a86987bb00e6 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Fri, 6 Nov 2026 23:39:55 +0000
Subject: [PATCH 54/54] moe cache: GGML_MOE_VERIFY flushes the fill batch
 before it compares

A check that fell inside a layer saw the host bookkeeping of the admissions queued for that layer, ahead of the device
maps, slots and cold pointers, and reported them as differences.  Debug path only: no effect without GGML_MOE_VERIFY_AT
or GGML_MOE_VERIFY_EVERY.
---
 ggml/src/ggml-cuda/moe-expert-cache.cu | 1 +
 1 file changed, 1 insertion(+)

diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index e666d08fe..5b003460e 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -9280,6 +9280,7 @@ static void route_log_locked(const table_t & t, char kind, const int32_t * ids,
 // arena slot and each RAM-tier slot of every table with a fresh pack of its expert from the file mapping; logs mismatches.
 // GGML_MOE_VERIFY_EVERY=<k>: every k-th call, check only the device maps and cold pointers against the host bookkeeping.
 static void verify_all_locked(bool data) {
+    (void) fb_flush_locked();   // a queued admission has already moved the host bookkeeping: land it before comparing
     int n_dev = 0;
     (void) cudaGetDeviceCount(&n_dev);
     for (int d = 0; d < n_dev; d++) {
-- 
