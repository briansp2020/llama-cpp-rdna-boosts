From 5dc15e176d4a30eff641b62bad0ed4d2dde0cf85 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Mon, 9 Nov 2026 04:34:34 +0000
Subject: [PATCH 18/20] review fixes: PLE threads fall back when a worker
 cannot start; hc_post_rms fusion stands down under GGML_CUDA_RMS_NORM_VEC

---
 ggml/src/ggml-cuda/norm.cu |  5 +++++
 src/models/qwen4exp.cpp    | 15 +++++++++++----
 2 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-cuda/norm.cu b/ggml/src/ggml-cuda/norm.cu
index d3530a038..e2add0590 100644
--- a/ggml/src/ggml-cuda/norm.cu
+++ b/ggml/src/ggml-cuda/norm.cu
@@ -1452,6 +1452,11 @@ bool ggml_cuda_op_dsv4_hc_post_rms_fused(ggml_backend_cuda_context & ctx, ggml_t
         !ggml_is_contiguous(mul) || !ggml_are_same_shape(mul, hc_post) || hc_post->ne[3] != 1) {
         return false;
     }
+    // GGML_CUDA_RMS_NORM_VEC=1 makes the stock rms_norm sum squares per float4, a different order than this kernel's
+    // scalar sum: leave the ops unfused then, so the result stays the one the unfused graph computes.
+    if (ggml_cuda_rms_norm_vec()) {
+        return false;
+    }
     float eps = 0.0f;
     memcpy(&eps, rms->op_params, sizeof(float));
 
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 9ca6e0676..8c3ccbdd7 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -6,6 +6,7 @@
 #include <algorithm>
 #include <cinttypes>
 #include <cstdlib>
+#include <system_error>
 #include <thread>
 #include <vector>
 #if defined(__linux__) || defined(__APPLE__)
@@ -3072,7 +3073,8 @@ void llm_graph_input_ple::set_input(const llama_ubatch * ubatch) {
         }
         float * const out = direct ? (float *) emb->data : emb_scratch.data();
         // every row is dequantized on its own, so splitting the rows over threads gives the same bytes; a prompt ubatch
-        // of 4096 tokens has ~200k rows, ~30 ms on one thread between the GPU's ubatches.  LLAMA_PLE_THREADS=1: one thread.
+        // of 4096 tokens has ~200k rows, ~30 ms on one thread between the GPU's ubatches.  One thread per 4096 rows, so
+        // fewer than 8192 rows (decode) stay on this thread.  LLAMA_PLE_THREADS=1: one thread.
         static const int n_thr_max = [] {
             const char * e = getenv("LLAMA_PLE_THREADS");
             return e != nullptr ? std::max(1, atoi(e)) : 8;
@@ -3096,11 +3098,16 @@ void llm_graph_input_ple::set_input(const llama_ubatch * ubatch) {
             std::vector<std::thread> workers;
             workers.reserve(n_thr - 1);
             const size_t chunk = (n_rows + n_thr - 1) / n_thr;
-            for (int t = 1; t < n_thr; ++t) {
-                const size_t k0 = std::min(n_rows, t * chunk), k1 = std::min(n_rows, k0 + chunk);
-                workers.emplace_back(gather_rows, k0, k1);
+            try {
+                for (int t = 1; t < n_thr; ++t) {
+                    const size_t k0 = std::min(n_rows, t * chunk), k1 = std::min(n_rows, k0 + chunk);
+                    workers.emplace_back(gather_rows, k0, k1);
+                }
+            } catch (const std::system_error &) {
+                // a worker could not be started: this thread also takes the rows of the ones that are missing
             }
             gather_rows(0, std::min(n_rows, chunk));
+            gather_rows(std::min(n_rows, (workers.size() + 1) * chunk), n_rows);
             for (auto & w : workers) {
                 w.join();
             }
-- 
