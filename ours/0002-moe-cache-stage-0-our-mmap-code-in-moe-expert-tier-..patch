diff --git a/ggml/src/ggml-cuda/moe-expert-tier-state.inc b/ggml/src/ggml-cuda/moe-expert-tier-state.inc
new file mode 100644
index 000000000..af315d4d7
--- /dev/null
+++ b/ggml/src/ggml-cuda/moe-expert-tier-state.inc
@@ -0,0 +1,72 @@
+// moe-expert-tier-state.inc: included near the top of moe-expert-cache.cu, inside its anonymous namespace.
+// The per-table fields of our mmap RAM tier (--host-experts mmap); table_t derives from this struct, so Stew's table layout stays as he wrote it.
+struct moe_tier_fields {
+    int                   bounce_rr = 0;   // next entry to wait for when the bounce ring is full
+    bool        host_sparse = false;    // pageable `host`: only the experts a GPU may read are registered (see sreg_*)
+    bool        sparse_all  = false;    // the whole table is registered since the last trim
+    bool        sparse_off  = false;    // pageable master that could not be registered: the cache declines this table
+    void *      stage_dev   = nullptr;  // prefill staging: per-expert source pointers + cold flags (device copy)
+    void *      route_dev   = nullptr;  // small-prefill routed fill: per-entry source, expert id, cold flag
+    std::vector<uint8_t> route_pack;
+    // Prefill in place (GGML_MOE_PREFILL_INPLACE): the hook packs the routed fill (staged entries first, then the
+    // arena-resident ones the routed-compact MMQ can read in place) but launches nothing; the consumer resolves it
+    // (moe_cache_prefill_resolve), copying only the staged entries when it reads the rest in place.
+    bool        pf_pending  = false;
+    void *      pf_dst      = nullptr;
+    int         pf_k_stage  = 0;
+    int         pf_k_in     = 0;
+    int         pf_k_pad    = 0;   // tail-pad neighbours of in-place experts, copied only for a full-table read
+    int64_t     pf_rows     = 0;
+    bool        pf_do2d     = false;
+    std::vector<uint8_t> stage_pack;    // ... and the host copy they are uploaded from
+    mutable std::vector<uint8_t> sreg_refused;   // experts whose registration the pin budget refused (cleared by a trim)
+    // RAM tier (sparse masters): an owned pinned copy of exactly the experts the arena does not hold, in the arena's
+    // compact layout.  An admission swaps arena <-> RAM, so nothing is read from the file after sizing.
+    char *      ram_base    = nullptr;
+    size_t      ram_bytes   = 0;
+    std::vector<int32_t> ram_slot;      // expert -> RAM slot, -1 while resident
+    bool        ram_partial = false;    // the tier holds only this layer's share (the hottest cold experts); an
+                                        // expert outside it is read and filled through the registered file alias
+    std::vector<int32_t> ram_free;      // free RAM slots (the spares: where an evicted expert lands)
+    std::vector<int32_t> ram_pending;   // RAM slots freed by a swap whose H2D may still be pending: reusable only after
+                                        // `swap_ev` (tier_release_pending_locked), never within the same call
+    uintptr_t * cold_ptrs   = nullptr;  // device, expert -> its cold bytes (low bit: host geometry); kept once set
+    cudaEvent_t swap_ev     = nullptr;  // after the last swap (prefill staging on the copy stream waits on it)
+    // GGML_MOE_FILL_FENCE: in a decode take-over the swaps and the map upload record no event; the remap kernel's lag
+    // flag (written after them on the same stream) marks them done.  *_defer: issued, not yet covered by a launch;
+    // *_mark_flag: the latest marker after them is the lag flag value *_mark_seq (else swap_ev / dr_map_ev).
+    bool        swap_defer     = false;
+    bool        swap_mark_flag = false;
+    int32_t     swap_mark_seq  = 0;
+    bool        map_defer      = false;
+    bool        map_mark_flag  = false;
+    int32_t     map_mark_seq   = 0;
+    void *      mark_stream    = nullptr;   // the stream the deferred work went to
+    // Per arena slot, when its last fill is known to have landed (copy-back ahead reads the slot on the side stream):
+    // 0 = complete (a synchronous fill), > 0 = once the lag flag reaches that value, -1 = unknown (the side stream
+    // waits on pol_ev, as before), -2 = filled in the open decode take-over (not yet committed).  Missing = -1.
+    std::vector<int32_t> slot_seq;
+    std::vector<int32_t> defer_slots;       // slots at -2: the commit gives them its seq, a flush makes them -1
+    // Copy-back ahead (GGML_MOE_TIER_PRECOPY): spare RAM slots that already hold a copy of a resident the policy is likely
+    // to evict next (D2H on the device's side stream, done when `ev` fires), so its admission needs no D2H on the compute
+    // stream.  The copy stays valid while the expert is resident (weights never change); an entry is consumed by the swap
+    // that evicts it, or reclaimed once its copy completed and the expert is no longer a candidate.
+    struct precopy_t { int32_t expert; int32_t ram; cudaEvent_t ev; };
+    std::vector<precopy_t>   precopy;
+    std::vector<cudaEvent_t> precopy_idle;   // recorded-and-done or never-recorded events, for reuse
+    cudaEvent_t pol_ev      = nullptr;  // compute stream, after a policy pass: the side stream waits it before a D2H
+    // wip/prefill-prefetch (GGML_MOE_PF_PREFETCH=1): this table's region in its device's per-layer staging (a mirror of
+    // its RAM tier, then the scratch slot's expert), and the expert -> location map the routed-compact MMQ reads.
+    int64_t     pf_off      = -1;
+    size_t      pf_ram_n    = 0;        // RAM-tier slots mirrored (ram_bytes / expert_bytes)
+    int32_t *   pf_map_dev  = nullptr;  // expert -> in-place slot (< slots - 1), or slots - 1 + staging index
+    int32_t *   pf_map_host = nullptr;  // pinned, mapped source of the map upload
+    int32_t *   pf_map_hdev = nullptr;  // device alias of pf_map_host: the copy kernel reads it
+    cudaEvent_t pf_map_ev   = nullptr;
+    std::vector<int32_t> pf_map_last;   // the map last uploaded
+    bool        pf_pref     = false;    // the pending prefill fill is a prefetched one
+    bool        pf_scratch  = false;    // the map sends an expert to the scratch slot's copy (copied at the op)
+    const char * pf_stage   = nullptr;  // this table's staging region for the pending fill
+    uint32_t    remap_round = 0;    // scheduler round the remap was published in (remap_round_locked)
+    int32_t *   dr_map_hdev = nullptr;  // device alias of dr_map_host: the copy kernel reads the staging through it
+};
diff --git a/ggml/src/ggml-cuda/moe-expert-tier.inc b/ggml/src/ggml-cuda/moe-expert-tier.inc
new file mode 100644
index 000000000..b4cc7cc8b
--- /dev/null
+++ b/ggml/src/ggml-cuda/moe-expert-tier.inc
@@ -0,0 +1,3210 @@
+// moe-expert-tier.inc: included at the end of moe-expert-cache.cu.  Our --host-experts mmap code.
+#include <thread>
+
+#if defined(GGML_USE_HIP) && !defined(cudaErrorInvalidValue)
+#define cudaErrorInvalidValue hipErrorInvalidValue
+#endif
+
+static bool g_sig_probe = false;   // moe_cache_redirect_sig lookups: not counted in the stats
+
+#ifndef MADV_POPULATE_READ
+#define MADV_POPULATE_READ 22
+#endif
+
+int64_t                             g_force_admits    = 0;  // routed experts of a sparse table without a tier filled through the bounce (see force_admit_locked)
+int64_t                             g_fill_fail       = 0;   // fills rolled back (GGML_MOE_FILL_ROLLBACK)
+// Resolve the pinned host master's device-accessible alias once.  `t.src_off` is folded in by
+// `moe_cache_get_cold`, so the alias is always the base of the host tensor.
+//
+// Only a host allocation the runtime can map for device access may be used as an in-place kernel-read
+// master, and `cudaHostGetDevicePointer` is the runtime's own answer.  A pageable model mapping
+// (`--host-experts mmap` -> `CPU_Mapped`) maps to no device address; on a GPU without XNACK (RDNA
+// under ROCm reports `XNACK enabled: NO`) a kernel read of it is a fatal "page not present" fault
+// (issue #116, `mul_mat_vec_q_moe`'s cold read).  Leave `host_dev` null in that case: the in-place
+// cold region requires it and stands down, while the
+// fill copies (which source `t.host` through cudaMemcpyAsync, pageable-safe) keep the cache correct.
+// ---- sparse registration of a pageable host master (--host-experts mmap) ---------------------------------------
+// RDNA has no XNACK, so a kernel cannot read a pageable host address (issue #116).  A pageable expert master is made
+// GPU-readable without pinning all of it: a second read-only MAP_SHARED mapping of the model file (the same page
+// cache, no extra RAM) is registered with hipHostRegister only where a GPU may read it - the experts not resident in
+// the arena of some table of that master - and a registered range is device-readable at its CPU address.
+// Invariant: every expert a GPU may read from the host (a cold read, or a fill from the alias) is registered when
+// the read is enqueued and stays registered until it has completed (the trim synchronizes every device first).
+static std::map<uintptr_t, size_t> g_sreg;              // registered runs: page-aligned start -> bytes (disjoint)
+static size_t  g_sreg_bytes = 0;
+static size_t  g_sreg_peak  = 0;
+static int64_t g_sreg_fail  = 0;                         // hipHostRegister refusals
+static int64_t g_sreg_calls = 0;                         // successful hipHostRegister calls (runs created)
+static int64_t g_sreg_keep  = 0;                         // admissions skipped because a registration failed
+static int64_t g_sreg_stay  = 0;                         // admissions skipped because the victim left the page cache
+static int64_t g_sreg_nolock = 0;                        // registered runs that could not be mlocked (reclaimable)
+static int64_t g_stage_tables = 0;                       // prefill tables staged from the arena + registered alias
+static int64_t g_route_fills  = 0;                       // small-prefill routed fills from the arena + registered alias
+static int64_t g_sreg_remaps = 0;                        // unregistered runs remapped (drops the driver's SVM range)
+struct sreg_alias_t { uintptr_t lo, hi; int fd; off_t off; };
+static std::vector<sreg_alias_t> g_sreg_alias;           // every alias mapping: [lo, hi) maps `fd` from `off`
+// Replace [a, a + len) of an alias with a fresh mapping of the same file pages.  hipHostUnregister leaves KFD's SVM
+// range behind: when the kernel later reclaims one of its pages the driver re-faults the WHOLE range from disk
+// (svm_range_restore_work).  Unmapping the range removes it.
+static void sreg_remap(uintptr_t a, size_t len) {
+    static const bool off = getenv("GGML_MOE_SREG_NOREMAP") != nullptr && atoi(getenv("GGML_MOE_SREG_NOREMAP")) != 0;
+    if (off) {
+        return;
+    }
+    for (const sreg_alias_t & m : g_sreg_alias) {
+        if (a >= m.lo && a + len <= m.hi) {
+            void * r = mmap((void *) a, len, PROT_READ, MAP_SHARED | MAP_FIXED, m.fd, m.off + (off_t) (a - m.lo));
+            if (r != MAP_FAILED) {
+                g_sreg_remaps++;
+            }
+            return;
+        }
+    }
+}
+static int64_t g_sreg_trims = 0;
+static std::atomic<bool> g_any_sparse{false};            // some table has a sparse (mmap) master
+static const size_t SREG_PAD = 8192;                     // > the MMQ K-tile over-read past an expert's last row
+static size_t sreg_page() {
+    static const size_t pg = (size_t) sysconf(_SC_PAGESIZE);
+    return pg;
+}
+static size_t sreg_phys_bytes() {
+    const long pages = sysconf(_SC_PHYS_PAGES);
+    return pages > 0 ? (size_t) pages * sreg_page() : 0;
+}
+// Register every page of [lo, hi) that is not registered yet (as new disjoint runs).  False on a refusal.
+// One budget for the host memory this feature pins (mlock + GPU registration): the RAM tier of the mmap tables plus the
+// sparse registration of the tables without a tier.  GGML_MOE_PIN_BUDGET_MIB; default min(60 % of RAM, RAM - 8 GiB).
+// The tier is built hottest layer first (the sizing order) while it fits; the other tables register their cold experts
+// within what is left, and a read whose registration does not fit declines to the scheduler path.  The warm-up before the
+// sizing registers on demand within the same budget, and each table's tier then replaces its own registration, so the
+// pinned total stays within the budget (plus one table's tier during its build).
+static int64_t pin_budget_bytes() {
+    static const int64_t v = [] {
+        const char * e = getenv("GGML_MOE_PIN_BUDGET_MIB");
+        if (e != nullptr) {
+            return (int64_t) atoll(e) << 20;
+        }
+        const int64_t ram = (int64_t) sreg_phys_bytes();
+        return std::max<int64_t>(0, std::min<int64_t>(ram / 10 * 6, ram - ((int64_t) 8 << 30)));
+    }();
+    return v;
+}
+static int64_t g_tier_bytes  = 0;   // RAM tier bytes pinned (all tables)
+static int64_t g_sreg_capped       = 0;   // registrations refused by the pin budget
+static bool sreg_ensure(uintptr_t lo, uintptr_t hi) {
+    const size_t pg = sreg_page();
+    lo &= ~(uintptr_t) (pg - 1);
+    hi  = (hi + pg - 1) & ~(uintptr_t) (pg - 1);
+    uintptr_t cur = lo;
+    while (cur < hi) {
+        auto it = g_sreg.lower_bound(cur);
+        if (it != g_sreg.end() && it->first == cur) {
+            cur += it->second;
+            continue;
+        }
+        if (it != g_sreg.begin()) {
+            auto p = std::prev(it);
+            if (p->first + p->second > cur) {
+                cur = p->first + p->second;
+                continue;
+            }
+        }
+        const uintptr_t gap_end = (it == g_sreg.end()) ? hi : std::min<uintptr_t>(hi, it->first);
+        if (g_tier_bytes + (int64_t) (g_sreg_bytes + (gap_end - cur)) > pin_budget_bytes()) {
+            g_sreg_capped++;
+            return false;   // over the pin budget: the read declines (served by the scheduler path)
+        }
+        (void) madvise((void *) cur, gap_end - cur, MADV_WILLNEED);   // large readahead instead of 4 KiB faults
+        // hipHostRegister does not pin (HMM mirror): without the lock the kernel reclaims these GPU-only-read pages
+        // first and the KFD restore worker re-reads them from disk with the queues stopped.
+        if (mlock((void *) cur, gap_end - cur) != 0 && g_sreg_nolock++ < 2) {
+            GGML_LOG_WARN("moe_cache sparse registration: mlock %p + %zu failed: %s (registered pages stay reclaimable)\n",
+                          (void *) cur, (size_t) (gap_end - cur), strerror(errno));
+        }
+        const cudaError_t err = cudaHostRegister((void *) cur, gap_end - cur, cudaHostRegisterPortable | cudaHostRegisterReadOnly);
+        if (err != cudaSuccess) {
+            (void) cudaGetLastError();
+            (void) munlock((void *) cur, gap_end - cur);
+            if (g_sreg_fail++ < 2) {
+                GGML_LOG_WARN("moe_cache sparse registration: register %p + %zu failed: %s\n", (void *) cur,
+                              (size_t) (gap_end - cur), cudaGetErrorString(err));
+            }
+            return false;
+        }
+        g_sreg[cur]   = gap_end - cur;
+        g_sreg_bytes += gap_end - cur;
+        g_sreg_peak   = std::max(g_sreg_peak, g_sreg_bytes);
+        g_sreg_calls++;
+        cur = gap_end;
+    }
+    return true;
+}
+// The bytes of expert `e` THIS table (device) reads in place: its own slice when the slice is contiguous (an axis-1
+// split: gate/up under -sm tensor), else the whole expert (an axis-0 slice interleaves with the other device row by row).
+static void sparse_span(const table_t & t, int32_t e, uintptr_t & lo, uintptr_t & hi) {
+    const bool strided = t.split_axis == 0 && t.host_pitch != 0;
+    lo = (uintptr_t) t.host_dev + (uintptr_t) e * t.host_bytes + (strided ? 0 : (uintptr_t) t.src_off);
+    hi = lo + (strided ? t.host_bytes : t.expert_bytes);
+}
+// Make expert `e` of a sparse table device-readable.  False when it cannot be (the caller must not let a GPU read it).
+// Registered bytes inside [lo, hi) (whole runs that start there).
+static size_t sreg_bytes_in(uintptr_t lo, uintptr_t hi) {
+    size_t n = 0;
+    for (auto it = g_sreg.lower_bound(lo & ~(uintptr_t) (sreg_page() - 1)); it != g_sreg.end() && it->first < hi; ++it) {
+        n += it->second;
+    }
+    return n;
+}
+static bool sparse_need_locked(const table_t & t, int32_t e) {
+    if (!t.host_sparse || t.host_dev == nullptr) {
+        return true;
+    }
+    if (t.ram_base != nullptr && (!t.ram_partial || (e >= 0 && e < (int32_t) t.ram_slot.size() && t.ram_slot[(size_t) e] >= 0))) {
+        return true;   // (a RAM-tier table reads its cold experts from the tier)
+    }
+    if (e < 0 || e >= t.n_experts) {
+        return false;
+    }
+    if ((size_t) e < t.sreg_refused.size() && t.sreg_refused[(size_t) e]) {
+        return false;   // refused by the pin budget since the last trim
+    }
+    uintptr_t lo, hi;
+    sparse_span(t, e, lo, hi);
+    const int64_t capped = g_sreg_capped;
+    if (sreg_ensure(lo, hi + SREG_PAD) || sreg_ensure(lo, hi)) {   // (the pad may run past the mapping)
+        return true;
+    }
+    // refused by the budget, or the registration itself failed: either way not retried until the next trim (a failed
+    // register already paid an mlock + munlock of the span, and every call would repeat it)
+    (void) capped;
+    {
+        if (t.sreg_refused.size() != (size_t) t.n_experts) {
+            t.sreg_refused.assign((size_t) t.n_experts, 0);
+        }
+        t.sreg_refused[(size_t) e] = 1;
+    }
+    return false;
+}
+// Read [lo, hi) of a pageable mapping into the page cache with several threads (one synchronous fault stream reads
+// the NVMe at a fraction of its bandwidth).
+static void sparse_populate(uintptr_t lo, uintptr_t hi) {
+#ifndef MADV_POPULATE_READ
+#define MADV_POPULATE_READ 22
+#endif
+    const size_t pg = sreg_page();
+    lo &= ~(uintptr_t) (pg - 1);
+    const int       n_thr = 8;
+    const uintptr_t step  = ((hi - lo) / n_thr + pg - 1) & ~(uintptr_t) (pg - 1);
+    std::vector<std::thread> thr;
+    for (int i = 0; i < n_thr; i++) {
+        const uintptr_t a = lo + (uintptr_t) i * step, b = std::min<uintptr_t>(hi, a + step);
+        if (a < b) {
+            thr.emplace_back([a, b] { (void) madvise((void *) a, b - a, MADV_POPULATE_READ); });
+        }
+    }
+    for (auto & th : thr) {
+        th.join();
+    }
+}
+// Copy this device's slice of expert `e` from the (populated) mapping to `dst` in the arena's compact layout.
+static void sparse_pack_expert(const table_t & t, int32_t e, char * dst) {
+    const char * src = (const char *) t.host_dev + (size_t) e * t.host_bytes + t.src_off;
+    if (t.split_axis == 0 && t.host_pitch != 0) {
+        const size_t rows = t.host_bytes / t.host_pitch, row_bytes = t.expert_bytes / rows;
+        for (size_t r = 0; r < rows; r++) {
+            memcpy(dst + r * row_bytes, src + r * t.host_pitch, row_bytes);
+        }
+    } else {
+        memcpy(dst, src, t.expert_bytes);
+    }
+}
+// Copy experts 0..k-1 of a sparse table into arena slots 0..k-1 through a pinned staging buffer: the master stays
+// unregistered (registering, then dropping, what the arena holds costs a register call per expert).
+static bool sparse_stage_fill_locked(const table_t & t, int k) {
+    static char *  stage     = nullptr;
+    static size_t  stage_cap = 0;
+    const bool     do2d = t.split_axis == 0 && t.host_pitch != 0;
+    const int64_t  rows = do2d ? (int64_t) (t.host_bytes / t.host_pitch) : 1;
+    if (rows <= 0 || t.expert_bytes % (size_t) rows != 0) {
+        return false;
+    }
+    const size_t need = std::max<size_t>(t.expert_bytes, 64u << 20);
+    if (stage_cap < need) {
+        if (stage != nullptr) {
+            (void) cudaFreeHost(stage);
+        }
+        stage = nullptr;
+        stage_cap = 0;
+        if (cudaMallocHost((void **) &stage, need) != cudaSuccess) {
+            (void) cudaGetLastError();
+            stage = nullptr;
+            return false;
+        }
+        stage_cap = need;
+    }
+    device_guard dg(t.device);
+    const int per = (int) (stage_cap / t.expert_bytes);
+    for (int e0 = 0; e0 < k; e0 += per) {
+        const int n = std::min(per, k - e0);
+        for (int j = 0; j < n; j++) {
+            sparse_pack_expert(t, e0 + j, stage + (size_t) j * t.expert_bytes);
+        }
+        if (cudaMemcpy((char *) t.arena + (size_t) e0 * t.expert_bytes, stage, (size_t) n * t.expert_bytes,
+                       cudaMemcpyHostToDevice) != cudaSuccess) {
+            (void) cudaGetLastError();
