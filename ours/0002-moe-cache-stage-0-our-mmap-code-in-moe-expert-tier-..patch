+// Copies between the arena and pinned host memory done by a kernel (the GPU reads / writes the host memory directly).
+// On ROCm a small hipMemcpyAsync to or from pinned memory can leave the device's later queued work unsubmitted until a
+// host synchronize; with the all-reduce pairing the two devices, that stalls the peer past its spin timeout (HANDOVER 303).
+static __global__ void moe_cache_copy_kernel(char * __restrict__ dst, const char * __restrict__ src, size_t n) {
+    const size_t stride = (size_t) gridDim.x * blockDim.x;
+    size_t       i      = (size_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if ((((uintptr_t) dst | (uintptr_t) src | n) & 15) == 0) {
+        uint4 *       d = (uint4 *) dst;
+        const uint4 * q = (const uint4 *) src;
+        for (; i < n / 16; i += stride) {
+            d[i] = q[i];
+        }
+        return;
+    }
+    for (; i < n; i += stride) {
+        dst[i] = src[i];
+    }
