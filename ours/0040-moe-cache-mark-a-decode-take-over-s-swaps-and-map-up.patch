From e5bd2aa8c1ac77b5d751a5dd9c3ad923c97177c6 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Tue, 3 Nov 2026 07:17:27 +0000
Subject: [PATCH 40/43] moe cache: mark a decode take-over's swaps and map
 upload done by the remap lag flag, not an event each (GGML_MOE_FILL_FENCE,
 default on)

Every cudaEventRecord on the compute stream is a marker packet the GPU spends ~4-6 us on (FINDINGS 745): an
admitting layer-step recorded swap_ev after every swap and dr_map_ev after the map upload.  Inside a decode take-over
(devremap_prep_locked) those records are deferred; the remap kernel launched right after on the same stream already
writes the lag flag with a system-scope release, so its value marks the deferred work done.  Every exit without a
flag launch records the events as before; a blocking release or another stream's wait materializes swap_ev first.
pol_ev (the precopy side stream's wait) is unchanged.  GGML_MOE_FILL_FENCE=0 restores the old records.
---
 ggml/src/ggml-cuda/moe-expert-cache.cu | 125 +++++++++++++++++++++++--
 1 file changed, 118 insertions(+), 7 deletions(-)

diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index 8bcdeb5a2..206669ff0 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -137,6 +137,16 @@ struct table_t {
                                         // `swap_ev` (tier_release_pending_locked), never within the same call
     uintptr_t * cold_ptrs   = nullptr;  // device, expert -> its cold bytes (low bit: host geometry); kept once set
     cudaEvent_t swap_ev     = nullptr;  // after the last swap (prefill staging on the copy stream waits on it)
+    // GGML_MOE_FILL_FENCE: in a decode take-over the swaps and the map upload record no event; the remap kernel's lag
+    // flag (written after them on the same stream) marks them done.  *_defer: issued, not yet covered by a launch;
+    // *_mark_flag: the latest marker after them is the lag flag value *_mark_seq (else swap_ev / dr_map_ev).
+    bool        swap_defer     = false;
+    bool        swap_mark_flag = false;
+    int32_t     swap_mark_seq  = 0;
+    bool        map_defer      = false;
+    bool        map_mark_flag  = false;
+    int32_t     map_mark_seq   = 0;
+    void *      mark_stream    = nullptr;   // the stream the deferred work went to
     // Copy-back ahead (GGML_MOE_TIER_PRECOPY): spare RAM slots that already hold a copy of a resident the policy is likely
     // to evict next (D2H on the device's side stream, done when `ev` fires), so its admission needs no D2H on the compute
     // stream.  The copy stays valid while the expert is resident (weights never change); an entry is consumed by the swap
@@ -946,6 +956,15 @@ static bool tier_fill_on() {
 static int64_t g_tier_swaps_d2h = 0;   // swaps that copied the victim back on the compute stream
 static int64_t g_tier_nospare   = 0;   // misses served cold because no spare RAM slot (or precopy of the victim) was ready
 static int64_t g_pc_issued = 0, g_pc_used = 0, g_pc_reclaimed = 0;
+// GGML_MOE_FILL_FENCE (default on): a decode take-over's swaps and map upload are marked done by the remap kernel's lag
+// flag instead of an event record each (every record is a marker packet the GPU spends ~4-6 us on, FINDINGS 745).
+// =0: an event after every swap and map upload, as before.
+static const bool g_fill_fence = [] {
+    const char * e = getenv("GGML_MOE_FILL_FENCE");
+    return e == nullptr || atoi(e) != 0;
+}();
+static const void * g_defer_tab = nullptr;   // the table whose decode take-over defers its markers (else none)
+static int64_t g_fence_commits = 0, g_fence_flushes = 0;
 static int64_t g_pc_waited = 0;   // admissions whose precopy had not completed yet (the GPU waited for it)
 // GGML_MOE_TIER_PRECOPY=0: no copy-back ahead (each swap copies its victim back on the compute stream, as before).
 static const bool g_precopy = [] {
@@ -1294,6 +1313,7 @@ static void tier_drop_all_locked(const char * why) {
         t.ram_incl    = false;
         t.ram_free.clear();
         t.ram_pending.clear();
+        t.swap_defer = false; t.swap_mark_flag = false;
         for (const table_t::precopy_t & c : t.precopy) {
             t.precopy_idle.push_back(c.ev);
         }
@@ -1890,7 +1910,12 @@ static cudaError_t tier_swap_locked(table_t & t, void * dst, int32_t e, int32_t
         if (err != cudaSuccess) {
             return err;
         }
-        (void) cudaEventRecord(t.swap_ev, s);
+        if (g_defer_tab == &t) {
+            t.swap_defer = true; t.mark_stream = stream;
+        } else {
+            (void) cudaEventRecord(t.swap_ev, s);
+            t.swap_mark_flag = false;
+        }
         g_tier_file_fills++;
         g_tier_swaps++;
         return cudaGetLastError();
@@ -1907,17 +1932,76 @@ static cudaError_t tier_swap_locked(table_t & t, void * dst, int32_t e, int32_t
     }
     t.ram_slot[(size_t) e] = -1;
     t.ram_pending.push_back(p);   // its H2D is only enqueued: a D2H into it before that copy ran would corrupt the expert
-    (void) cudaEventRecord(t.swap_ev, s);
+    if (g_defer_tab == &t) {
+        t.swap_defer = true; t.mark_stream = stream;
+    } else {
+        (void) cudaEventRecord(t.swap_ev, s);
+        t.swap_mark_flag = false;
+    }
     g_tier_swaps++;
     return cudaGetLastError();
 }
 
+// GGML_MOE_FILL_FENCE: the lag flag has reached `seq` (the remap launch that wrote it ran after the deferred work).
+static bool fence_done_locked(const table_t & t, int32_t seq) {
+    if (t.dr_lag_host == nullptr) {
+        return false;
+    }
+    const uint32_t v = (uint32_t) __atomic_load_n(&t.dr_lag_host[t.dr_cap], __ATOMIC_ACQUIRE);
+    return (int32_t) (v - (uint32_t) seq) >= 0;
+}
+// Deferred swaps / map upload that no launch will cover: record their events now (on the stream they went to).
+static void fence_flush_locked(table_t & t) {
+    if (!t.swap_defer && !t.map_defer) {
+        return;
+    }
+    device_guard dg(t.device);
+    const cudaStream_t ms = (cudaStream_t) t.mark_stream;
+    if (t.swap_defer) {
+        (void) cudaEventRecord(t.swap_ev, ms);
+        t.swap_defer = false; t.swap_mark_flag = false;
+    }
+    if (t.map_defer) {
+        (void) cudaEventRecord(t.dr_map_ev, ms);
+        t.map_defer = false; t.map_mark_flag = false;
+    }
+    (void) cudaGetLastError();
+    g_fence_flushes++;
+}
+// The remap launch that writes lag flag value `seq` covers the deferred work.
+static void fence_commit_locked(table_t & t, int32_t seq) {
+    g_fence_commits += t.swap_defer || t.map_defer;
+    if (t.swap_defer) {
+        t.swap_defer = false; t.swap_mark_flag = true; t.swap_mark_seq = seq;
+    }
+    if (t.map_defer) {
+        t.map_defer = false; t.map_mark_flag = true; t.map_mark_seq = seq;
+    }
+}
+// swap_ev made current again (a consumer that needs an event: a blocking wait, another stream's wait).
+static void swap_ev_materialize_locked(table_t & t) {
+    fence_flush_locked(t);
+    if (t.swap_mark_flag) {
+        device_guard dg(t.device);
+        (void) cudaEventRecord(t.swap_ev, (cudaStream_t) t.mark_stream);
+        (void) cudaGetLastError();
+        t.swap_mark_flag = false;
+    }
+}
+
 // Make the RAM slots freed by earlier swaps reusable, once every swap enqueued so far has completed.
 static void tier_release_pending_locked(table_t & t, bool block = true) {
     if (t.ram_pending.empty()) {
         return;
     }
-    if (t.swap_ev != nullptr) {
+    if (t.swap_defer || (t.swap_mark_flag && block)) {
+        swap_ev_materialize_locked(t);   // never spin on the flag: a blocking wait uses an event
+    }
+    if (t.swap_mark_flag) {
+        if (!fence_done_locked(t, t.swap_mark_seq)) {
+            return;   // not yet: the spare stays pending, misses are served cold meanwhile
+        }
+    } else if (t.swap_ev != nullptr) {
         device_guard dg(t.device);
         if (!block) {
             if (cudaEventQuery(t.swap_ev) != cudaSuccess) {
@@ -4838,6 +4922,7 @@ bool moe_cache_stage_table(const void * src, size_t offset, size_t total, void *
             return false;
         }
         if (t.swap_ev != nullptr) {
+            swap_ev_materialize_locked(t);
             (void) cudaStreamWaitEvent((cudaStream_t) stream, t.swap_ev, 0);   // the tier is written on the compute stream
         }
         moe_cache_stage_kernel<<<dim3(16, (unsigned) n), 256, 0, (cudaStream_t) stream>>>(
@@ -8617,6 +8702,10 @@ static void devremap_free_locked(table_t & t) {
         return;
     }
     device_guard dg(t.dr_device);
+    if (t.swap_defer || t.swap_mark_flag || t.map_defer || t.map_mark_flag) {
+        (void) cudaDeviceSynchronize();   // the markers name the lag flag freed below: everything they cover is done
+        t.swap_defer = t.swap_mark_flag = t.map_defer = t.map_mark_flag = false;
+    }
     if (t.dr_map_dev  != nullptr) { (void) cudaFree(t.dr_map_dev); }
     if (t.dr_map_host != nullptr) { (void) cudaFreeHost(t.dr_map_host); }
     if (t.dr_lag_host != nullptr) { (void) cudaFreeHost(t.dr_lag_host); }
@@ -8678,7 +8767,7 @@ static bool dr_map_refresh_locked(table_t & t, cudaStream_t s) {
     if (!t.slot_dirty && t.dr_map_ok) {
         return true;
     }
-    if (cudaEventQuery(t.dr_map_ev) != cudaSuccess) {
+    if (t.map_defer || (t.map_mark_flag ? !fence_done_locked(t, t.map_mark_seq) : cudaEventQuery(t.dr_map_ev) != cudaSuccess)) {
         (void) cudaGetLastError();
         return false;
     }
@@ -8698,7 +8787,12 @@ static bool dr_map_refresh_locked(table_t & t, cudaStream_t s) {
         t.dr_map_ok = false;
         return false;
     }
-    (void) cudaEventRecord(t.dr_map_ev, s);
+    if (g_defer_tab == &t) {
+        t.map_defer = true; t.mark_stream = s;
+    } else {
+        (void) cudaEventRecord(t.dr_map_ev, s);
+        t.map_mark_flag = false;
+    }
     t.slot_dirty = false;
     t.dr_map_ok  = true;
     return true;
@@ -8923,6 +9017,11 @@ static bool devremap_prep_locked(table_t & t, void * stream) {
         return false;
     }
     const cudaStream_t s = (cudaStream_t) stream;
+    // the caller commits (the remap launch's lag flag) or flushes (events) whatever this defers
+    struct defer_scope {
+        explicit defer_scope(const table_t * p) { g_defer_tab = g_fill_fence ? p : nullptr; }
+        ~defer_scope() { g_defer_tab = nullptr; }
+    };
 
     // 1. The residency policy on the previous call's routing (the old pass 1, one call late).  Its admissions and
     //    tier swaps are enqueued on `s`, ahead of this call's remap and op.  The event is in the past: the host read
@@ -8931,6 +9030,7 @@ static bool devremap_prep_locked(table_t & t, void * stream) {
     // device can hold back the other device's half of an all-reduce (the internal AR then times out and returns a
     // partial sum).  Work that is not ready yet is skipped for this call; residency never changes the output.
     tier_release_pending_locked(t, false);
+    defer_scope ds(&t);
     if (t.dr_lag_n > 0) {
         const bool lag_ready = t.dr_lag_flag ? __atomic_load_n(&t.dr_lag_host[t.dr_cap], __ATOMIC_ACQUIRE) == t.dr_lag_seq
                                              : cudaEventQuery(t.dr_lag_ev) == cudaSuccess;
@@ -9477,6 +9577,7 @@ bool moe_cache_remap_dev(const ggml_tensor * weight, const ggml_tensor * weight_
     device_guard       dg(t.device);
     const cudaStream_t s = (cudaStream_t) stream;
     if (!devremap_prep_locked(t, stream)) {
+        fence_flush_locked(t);
         return decline();
     }
     moe_devremap_jobs jobs = {};
@@ -9499,6 +9600,7 @@ bool moe_cache_remap_dev(const ggml_tensor * weight, const ggml_tensor * weight_
                 continue;
             }
             if (!devremap_prep_locked(u, stream)) {
+                fence_flush_locked(u);
                 u.remap_n_used = 0;
                 u.dr_lag_n     = 0;
                 continue;   // its own call retries
@@ -9522,11 +9624,19 @@ bool moe_cache_remap_dev(const ggml_tensor * weight, const ggml_tensor * weight_
     moe_cache_remap_kernel<<<dim3((unsigned) ((n + 255) / 256), (unsigned) n_jobs), 256, 0, s>>>(
             (const int32_t *) ids->data, s1, (int) n_used, (int) n_tok, t.n_experts, jobs);
     if (cudaGetLastError() != cudaSuccess) {
+        for (int j = 0; j < n_jobs; j++) {
+            fence_flush_locked(g_tables[job_id[j]]);
+        }
         return decline();
     }
     if (!use_flag) {
         for (int j = 0; j < n_jobs; j++) {
             (void) cudaEventRecord(g_tables[job_id[j]].dr_lag_ev, s);
+            fence_flush_locked(g_tables[job_id[j]]);
+        }
+    } else {
+        for (int j = 0; j < n_jobs; j++) {
+            fence_commit_locked(g_tables[job_id[j]], jobs.seq_val[j]);
         }
     }
     b.ids    = ids->data;
@@ -10003,8 +10113,9 @@ void moe_cache_report() {
                       "in-stream; %lld misses cold for lack of a spare\n", __func__, g_tier_spares, g_precopy ? "on" : "off",
                       (long long) g_pc_issued, (long long) g_pc_used, (long long) g_pc_waited, (long long) g_pc_reclaimed,
                       (long long) g_tier_swaps_d2h, (long long) g_tier_nospare);
-        GGML_LOG_WARN("%s: device remap: %lld calls%s\n", __func__, (long long) g_devremap_calls,
-                      g_devremap ? "" : " (GGML_MOE_DEVREMAP=0)");
+        GGML_LOG_WARN("%s: device remap: %lld calls%s; fill fence %s: %lld take-overs marked by the lag flag, %lld by events\n",
+                      __func__, (long long) g_devremap_calls, g_devremap ? "" : " (GGML_MOE_DEVREMAP=0)",
+                      g_fill_fence ? "on" : "off (GGML_MOE_FILL_FENCE=0)", (long long) g_fence_commits, (long long) g_fence_flushes);
         int n_pairs = 0, n_diff = 0;
         for (const table_t & g : g_tables) {
             if (g.role.find("ffn_gate_exps") == std::string::npos || g.ram_base == nullptr) {
