---
 ggml/src/ggml-cuda/moe-expert-tier.inc | 48 ++++++++++++++++++++++++--
 1 file changed, 45 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-cuda/moe-expert-tier.inc b/ggml/src/ggml-cuda/moe-expert-tier.inc
index 6f1100c9d3..2f581c0ceb 100644
--- a/ggml/src/ggml-cuda/moe-expert-tier.inc
+++ b/ggml/src/ggml-cuda/moe-expert-tier.inc
@@ -2360,23 +2360,50 @@ static __global__ void moe_cache_route_kernel(char * __restrict__ dst, const cha
 // Where a device-side copy reads expert `e`: its arena slot, its RAM-tier slot (both contiguous, cold 0), or the
 // registered alias of the sparse master with the host geometry (cold 1, registered here).  False: a RAM-tier table
 // without a slot for `e`, or an alias that cannot be registered.
-static bool expert_copy_src_locked(const table_t & t, int32_t e, const char ** src, uint8_t * cold) {
+// GGML_MOE_KV_SEG_PF (default on with the KV segment, =0 off): a small prefill ubatch, which passes the `stream` its copy
+// runs on, reads an expert's KV-segment copy (contiguous, cold 0, the same bytes) before the RAM tier or the file: a
+// device-to-device copy.  Only on the stream that writes and reuses those slots, so the read is ordered against them,
+// and not a slot a queued fill job still writes or a fill has pinned.  Nothing of the policy's state is touched.
+// n_src (optional) counts the expert by source: arena, KV copy, RAM tier, file.  A usable KV copy counts as one with
+// the switch off too (the source is then the RAM tier / file as before), so the report sizes what the switch would move.
+static bool kvl_seg_pf_on() {
+    static const bool v = kvl_seg_on() && (getenv("GGML_MOE_KV_SEG_PF") == nullptr || atoi(getenv("GGML_MOE_KV_SEG_PF")) > 0);
+    return v;
+}
+static int64_t g_pf_src_n[4] = {};   // small prefill ubatches: experts staged from the arena, a KV copy, the RAM tier, the file
+static bool expert_copy_src_locked(const table_t & t, int32_t e, const char ** src, uint8_t * cold, void * stream = nullptr,
+                                   int64_t * n_src = nullptr) {
     const auto it = t.expert_slot.find(e);
+    int        kv = stream != nullptr && kvl_seg_on() && stream == kvl_stream(t.device) && e < (int32_t) kvl_kvv(t).size() ?
+                    kvl_kvv(t)[(size_t) e] : -1;
+    if (kv >= 0 && (kv == g_kvl_pin || fb_kv_busy(kv) || !kvl_avail(g_kvl_slots[(size_t) kv]))) {
+        kv = -1;
+    }
+    int from = 0;
     if (it != t.expert_slot.end() && t.arena != nullptr) {
         *src  = (const char *) t.arena + (size_t) it->second * t.expert_bytes;
         *cold = 0;
+    } else if (kv >= 0 && kvl_seg_pf_on()) {
+        *src  = kvl_ptr(g_kvl_slots[(size_t) kv]);
+        *cold = 0;
+        from  = 1;
     } else if (t.ram_base != nullptr && (!t.ram_partial || t.ram_slot[(size_t) e] >= 0)) {
         if (t.ram_slot[(size_t) e] < 0) {
             return false;
         }
         *src  = t.ram_base + (size_t) t.ram_slot[(size_t) e] * t.expert_bytes;
         *cold = 0;
+        from  = kv >= 0 ? 1 : 2;
     } else {
         if (!sparse_need_locked(t, e)) {
             return false;
         }
         *src  = (const char *) t.host_dev + (size_t) e * t.host_bytes + t.src_off;
         *cold = 1;
+        from  = kv >= 0 ? 1 : 3;
+    }
+    if (n_src != nullptr) {
+        n_src[from]++;
     }
     return true;
 }
@@ -2414,11 +2441,12 @@ static bool sparse_fill_routed_locked(table_t & t, void * dst, const int32_t * i
     int32_t *     eids = (int32_t *) (t.route_pack.data() + n * sizeof(void *));
     uint8_t *     cold = t.route_pack.data() + n * (sizeof(void *) + sizeof(int32_t));
     unsigned k = 0;
+    int64_t  n_src[4] = {};
     for (int32_t e = 0; e < t.n_experts; e++) {
         if (!want[(size_t) e]) {
             continue;
         }
-        if (!expert_copy_src_locked(t, e, &srcs[k], &cold[k])) {
+        if (!expert_copy_src_locked(t, e, &srcs[k], &cold[k], stream, n_src)) {
             return false;
         }
         eids[k] = e;
@@ -2449,6 +2477,9 @@ static bool sparse_fill_routed_locked(table_t & t, void * dst, const int32_t * i
         return false;
     }
     g_route_fills++;
+    for (int i = 0; i < 4; i++) {
+        g_pf_src_n[i] += n_src[i];
+    }
     return true;
 }
 } // namespace
@@ -2897,8 +2928,10 @@ static bool prefill_inplace_prepare_locked(table_t & t, const ggml_tensor * weig
     int32_t *     eids = (int32_t *) (t.route_pack.data() + n * sizeof(void *));
     uint8_t *     cold = t.route_pack.data() + n * (sizeof(void *) + sizeof(int32_t));
     int k = 0;
+    int64_t   n_src[4] = {};
+    int64_t * cnt      = n_src;   // the staged entries only: the in-place and pad ones are not read by the in-place fill
     const auto add = [&](int32_t e) -> bool {
-        if (!expert_copy_src_locked(t, e, &srcs[k], &cold[k])) {
+        if (!expert_copy_src_locked(t, e, &srcs[k], &cold[k], stream, cnt)) {
             return false;
         }
         eids[k++] = e;
@@ -2910,6 +2943,7 @@ static bool prefill_inplace_prepare_locked(table_t & t, const ggml_tensor * weig
         }
     }
     const int k_stage = k;
+    cnt = nullptr;
     for (int32_t e = 0; e < t.n_experts; e++) {
         if (used[(size_t) e] && !stage[(size_t) e] && !add(e)) {
             return false;
@@ -2953,6 +2987,9 @@ static bool prefill_inplace_prepare_locked(table_t & t, const ggml_tensor * weig
     t.pf_do2d    = do2d;
     g_alias_to_id[weight_cpy] = (int) (&t - g_tables.data());
     g_route_fills++;
+    for (int i = 0; i < 4; i++) {
+        g_pf_src_n[i] += n_src[i];
+    }
     return true;
 }
 // ---- wip/prefill-prefetch (GGML_MOE_PF_PREFETCH=1) ----
@@ -4352,6 +4389,11 @@ static void tier_report_locked() {
                 GGML_LOG_WARN("%s: KV segment: %lld seeds, %lld demand fills (%lld replacing), %lld held, %lld policy reads of held experts; quota %d / %d per table\n", __func__,
                               (long long) g_kvl_seeds, (long long) g_kvl_seg_fills, (long long) g_kvl_seg_repl, (long long) held,
                               (long long) g_kvl_seg_hits, g_kvl_quota[0], g_kvl_quota[1]);
+                GGML_LOG_WARN("%s: KV segment: small prefill ubatches staged %lld experts from the arena, %lld %s, "
+                              "%lld from the RAM tier, %lld from the file\n", __func__, (long long) g_pf_src_n[0],
+                              (long long) g_pf_src_n[1], kvl_seg_pf_on() ? "from KV copies" :
+                              "with a KV copy (GGML_MOE_KV_SEG_PF off: read from the RAM tier / file)",
+                              (long long) g_pf_src_n[2], (long long) g_pf_src_n[3]);
             }
             if (g_pf_lends > 0 || g_pf_takes > 0) {
                 int64_t pf_held = 0;
-- 
